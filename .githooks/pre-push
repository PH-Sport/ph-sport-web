#!/bin/sh
# Corre el smoke E2E antes de subir a main. En este proyecto un push a main
# despliega a producción, así que es la última parada antes de que un fallo sea
# visible para el usuario.
#
# Vive en .githooks/ (versionado) y no en .git/hooks/ (que no se clona) para que
# valga en cualquier dispositivo. Lo activa `core.hooksPath`, que configura el
# script `prepare` de package.json en cada npm install.
#
# Para saltárselo puntualmente: git push --no-verify
# (la Action de GitHub lo comprobará igual, solo que después del despliegue).

rama_protegida="refs/heads/main"
toca_main=0
shas_subidos=""

# git entrega por stdin una línea por ref empujada:
#   <ref local> <sha local> <ref remota> <sha remota>
while read -r _ref_local sha_local ref_remota _sha_remota; do
  # Sha local a ceros = se está borrando la rama remota: nada que comprobar.
  case "$sha_local" in
    *[!0]*) ;;
    *) continue ;;
  esac
  shas_subidos="$shas_subidos $sha_local"
  if [ "$ref_remota" = "$rama_protegida" ]; then
    toca_main=1
  fi
done

# Los planes y specs van a docs/historico/, no a docs/superpowers/ — que es donde
# las skills de superpowers escriben por defecto, y por eso reaparece sola. El
# porqué del nombre está en CLAUDE.md → "Dónde va un plan o una spec nueva".
for sha in $shas_subidos; do
  [ -n "$(git ls-tree -r --name-only "$sha" -- docs/superpowers 2>/dev/null)" ] || continue

  cat >&2 <<'MSG'

✗ pre-push: hay documentos en docs/superpowers/ — push abortado.

  Esa carpeta se retiró: su nombre decía qué herramienta escribió los documentos,
  no que están congelados, que es lo que hay que saber antes de leerlos.

  Arreglarlo:  git mv docs/superpowers/plans/* docs/historico/plans/
               git mv docs/superpowers/specs/* docs/historico/specs/
               rmdir docs/superpowers/plans docs/superpowers/specs docs/superpowers

  (Ojo: NO afecta a .superpowers/ en la raíz, que sí es del plugin.)

MSG
  exit 1
done

if [ "$toca_main" -eq 0 ]; then
  exit 0
fi

echo "▶ pre-push: smoke E2E antes de desplegar a producción (~40s)…"

if npm run test:e2e --silent; then
  echo "✓ pre-push: 38 tests en verde. Subiendo."
  exit 0
fi

cat >&2 <<'MSG'

✗ pre-push: el smoke E2E ha fallado — push abortado.

  Un push a main despliega a producción, así que esto habría llegado a la web.

  Ver el detalle:   npx playwright show-report
  Repetir en vivo:  npm run test:e2e:ui
  Subir de todos modos (bajo tu responsabilidad):  git push --no-verify

MSG
exit 1
