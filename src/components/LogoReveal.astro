---
// Telón de intro — animación en CSS, sin GSAP.
//
// Antes esto era una timeline de GSAP lanzada en `astro:page-load` (es decir,
// después de `window.load`): el overlay tapaba la home hasta 2,57 s DESPUÉS de
// que hubiera terminado de cargar todo, y sólo desaparecía si el JS llegaba, se
// ejecutaba y terminaba bien. Un fallo de JS dejaba la portada en negro.
//
// Ahora la animación es CSS puro: arranca con el primer pintado y termina sola
// pase lo que pase. El JS que queda no la controla, sólo anota que ya se ha
// visto.
//
// El overlay se monta como hermano de <main> (ver BaseLayout), no dentro. Con
// `transition:name` en <main> se forma un contexto de apilamiento propio y el
// z-index del overlay no podía ganar al header; había un parche de CSS para
// taparlo que ya no hace falta.
//
// Longitudes del trazo: son constantes (el viewBox y los puntos están fijos), así
// que van escritas. Antes se medían con getTotalLength() en tiempo de ejecución,
// con 32 reintentos por si el SVG aún no tenía layout y dos valores de reserva
// que, de paso, estaban un 22% pasados. Nada de eso hace falta.
const LOGO_VIEWBOX = '0 0 259.8 206.1';
const POLYGON_1_POINTS =
  '0 206.1 58.2 206.1 57.9 145.5 158.1 45.4 112.7 0 0 0 0 52.6 76.9 52.6 0 128.7';
const POLYGON_2_POINTS =
  '122.6 206.1 200.1 206.1 152.2 157.8 173 137.1 182.4 146.4 259.8 146.4 169.6 55.6 130.5 94.2 131.8 95.6 141.1 105.4 120.3 125.8 109.8 115.4 70.8 153.9';

/** Perímetros reales, redondeados HACIA ARRIBA: por debajo asomaría una esquirla
 *  del segmento de cierre del polígono en el offset máximo. */
const LEN_1 = 753; // real 752,4284
const LEN_2 = 637; // real 636,0980
---

<div data-logo-reveal-overlay aria-hidden="true" inert>
  <div class="logo-reveal-container" data-logo-reveal-container>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox={LOGO_VIEWBOX}
      fill="currentColor"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="butt"
      stroke-linejoin="bevel"
    >
      <polygon data-logo-line1 points={POLYGON_1_POINTS} stroke-dasharray={LEN_1} stroke-dashoffset={LEN_1} />
      <polygon data-logo-line2 points={POLYGON_2_POINTS} stroke-dasharray={LEN_2} stroke-dashoffset={LEN_2} />
    </svg>
  </div>
</div>

{/* El CSS del telón NO vive aquí sino en línea en el <head> de BaseLayout.
    Motivo medido: desde este componente el CSS viaja en el bundle común y no se
    aplicaba hasta los 838 ms — el overlay se pintaba antes como un div suelto,
    sin tapar nada, y la animación arrancaba con medio segundo de retraso. */}

<script>
  /* Lo único que hace el JS es anotar que la intro ya se ha visto. Si nada de
     esto llega a ejecutarse, el telón se reproduce y se va igual: la animación es
     CSS y no depende de nadie. */
  const CLAVE_VISTA = 'ph-intro-vista';
  const CLAVE_PETICION = 'ph-logo-reveal-request';
  /** 18 h: no repite la intro al que vuelve el mismo día por la tarde, y sí al que
   *  vuelve al día siguiente. Se guarda un instante, no una fecha: así no hay
   *  borde de medianoche, ni sorpresas al viajar de país o al cambiar el reloj. */
  const VENTANA_MS = 18 * 60 * 60 * 1000;

  function marcarVista(): void {
    try {
      localStorage.setItem(CLAVE_VISTA, String(Date.now()));
    } catch {
      /* almacenamiento bloqueado (incógnito estricto): la intro volverá a salir */
    }
  }

  function marcaVigente(): boolean {
    try {
      const t = Number(localStorage.getItem(CLAVE_VISTA));
      return Number.isFinite(t) && t > 0 && Date.now() - t < VENTANA_MS;
    } catch {
      return false;
    }
  }

  /** El clic en el logo del menú pide la intro a propósito. Al ser navegación SPA
   *  el script del <head> no vuelve a correr, así que se consume aquí. */
  function consumirPeticion(): boolean {
    try {
      const pedida = sessionStorage.getItem(CLAVE_PETICION) === '1';
      if (pedida) sessionStorage.removeItem(CLAVE_PETICION);
      return pedida;
    } catch {
      return false;
    }
  }

  function observarOverlay(): void {
    const overlay = document.querySelector<HTMLElement>('[data-logo-reveal-overlay]');
    if (!overlay) return; // no estamos en la home
    if (document.documentElement.classList.contains('ph-sin-intro')) return;
    if (overlay.dataset.observado === '1') return;
    overlay.dataset.observado = '1';

    // Se anota cuando la intro TERMINA de verse, no cuando carga el documento:
    // Chrome prerenderiza páginas desde la barra de direcciones y ejecuta sus
    // scripts antes de mostrarlas, así que anotar en la carga se comería la intro
    // de la primera visita sin que nadie la viera.
    //
    // Se pregunta por la animación en vez de escuchar `animationend` porque este
    // script no controla cuándo se ejecuta: si arrancara tarde, el evento ya
    // habría pasado y la marca no se escribiría nunca (la intro reaparecía en
    // cada visita). Preguntando, el caso "ya ha terminado" también queda cubierto.
    const salida = overlay
      .getAnimations()
      .find((a) => (a as CSSAnimation).animationName === 'ph-intro-salir');

    if (!salida) {
      // O ya terminó, o no hay animación (sin movimiento). Sólo cuenta como vista
      // si de verdad se llegó a reproducir, es decir, si el telón está retirado.
      if (getComputedStyle(overlay).visibility === 'hidden') marcarVista();
      return;
    }
    void salida.finished.then(marcarVista).catch(() => {});
  }

  /* Se llama en cuanto corre el módulo —no sólo en `astro:page-load`, que espera a
     `window.load` y puede llegar después de que el telón haya terminado— y también
     en cada navegación interna. La guarda `observado` evita duplicar. */
  observarOverlay();
  document.addEventListener('astro:page-load', observarOverlay);

  /* Navegación interna: Astro rehace <html> en cada swap y se lleva la clase, así
     que hay que volver a DECIDIR sobre el documento entrante. Copiar la clase no
     serviría: cuando la intro sí se reproduce, la clase no está puesta, y al
     volver a la home desde otra página la intro saldría otra vez. */
  document.addEventListener('astro:before-swap', (e) => {
    const nuevo = (e as { newDocument?: Document }).newDocument;
    if (!nuevo) return;
    if (consumirPeticion()) return; // la ha pedido el usuario: que salga
    if (marcaVigente()) nuevo.documentElement.classList.add('ph-sin-intro');
  });
</script>
