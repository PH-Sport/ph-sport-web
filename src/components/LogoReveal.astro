---
// LogoReveal vanilla (sin React) — reemplaza al island LogoReveal.tsx, su único
// uso de React. Elimina el runtime de React/ReactDOM (~182 KB) de la home.
//
// El overlay se renderiza en server y cubre el contenido desde el primer paint
// (igual que hacía el SSR del island), así que no hay flash de contenido antes de
// la intro. Un <script> con GSAP reproduce la animación (o descarta el overlay) en
// astro:page-load — el mismo patrón que usan todas las secciones .astro.
const LOGO_VIEWBOX = '0 0 259.8 206.1';
const POLYGON_1_POINTS =
  '0 206.1 58.2 206.1 57.9 145.5 158.1 45.4 112.7 0 0 0 0 52.6 76.9 52.6 0 128.7';
const POLYGON_2_POINTS =
  '122.6 206.1 200.1 206.1 152.2 157.8 173 137.1 182.4 146.4 259.8 146.4 169.6 55.6 130.5 94.2 131.8 95.6 141.1 105.4 120.3 125.8 109.8 115.4 70.8 153.9';
---

<div
  data-logo-reveal-overlay
  style="position:fixed;inset:0;z-index:9999;background-color:#0d0f12;display:flex;align-items:center;justify-content:center"
>
  <div
    class="logo-reveal-container"
    data-logo-reveal-container
    style="color:#ffffff"
    aria-hidden="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox={LOGO_VIEWBOX}
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="butt"
      stroke-linejoin="bevel"
      style="display:block;width:100%;height:auto;overflow:visible"
    >
      <polygon
        data-logo-line1
        points={POLYGON_1_POINTS}
        stroke-dasharray="9999"
        stroke-dashoffset="9999"
      />
      <polygon
        data-logo-line2
        points={POLYGON_2_POINTS}
        stroke-dasharray="9999"
        stroke-dashoffset="9999"
      />
    </svg>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  const REVEAL_REQUEST_KEY = 'ph-logo-reveal-request';
  // Oculta el chrome (header) mientras el overlay está activo: el overlay vive en
  // main (z-index bajo) y el header fijo quedaría encima.
  const REVEAL_CHROME_CLASS = 'ph-logo-reveal-active';
  // Si getTotalLength() es 0 (SVG aún sin layout), reintentar en vez de saltar la animación.
  const LAYOUT_LENGTH_RETRIES_MAX = 32;
  const FALLBACK_LEN_1 = 920;
  const FALLBACK_LEN_2 = 780;

  // Persiste durante la vida del documento: el módulo se ejecuta una sola vez y
  // sobrevive a las navegaciones SPA (Astro no re-ejecuta scripts ya cargados), se
  // resetea solo en F5/cold load. Distingue la primera entrada a home (cold load o
  // SPA-nav a home desde otra ruta) de los re-mounts por navegación interna.
  let firstRunThisDoc = true;
  let activeTimeline: gsap.core.Timeline | null = null;

  function setRevealChromeVisible(visible: boolean): void {
    document.documentElement.classList.toggle(REVEAL_CHROME_CLASS, !visible);
  }

  function restoreLayout(): void {
    document.documentElement.style.overflow = '';
    document.documentElement.style.paddingRight = '';
  }

  function dispatchLogoRevealed(): void {
    document.dispatchEvent(new CustomEvent('ph:logo-revealed'));
  }

  // Si el dismiss ocurre en el mismo tick que el arranque, un posible listener
  // (astro:page-load) puede no existir aún y el evento se perdería: lo aplazamos.
  function scheduleLogoRevealed(): void {
    requestAnimationFrame(() => requestAnimationFrame(dispatchLogoRevealed));
  }

  // Entrada suave del header tras el overlay (respeta reduced-motion → instantáneo).
  function revealHeaderAfterIntro(): void {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setRevealChromeVisible(true);
      return;
    }
    gsap.killTweensOf(header);
    gsap.set(header, { opacity: 0, y: -14, pointerEvents: 'none' });
    setRevealChromeVisible(true);
    gsap.to(header, {
      opacity: 1,
      y: 0,
      duration: 0.55,
      ease: 'power3.out',
      onComplete: () => {
        gsap.set(header, { clearProps: 'opacity,transform,pointerEvents' });
      },
    });
  }

  function dismissOverlay(overlay: HTMLElement): void {
    overlay.style.display = 'none';
    restoreLayout();
    setRevealChromeVisible(true);
    scheduleLogoRevealed();
  }

  function runTimeline(
    overlay: HTMLElement,
    container: HTMLElement,
    line1: SVGPolygonElement,
    line2: SVGPolygonElement,
    len1: number,
    len2: number,
  ): void {
    gsap.set(overlay, { opacity: 1, display: 'flex' });

    const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
    document.documentElement.style.paddingRight = `${scrollbarWidth}px`;
    document.documentElement.style.overflow = 'hidden';
    setRevealChromeVisible(false);

    gsap.set([line1, line2], {
      strokeDasharray: (i: number) => (i === 0 ? len1 : len2),
      strokeDashoffset: (i: number) => (i === 0 ? len1 : len2),
    });

    let revealDispatched = false;
    const dispatchRevealOnce = (): void => {
      if (revealDispatched) return;
      revealDispatched = true;
      dispatchLogoRevealed();
    };

    const tl = gsap.timeline({
      onComplete: () => {
        overlay.style.display = 'none';
        dispatchRevealOnce();
        revealHeaderAfterIntro();
        activeTimeline = null;
      },
    });
    activeTimeline = tl;

    tl.to(line1, { strokeDashoffset: 0, duration: 0.8, ease: 'power3.inOut' })
      .to(line2, { strokeDashoffset: 0, duration: 0.7, ease: 'power3.inOut' }, '-=0.45')
      .to(container, { color: '#D6B25E', duration: 0.3, ease: 'power2.inOut' }, '-=0.15')
      .to([line1, line2], { fill: '#D6B25E', duration: 0.35, ease: 'power2.inOut' }, '-=0.1')
      .to([line1, line2], { stroke: 'none', duration: 0.2 }, '-=0.05')
      .to({}, { duration: 0.3 });

    const exitDistance = window.innerWidth / 2 + 150;
    tl.to(line1, { x: -exitDistance, opacity: 0, duration: 0.6, ease: 'expo.in' })
      .to(line2, { x: exitDistance, opacity: 0, duration: 0.6, ease: 'expo.in' }, '<');
    tl.to(overlay, { opacity: 0, duration: 0.3, onStart: restoreLayout }, '-=0.25');
  }

  function runLogoReveal(): void {
    const overlay = document.querySelector<HTMLElement>('[data-logo-reveal-overlay]');
    if (!overlay) return; // no estamos en home

    const isFirstMount = firstRunThisDoc;
    firstRunThisDoc = false;

    const container = document.querySelector<HTMLElement>('[data-logo-reveal-container]');
    const line1 = document.querySelector<SVGPolygonElement>('[data-logo-line1]');
    const line2 = document.querySelector<SVGPolygonElement>('[data-logo-line2]');

    const path = window.location.pathname.replace(/\/$/, '') || '/';
    const isHome = path === '/' || path === '/en';

    if (!isHome || !container || !line1 || !line2) {
      dismissOverlay(overlay);
      return;
    }

    const hasRequest = sessionStorage.getItem(REVEAL_REQUEST_KEY) === '1';
    if (hasRequest) sessionStorage.removeItem(REVEAL_REQUEST_KEY);

    // Reveal si: (1) primera entrada a home en este documento (cold load / F5 /
    // SPA-nav a home desde otra ruta) → isFirstMount, o (2) click en el logo del
    // navbar → REVEAL_REQUEST_KEY. Los re-mounts por SPA navigation quedan fuera.
    const shouldReveal = hasRequest || isFirstMount;
    if (!shouldReveal) {
      dismissOverlay(overlay);
      return;
    }

    let lengthAttempts = 0;
    const start = (): void => {
      let len1v = line1.getTotalLength();
      let len2v = line2.getTotalLength();
      if (len1v < 1 || len2v < 1) {
        lengthAttempts += 1;
        if (lengthAttempts < LAYOUT_LENGTH_RETRIES_MAX) {
          requestAnimationFrame(start);
          return;
        }
        len1v = FALLBACK_LEN_1;
        len2v = FALLBACK_LEN_2;
      }
      runTimeline(overlay, container, line1, line2, len1v, len2v);
    };
    requestAnimationFrame(start);
  }

  // Cleanup antes de cada swap (equivale al unmount del island): mata la timeline,
  // restaura el layout y revela el chrome para no dejar el header oculto.
  document.addEventListener('astro:before-swap', () => {
    if (activeTimeline) {
      activeTimeline.kill();
      activeTimeline = null;
    }
    const overlay = document.querySelector<HTMLElement>('[data-logo-reveal-overlay]');
    const line1 = document.querySelector<SVGPolygonElement>('[data-logo-line1]');
    const line2 = document.querySelector<SVGPolygonElement>('[data-logo-line2]');
    [overlay, line1, line2].forEach((el) => el && gsap.killTweensOf(el));
    restoreLayout();
    setRevealChromeVisible(true);
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (header) gsap.set(header, { clearProps: 'opacity,transform,pointerEvents' });
  });

  document.addEventListener('astro:page-load', runLogoReveal);
</script>
