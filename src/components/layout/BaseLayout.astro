---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import QuietScrollHistory from './QuietScrollHistory.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import LogoReveal from '@/components/LogoReveal.astro';
import { useTranslations, getLangUrls, localizePath, supportedLangs, type Lang } from '@/i18n/utils';
import { SITE_URL } from '@/lib/constants';
import { SOCIAL_LINKS, isSocialPlaceholder } from '@/lib/social';
import { NAV_ITEMS } from '@/lib/navigation';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonical: string;
  ogImage?: string;
  hasHero?: boolean;
  noIndex?: boolean;
  /** Monta el telón de intro (sólo la home). Va aquí y no en la página para que
   *  quede fuera de <main> — ver el comentario junto a <LogoReveal />. */
  intro?: boolean;
  /**
   * Imagen LCP a precargar. Si la imagen tiene variantes responsive,
   * pasa { mobile, desktop } y se emiten dos preloads media-aware
   * para evitar descargar las dos.
   */
  preloadImage?: string | { mobile: string; desktop: string; mobileMaxWidth?: number };
}

const { title, description, lang, canonical, ogImage, hasHero = false, noIndex = false, intro = false, preloadImage } = Astro.props;
const preloadIsResponsive = typeof preloadImage === 'object' && preloadImage !== null;
const preloadMobile = preloadIsResponsive ? preloadImage.mobile : null;
const preloadDesktop = preloadIsResponsive ? preloadImage.desktop : null;
const preloadBreakpoint = preloadIsResponsive ? (preloadImage.mobileMaxWidth ?? 720) : 720;
const preloadSingle = typeof preloadImage === 'string' ? preloadImage : null;
const t = useTranslations(lang);

// Una etiqueta hreflang por cada idioma en que existe esta página (los textos
// legales no tienen versión italiana). La propia usa el canonical tal cual.
const langUrls = getLangUrls(Astro.url.pathname);
const alternates = supportedLangs
  .filter((code) => langUrls[code] !== undefined)
  .map((code) => ({ code, href: code === lang ? canonical : `${SITE_URL}${langUrls[code]}` }));
const esUrl = alternates.find((a) => a.code === 'es')!.href;

const OG_LOCALES: Record<Lang, string> = { es: 'es_ES', en: 'en_US', it: 'it_IT' };

// OG image: el override (`ogImage`) puede llegar relativo o absoluto.
// Sin override, fallback al asset por defecto. La spec OG exige URL absoluta.
const ogImageRaw = ogImage ?? '/og-image.jpg';
const ogImageUrl = ogImageRaw.startsWith('http') ? ogImageRaw : `${SITE_URL}${ogImageRaw}`;

// WebSite: esquema que Google usa específicamente para el "site name" en SERP
// (el nombre junto al logo y la URL). Sin esto, Google lo deriva del dominio en minúsculas.
//
// Solo se emite en la raíz del dominio: Google exige que este bloque esté en la
// home ("the domain or subdomain level root URI") e ignora el site name a nivel
// de subdirectorio, así que en /en/ y en el resto de páginas solo sería ruido.
// `url` lleva barra final para coincidir con el canonical exacto de la home.
const isHome = Astro.url.pathname === '/';
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PHSPORT',
  url: `${SITE_URL}/`,
};

// SportsOrganization: identidad de marca para que Google muestre "PHSPORT" en
// SERP en lugar de derivar el nombre del dominio en minúsculas. Bloque global;
// la description sigue el idioma de la página actual.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'PHSPORT',
  alternateName: 'PHSPORT Management',
  url: SITE_URL,
  logo: `${SITE_URL}/logo.svg`,
  description: t('site.description'),
  sameAs: SOCIAL_LINKS.filter((s) => !isSocialPlaceholder(s.href)).map((s) => s.href),
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'info@phsport.es',
    availableLanguage: ['Spanish', 'English'],
  },
};

// El cartón de título entre páginas (`.ph-stinger`, ph-motion.ts) enseña el
// nombre de la página de destino en su idioma: las etiquetas del menú y, para
// los textos legales, las del pie. Mapa ruta → etiqueta, sin barra final.
const normPath = (path: string) => (path === '/' ? '/' : path.replace(/\/+$/, ''));
const cardTitles: Record<string, string> = {};
for (const code of supportedLangs) {
  const tl = useTranslations(code);
  for (const item of NAV_ITEMS) cardTitles[normPath(item.href[code])] = tl(item.labelKey);
}
for (const code of ['es', 'en'] as const) {
  const tl = useTranslations(code);
  cardTitles[normPath(localizePath('/aviso-legal', code))] = tl('footer.legal.notice');
  cardTitles[normPath(localizePath('/privacidad', code))] = tl('footer.legal.privacy');
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    {/* `viewport-fit=cover`: la página se dibuja también bajo la barra de estado y el
        notch, así esas franjas salen del negro de la web y no del blanco del sistema
        cuando el móvil está en modo claro. Lo que queda tapado se recupera con
        `env(safe-area-inset-*)` en global.css y en la cápsula del header. */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    {/* La web es oscura siempre, no sigue al sistema. Sin esta declaración el
        navegador la trata como clara: pinta de blanco el rebote del scroll y los
        controles nativos, y en iOS puede teñir su propio chrome en claro. Va en el
        <head> —y repetida en CSS— para que valga desde el primer pintado. */}
    <meta name="color-scheme" content="dark" />

    {/* Dos decisiones que hay que tomar ANTES del primer pintado, en una sola
        pausa del parser:

        1. FOUC guard: marca el documento si vamos a animar (no reduced-motion).
           El CSS oculta [data-reveal] mientras esté la clase; el init de cada
           sección los revela cuando GSAP toma el control, evitando el parpadeo
           entre el pintado y el arranque. Sin JS o con reduced-motion la clase
           no se añade → visible.

        2. Telón de intro: si ya se vio hace menos de 18 h y el usuario no lo ha
           pedido a propósito (clic en el logo), se marca el documento para que el
           CSS no llegue ni a pintar el overlay. Tiene que ser aquí y no en el
           componente: una vez pintado, ya es tarde.

        `document.prerendering`: Chrome prerenderiza páginas desde la barra de
        direcciones y ejecuta sus scripts antes de mostrarlas. Sin esta guarda, la
        intro de la primera visita se daría por vista sin que nadie la viera. */}
    <script is:inline>
      (function () {
        var raiz = document.documentElement;
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          raiz.classList.add('ph-anim');
        }
        if (document.prerendering) return;
        try {
          if (sessionStorage.getItem('ph-logo-reveal-request') === '1') return;
          var t = Number(localStorage.getItem('ph-intro-vista'));
          if (t > 0 && Date.now() - t < 18 * 60 * 60 * 1000) {
            raiz.classList.add('ph-sin-intro');
          }
        } catch (e) {
          /* almacenamiento bloqueado: que salga la intro */
        }
      })();
    </script>

    {/* Iconos: SVG primario + PNG fallback + apple-touch (iOS home screen) + mask-icon (Safari pinned tab). */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#D6B25E" />
    <meta name="theme-color" content="#0d0f12" />

    {/* iOS: si el usuario añade phsport.es a Home Screen, abre standalone (sin chrome de Safari)
        con status bar translúcido sobre el hero negro. Title corto bajo el icono. */}
    {/* `mobile-web-app-capable` es el nombre estándar; el `apple-` está deprecado y
        salta un aviso en consola, pero se mantiene porque iOS aún lee ese. */}
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PHSPORT" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {/* x-default: quien no habla ninguno de los idiomas de la web ve la versión española. */}
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

    {/* Open Graph: tarjetas ricas en WhatsApp, iMessage, LinkedIn, Slack, Discord, FB. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PHSPORT" />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter / X: usa su propio namespace; `summary_large_image` muestra hero a ancho completo. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preload" href="/fonts/sohne/sohne-buch.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sohne/sohne-halbfett.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sohne/sohne-dreiviertelfett.woff2" as="font" type="font/woff2" crossorigin />

    {preloadSingle && <link rel="preload" as="image" href={preloadSingle} />}
    {preloadIsResponsive && (
      <>
        <link rel="preload" as="image" href={preloadMobile} media={`(max-width: ${preloadBreakpoint}px)`} />
        <link rel="preload" as="image" href={preloadDesktop} media={`(min-width: ${preloadBreakpoint + 1}px)`} />
      </>
    )}

    {/* Telón de intro: su CSS va aquí, en línea, y no en el componente.
        Medido: desde el `<style>` del componente el CSS no se aplicaba hasta los
        838 ms (viaja en el bundle común, que hay que descargar), así que el
        overlay se pintaba ~180 ms como un div suelto sin tapar nada y la
        animación arrancaba tarde. En línea aplica con el primer pintado.

        No confundir con lo que había antes: aquello eran declaraciones en el
        atributo `style` del elemento, que ganan a cualquier regla y hacían
        imposible ocultarlo. Esto es una hoja normal, así que la regla de
        `ph-sin-intro` funciona. */}
    {/* La intro es un corte seco de cine (LogoReveal.astro): negro; un hilo dorado
        se dibuja en el centro y el logo se abre desde esa rendija, con el tamaño
        y en el sitio exactos del rótulo de neón del vídeo —las dos fórmulas de
        ancho salen del encuadre del render, `scale` en
        scripts/hero-neon/neon.html, con la cámara en la pose con la que arranca
        el encendido (distancia 1,22): 0,48 del alto en apaisado y 0,70 del ancho
        en vertical, entre 1,22, con `cover`—; se sostiene y, a 1,2 s, corta en
        seco al neón en el mismo sitio (un corte a juego). Ahí arranca el lema del
        hero. La animación de salida se sigue llamando `ph-intro-salir`: el script
        del componente y el del hero la buscan por nombre. */}
    {intro && (
      <style is:inline set:html={`
[data-logo-reveal-overlay]{position:fixed;inset:0;z-index:9999;background-color:#0d0f12;view-transition-name:ph-intro;touch-action:none;animation:ph-intro-salir .04s linear 1.2s forwards}
html.ph-sin-intro [data-logo-reveal-overlay]{display:none}
@media (prefers-reduced-motion:reduce){[data-logo-reveal-overlay]{display:none}}
[data-logo-reveal-overlay] .logo-reveal-container{position:absolute;left:50%;top:50%;width:max(27.9vw,49.6vh);color:#D6B25E;transform:translate(-50%,-50%)}
@media (max-aspect-ratio:9/10){[data-logo-reveal-overlay] .logo-reveal-container{width:max(57.4vw,26.5vh)}}
[data-logo-reveal-overlay] .logo-reveal-container::before{content:'';position:absolute;left:0;right:0;top:50%;height:1px;margin-top:-.5px;background:#D6B25E;transform:scaleX(0);animation:ph-intro-hilo .16s cubic-bezier(.16,1,.3,1) .1s forwards,ph-intro-hilo-fuera .2s linear .5s forwards}
[data-logo-reveal-overlay] svg{display:block;width:100%;height:auto;clip-path:inset(50% 0 50% 0);animation:ph-intro-rendija .36s cubic-bezier(.05,.7,.1,1) .26s forwards}
@keyframes ph-intro-hilo{to{transform:scaleX(1)}}
@keyframes ph-intro-hilo-fuera{to{opacity:0}}
@keyframes ph-intro-rendija{to{clip-path:inset(0 0 0 0)}}
@keyframes ph-intro-salir{0%,99%{visibility:visible}to{visibility:hidden;opacity:0;pointer-events:none}}
`} />
    )}

    {/* Antes del router a propósito: envuelve `history.replaceState` para que el
        guardado de scroll no toque el historial y la barra de direcciones no
        vuelva a salir en los navegadores WebKit de iPhone. Ver el componente. */}
    <QuietScrollHistory />
    <ClientRouter />
  </head>
  <body>
    {/* Sonda del alto de pantalla: la mide el script de más abajo para congelar
        `--ph-viewport-h`. Invisible y sin peso en el layout. */}
    <div data-viewport-probe aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">{t('a11y.skip')}</a>
    {/* El telón va FUERA de <main> a propósito. `transition:name` forma un
        contexto de apilamiento propio, así que dentro de main su z-index no podía
        ganarle al header (hacía falta un parche de CSS para ocultarlo) y además
        el fundido entre páginas se comía los primeros fotogramas de la intro.
        Como hermano de main, el z-index manda y no hace falta nada de eso. */}
    {intro && <LogoReveal />}
    <Header />
    <main
      id="main-content"
      class:list={[!hasHero && 'main--padded']}
      transition:name="page-main"
    >
      <slot />
    </main>
    <Footer />
    {/* El cartón de título que tapa el cambio de página (`.ph-stinger` en
        global.css; lo mueve src/scripts/ph-motion.ts). Va fijo a la pantalla y
        con su propio nombre de View Transition: por encima de la página y del
        menú móvil, por debajo de la cabecera. `data-titles` es el nombre de cada
        página en su idioma. */}
    <div class="ph-stinger" data-stinger data-titles={JSON.stringify(cardTitles)} aria-hidden="true">
      <span class="ph-stinger__label" data-stinger-label></span>
    </div>

    <script>
      /* El alto de pantalla se mide una vez y se queda quieto.
       *
       * Ninguna unidad de CSS sirve para esto en los navegadores de iPhone que no
       * son Safari: al recoger o sacar su barra de direcciones redimensionan la
       * ventana entera, y `svh`, `lvh` y `vh` la siguen todas (medido en un iPhone
       * real: 630 ↔ 717px). Un elemento a pantalla completa cambia de alto en pleno
       * scroll, empuja lo que tiene debajo e invalida la capa del documento, así que
       * se repinta la página entera. Congelado el valor, la ventana encoge y estira
       * sin que el layout se mueva.
       *
       * Se vuelve a medir sólo cuando cambia el ANCHO —rotar el móvil, redimensionar
       * la ventana—, que es el único cambio que de verdad pide recalcular. Un cambio
       * de sólo alto es la barra, y ésa es justo la que hay que ignorar.
       *
       * Si el script no llega a correr, manda el `100svh` de respaldo y todo mide lo
       * mismo: esto no añade una medida, congela la que ya había. */
      let anchoMedido = -1;
      let altoCongelado = '';

      function medirAltoPantalla() {
        // La sonda lleva `svh` literal, así que su altura no depende del valor
        // congelado: se puede leer sin retirarlo antes.
        const sonda = document.querySelector<HTMLElement>('[data-viewport-probe]');
        if (!sonda || window.innerWidth === anchoMedido) return;
        anchoMedido = window.innerWidth;
        altoCongelado = `${Math.round(sonda.getBoundingClientRect().height)}px`;
        document.documentElement.style.setProperty('--ph-viewport-h', altoCongelado);
      }

      function reaplicarAltoPantalla() {
        // Astro rehace el <html> en cada swap y se lleva por delante el estilo
        // inline: se repone el valor ya medido, sin volver a medir, para que todas
        // las páginas de la sesión compartan el mismo alto.
        if (altoCongelado) {
          document.documentElement.style.setProperty('--ph-viewport-h', altoCongelado);
        }
      }

      medirAltoPantalla();
      window.addEventListener('resize', medirAltoPantalla, { passive: true });
      document.addEventListener('astro:after-swap', reaplicarAltoPantalla);

      const HEADER_SCROLL_THRESHOLD = 16;
      const SCROLL_HIDE_MIN_Y = 64;
      const SCROLL_DIRECTION_DELTA = 6;

      let lastScrollY = 0;
      let scrollFrameScheduled = false;

      function prefersReducedMotion(): boolean {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      }

      function isMobileMenuOpen(): boolean {
        return document.querySelector('[data-mobile-menu]')?.classList.contains('is-open') ?? false;
      }

      // Lecturas primero, escrituras después: evita que un classList.toggle
      // invalide layout y forme el patrón read-write-read-write que causaba
      // forced reflow (19-48 ms por scroll en el audit perf).
      function updateScrollEffects() {
        const header = document.querySelector('[data-header]');
        if (!header) return;

        // PHASE 1 — reads
        const y = window.scrollY;
        const reducedMotion = prefersReducedMotion();
        const menuOpen = isMobileMenuOpen();
        const wasHidden = header.classList.contains('header--scroll-hidden');
        const delta = y - lastScrollY;

        // PHASE 2 — compute (sin tocar DOM)
        const shouldBeSolid = y > HEADER_SCROLL_THRESHOLD;
        let shouldHide = wasHidden;

        if (reducedMotion || menuOpen || y < SCROLL_HIDE_MIN_Y) {
          shouldHide = false;
        } else if (Math.abs(delta) >= SCROLL_DIRECTION_DELTA) {
          shouldHide = delta > 0;
        }

        // PHASE 3 — writes
        header.classList.toggle('header--solid', shouldBeSolid);
        header.classList.toggle('header--scroll-hidden', shouldHide);

        lastScrollY = y;
      }

      // rAF-throttle: coalesce múltiples scroll events en un único update por frame.
      function onScroll() {
        if (scrollFrameScheduled) return;
        scrollFrameScheduled = true;
        requestAnimationFrame(() => {
          updateScrollEffects();
          scrollFrameScheduled = false;
        });
      }

      function onPageLoad() {
        lastScrollY = window.scrollY;
        document.querySelector('[data-header]')?.classList.remove('header--scroll-hidden');
        updateScrollEffects();
      }

      document.addEventListener('astro:page-load', onPageLoad);
      document.addEventListener('scroll', onScroll, { passive: true });
    </script>

  </body>
</html>

<style is:global>
  .main--padded {
    /* Reserva la zona de la cabecera fija en las páginas sin hero (los textos legales). */
    padding-top: calc(5rem + 0.875rem);
  }

  /* ── El cambio de página, debajo del cartón ─────────────────────────────
     El cartón de título (`.ph-stinger`) tapa la pantalla antes de que la View
     Transition fotografíe la página vieja y sale por arriba sobre la nueva, así
     que la página no necesita fundido: la vieja se oculta y la nueva aparece tal
     cual. Duraciones y curvas LITERALES (sin var): las custom properties no
     heredan de forma fiable en el árbol de pseudo-elementos ::view-transition. */
  ::view-transition-old(page-main) {
    animation: none;
    opacity: 0;
  }

  ::view-transition-new(page-main) {
    animation: none;
  }

  @keyframes ph-telon-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes ph-telon-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Movimiento reducido: no hay cartón; un fundido corto de la página. */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(page-main) {
      opacity: 1;
      animation: ph-telon-out 0.15s cubic-bezier(0.2, 0, 0, 1) both;
    }
    ::view-transition-new(page-main) {
      animation: ph-telon-in 0.15s cubic-bezier(0.2, 0, 0, 1) 0.08s both;
    }
  }
</style>
