---
import { useTranslations, getLangFromUrl, localizePath } from '@/i18n/utils';
import { NAV_ITEMS } from '@/lib/navigation';
import { SOCIAL_LINKS, isSocialPlaceholder, type SocialId } from '@/lib/social';
import FooterSocialIcon from '@/components/ui/FooterSocialIcon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const nav = NAV_ITEMS.map((item) => ({
  href: item.href[lang],
  label: t(item.labelKey),
}));

// Los textos legales no existen en italiano: desde /it/ llevan a la versión
// inglesa (DECISIONS.md, 2026-10-01). Cuando el destino está en otro idioma, el
// enlace lo declara con hreflang.
const legalLinks = [
  { href: localizePath('/aviso-legal', lang), label: t('footer.legal.notice') },
  { href: localizePath('/privacidad', lang), label: t('footer.legal.privacy') },
].map((link) => {
  const targetLang = getLangFromUrl(new URL(link.href, Astro.url));
  return { ...link, hreflang: targetLang === lang ? undefined : targetLang };
});

const socialLabel = (id: SocialId) => {
  const key = id === 'instagram' ? 'footer.social.instagram' : 'footer.social.linkedin';
  return t(key);
};
---

{/* El informe final: el lema cierra la página con un nodo terminal, el logo se
    vuelve a dibujar y las páginas, el contacto y las redes van como listas con
    nodos. El pie está también en las páginas legales, que no cargan GSAP: todo
    su movimiento es CSS que arranca al entrar en pantalla (ph-motion.ts). */}
<footer class="footer">
  <div class="ph-section footer-inner">
    <div class="footer-close" data-inview data-footer-close>
      <span class="footer-close__rule" aria-hidden="true"></span>
      <p class="footer-lema">
        <span class="footer-lema__lead ph-enter">{t('hero.claim.lead')}</span>
        <span class="footer-lema__accent ph-enter">{t('hero.claim.accent')}<span class="ph-node ph-node--lg ph-node--pop footer-lema__node" aria-hidden="true" data-footer-node></span></span>
      </p>
    </div>

    <div class="footer-grid">
      <div class="footer-brand">
        {/* Se dibuja al entrar en pantalla: trazo y después relleno. Los perímetros
            (753 y 637) son los de LogoReveal.astro. */}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 259.8 206.1"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="4"
          stroke-linejoin="bevel"
          aria-hidden="true"
          class="footer-logo"
          data-inview
        >
          <polygon class="footer-logo__line" points="0 206.1 58.2 206.1 57.9 145.5 158.1 45.4 112.7 0 0 0 0 52.6 76.9 52.6 0 128.7" stroke-dasharray="753" />
          <polygon class="footer-logo__line footer-logo__line--2" points="122.6 206.1 200.1 206.1 152.2 157.8 173 137.1 182.4 146.4 259.8 146.4 169.6 55.6 130.5 94.2 131.8 95.6 141.1 105.4 120.3 125.8 109.8 115.4 70.8 153.9" stroke-dasharray="637" />
        </svg>
      </div>

      <nav class="footer-col" aria-label={t('footer.nav.label')}>
        <span class="footer-col-label">{t('footer.pages')}</span>
        <ul class="footer-list">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                <span class="ph-node ph-node--sm footer-link__node" aria-hidden="true"></span>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-col">
        <span class="footer-col-label">{t('footer.contact')}</span>
        <ul class="footer-list">
          <li>
            <a href={`mailto:${t('footer.email')}`} class="footer-link">
              <span class="ph-node ph-node--sm footer-link__node" aria-hidden="true"></span>
              <span>{t('footer.email')}</span>
            </a>
          </li>
        </ul>

        <span class="footer-col-label footer-col-label--social">{t('footer.social.heading')}</span>
        <ul class="footer-list" aria-label={t('footer.social.label')}>
          {SOCIAL_LINKS.map((s) => (
            <li>
              {isSocialPlaceholder(s.href) ? (
                <span class="footer-link footer-link--disabled" aria-disabled="true">
                  <span class="ph-node ph-node--sm ph-node--muted footer-link__node" aria-hidden="true"></span>
                  <FooterSocialIcon id={s.id} />
                  <span>{socialLabel(s.id)}</span>
                </span>
              ) : (
                <a href={s.href} class="footer-link" target="_blank" rel="noopener noreferrer">
                  <span class="ph-node ph-node--sm footer-link__node" aria-hidden="true"></span>
                  <FooterSocialIcon id={s.id} />
                  <span>{socialLabel(s.id)}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {t('site.name')}. {t('footer.rights')}</p>
      <nav class="footer-legal" aria-label={t('footer.legal.label')}>
        {legalLinks.map((link, i) => (
          <>
            {i > 0 && <span class="footer-legal-sep" aria-hidden="true">·</span>}
            <a href={link.href} hreflang={link.hreflang} class="footer-legal-link">
              {link.label}
            </a>
          </>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
  }

  .footer-inner {
    padding-block: 0 clamp(20px, 3vw, 28px);
  }

  /* ── Cierre: el lema, con su nodo final ── */
  .footer-close {
    position: relative;
    padding-block: clamp(56px, 8vw, 104px) clamp(36px, 5vw, 56px);
  }

  .footer-close__rule {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, rgba(214, 178, 94, 0.6), var(--ph-struct-soft) 40%);
    transform-origin: 0 50%;
    transition: transform var(--ph-dur-field) var(--ph-ease-out);
  }

  :global(html.ph-anim) .footer-close:not(.is-inview) .footer-close__rule {
    transform: scaleX(0);
  }

  :global(html.ph-anim:not(.ph-motion)) .footer-close__rule {
    animation: ph-motion-failsafe 0s linear 2.5s forwards;
  }

  .footer-lema {
    max-width: none;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(40px, 8.4vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--color-ph-white);
  }

  .footer-lema__lead,
  .footer-lema__accent {
    display: block;
  }

  .footer-lema__accent {
    --enter-delay: 90ms;
    color: var(--color-ph-gold);
  }

  /* El nodo terminal: donde acaba el recorrido. */
  .footer-lema__node {
    margin-left: 0.28em;
    vertical-align: 0.12em;
    transition-delay: 360ms;
  }

  /* ── Rejilla: marca, páginas, contacto y redes ── */
  .footer-grid {
    display: grid;
    gap: 32px;
    padding-block: clamp(28px, 4vw, 40px);
    border-top: 1px solid var(--color-ph-white-10);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: clamp(24px, 4vw, 48px);
      align-items: start;
    }
  }

  .footer-brand {
    display: flex;
    align-items: flex-start;
  }

  .footer-logo {
    height: 2.25rem;
    width: auto;
    overflow: visible;
    color: var(--color-ph-white);
  }

  .footer-logo__line {
    stroke-dashoffset: 0;
    fill-opacity: 1;
    stroke-opacity: 0;
    transition:
      stroke-dashoffset 900ms cubic-bezier(0.77, 0, 0.175, 1),
      fill-opacity 300ms var(--ph-ease-std) 820ms,
      stroke-opacity 200ms linear 1100ms;
  }

  .footer-logo__line--2 {
    transition-delay: 180ms, 820ms, 1100ms;
  }

  :global(html.ph-anim) .footer-logo:not(.is-inview) .footer-logo__line {
    stroke-dashoffset: 753;
    fill-opacity: 0;
    stroke-opacity: 1;
  }

  :global(html.ph-anim) .footer-logo:not(.is-inview) .footer-logo__line--2 {
    stroke-dashoffset: 637;
  }

  :global(html.ph-anim:not(.ph-motion)) .footer-logo__line {
    animation: ph-footer-logo-failsafe 0s linear 2.5s forwards;
  }

  @keyframes ph-footer-logo-failsafe {
    to { stroke-dashoffset: 0; fill-opacity: 1; stroke-opacity: 0; }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-col-label {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--ph-ink-meta);
  }

  .footer-col-label--social {
    margin-top: 22px;
  }

  .footer-list {
    display: flex;
    flex-direction: column;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  /* Cada entrada, un nodo y su texto. Al señalarla, el nodo se rellena y el
     anillo se expande una vez. */
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 40px;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.74);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  .footer-link :global(.footer-social-svg) {
    width: 16px;
    height: 16px;
    flex: none;
  }

  @media (hover: hover) {
    .footer-link:hover {
      color: var(--color-ph-white);
    }
    .footer-link:hover .footer-link__node {
      background-color: var(--color-ph-gold);
    }
    .footer-link:hover .footer-link__node::after {
      background-color: var(--color-ph-black);
    }
    .footer-link:hover .footer-link__node::before {
      animation: ph-ping 320ms var(--ph-ease-out) both;
    }
  }

  .footer-link:active {
    color: var(--color-ph-gold);
  }

  .footer-link--disabled {
    opacity: 0.45;
    pointer-events: none;
  }

  /* ── Una línea: copyright y textos legales ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 24px;
    padding-top: 16px;
    border-top: 1px solid var(--color-ph-white-10);
  }

  .footer-bottom p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ph-ink-meta);
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-legal-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ph-ink-meta);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  @media (hover: hover) {
    .footer-legal-link:hover {
      color: var(--color-ph-white);
    }
  }

  .footer-legal-sep {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-close__rule,
    .footer-logo__line,
    .footer-link {
      transition: none;
    }
    .footer-link:hover .footer-link__node::before {
      animation: none;
    }
  }
</style>

<script>
  /* El pie está en todas las páginas: el núcleo de movimiento (sin GSAP) vigila lo
     que entra en pantalla. Cuando el lema termina de llegar, su nodo final se
     activa una vez. */
  import { whenInView, ping } from '@/scripts/ph-motion';

  function initFooter(): void {
    const close = document.querySelector<HTMLElement>('[data-footer-close]');
    const node = close?.querySelector<HTMLElement>('[data-footer-node]');
    if (!close || !node) return;
    whenInView(close, () => window.setTimeout(() => ping(node), 620));
  }

  document.addEventListener('astro:page-load', initFooter);
</script>
