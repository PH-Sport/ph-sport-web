---
import { useTranslations, getLangFromUrl, localizePath } from '@/i18n/utils';
import { NAV_ITEMS } from '@/lib/navigation';
import { SOCIAL_LINKS, isSocialPlaceholder, type SocialId } from '@/lib/social';
import FooterSocialIcon from '@/components/ui/FooterSocialIcon.astro';
import Plate from '@/components/ui/Plate.astro';
import Bug from '@/components/ui/Bug.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const nav = NAV_ITEMS.map((item) => ({
  href: item.href[lang],
  label: t(item.labelKey),
}));

// Los textos legales no existen en italiano: desde /it/ llevan a la versión
// inglesa (DECISIONS.md, 2026-10-01). Cuando el destino está en otro idioma, el
// enlace lo declara con hreflang.
const legalLinks = [
  { href: localizePath('/aviso-legal', lang), label: t('footer.legal.notice') },
  { href: localizePath('/privacidad', lang), label: t('footer.legal.privacy') },
].map((link) => {
  const targetLang = getLangFromUrl(new URL(link.href, Astro.url));
  return { ...link, hreflang: targetLang === lang ? undefined : targetLang };
});

const socialLabel = (id: SocialId) => {
  const key = id === 'instagram' ? 'footer.social.instagram' : 'footer.social.linkedin';
  return t(key);
};
---

{/* El tablero de cierre de la retransmisión: la pestaña dorada a lo ancho, el
    lema como rótulo inferior y las columnas en placas. Está en todas las páginas,
    también en las legales, que no cargan GSAP: todo lo que se mueve aquí es CSS
    (lo arranca el núcleo de movimiento al entrar en pantalla). */}
<footer class="ftr">
  <div class="ftr__rule" data-inview aria-hidden="true"></div>

  <div class="ftr__logo-bg" aria-hidden="true">
    <img
      src="/logo-ph-3d.webp"
      srcset="/logo-ph-3d-sm.webp 820w, /logo-ph-3d.webp 1640w"
      sizes="min(80vw, 560px)"
      alt=""
      width="1640"
      height="1321"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />
  </div>

  <div class="ftr__inner">
    <p class="ftr__claim ph-lt" data-inview>
      <Plate tab d={0}>{t('hero.claim.lead')}</Plate>{' '}
      <Plate gold d={90} step={1}>{t('hero.claim.accent')}</Plate>
    </p>

    <div class="ftr__grid">
      <nav class="ftr__col" aria-label={t('footer.nav.label')} data-inview>
        <Bug text={t('footer.pages')} inview={false} />
        <ul class="ftr__rows">
          {nav.map((item, i) => (
            <li style={`--d: ${80 + i * 50}ms`}>
              <a href={item.href} class="ftr__row">
                <span class="ftr__row-tab" aria-hidden="true"></span>
                <span class="ftr__row-text">{item.label}</span>
                <svg class="ftr__row-arrow" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.6 0.6 9.2 5 1.6 9.4Z" fill="currentColor" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="ftr__col" data-inview>
        <Bug text={t('footer.contact')} inview={false} d={60} />
        <a href={`mailto:${t('footer.email')}`} class="ftr__mail">
          <span>{t('footer.email')}</span>
        </a>
      </div>

      <div class="ftr__col" data-inview>
        <Bug text={t('footer.social.heading')} inview={false} d={120} />
        <ul class="ftr__social" role="list" aria-label={t('footer.social.label')}>
          {SOCIAL_LINKS.map((s) => (
            <li>
              {isSocialPlaceholder(s.href) ? (
                <span class="ftr__social-link ftr__social-link--disabled" aria-disabled="true" title={socialLabel(s.id)}>
                  <FooterSocialIcon id={s.id} />
                </span>
              ) : (
                <a href={s.href} class="ftr__social-link" target="_blank" rel="noopener noreferrer" aria-label={socialLabel(s.id)}>
                  <FooterSocialIcon id={s.id} />
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* La barra fina de abajo: derechos y textos legales. */}
    <div class="ftr__bar">
      <p>&copy; {year} {t('site.name')}. {t('footer.rights')}</p>
      <nav class="ftr__legal" aria-label={t('footer.legal.label')}>
        {legalLinks.map((link, i) => (
          <>
            {i > 0 && <span class="ftr__legal-sep" aria-hidden="true">·</span>}
            <a href={link.href} hreflang={link.hreflang} class="ftr__legal-link">{link.label}</a>
          </>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: var(--color-ph-black);
  }

  /* La pestaña dorada a lo ancho: abre el tablero. Se traza al llegar. */
  .ftr__rule {
    height: 4px;
    background: var(--color-ph-gold);
    transform-origin: 0 50%;
    transition: transform 640ms var(--ph-ease-out);
  }
  :global(html.ph-anim) .ftr__rule:not(.is-inview) { transform: scaleX(0); }
  :global(html.ph-anim:not(.ph-motion)) .ftr__rule { animation: ph-motion-failsafe 0s linear 2.5s forwards; }

  .ftr__logo-bg {
    position: absolute;
    right: -4%;
    bottom: -6%;
    pointer-events: none;
    opacity: 0.1;
  }
  .ftr__logo-bg img {
    display: block;
    width: min(80vw, 560px);
    height: auto;
    user-select: none;
  }

  .ftr__inner {
    position: relative;
    z-index: 1;
    padding: clamp(48px, 7vw, 88px) var(--ph-section-px) 0;
  }

  /* El lema, como rótulo inferior: más pequeño que el de la portada. */
  .ftr__claim {
    max-width: none;
    margin: 0;
    font-size: clamp(26px, 7.2vw, 64px);
  }

  .ftr__grid {
    display: grid;
    gap: 36px;
    margin-top: clamp(44px, 6vw, 72px);
  }
  @media (min-width: 768px) {
    .ftr__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 0.8fr);
      gap: clamp(24px, 4vw, 56px);
    }
  }

  .ftr__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
  }

  /* Páginas: filas de placa, como las de una alineación. */
  .ftr__rows {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
    max-width: 360px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ftr__row {
    --cut: 44px;
    position: relative;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 44px;
    padding: 0 calc(var(--cut) * 0.62) 0 14px;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }
  .ftr__row::before,
  .ftr__row::after {
    content: '';
    position: absolute;
    z-index: -1;
  }
  .ftr__row::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, 0 100%);
  }
  .ftr__row::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, calc(100% - 0.41px) 0, calc(100% - var(--cut) + 1.59px) 100%, 0 100%);
  }
  /* Al señalar la fila, la pestaña dorada asoma arriba a la izquierda. */
  .ftr__row-tab {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 40px;
    height: 4px;
    background: var(--color-ph-gold);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 140ms var(--ph-ease-in);
  }
  .ftr__row-arrow {
    width: 9px;
    height: 9px;
    color: var(--color-ph-gold);
    opacity: 0.6;
    transition: transform var(--ph-dur-state) var(--ph-ease-out), opacity var(--ph-dur-state) var(--ph-ease-std);
  }
  @media (hover: hover) and (pointer: fine) {
    .ftr__row:hover { color: var(--color-ph-white); }
    .ftr__row:hover .ftr__row-tab { transform: scaleX(1); transition: transform var(--ph-dur-state) var(--ph-ease-out); }
    .ftr__row:hover .ftr__row-arrow { opacity: 1; transform: translateX(3px); }
  }
  .ftr__row:active { color: var(--color-ph-gold); }
  .ftr__row:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: 2px; }

  /* Las filas entran en cascada detrás de su bug. */
  .ftr__rows li {
    transition: clip-path var(--ph-dur-wipe) var(--ph-ease-out) var(--d, 0ms);
    clip-path: inset(-4px -4px -4px -4px);
  }
  :global(html.ph-anim) .ftr__col:not(.is-inview) .ftr__rows li { clip-path: inset(-4px 100% -4px -4px); }
  :global(html.ph-anim:not(.ph-motion)) .ftr__rows li { animation: ph-failsafe-unclip 0s linear 2.5s forwards; }

  /* El correo, en su placa. */
  .ftr__mail {
    --cut: 48px;
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    height: 48px;
    padding: 0 calc(var(--cut) * 0.7) 0 16px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ph-white);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }
  .ftr__mail span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ftr__mail::before,
  .ftr__mail::after {
    content: '';
    position: absolute;
    z-index: -1;
  }
  .ftr__mail::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, 0 100%);
  }
  .ftr__mail::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, calc(100% - 0.41px) 0, calc(100% - var(--cut) + 1.59px) 100%, 0 100%);
  }
  @media (hover: hover) and (pointer: fine) {
    .ftr__mail:hover { color: var(--color-ph-gold); }
  }
  .ftr__mail:active { color: var(--color-ph-gold); }
  .ftr__mail:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: 2px; }

  /* Síguenos: iconos en placas cuadradas. */
  .ftr__social {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ftr__social-link {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: rgba(255, 255, 255, 0.8);
    background: var(--ph-plate);
    box-shadow: inset 0 0 0 1px var(--ph-plate-edge);
    transition: color var(--ph-dur-state) var(--ph-ease-std), box-shadow var(--ph-dur-state) var(--ph-ease-std);
  }
  .ftr__social-link :global(svg) { width: 18px; height: 18px; }
  @media (hover: hover) and (pointer: fine) {
    .ftr__social-link:hover { color: var(--color-ph-gold); box-shadow: inset 0 0 0 1px var(--color-ph-gold); }
  }
  .ftr__social-link:active { color: var(--color-ph-gold); }
  .ftr__social-link:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: 2px; }
  .ftr__social-link--disabled { opacity: 0.45; pointer-events: none; }

  /* La barra fina de abajo. */
  .ftr__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(48px, 6vw, 72px);
    padding: 16px 0 calc(18px + env(safe-area-inset-bottom));
    box-shadow: inset 0 1px 0 var(--ph-plate-line);
  }
  .ftr__bar p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ph-ink-meta);
  }
  .ftr__legal {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ftr__legal-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ph-ink-meta);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }
  @media (hover: hover) and (pointer: fine) {
    .ftr__legal-link:hover { color: var(--color-ph-white); }
  }
  .ftr__legal-link:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: 2px; }
  .ftr__legal-sep {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .ftr__rule,
    .ftr__row,
    .ftr__row-tab,
    .ftr__row-arrow,
    .ftr__rows li,
    .ftr__mail,
    .ftr__social-link,
    .ftr__legal-link {
      transition: none;
    }
  }
</style>
