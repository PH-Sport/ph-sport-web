---
import { useTranslations, getLangFromUrl, localizePath } from '@/i18n/utils';
import { NAV_ITEMS } from '@/lib/navigation';
import { SOCIAL_LINKS, isSocialPlaceholder, type SocialId } from '@/lib/social';
import FooterSocialIcon from '@/components/ui/FooterSocialIcon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const nav = NAV_ITEMS.map((item) => ({
  href: item.href[lang],
  label: t(item.labelKey),
}));

// Los textos legales no existen en italiano: desde /it/ llevan a la versión
// inglesa (DECISIONS.md, 2026-10-01). Cuando el destino está en otro idioma, el
// enlace lo declara con hreflang.
const legalLinks = [
  { href: localizePath('/aviso-legal', lang), label: t('footer.legal.notice') },
  { href: localizePath('/privacidad', lang), label: t('footer.legal.privacy') },
].map((link) => {
  const targetLang = getLangFromUrl(new URL(link.href, Astro.url));
  return { ...link, hreflang: targetLang === lang ? undefined : targetLang };
});

const socialLabel = (id: SocialId) => {
  const key = id === 'instagram' ? 'footer.social.instagram' : 'footer.social.linkedin';
  return t(key);
};
---

{/* El pie son los créditos finales: el lema en tipografía gigante que deriva en
    horizontal con el scroll (una línea hacia cada lado) y, debajo, las columnas
    suizas —Páginas, Contacto, Síguenos— con el logo que se dibuja. El pie está
    también en las páginas legales, que no cargan GSAP: la deriva va sin él. */}
<footer class="footer">
  <div class="footer__rule ph-rule" aria-hidden="true" data-inview></div>

  <p class="footer__lema" data-footer-lema>
    <span class="footer__line" data-drift="1">{t('hero.claim.lead')}</span>
    <span class="footer__line footer__line--gold" data-drift="-1">{t('hero.claim.accent')}</span>
  </p>

  <div class="footer__cols ph-grid">
    <div class="footer__brand">
      {/* Se dibuja al entrar en pantalla: trazo y después relleno. Los perímetros
          (753 y 637) son los reales de los dos polígonos del logo. */}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 259.8 206.1"
        fill="currentColor"
        stroke="currentColor"
        stroke-width="4"
        stroke-linejoin="bevel"
        aria-hidden="true"
        class="footer__logo"
        data-inview
      >
        <polygon class="footer__logo-line" points="0 206.1 58.2 206.1 57.9 145.5 158.1 45.4 112.7 0 0 0 0 52.6 76.9 52.6 0 128.7" stroke-dasharray="753" />
        <polygon class="footer__logo-line footer__logo-line--2" points="122.6 206.1 200.1 206.1 152.2 157.8 173 137.1 182.4 146.4 259.8 146.4 169.6 55.6 130.5 94.2 131.8 95.6 141.1 105.4 120.3 125.8 109.8 115.4 70.8 153.9" stroke-dasharray="637" />
      </svg>
    </div>

    <nav class="footer__col footer__col--pages" aria-label={t('footer.nav.label')}>
      <span class="footer__label">{t('footer.pages')}</span>
      <ul class="footer__list">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="footer__link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer__col footer__col--contact">
      <span class="footer__label">{t('footer.contact')}</span>
      <a href={`mailto:${t('footer.email')}`} class="footer__link footer__email">{t('footer.email')}</a>
    </div>

    <div class="footer__col footer__col--social">
      <span class="footer__label">{t('footer.social.heading')}</span>
      <ul class="footer__social" role="list" aria-label={t('footer.social.label')}>
        {SOCIAL_LINKS.map((s) => (
          <li>
            {isSocialPlaceholder(s.href) ? (
              <span class="footer__social-link footer__social-link--disabled" aria-disabled="true" title={socialLabel(s.id)}>
                <FooterSocialIcon id={s.id} />
              </span>
            ) : (
              <a href={s.href} class="footer__social-link" target="_blank" rel="noopener noreferrer" aria-label={socialLabel(s.id)}>
                <FooterSocialIcon id={s.id} />
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <p>&copy; {year} {t('site.name')}. {t('footer.rights')}</p>
    <nav class="footer__legal" aria-label={t('footer.legal.label')}>
      {legalLinks.map((link) => (
        <a href={link.href} hreflang={link.hreflang} class="footer__legal-link">{link.label}</a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding: 0 var(--ph-section-px) calc(1.25rem + env(safe-area-inset-bottom));
    background: var(--color-ph-black);
    overflow-x: hidden; /* Safari < 16 no conoce `clip` */
    overflow-x: clip;
  }

  .footer__rule {
    height: 1px;
    margin-inline: calc(-1 * var(--ph-section-px));
  }

  /* ── El lema, a escala de créditos ──
     Sin JS (o con movimiento reducido) va partido en líneas y entero. Con el
     núcleo de movimiento en marcha (`ph-motion`), cada línea va en una sola fila,
     entra desplazada desde un lado y se asienta alineada al llegar al final de la
     página. El tamaño es el que hace caber «Forever Football.» entero en el ancho
     de la columna (mide 6,93 veces su cuerpo; 7,1 deja aire): el lema se lee
     completo justo donde la página termina y uno se para. */
  .footer__lema {
    display: flex;
    flex-direction: column;
    gap: 0.04em;
    max-width: none;
    margin: 0 calc(-1 * var(--ph-section-px));
    padding: clamp(3.5rem, 9vw, 7rem) var(--ph-section-px) clamp(2.5rem, 6vw, 5rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(56px, 15vw, 240px);
    line-height: 0.86;
    letter-spacing: var(--ph-giant-track);
    color: var(--color-ph-white);
  }

  .footer__line {
    display: block;
    width: max-content;
    max-width: 100%;
  }

  .footer__line--gold {
    color: var(--color-ph-gold);
  }

  :global(html.ph-anim.ph-motion) .footer__lema {
    font-size: calc((100vw - 2 * var(--ph-section-px)) / 7.1);
  }

  :global(html.ph-anim.ph-motion) .footer__line {
    max-width: none;
    white-space: nowrap;
    will-change: transform;
  }

  /* ── Columnas suizas ── */
  .footer__cols {
    row-gap: 2.25rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--ph-hair);
  }

  /* Móvil: el logo arriba; Páginas a la izquierda y, a su lado, Contacto y
     Síguenos apilados. Escritorio: cuatro columnas en la retícula de 12. */
  .footer__brand { grid-column: 1 / -1; }
  .footer__col--pages { grid-column: 1 / 3; grid-row: 2 / span 2; }
  .footer__col--contact { grid-column: 3 / 5; grid-row: 2; }
  .footer__col--social { grid-column: 3 / 5; grid-row: 3; }

  @media (min-width: 1024px) {
    .footer__brand { grid-column: 1 / 4; }
    .footer__col--pages { grid-column: 5 / 8; grid-row: 1; }
    .footer__col--contact { grid-column: 8 / 11; grid-row: 1; }
    .footer__col--social { grid-column: 11 / 13; grid-row: 1; }
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .footer__label {
    font-family: var(--font-body);
    font-size: var(--ph-small);
    letter-spacing: 0.02em;
    color: var(--ph-ink-meta);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Enlaces del pie: Söhne 600 a escala intermedia; al señalarlos, un hilo se
     dibuja debajo. */
  .footer__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    width: fit-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(18px, calc(0.4vw + 16.4px), 22px);
    letter-spacing: -0.015em;
    color: var(--color-ph-white);
    overflow-wrap: anywhere;
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  .footer__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.45rem;
    height: 1px;
    background: var(--color-ph-gold);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--ph-dur-move) var(--ph-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__link:hover::after { transform: scaleX(1); }
  }

  .footer__link:focus-visible::after { transform: scaleX(1); }
  .footer__link:active { color: var(--color-ph-gold); }

  .footer__social {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 0 -0.75rem;
    padding: 0;
    list-style: none;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-ph-white);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__social-link:hover { color: var(--color-ph-gold); }
  }

  .footer__social-link:active { color: var(--color-ph-gold); }

  .footer__social-link--disabled {
    opacity: 0.45;
    pointer-events: none;
  }

  .footer__social-link :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* El logo se dibuja al entrar: trazo y después relleno. */
  .footer__logo {
    height: 2.25rem;
    width: auto;
    overflow: visible;
    color: var(--color-ph-gold);
  }

  .footer__logo-line {
    stroke-dashoffset: 0;
    fill-opacity: 1;
    stroke-opacity: 0;
    transition:
      stroke-dashoffset 900ms cubic-bezier(0.77, 0, 0.175, 1),
      fill-opacity 300ms var(--ph-ease-std) 820ms,
      stroke-opacity 200ms linear 1100ms;
  }

  .footer__logo-line--2 {
    transition-delay: 180ms, 820ms, 1100ms;
  }

  :global(html.ph-anim) .footer__logo:not(.is-inview) .footer__logo-line {
    stroke-dashoffset: 753;
    fill-opacity: 0;
    stroke-opacity: 1;
  }

  :global(html.ph-anim) .footer__logo:not(.is-inview) .footer__logo-line--2 {
    stroke-dashoffset: 637;
  }

  :global(html.ph-anim:not(.ph-motion)) .footer__logo-line {
    animation: ph-footer-logo-failsafe 0s linear 2.5s forwards;
  }

  @keyframes ph-footer-logo-failsafe {
    to { stroke-dashoffset: 0; fill-opacity: 1; stroke-opacity: 0; }
  }

  /* ── Legales y copyright, en pequeño ── */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ph-hair);
  }

  .footer__bottom p {
    margin: 0;
    font-size: var(--ph-small);
    color: var(--ph-ink-meta);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .footer__legal-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--ph-small);
    color: var(--ph-ink-meta);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition:
      color var(--ph-dur-state) var(--ph-ease-std),
      text-decoration-color var(--ph-dur-state) var(--ph-ease-std);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__legal-link:hover {
      color: var(--color-ph-white);
      text-decoration-color: currentColor;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__logo-line,
    .footer__link,
    .footer__link::after,
    .footer__social-link,
    .footer__legal-link {
      transition: none;
    }
  }
</style>

<script>
  /* La deriva del lema: cada línea entra desplazada hacia un lado (`data-drift`:
     1 viene de la derecha, -1 de la izquierda) y se asienta alineada cuando el pie
     llega al final de la página, donde el lema se lee entero. Sin GSAP —el pie
     está en las páginas legales, que no lo cargan—: un listener de scroll pasivo
     que solo trabaja mientras el pie está cerca de la pantalla, y solo
     `transform`. Con movimiento reducido no se mueve: el lema va partido y entero
     (CSS). */
  let driftCleanup: (() => void) | null = null;

  function initFooterDrift(): void {
    driftCleanup?.();
    driftCleanup = null;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const lema = document.querySelector<HTMLElement>('[data-footer-lema]');
    const footer = lema?.closest('footer');
    if (!lema || !footer) return;
    const lines = Array.from(lema.querySelectorAll<HTMLElement>('[data-drift]'));

    let raf = 0;
    let near = false;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      const rect = footer.getBoundingClientRect();
      // 0 cuando el pie asoma por abajo; 1 al llegar al final de la página.
      const p = Math.min(1, Math.max(0, (vh - rect.top) / Math.max(1, rect.height)));
      const shift = window.innerWidth * 0.35;
      lines.forEach((line) => {
        const dir = Number(line.dataset.drift);
        const x = dir * shift * (1 - p);
        line.style.transform = `translate3d(${x.toFixed(1)}px, 0, 0)`;
      });
    };
    const onScroll = () => {
      if (near && !raf) raf = requestAnimationFrame(update);
    };
    const io = new IntersectionObserver(([entry]) => {
      near = entry.isIntersecting;
      if (near) onScroll();
    }, { rootMargin: '0px 0px 50% 0px' });
    io.observe(footer);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
    driftCleanup = () => {
      io.disconnect();
      cancelAnimationFrame(raf);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };
  }

  document.addEventListener('astro:page-load', initFooterDrift);
  document.addEventListener('astro:before-swap', () => {
    driftCleanup?.();
    driftCleanup = null;
  });
</script>
