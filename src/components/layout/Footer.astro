---
import { useTranslations, getLangFromUrl, localizePath } from '@/i18n/utils';
import { NAV_ITEMS } from '@/lib/navigation';
import { SOCIAL_LINKS, isSocialPlaceholder, type SocialId } from '@/lib/social';
import FooterSocialIcon from '@/components/ui/FooterSocialIcon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const nav = NAV_ITEMS.map((item) => ({
  href: item.href[lang],
  label: t(item.labelKey),
}));

// Los textos legales no existen en italiano: desde /it/ llevan a la versión
// inglesa (DECISIONS.md, 2026-10-01). Cuando el destino está en otro idioma, el
// enlace lo declara con hreflang.
const legalLinks = [
  { href: localizePath('/aviso-legal', lang), label: t('footer.legal.notice') },
  { href: localizePath('/privacidad', lang), label: t('footer.legal.privacy') },
].map((link) => {
  const targetLang = getLangFromUrl(new URL(link.href, Astro.url));
  return { ...link, hreflang: targetLang === lang ? undefined : targetLang };
});

const socialLabel = (id: SocialId) => {
  const key = id === 'instagram' ? 'footer.social.instagram' : 'footer.social.linkedin';
  return t(key);
};
---

<footer class="footer">
  <div class="footer-logo-bg" aria-hidden="true">
    <img
      src="/logo-ph-3d.webp"
      srcset="/logo-ph-3d-sm.webp 820w, /logo-ph-3d.webp 1640w"
      sizes="min(92vw, 620px)"
      alt=""
      width="1640"
      height="1321"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />
  </div>

  <div class="ph-section">
    <!-- 02 · Sello editorial -->
    <p class="footer-sello">
      {t('hero.claim.lead')} <span class="footer-sello__accent">{t('hero.claim.accent')}</span>
    </p>

    <!-- 03 · 3-col funcional -->
    <div class="footer-grid">
      <!-- Col 1: brand -->
      <div class="footer-brand">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 259.8 206.1"
          fill="currentColor"
          aria-hidden="true"
          class="footer-logo"
        >
          <polygon points="0 206.1 58.2 206.1 57.9 145.5 158.1 45.4 112.7 0 0 0 0 52.6 76.9 52.6 0 128.7" />
          <polygon points="122.6 206.1 200.1 206.1 152.2 157.8 173 137.1 182.4 146.4 259.8 146.4 169.6 55.6 130.5 94.2 131.8 95.6 141.1 105.4 120.3 125.8 109.8 115.4 70.8 153.9" />
        </svg>
      </div>

      <!-- Col 2: páginas -->
      <nav class="footer-col" aria-label={t('footer.nav.label')}>
        <span class="footer-col-label">{t('footer.pages')}</span>
        <ul class="footer-nav">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Col 3: contacto + social -->
      <div class="footer-col">
        <span class="footer-col-label">{t('footer.contact')}</span>
        <div class="footer-contact">
          <a href={`mailto:${t('footer.email')}`} class="footer-email">
            {t('footer.email')}
          </a>
        </div>

        <span class="footer-col-label footer-col-label--social">{t('footer.social.heading')}</span>
        {/* Una sola etiqueta que viaja de un icono a otro (ph-ui.css + ph-motion.ts). */}
        <div class="ph-tip-group footer-social" data-ph-tip-group>
        <span class="ph-tip" aria-hidden="true"></span>
        <ul class="footer-social-list" role="list" aria-label={t('footer.social.label')}>
          {
            SOCIAL_LINKS.map((s) => (
              <li>
                {isSocialPlaceholder(s.href) ? (
                  <span
                    class="ph-icon-btn ph-icon-btn--sm footer-social-link footer-social-link--disabled"
                    aria-disabled="true"
                    title={socialLabel(s.id)}
                  >
                    <FooterSocialIcon id={s.id} />
                  </span>
                ) : (
                  <a
                    href={s.href}
                    class="ph-icon-btn ph-icon-btn--sm footer-social-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={socialLabel(s.id)}
                    data-tip={socialLabel(s.id)}
                  >
                    <FooterSocialIcon id={s.id} />
                  </a>
                )}
              </li>
            ))
          }
        </ul>
        </div>
      </div>
    </div>

    <!-- 04 · Copyright + legal -->
    <div class="footer-bottom">
      <p>&copy; {year} {t('site.name')}. {t('footer.rights')}</p>
      <nav class="footer-legal" aria-label={t('footer.legal.label')}>
        {legalLinks.map((link, i) => (
          <>
            {i > 0 && <span class="footer-legal-sep" aria-hidden="true">·</span>}
            <a href={link.href} hreflang={link.hreflang} class="footer-legal-link">
              {link.label}
            </a>
          </>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  /* Pie con el mismo sistema que el resto de la web: filas con línea fina,
     etiquetas legibles y los iconos sociales como botones (ph-ui.css). */
  .footer {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding-top: clamp(64px, 7vw, 120px);
  }

  .footer-logo-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 6%;
    opacity: 0.18;
  }
  .footer-logo-bg img {
    width: min(70vw, 620px);
    height: auto;
    user-select: none;
  }
  .footer > *:not(.footer-logo-bg) {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 767px) {
    .footer-logo-bg {
      padding-right: 0;
      justify-content: center;
      opacity: 0.12;
    }
    .footer-logo-bg img { width: min(90vw, 480px); }
  }

  /* El lema de la casa, en la voz de los titulares. */
  .footer-sello {
    max-width: none;
    margin: 0;
    padding-block: 0 clamp(28px, 3vw, 44px);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(32px, calc(2.4vw + 22px), 56px);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--color-ph-white);
  }
  .footer-sello__accent { color: var(--color-ph-gold); font-style: italic; font-weight: 400; }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--mochi-surface-border);
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: clamp(2rem, 4vw, 3rem);
      align-items: start;
    }
  }

  .footer-brand { display: flex; align-items: flex-start; }
  .footer-logo { height: 2.25rem; width: auto; color: var(--color-ph-gold); }

  .footer-col { display: flex; flex-direction: column; }
  .footer-col-label { font-size: 13px; letter-spacing: 0.03em; color: var(--ph-ink-meta); }
  .footer-col-label--social { margin-top: 1.75rem; }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .footer-link,
  .footer-email {
    width: fit-content;
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--ph-ink-body);
    transition: color var(--mochi-duration-color) var(--mochi-ease-color);
  }
  @media (hover: hover) {
    .footer-link:hover { color: var(--color-ph-white); }
    .footer-email:hover { color: var(--mochi-accent-strong); }
  }
  .footer-contact { margin-top: 1rem; }

  .footer-social { margin-top: 1rem; width: fit-content; }
  .footer-social-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .footer-social-link { color: var(--ph-ink-body); }
  @media (hover: hover) { .footer-social-link:hover { color: var(--color-ph-white); } }
  .footer-social-link--disabled { opacity: 0.45; pointer-events: none; }
  .footer-social-link :global(svg) { width: 18px; height: 18px; }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(16px, 2vw, 24px);
    padding-top: 18px;
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--mochi-surface-border);
  }
  .footer-bottom p { margin: 0; font-size: 13px; color: rgba(255, 255, 255, 0.5); }
  .footer-legal { display: flex; align-items: center; gap: 0.5rem; }
  .footer-legal-sep { color: rgba(255, 255, 255, 0.3); }
  .footer-legal-link {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.62);
    transition: color var(--mochi-duration-color) var(--mochi-ease-color);
  }
  @media (hover: hover) { .footer-legal-link:hover { color: var(--color-ph-white); } }
</style>
