---
import {
  useTranslations,
  getLangFromUrl,
  getLangSwitchUrl,
  getHomePath,
  supportedLangs,
  LANG_NAMES,
} from '@/i18n/utils';
import { NAV_ITEMS } from '@/lib/navigation';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const langOptions = supportedLangs.map((code) => ({
  code,
  name: LANG_NAMES[code],
  href: getLangSwitchUrl(Astro.url.pathname, code),
  current: code === lang,
}));
const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');

const nav = NAV_ITEMS.map((item) => ({
  href: item.href[lang],
  label: t(item.labelKey),
}));

const isActive = (href: string): boolean => {
  const normalizedHref = href === '/' ? '/' : href.replace(/\/$/, '');
  return normalizedHref === currentPath;
};
---

{/* La cabecera es la barra de herramientas de la sala de análisis: el logo a la
    izquierda y, en escritorio, las cuatro páginas con un visor (cuatro
    escuadras) que marca la activa y se desplaza a la que se señala. El idioma es
    una pestaña con su código; su panel va enmarcado por escuadras. En el móvil,
    el menú es un campo que se dibuja con las páginas como nodos sobre la banda. */}
<header data-header transition:persist>
  <div class="header-shell">
    <div class="header-inner">
      <a href={getHomePath(lang)} class="header-logo" aria-label={t('a11y.logo')}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 259.8 206.1" fill="currentColor" aria-hidden="true">
          <polygon points="0 206.1 58.2 206.1 57.9 145.5 158.1 45.4 112.7 0 0 0 0 52.6 76.9 52.6 0 128.7" />
          <polygon points="122.6 206.1 200.1 206.1 152.2 157.8 173 137.1 182.4 146.4 259.8 146.4 169.6 55.6 130.5 94.2 131.8 95.6 141.1 105.4 120.3 125.8 109.8 115.4 70.8 153.9" />
        </svg>
        <span class="ph-visor ph-visor--hover header-logo__visor" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </a>

      <nav class="header-nav" aria-label={t('nav.aria.main')}>
        <div class="header-nav-list-wrap" data-nav-wrap>
          {/* El visor de la navegación: cuatro escuadras que el script coloca
              alrededor de la página activa y desplaza a la que se señala. */}
          <span class="nav-visor" aria-hidden="true" data-nav-visor><i></i><i></i><i></i><i></i></span>
          <ul class="header-nav-list">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-astro-prefetch="load"
                  class:list={['nav-link', isActive(item.href) && 'is-active']}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  <span class="nav-link__text">{item.label}</span>
                </a>
              </li>
            ))}
            <li class="lang-menu" data-lang-menu>
              {/* Pestaña de idioma: el botón muestra el código del idioma actual y
                  abre los tres. Es un botón que despliega enlaces normales (patrón
                  "disclosure"), no un role="menu": cada opción es navegación. */}
              <button
                type="button"
                class="lang-tab"
                data-lang-trigger
                aria-expanded="false"
                aria-controls="lang-panel"
                aria-label={`${t('nav.lang.menu')}: ${LANG_NAMES[lang]}`}
              >
                <span class="lang-tab__code ph-num" data-lang-current-label>{lang.toUpperCase()}</span>
                <svg class="lang-tab__caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
                </svg>
              </button>
              <div id="lang-panel" class="lang-panel" data-lang-panel>
                <span class="ph-visor lang-panel__visor" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                <ul class="lang-panel__list">
                  {langOptions.map((option) => (
                    <li>
                      {/* hreflang = idioma del destino, no el de esta página: declara la
                          frontera entre versiones a buscadores y lectores de pantalla. */}
                      <a
                        href={option.href}
                        hreflang={option.code}
                        lang={option.code}
                        class="lang-option"
                        data-lang-option={option.code}
                        aria-current={option.current ? 'true' : undefined}
                      >
                        <span class="lang-option__code ph-num" aria-hidden="true">{option.code.toUpperCase()}</span>
                        <span class="lang-option__name">{option.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          </ul>
        </div>
      </nav>

      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        data-label-open={t('a11y.menu.open')}
        data-label-close={t('a11y.menu.close')}
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('a11y.menu.open')}
      >
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
        <span class="ph-visor ph-visor--js menu-toggle__visor" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<!-- Overlay fuera de [data-header]: así no queda atrapado en la capa de la barra. -->
<div id="mobile-menu" class="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu-backdrop" data-mobile-menu-dismiss aria-hidden="true"></div>
  <div class="mobile-menu-inner">
    <div class="mm-field">
      <div class="mm-pitch-box">
        {/* El campo, en vertical: bandas y líneas de fondo, medio campo, círculo
            central, áreas y semicírculos. Las longitudes (`--l`) son las de cada
            trazo en las unidades del dibujo, que escala sin deformarse. */}
        <svg class="mm-pitch" viewBox="0 0 100 154" preserveAspectRatio="xMidYMid meet" aria-hidden="true" data-hairline>
          <rect class="mm-line" x="0.5" y="0.5" width="99" height="153" style="--l: 504; --d: 0ms" />
          <path class="mm-line" d="M0.5 77H99.5" style="--l: 99; --d: 80ms" />
          <circle class="mm-line" cx="50" cy="77" r="13" style="--l: 82; --d: 110ms" />
          <path class="mm-line" d="M20 0.5V24H80V0.5" style="--l: 107; --d: 140ms" />
          <path class="mm-line" d="M36 0.5V8.5H64V0.5" style="--l: 44; --d: 180ms" />
          <path class="mm-line" d="M39.05 24A13 13 0 0 0 60.95 24" style="--l: 27; --d: 200ms" />
          <path class="mm-line" d="M20 153.5V130H80V153.5" style="--l: 107; --d: 140ms" />
          <path class="mm-line" d="M36 153.5V145.5H64V153.5" style="--l: 44; --d: 180ms" />
          <path class="mm-line" d="M39.05 130A13 13 0 0 1 60.95 130" style="--l: 27; --d: 200ms" />
          <circle class="mm-spot" cx="50" cy="77" r="0.9" />
        </svg>
        <nav class="mm-nav" aria-label={t('nav.aria.mobile')}>
          <ul class="mobile-nav-list">
            {nav.map((item, i) => (
              <li style={`--row: ${i}`}>
                <a
                  href={item.href}
                  data-mobile-link
                  data-astro-prefetch="load"
                  class:list={['mobile-link', isActive(item.href) && 'mobile-link--active']}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  <span class="ph-node mobile-link__node" aria-hidden="true"></span>
                  <span class="mobile-link__label">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    {/* En móvil no hay desplegable dentro del menú: el menú ya es el panel que se
        abre, así que los tres idiomas van en fila, con el actual marcado. */}
    <ul class="mm-langs" aria-label={t('nav.lang.menu')}>
      {langOptions.map((option) => (
        <li>
          <a
            href={option.href}
            hreflang={option.code}
            lang={option.code}
            data-mobile-link
            data-lang-option={option.code}
            aria-current={option.current ? 'true' : undefined}
            class="mm-lang"
          >
            <span class="mm-lang__code ph-num" aria-hidden="true">{option.code.toUpperCase()}</span>
            <span class="mm-lang__name">{option.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* ── Barra (sólida, oculta al bajar: reglas globales en BaseLayout) ── */
  .header-shell {
    width: 100%;
    /* Con `viewport-fit=cover` el `top: 0` del header queda debajo de la barra de
       estado: se le suma la zona segura. Sin notch el inset es 0. */
    padding-top: env(safe-area-inset-top);
    /* Nombre propio de View Transition: saca la barra del snapshot `root` para
       que no se funda (sale/entra) en cada navegación SPA. Ver bloque is:global. */
    view-transition-name: ph-header;
    transition:
      transform var(--ph-dur-move) var(--ph-ease-out),
      background-color var(--ph-dur-state) var(--ph-ease-std),
      box-shadow var(--ph-dur-state) var(--ph-ease-std);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 60px;
    /* El logo cae en la vertical del texto de las páginas (un margen de sección). */
    padding-inline:
      calc(var(--ph-section-px) + env(safe-area-inset-left))
      calc(var(--ph-section-px) + env(safe-area-inset-right));
  }

  @media (min-width: 768px) {
    .header-inner { height: 76px; }
  }

  /* ── Logo ── */
  .header-logo {
    position: relative;
    display: inline-flex;
    padding: 8px;
    margin-left: -8px;
    color: var(--color-ph-gold);
  }

  .header-logo svg {
    display: block;
    height: 22px;
    width: auto;
  }

  @media (min-width: 768px) {
    .header-logo svg { height: 26px; }
  }

  .header-logo__visor {
    --visor-arm: 6px;
    --visor-inset: 0px;
    --visor-off: 6px;
  }

  /* ── Navegación de escritorio ── */
  .header-nav { display: none; }

  @media (min-width: 768px) {
    .header-nav { display: block; }
  }

  .header-nav-list-wrap {
    position: relative;
  }

  .header-nav-list {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.1vw, 30px);
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 2px;
    font-family: var(--font-body);
    font-size: 15px;
    letter-spacing: 0.005em;
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-ph-white);
  }

  /* El visor de la navegación: cada esquina va a su sitio con `transform`
     (`--x`, `--y` desde el script). Al cambiar de página la cabecera persiste y
     el visor viaja hasta la nueva activa. */
  .nav-visor {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--ph-dur-state) var(--ph-ease-std);
  }

  .nav-visor.is-shown { opacity: 1; }

  .nav-visor > i {
    position: absolute;
    top: 0;
    left: 0;
    width: 7px;
    height: 7px;
    border: 0 solid var(--color-ph-gold);
    transform: translate(var(--x, 0px), var(--y, 0px));
  }

  .nav-visor.is-animated > i {
    transition: transform var(--ph-dur-lock) var(--ph-ease-out);
  }

  .nav-visor > i:nth-child(1) { border-top-width: 1.5px; border-left-width: 1.5px; }
  .nav-visor > i:nth-child(2) { border-top-width: 1.5px; border-right-width: 1.5px; }
  .nav-visor > i:nth-child(3) { border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .nav-visor > i:nth-child(4) { border-bottom-width: 1.5px; border-right-width: 1.5px; }

  @media (prefers-reduced-motion: reduce) {
    .nav-visor.is-animated > i { transition: none; }
  }

  /* ── Pestaña de idioma ── */
  .lang-menu {
    position: relative;
    margin-left: 4px;
    padding-left: clamp(12px, 1.6vw, 22px);
  }

  /* Una raya fina separa las páginas de la pestaña. */
  .lang-menu::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1px;
    height: 16px;
    margin-top: -8px;
    background: var(--ph-struct-soft);
  }

  .lang-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 4px;
    background: none;
    border: 0;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  .lang-tab__code {
    font-size: 13px;
    color: var(--color-ph-gold);
  }

  .lang-tab:hover,
  .lang-tab[aria-expanded='true'] {
    color: var(--color-ph-white);
  }

  .lang-tab__caret {
    display: block;
    transition: transform var(--ph-dur-state) var(--ph-ease-std);
  }

  .lang-tab[aria-expanded='true'] .lang-tab__caret {
    transform: rotate(180deg);
  }

  /* ── Panel de idioma, enmarcado por escuadras ──
     El estado lo lleva `aria-expanded` del botón: el CSS abre el panel a partir
     de él, así no hay dos fuentes de verdad. Entra en 200 ms y sale en 140 ms. */
  .lang-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: -8px;
    z-index: 1;
    min-width: 196px;
    padding: 10px;
    background-color: rgba(13, 15, 18, 0.97);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 140ms var(--ph-ease-in),
      transform 140ms var(--ph-ease-in),
      visibility 0s linear 140ms;
  }

  .lang-tab[aria-expanded='true'] + .lang-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition:
      opacity 200ms var(--ph-ease-out),
      transform 200ms var(--ph-ease-out),
      visibility 0s linear 0s;
  }

  .lang-panel__visor {
    --visor-arm: 10px;
    --visor-inset: 0px;
  }

  .lang-panel__list {
    list-style: none;
  }

  /* Al navegar se cierra en seco. La View Transition fotografía la cabecera antes
     del cambio de página y mantiene esa foto toda la transición: con el panel a
     medio fundir, se vería encima ~0,4 s. Lo comprueba el smoke. */
  .lang-menu.is-closing-instantly .lang-tab,
  .lang-menu.is-closing-instantly .lang-panel,
  .lang-menu.is-closing-instantly .lang-tab__caret {
    transition: none;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 42px;
    padding: 0 10px;
    font-family: var(--font-body);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.72);
    transition:
      color var(--ph-dur-state) var(--ph-ease-std),
      background-color var(--ph-dur-state) var(--ph-ease-std);
  }

  .lang-option__code {
    min-width: 20px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
  }

  .lang-option:hover,
  .lang-option:focus-visible {
    color: var(--color-ph-white);
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* El idioma en que se está leyendo: texto pleno, código en oro y un nodo
     relleno al final. */
  .lang-option[aria-current='true'] {
    color: var(--color-ph-white);
  }

  .lang-option[aria-current='true'] .lang-option__code {
    color: var(--color-ph-gold);
  }

  .lang-option[aria-current='true']::after {
    content: '';
    width: 7px;
    height: 7px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--color-ph-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-panel,
    .lang-tab[aria-expanded='true'] + .lang-panel {
      transform: none;
    }
    .lang-tab__caret { transition: none; }
  }

  /* ── Botón del menú móvil: dos barras que se cruzan en una X ── */
  .menu-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-ph-white);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  @media (min-width: 768px) {
    .menu-toggle { display: none; }
  }

  .menu-toggle[aria-expanded='true'] {
    color: var(--color-ph-gold);
  }

  .menu-toggle__bars {
    position: relative;
    width: 22px;
    height: 12px;
  }

  .menu-toggle__bars > span {
    position: absolute;
    left: 0;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--ph-dur-lock) var(--ph-ease-out);
  }

  .menu-toggle__bars > span:first-child { top: 0; }

  /* La de abajo, más corta y pegada a la derecha. */
  .menu-toggle__bars > span:last-child {
    top: 10.5px;
    transform: translateX(4px) scaleX(0.64);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars > span:first-child {
    transform: translateY(5.25px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars > span:last-child {
    transform: translateY(-5.25px) rotate(-45deg);
  }

  /* Abierto, el botón queda fijado por un visor pequeño. */
  .menu-toggle__visor {
    --visor-arm: 6px;
    --visor-inset: 4px;
    --visor-off: 6px;
  }

  .menu-toggle[aria-expanded='true'] > .ph-visor--js > i {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle__bars > span { transition: none; }
  }

  /* ── Menú móvil: un campo que se dibuja ──
     El panel aparece en 160 ms; el campo se traza en 400 ms y las páginas entran
     como nodos sobre la banda izquierda, en cascada. Cerrar tarda 200 ms: el panel
     se apaga entero, sin deshacer los trazos. El JS solo pone y quita clases
     (`is-open`, `mobile-menu--closing`). */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    isolation: isolate;
    background: var(--color-ph-black);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 200ms var(--ph-ease-in),
      visibility 0s linear 200ms;
  }

  /* La retícula también dentro del panel, que es opaco. */
  .mobile-menu::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--ph-grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--ph-grid-line) 1px, transparent 1px);
    background-size: var(--ph-grid) var(--ph-grid);
    background-position: var(--ph-section-px) 0;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 160ms var(--ph-ease-out),
      visibility 0s linear 0s;
  }

  .mobile-menu.is-open.mobile-menu--closing {
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms var(--ph-ease-in);
  }

  /* Capa detrás del contenido: recibe los toques en el vacío y cierra. */
  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: pointer;
  }

  .mobile-menu-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
    pointer-events: none;
    /* El overlay es `fixed`: no hereda las zonas seguras del body y las pide
       aparte. El hueco de arriba lo da `--mobile-menu-chrome-offset`, que se mide
       de la barra real y ya lleva el inset dentro. */
    padding:
      calc(var(--mobile-menu-chrome-offset, 60px) + 16px)
      calc(var(--ph-section-px) + env(safe-area-inset-right))
      calc(24px + env(safe-area-inset-bottom))
      calc(var(--ph-section-px) + env(safe-area-inset-left));
  }

  .mm-field {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    container-type: size;
  }

  /* El campo cabe entero en lo que queda, apoyado en el margen izquierdo: su
     banda izquierda cae en la vertical del texto. */
  .mm-pitch-box {
    position: absolute;
    left: 0;
    top: 50%;
    width: min(100cqw, calc(100cqh * 100 / 154));
    aspect-ratio: 100 / 154;
    transform: translateY(-50%);
  }

  .mm-pitch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .mm-line {
    fill: none;
    stroke: rgba(255, 255, 255, 0.17);
    /* 1,2 px en pantalla, escale como escale el campo (`--k`, ph-motion.ts). */
    stroke-width: calc(1.2 * var(--k, 0.29));
    stroke-dasharray: var(--l) var(--l);
    stroke-dashoffset: var(--l);
    transition: stroke-dashoffset 120ms var(--ph-ease-in);
  }

  .mobile-menu.is-open .mm-line {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 400ms var(--ph-ease-out) var(--d, 0ms);
  }

  .mm-spot {
    fill: rgba(255, 255, 255, 0.3);
  }

  .mm-nav {
    position: absolute;
    inset: 0;
  }

  .mobile-nav-list {
    list-style: none;
  }

  /* Cuatro nodos sobre la banda izquierda, repartidos por el largo del campo y
     lejos de la línea de medio campo. */
  .mobile-nav-list li {
    --row: 0;
    position: absolute;
    left: 0;
    top: calc(15% + var(--row) * 23.33%);
    transform: translate(-9px, -50%);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 52px;
    pointer-events: auto;
    font-family: var(--font-display);
    font-size: clamp(28px, 8.6vw, 40px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.72);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
    -webkit-tap-highlight-color: transparent;
  }

  /* El anillo tapa la banda que pasa por debajo. */
  .mobile-link__node {
    --node: 18px;
    background-color: var(--color-ph-black);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 140ms var(--ph-ease-in),
      transform 140ms var(--ph-ease-in),
      background-color var(--ph-dur-state) var(--ph-ease-std);
  }

  .mobile-link__label {
    display: inline-block;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 140ms var(--ph-ease-in),
      transform 140ms var(--ph-ease-in);
  }

  .mobile-menu.is-open .mobile-link__node {
    opacity: 1;
    transform: none;
    transition:
      opacity 180ms var(--ph-ease-out) calc(160ms + var(--row) * 60ms),
      transform 180ms var(--ph-ease-out) calc(160ms + var(--row) * 60ms),
      background-color var(--ph-dur-state) var(--ph-ease-std);
  }

  .mobile-menu.is-open .mobile-link__label {
    opacity: 1;
    transform: none;
    transition:
      opacity 300ms var(--ph-ease-out) calc(220ms + var(--row) * 60ms),
      transform 300ms var(--ph-ease-out) calc(220ms + var(--row) * 60ms);
  }

  /* La página en la que se está: anillo relleno de oro. */
  .mobile-link--active {
    color: var(--color-ph-white);
  }

  .mobile-link--active .mobile-link__node {
    background-color: var(--color-ph-gold);
  }

  .mobile-link:active {
    color: var(--color-ph-gold);
    transition-duration: var(--ph-dur-tap);
  }

  .mobile-link:active .mobile-link__node {
    background-color: var(--color-ph-gold);
  }

  /* ── Idiomas, en fila al pie del menú ── */
  .mm-langs {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    padding-top: 14px;
    list-style: none;
    pointer-events: auto;
    border-top: 1px solid var(--ph-struct-soft);
    opacity: 0;
    transition: opacity 140ms var(--ph-ease-in);
  }

  .mobile-menu.is-open .mm-langs {
    opacity: 1;
    transition: opacity 300ms var(--ph-ease-out) 400ms;
  }

  .mm-lang {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-family: var(--font-body);
    font-size: 15px;
    color: rgba(255, 255, 255, 0.7);
    -webkit-tap-highlight-color: transparent;
  }

  .mm-lang__code {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
  }

  .mm-lang[aria-current='true'] {
    color: var(--color-ph-white);
  }

  .mm-lang[aria-current='true'] .mm-lang__code {
    color: var(--color-ph-gold);
  }

  .mm-lang:active {
    color: var(--color-ph-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-line,
    .mobile-menu.is-open .mm-line {
      stroke-dashoffset: 0;
      transition: none;
    }
    .mobile-link__node,
    .mobile-link__label,
    .mm-langs {
      opacity: 1;
      transform: none;
      transition: none !important;
    }
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }
</style>

<!-- View Transitions: estos pseudo-elementos cuelgan del documento (no del DOM
     scopeado del componente), por eso necesitan is:global. -->
<style is:global>
  /* Cabecera: sin animación de VT para que la barra quede estable (no se funde)
     durante la navegación. Su contenido es idéntico entre páginas; el visor de la
     navegación viaja dentro de ella con sus propias transiciones. */
  ::view-transition-group(ph-header),
  ::view-transition-old(ph-header),
  ::view-transition-new(ph-header) {
    animation: none;
  }
</style>

<script>
  // ── Rutas derivadas de la fuente central (src/lib/navigation.ts) ────────
  // La cabecera persiste entre navegaciones (`transition:persist`): su HTML es el
  // de la primera página que se cargó, así que todo lo que depende del idioma o
  // de la página se reescribe aquí en cada navegación.
  import { NAV_ITEMS } from '@/lib/navigation';
  // El núcleo de movimiento (sin GSAP) se carga con la cabecera, que está en
  // todas las páginas: vigila lo que entra en pantalla y arranca el escaneo entre
  // páginas (src/scripts/ph-motion.ts).
  import '@/scripts/ph-motion';
  import {
    useTranslations,
    getLangFromUrl,
    getLangSwitchUrl,
    getHomePath,
    LANG_NAMES,
    type Lang,
  } from '@/i18n/utils';

  function norm(p: string): string {
    return p === '/' ? '/' : p.replace(/\/+$/, '');
  }

  const header = document.querySelector<HTMLElement>('[data-header]');
  const wrap = header?.querySelector<HTMLElement>('[data-nav-wrap]') ?? null;
  const visor = header?.querySelector<HTMLElement>('[data-nav-visor]') ?? null;
  const desktopLinks = Array.from(header?.querySelectorAll<HTMLAnchorElement>('.nav-link') ?? []);

  // ── Visor de la navegación ────────────────────────────────────────────────
  // Cuatro escuadras alrededor del texto de la página activa. Al señalar o
  // enfocar otra entrada (o la pestaña de idioma) viajan hasta ella; al irse el
  // puntero o el foco, vuelven a la activa. Solo `transform`.
  const VISOR_ARM = 7;
  const PAD_X = 9;
  const PAD_Y = 6;
  let visorTarget: HTMLElement | null = null;

  function activeTarget(): HTMLElement | null {
    const link = desktopLinks.find((l) => l.classList.contains('is-active'));
    return link?.querySelector<HTMLElement>('.nav-link__text') ?? null;
  }

  function placeVisor(target: HTMLElement | null): void {
    if (!wrap || !visor) return;
    visorTarget = target;
    if (!target || target.getClientRects().length === 0) {
      visor.classList.remove('is-shown');
      return;
    }
    const w = wrap.getBoundingClientRect();
    const r = target.getBoundingClientRect();
    const x0 = r.left - w.left - PAD_X;
    const x1 = r.right - w.left + PAD_X - VISOR_ARM;
    const y0 = r.top - w.top - PAD_Y;
    const y1 = r.bottom - w.top + PAD_Y - VISOR_ARM;
    const corners = visor.children as HTMLCollectionOf<HTMLElement>;
    const pos: Array<[number, number]> = [[x0, y0], [x1, y0], [x0, y1], [x1, y1]];
    pos.forEach(([x, y], i) => {
      corners[i]?.style.setProperty('--x', `${Math.round(x * 2) / 2}px`);
      corners[i]?.style.setProperty('--y', `${Math.round(y * 2) / 2}px`);
    });
    visor.classList.add('is-shown');
  }

  function placeVisorInstantly(target: HTMLElement | null): void {
    const el = visor;
    if (!el) return;
    el.classList.remove('is-animated');
    placeVisor(target);
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-animated')));
  }

  if (wrap && visor) {
    desktopLinks.forEach((link) => {
      link.addEventListener('pointerenter', () => placeVisor(link.querySelector('.nav-link__text')));
      link.addEventListener('focus', () => {
        if (link.matches(':focus-visible')) placeVisor(link.querySelector('.nav-link__text'));
      });
    });
    const langTab = wrap.querySelector<HTMLElement>('[data-lang-trigger]');
    if (langTab) {
      langTab.addEventListener('pointerenter', () => placeVisor(langTab.querySelector('.lang-tab__code')));
      langTab.addEventListener('focus', () => {
        if (langTab.matches(':focus-visible')) placeVisor(langTab.querySelector('.lang-tab__code'));
      });
    }
    wrap.addEventListener('pointerleave', () => placeVisor(activeTarget()));
    wrap.addEventListener('focusout', (e) => {
      if (!wrap.contains(e.relatedTarget as Node | null)) placeVisor(activeTarget());
    });
  }

  function syncHeaderToCurrentPage() {
    const pathname = window.location.pathname;
    const lang = getLangFromUrl(new URL(window.location.href));
    const t = useTranslations(lang);
    const currentPath = norm(pathname);
    const navHrefs = NAV_ITEMS.map((i) => i.href[lang]);
    const navLabels = NAV_ITEMS.map((i) => t(i.labelKey));

    // Enlaces de escritorio: destino, texto y página activa.
    desktopLinks.forEach((link, i) => {
      const href = navHrefs[i] ?? link.href;
      link.href = href;
      const label = navLabels[i];
      const text = link.querySelector('.nav-link__text');
      if (label && text) text.textContent = label;
      const active = norm(href) === currentPath;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });

    // Menú móvil (se rehace en cada página, pero se repasa igual).
    document
      .querySelectorAll<HTMLAnchorElement>('.mobile-nav-list .mobile-link')
      .forEach((link, i) => {
        const href = navHrefs[i];
        const label = navLabels[i];
        if (href) link.href = href;
        const active = norm(href ?? '') === currentPath;
        link.classList.toggle('mobile-link--active', active);
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
        if (label) {
          const labelEl = link.querySelector('.mobile-link__label');
          if (labelEl) labelEl.textContent = label;
        }
      });

    // Logo
    const logo = document.querySelector<HTMLAnchorElement>('a.header-logo');
    if (logo) logo.href = getHomePath(lang);

    // Pestaña de idioma: el botón muestra el idioma actual…
    setLangMenuOpen(false);
    const trigger = getLangTrigger();
    if (trigger) {
      trigger.setAttribute('aria-label', `${t('nav.lang.menu')}: ${LANG_NAMES[lang]}`);
      const label = trigger.querySelector<HTMLElement>('[data-lang-current-label]');
      if (label) label.textContent = lang.toUpperCase();
    }

    // …y cada opción lleva a esta misma página en su idioma (o a la home de ese
    // idioma si la página no existe en él).
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-option]').forEach((option) => {
      const code = option.dataset.langOption as Lang;
      option.setAttribute('href', getLangSwitchUrl(pathname, code));
      if (code === lang) option.setAttribute('aria-current', 'true');
      else option.removeAttribute('aria-current');
    });
  }

  let firstLoad = true;
  document.addEventListener('astro:page-load', () => {
    syncHeaderToCurrentPage();
    if (firstLoad) {
      // Primera carga: el visor aparece en su sitio, sin viajar. Se repite cuando
      // llegan las fuentes, que cambian el ancho de las palabras.
      firstLoad = false;
      placeVisorInstantly(activeTarget());
      document.fonts?.ready.then(() => placeVisorInstantly(visorTarget ?? activeTarget()));
    } else {
      placeVisor(activeTarget());
    }
  });

  // Navegación SPA: la cabecera persiste y el visor viaja desde la página de la
  // que se viene hasta la nueva. Corre antes del primer pintado de la página
  // nueva; la cabecera se ve en directo durante la View Transition.
  document.addEventListener('astro:after-swap', () => {
    syncHeaderToCurrentPage();
    placeVisor(activeTarget());
  });

  // Sólo cuando cambia el ancho: en móvil, un resize de sólo altura es la barra
  // del navegador entrando y saliendo durante el scroll.
  let lastViewportWidth = window.innerWidth;
  window.addEventListener('resize', () => {
    if (window.innerWidth === lastViewportWidth) return;
    lastViewportWidth = window.innerWidth;
    placeVisorInstantly(visorTarget ?? activeTarget());
  });

  // ── Pestaña de idioma (escritorio) ───────────────────────────────────────
  // El estado vive en `aria-expanded` del botón y el CSS abre el panel a partir
  // de él. El botón está en la cabecera persistente: se reconsulta cada vez en
  // lugar de cachear el nodo, igual que el menú móvil.
  function getLangTrigger() {
    return document.querySelector<HTMLButtonElement>('[data-header] [data-lang-trigger]');
  }

  function isLangMenuOpen(): boolean {
    return getLangTrigger()?.getAttribute('aria-expanded') === 'true';
  }

  function setLangMenuOpen(open: boolean) {
    getLangTrigger()?.setAttribute('aria-expanded', String(open));
  }

  /**
   * Abre en `pointerup`, que iOS Safari despacha de forma fiable al primer toque
   * incluso cuando ignora el `click` (iPad usa esta cabecera de escritorio).
   * `click` queda para teclado y lectores de pantalla, y se descarta si el
   * puntero ya lo gestionó.
   */
  let langToggledByPointer = false;

  document.addEventListener('pointerup', (e) => {
    const target = e.target as Element | null;
    if (!target?.closest('[data-lang-trigger]')) return;
    e.preventDefault();
    setLangMenuOpen(!isLangMenuOpen());
    langToggledByPointer = true;
    requestAnimationFrame(() => {
      langToggledByPointer = false;
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target?.closest('[data-lang-trigger]') || langToggledByPointer) return;
    setLangMenuOpen(!isLangMenuOpen());
  });

  // Se cierra al tocar fuera, al sacar el foco con el tabulador y al hacer
  // scroll (la barra se esconde al bajar y se llevaría el panel abierto).
  document.addEventListener('pointerdown', (e) => {
    if (!isLangMenuOpen()) return;
    const target = e.target as Element | null;
    if (target?.closest('[data-lang-menu]')) return;
    setLangMenuOpen(false);
  });

  document.addEventListener('focusout', (e) => {
    if (!isLangMenuOpen()) return;
    const menu = (e.target as Element | null)?.closest('[data-lang-menu]');
    if (menu && !menu.contains(e.relatedTarget as Node | null)) setLangMenuOpen(false);
  });

  document.addEventListener(
    'scroll',
    () => {
      if (isLangMenuOpen()) setLangMenuOpen(false);
    },
    { passive: true },
  );

  // Al empezar cualquier navegación (una opción del panel, atrás, otro enlace),
  // cerrarlo sin animación antes de que la View Transition fotografíe la
  // cabecera. Ver `.is-closing-instantly` en el CSS.
  document.addEventListener('astro:before-preparation', () => {
    if (!isLangMenuOpen()) return;
    const menu = document.querySelector<HTMLElement>('[data-header] [data-lang-menu]');
    menu?.classList.add('is-closing-instantly');
    setLangMenuOpen(false);
  });

  document.addEventListener('astro:page-load', () => {
    document
      .querySelector<HTMLElement>('[data-header] [data-lang-menu]')
      ?.classList.remove('is-closing-instantly');
  });

  // ── Menú móvil ───────────────────────────────────────────────────────────
  // El overlay [data-mobile-menu] está fuera del <header transition:persist> y se
  // reemplaza en cada navegación: no cachear el nodo; siempre reconsultar el DOM.
  function getMobileMenu() {
    return document.querySelector<HTMLElement>('[data-mobile-menu]');
  }

  function getMenuToggle() {
    return document.querySelector<HTMLButtonElement>('[data-header] [data-menu-toggle]');
  }

  function syncMobileMenuChromeOffset() {
    const bar = document.querySelector<HTMLElement>('[data-header] .header-shell');
    if (!bar) return;
    const bottom = bar.getBoundingClientRect().bottom;
    const clamped = Math.max(48, Math.min(bottom, 220));
    document.documentElement.style.setProperty(
      '--mobile-menu-chrome-offset',
      `${Math.round(clamped * 10) / 10}px`,
    );
  }

  function updateMenuToggleA11y(open: boolean) {
    const toggle = getMenuToggle();
    if (!toggle) return;
    const openLbl = toggle.getAttribute('data-label-open');
    const closeLbl = toggle.getAttribute('data-label-close');
    if (openLbl && closeLbl) {
      toggle.setAttribute('aria-label', open ? closeLbl : openLbl);
    }
  }

  /** Mientras el menú está abierto, la página de debajo no recibe foco ni la leen
   *  los lectores de pantalla. */
  function setPageInert(on: boolean) {
    document.querySelectorAll<HTMLElement>('main, footer').forEach((el) => {
      el.inert = on;
    });
  }

  /** Lo que tarda en irse: el panel se apaga entero en 200 ms. */
  const MENU_CLOSE_TOTAL_MS = 200;

  let mobileMenuCloseTimer: ReturnType<typeof setTimeout> | null = null;

  function prefersReducedMotionMenu(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function menuFocusables(): HTMLElement[] {
    const menu = getMobileMenu();
    const toggle = getMenuToggle();
    const links = menu ? Array.from(menu.querySelectorAll<HTMLElement>('a[href]')) : [];
    return toggle ? [toggle, ...links] : links;
  }

  function finalizeMobileMenuClose(restoreFocus = false) {
    if (mobileMenuCloseTimer) {
      clearTimeout(mobileMenuCloseTimer);
      mobileMenuCloseTimer = null;
    }
    const mobileMenu = getMobileMenu();
    const wasOpen = mobileMenu?.classList.contains('is-open') ?? false;
    if (mobileMenu) {
      mobileMenu.classList.remove('is-open', 'mobile-menu--closing');
      mobileMenu.setAttribute('aria-hidden', 'true');
    }
    getMenuToggle()?.setAttribute('aria-expanded', 'false');
    updateMenuToggleA11y(false);
    document.documentElement.style.removeProperty('--mobile-menu-chrome-offset');
    document.body.style.overflow = '';
    setPageInert(false);
    if (restoreFocus && wasOpen) getMenuToggle()?.focus({ preventScroll: true });
  }

  function setMobileMenuOpen(open: boolean, restoreFocus = false) {
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;

    if (open) {
      if (mobileMenuCloseTimer) {
        clearTimeout(mobileMenuCloseTimer);
        mobileMenuCloseTimer = null;
      }
      mobileMenu.classList.remove('mobile-menu--closing');
      syncMobileMenuChromeOffset();
      requestAnimationFrame(() => syncMobileMenuChromeOffset());
      mobileMenu.classList.add('is-open');
      mobileMenu.setAttribute('aria-hidden', 'false');
      getMenuToggle()?.setAttribute('aria-expanded', 'true');
      updateMenuToggleA11y(true);
      document.body.style.overflow = 'hidden';
      setPageInert(true);
      // El foco entra en el menú, en la página en la que se está.
      const current =
        mobileMenu.querySelector<HTMLElement>('.mobile-link--active') ??
        mobileMenu.querySelector<HTMLElement>('.mobile-link');
      requestAnimationFrame(() => current?.focus({ preventScroll: true }));
      return;
    }

    if (!mobileMenu.classList.contains('is-open')) return;

    if (mobileMenu.classList.contains('mobile-menu--closing') || prefersReducedMotionMenu()) {
      finalizeMobileMenuClose(restoreFocus);
      return;
    }

    mobileMenu.classList.add('mobile-menu--closing');
    getMenuToggle()?.setAttribute('aria-expanded', 'false');
    updateMenuToggleA11y(false);
    if (restoreFocus) getMenuToggle()?.focus({ preventScroll: true });
    mobileMenuCloseTimer = setTimeout(() => {
      mobileMenuCloseTimer = null;
      finalizeMobileMenuClose(false);
    }, MENU_CLOSE_TOTAL_MS);
  }

  function onMobileMenuLayoutResize() {
    if (getMobileMenu()?.classList.contains('is-open')) {
      syncMobileMenuChromeOffset();
    }
  }

  function toggleMobileMenu() {
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;
    if (mobileMenu.classList.contains('mobile-menu--closing')) {
      if (mobileMenuCloseTimer) {
        clearTimeout(mobileMenuCloseTimer);
        mobileMenuCloseTimer = null;
      }
      mobileMenu.classList.remove('mobile-menu--closing');
      getMenuToggle()?.setAttribute('aria-expanded', 'true');
      updateMenuToggleA11y(true);
      return;
    }
    setMobileMenuOpen(!mobileMenu.classList.contains('is-open'));
  }

  /**
   * Handler principal: `pointerup` se dispara de forma fiable en TODOS los
   * dispositivos (touch + mouse) y NO requiere dos toques en iOS Safari como
   * `click` puede requerir con elementos con :hover CSS o post-animación.
   */
  let toggledByPointer = false;

  function onMobileMenuPointerUp(e: PointerEvent) {
    const target = e.target as Element | null;
    if (!target) return;

    if (target.closest('[data-menu-toggle]')) {
      e.preventDefault();
      toggleMobileMenu();
      toggledByPointer = true;
      requestAnimationFrame(() => {
        toggledByPointer = false;
      });
      return;
    }
    if (target.closest('[data-mobile-menu-dismiss]')) {
      setMobileMenuOpen(false, true);
    }
  }

  /**
   * `click` se mantiene para:
   * - Accesibilidad (teclado / lector de pantalla) en el botón.
   * - Enlaces de navegación del menú (.mobile-link, idiomas).
   */
  function onMobileMenuClick(e: MouseEvent) {
    const target = e.target as Element | null;
    if (!target) return;

    if (target.closest('[data-menu-toggle]')) {
      if (!toggledByPointer) toggleMobileMenu();
      return;
    }
    if (target.closest('[data-mobile-link]')) {
      setMobileMenuOpen(false);
    }
  }

  document.addEventListener('pointerup', onMobileMenuPointerUp);
  document.addEventListener('click', onMobileMenuClick);

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (target?.closest('a.header-logo')) {
      try { sessionStorage.setItem('ph-logo-reveal-request', '1'); } catch {}
    }
  });

  document.addEventListener('astro:page-load', () => finalizeMobileMenuClose());

  document.addEventListener('keydown', (event) => {
    const menuOpen = getMobileMenu()?.classList.contains('is-open') ?? false;

    // El foco no sale del menú mientras está abierto: del último enlace vuelve al
    // botón, y del botón hacia atrás va al último enlace.
    if (event.key === 'Tab' && menuOpen) {
      const items = menuFocusables();
      if (items.length < 2) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      } else if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (active && !items.includes(active)) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
      }
      return;
    }

    if (event.key !== 'Escape') return;
    if (menuOpen) setMobileMenuOpen(false, true);
    if (isLangMenuOpen()) {
      setLangMenuOpen(false);
      getLangTrigger()?.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) setMobileMenuOpen(false);
    else onMobileMenuLayoutResize();
  });

  window.visualViewport?.addEventListener('resize', onMobileMenuLayoutResize);
  window.addEventListener('orientationchange', onMobileMenuLayoutResize);
</script>
