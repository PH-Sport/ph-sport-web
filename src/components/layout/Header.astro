---
import {
  useTranslations,
  getLangFromUrl,
  getLangSwitchUrl,
  getHomePath,
  localizePath,
  supportedLangs,
  LANG_NAMES,
  LANG_FLAGS,
} from '@/i18n/utils';
import { NAV_ITEMS } from '@/lib/navigation';
import { LinkButton } from 'mochi-ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const langOptions = supportedLangs.map((code) => ({
  code,
  name: LANG_NAMES[code],
  flag: LANG_FLAGS[code],
  href: getLangSwitchUrl(Astro.url.pathname, code),
  current: code === lang,
}));
const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const contactHref = localizePath('/#contacto', lang);

const nav = NAV_ITEMS.map((item) => ({
  href: item.href[lang],
  label: t(item.labelKey),
}));

const isActive = (href: string): boolean => {
  const normalizedHref = href === '/' ? '/' : href.replace(/\/$/, '');
  return normalizedHref === currentPath;
};
---

<header data-header transition:persist>
  <div class="header-shell">
    <div class="header-inner">
      <a href={getHomePath(lang)} class="header-logo" aria-label={t('a11y.logo')}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 259.8 206.1" fill="currentColor" aria-hidden="true">
          <polygon points="0 206.1 58.2 206.1 57.9 145.5 158.1 45.4 112.7 0 0 0 0 52.6 76.9 52.6 0 128.7" />
          <polygon points="122.6 206.1 200.1 206.1 152.2 157.8 173 137.1 182.4 146.4 259.8 146.4 169.6 55.6 130.5 94.2 131.8 95.6 141.1 105.4 120.3 125.8 109.8 115.4 70.8 153.9" />
        </svg>
      </a>

      <nav class="header-nav" aria-label={t('nav.aria.main')}>
        <div class="header-nav-list-wrap">
          <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
          <ul class="header-nav-list">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-astro-prefetch="load"
                  class:list={['nav-link', isActive(item.href) && 'is-active']}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>

      <div class="header-end">
        <div class="lang-menu" data-lang-menu>
          {/* Desplegable de idioma: el botón muestra el idioma actual y crece hasta
              ser la lista de los tres. Es un botón que despliega enlaces normales
              (patrón "disclosure"), no un role="menu": cada opción es navegación. */}
          <button
            type="button"
            class="lang-switch"
            data-lang-trigger
            aria-expanded="false"
            aria-controls="lang-panel"
            aria-label={`${t('nav.lang.menu')}: ${LANG_NAMES[lang]}`}
          >
            <img src={LANG_FLAGS[lang]} alt="" width="20" height="15" class="lang-flag" data-lang-current-flag />
            <span class="lang-label" data-lang-current-label>{lang.toUpperCase()}</span>
            <svg class="lang-chevron" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <div id="lang-panel" class="lang-panel" data-lang-panel>
            {/* Primera fila: la misma cara que el botón, para que la lista parezca
                el botón crecido. Cierra al pulsarla. */}
            <div class="lang-current" data-lang-current aria-hidden="true">
              <img src={LANG_FLAGS[lang]} alt="" width="20" height="15" class="lang-flag" data-lang-current-flag />
              <span class="lang-label" data-lang-current-label>{lang.toUpperCase()}</span>
              <svg class="lang-chevron" viewBox="0 0 24 24" width="14" height="14"><path d="m6 9 6 6 6-6" /></svg>
            </div>
            <ul class="lang-options">
              {langOptions.map((option, i) => (
                <li>
                  {/* hreflang = idioma del destino, no el de esta página: declara la
                      frontera entre versiones a buscadores y lectores de pantalla. */}
                  <a
                    href={option.href}
                    hreflang={option.code}
                    lang={option.code}
                    class="lang-option"
                    data-lang-option={option.code}
                    aria-current={option.current ? 'true' : undefined}
                    style={`--i: ${i}`}
                  >
                    <img src={option.flag} alt="" width="20" height="15" class="lang-flag" />
                    <span>{option.name}</span>
                    <svg class="lang-check" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <span class="header-cta" data-header-cta>
          <LinkButton href={contactHref} variant="accent" size="sm">{t('footer.contact')}</LinkButton>
        </span>
      </div>

      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        data-label-open={t('a11y.menu.open')}
        data-label-close={t('a11y.menu.close')}
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('a11y.menu.open')}
      >
        <span class="menu-toggle__inner" aria-hidden="true">
          <span class="menu-toggle__bar"></span>
          <span class="menu-toggle__bar"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Overlay fuera de [data-header]: evita que backdrop-filter del header ancle position:fixed al rectángulo de la barra. -->
<div id="mobile-menu" class="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu-backdrop" data-mobile-menu-dismiss aria-hidden="true"></div>
  {/* El panel arranca con la forma de la cápsula de la cabecera y crece hasta ser el
      menú: la isla se transforma, no se abre una capa aparte. */}
  <div class="mobile-menu-panel">
    <div class="mobile-menu-inner">
      <nav aria-label={t('nav.aria.mobile')}>
        <ul class="mobile-nav-list">
          {nav.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a
                href={item.href}
                data-mobile-link
                data-astro-prefetch="load"
                class:list={['mobile-link', isActive(item.href) && 'mobile-link--active']}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* En móvil no hay desplegable dentro del menú: el menú ya es el panel que se
          abre, así que los tres idiomas van a la vista, con el actual marcado. */}
      <div class="mobile-menu-foot" style={`--i: ${nav.length}`}>
        <ul class="lang-list--mobile" aria-label={t('nav.lang.menu')}>
          {langOptions.map((option) => (
            <li>
              <a
                href={option.href}
                hreflang={option.code}
                lang={option.code}
                data-mobile-link
                data-lang-option={option.code}
                aria-current={option.current ? 'true' : undefined}
                aria-label={option.name}
                class="lang-switch--mobile"
              >
                <img src={option.flag} alt="" width="20" height="15" class="lang-flag" />
                <span>{option.code.toUpperCase()}</span>
              </a>
            </li>
          ))}
        </ul>
        <span class="header-cta" data-header-cta>
          <LinkButton href={contactHref} variant="accent" size="sm" data-mobile-link>{t('footer.contact')}</LinkButton>
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Cápsula flotante: una isla que se transforma ─────────────────────────────
     Margen exterior y relleno interior a medias (½ del margen de sección cada uno):
     así el logo y la última pieza del menú caen en la misma vertical que los textos
     de las páginas. Al bajar, la isla se vuelve sólida y se estrecha (estado
     `header--solid`, en el CSS global de BaseLayout). */
  .header-shell {
    width: calc(100% - var(--ph-section-px));
    margin-inline: auto;
    /* Con `viewport-fit=cover` el `top: 0` del header queda debajo de la barra de
       estado: se le suma la zona segura para que la cápsula siga cayendo por debajo. */
    margin-top: calc(0.75rem + env(safe-area-inset-top));
    border-radius: var(--ph-r-md);
    /* Nombre propio de View Transition: saca la cápsula del snapshot `root` para
       que no se funda (sale/entra) en cada navegación SPA. Ver bloque is:global. */
    view-transition-name: ph-header;
    transition:
      width var(--mochi-duration-morph) var(--mochi-ease-morph),
      transform var(--mochi-duration-morph) var(--mochi-ease-morph),
      background-color var(--mochi-duration-morph) var(--mochi-ease-morph),
      border-color var(--mochi-duration-morph) var(--mochi-ease-morph),
      box-shadow var(--mochi-duration-morph) var(--mochi-ease-morph);
  }

  @media (max-width: 767px) {
    .header-shell { margin-top: calc(0.5rem + env(safe-area-inset-top)); }
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 12px;
    padding: 10px calc(var(--ph-section-px) / 2);
  }

  @media (max-width: 767px) {
    .header-inner { grid-template-columns: auto 1fr; padding: 8px 10px 8px calc(var(--ph-section-px) / 2); }
  }

  /* ── Logo ── */
  .header-logo {
    display: block;
    color: var(--color-ph-gold);
    transition: color var(--mochi-duration-color) var(--mochi-ease-color);
  }
  .header-logo svg { display: block; height: 1.75rem; width: auto; }
  @media (max-width: 767px) { .header-logo svg { height: 1.5rem; } }
  .header-logo:hover { color: var(--mochi-accent-strong); }

  /* ── Navegación de escritorio ── */
  .header-nav { display: none; justify-self: center; }
  @media (min-width: 768px) { .header-nav { display: block; } }

  .header-nav-list-wrap { position: relative; padding: 4px; }
  .header-nav-list { position: relative; z-index: 1; display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; }

  .nav-link {
    display: block;
    padding: 9px 14px;
    border-radius: var(--ph-r-sm);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.64);
    transition: color var(--mochi-duration-color) var(--mochi-ease-color);
  }
  .nav-link:hover,
  .nav-link.is-active { color: var(--color-ph-white); }

  /* Pastilla que se desliza bajo el enlace (al pasar el ratón y al cambiar de
     página). Se coloca con `translateX` + ancho desde el script. Sin subrayado
     dorado (2026-10-02): marcaba dos veces la página actual y era un dorado más
     en la cabecera, que ya lleva el logo y el botón de contacto. */
  .nav-indicator {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--w, 0px);
    transform: translateX(var(--x, 0px));
    border-radius: var(--ph-r-sm);
    background: rgba(255, 255, 255, 0.075);
    opacity: 0;
    pointer-events: none;
    /* Nombre propio de View Transition: el navegador morfea su geometría de la
       página vieja a la nueva → ESE morph es el deslizamiento, por encima del
       telón. La geometría nueva se fija en astro:after-swap, antes del snapshot. */
    view-transition-name: ph-nav-indicator;
  }
  .nav-indicator.is-visible { opacity: 1; }
  .nav-indicator.is-animated {
    transition:
      transform var(--mochi-duration-morph) var(--mochi-ease-morph),
      width var(--mochi-duration-morph) var(--mochi-ease-morph),
      opacity var(--mochi-duration-fade-in) var(--mochi-ease-fade-in);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-indicator.is-animated { transition: none; }
  }

  /* ── Extremo derecho: idioma y contacto ── */
  .header-end { display: none; align-items: center; gap: 8px; }
  @media (min-width: 768px) { .header-end { display: flex; } }

  /* Desplegable de idioma: el botón crece hasta ser la lista (recorte que se abre
     con «morph») y las opciones entran después con un desenfoque corto. El estado
     lo lleva `aria-expanded` del botón: el CSS abre el panel a partir de él. */
  .lang-menu { position: relative; }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 12px;
    border-radius: var(--ph-r-btn-sm);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-ph-white);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--mochi-duration-color) var(--mochi-ease-color),
      transform var(--mochi-duration-snappy) var(--mochi-ease-snappy);
  }
  .lang-switch:hover { background: rgba(255, 255, 255, 0.07); }
  .lang-switch:active { transform: scale(0.965); transition-duration: var(--mochi-duration-press); transition-timing-function: var(--mochi-ease-press); }
  .lang-flag { display: block; width: 20px; height: 15px; border-radius: 3px; }
  .lang-label { font-family: var(--font-display); font-size: 13px; font-weight: 500; letter-spacing: 0.03em; }
  .lang-chevron {
    display: block;
    fill: none;
    stroke: rgba(255, 255, 255, 0.62);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate var(--mochi-duration-snappy) var(--mochi-ease-snappy);
  }
  .lang-current .lang-chevron { rotate: 180deg; }

  .lang-panel {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    width: 212px;
    padding: 6px;
    border-radius: var(--ph-r-md);
    background: var(--mochi-solid);
    /* Cerrado, el recorte tiene exactamente la forma del botón, en su esquina. */
    clip-path: inset(0 0 calc(100% - 40px) calc(100% - var(--bw, 76px)) round var(--ph-r-btn-sm));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      clip-path var(--mochi-duration-morph) var(--mochi-ease-morph),
      opacity var(--mochi-duration-fade-out) var(--mochi-ease-fade-out) 120ms,
      visibility 0s linear var(--mochi-duration-morph);
  }
  .lang-switch[aria-expanded='true'] + .lang-panel {
    clip-path: inset(0 0 0 0 round var(--ph-r-md));
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      clip-path var(--mochi-duration-morph) var(--mochi-ease-morph),
      opacity 0s,
      visibility 0s;
  }
  .lang-current {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    height: 28px;
    padding: 0 7px;
    color: var(--color-ph-white);
    cursor: pointer;
  }
  .lang-options { display: grid; gap: 2px; margin: 6px 0 0; padding: 6px 0 0; list-style: none; border-top: 1px solid var(--mochi-surface-border); }
  .lang-option {
    display: grid;
    grid-template-columns: 20px 1fr 16px;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-radius: var(--ph-r-sm);
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--color-ph-white);
    opacity: 0;
    filter: blur(4px);
    translate: 0 -4px;
    transition:
      background-color var(--mochi-duration-color) var(--mochi-ease-color),
      opacity var(--mochi-duration-fade-out) var(--mochi-ease-fade-out),
      filter var(--mochi-duration-fade-out) var(--mochi-ease-fade-out),
      translate var(--mochi-duration-fade-out) var(--mochi-ease-fade-out);
  }
  .lang-switch[aria-expanded='true'] + .lang-panel .lang-option {
    opacity: 1;
    filter: blur(0);
    translate: 0 0;
    transition:
      background-color var(--mochi-duration-color) var(--mochi-ease-color),
      opacity var(--mochi-duration-fade-in) var(--mochi-ease-fade-in) calc(60ms + var(--i) * 26ms),
      filter var(--mochi-duration-fade-in) var(--mochi-ease-fade-in) calc(60ms + var(--i) * 26ms),
      translate var(--mochi-duration-fade-in) var(--mochi-ease-fade-in) calc(60ms + var(--i) * 26ms);
  }
  .lang-option:hover,
  .lang-option:focus-visible { background-color: rgba(255, 255, 255, 0.07); }
  .lang-check { fill: none; stroke: var(--color-ph-gold); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; opacity: 0; }
  .lang-option[aria-current='true'] .lang-check { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .lang-panel, .lang-switch[aria-expanded='true'] + .lang-panel,
    .lang-option, .lang-switch[aria-expanded='true'] + .lang-panel .lang-option,
    .lang-chevron { transition: none; }
  }

  /* Al navegar se cierra en seco. La View Transition fotografía la cabecera antes
     del cambio de página y mantiene esa foto toda la transición: con el panel a
     medio fundir, se vería encima ~0,4 s. Lo comprueba el smoke. */
  .lang-menu.is-closing-instantly .lang-switch,
  .lang-menu.is-closing-instantly .lang-panel,
  .lang-menu.is-closing-instantly .lang-option,
  .lang-menu.is-closing-instantly .lang-chevron { transition: none; }

  /* ── Botón del menú móvil: dos barras que se cruzan ── */
  .menu-toggle {
    display: inline-grid;
    place-items: center;
    justify-self: end;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--ph-r-btn);
    background: var(--mochi-solid);
    color: var(--color-ph-white);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform var(--mochi-duration-snappy) var(--mochi-ease-snappy);
  }
  .menu-toggle:active { transform: scale(0.965); transition-duration: var(--mochi-duration-press); transition-timing-function: var(--mochi-ease-press); }
  @media (min-width: 768px) { .menu-toggle { display: none; } }

  .menu-toggle__inner { position: relative; width: 20px; height: 14px; }
  .menu-toggle__bar {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.6px;
    border-radius: 1px;
    background: currentColor;
    transition:
      top var(--mochi-duration-snappy) var(--mochi-ease-snappy),
      rotate var(--mochi-duration-snappy) var(--mochi-ease-snappy),
      left var(--mochi-duration-snappy) var(--mochi-ease-snappy);
  }
  .menu-toggle__bar:nth-child(1) { top: 2px; }
  .menu-toggle__bar:nth-child(2) { top: 10.4px; left: 6px; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(1) { top: 6.2px; rotate: 45deg; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(2) { top: 6.2px; left: 0; rotate: -45deg; }
  @media (prefers-reduced-motion: reduce) { .menu-toggle__bar { transition: none; } }

  /* ── Menú móvil: la isla de la cabecera crece hasta ser el menú ──────────────
     El panel cae justo donde está la cápsula y arranca recortado a su alto
     (`--cap-h`, medido en el script): al abrir, el recorte crece con «morph» y los
     enlaces entran después con desenfoque. Al cerrar, el script mantiene `is-open`
     con `mobile-menu--closing` mientras el recorte vuelve a la cápsula. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear var(--mochi-duration-morph);
  }
  .mobile-menu.is-open { visibility: visible; pointer-events: auto; transition: none; }

  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(13, 15, 18, 0.62);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    opacity: 0;
    cursor: pointer;
    transition: opacity var(--mochi-duration-fade-out) var(--mochi-ease-fade-out);
  }
  .mobile-menu.is-open .mobile-menu-backdrop { opacity: 1; transition: opacity var(--mochi-duration-fade-in) var(--mochi-ease-fade-in); }
  .mobile-menu.is-open.mobile-menu--closing .mobile-menu-backdrop { opacity: 0; pointer-events: none; transition: opacity var(--mochi-duration-fade-out) var(--mochi-ease-fade-out); }

  .mobile-menu-panel {
    position: absolute;
    top: calc(0.5rem + env(safe-area-inset-top));
    left: calc(var(--ph-section-px) / 2 + env(safe-area-inset-left));
    right: calc(var(--ph-section-px) / 2 + env(safe-area-inset-right));
    max-height: calc(100dvh - 1rem - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    overflow-y: auto;
    border-radius: var(--ph-r-md);
    background: rgba(21, 23, 27, 0.97);
    box-shadow: var(--mochi-shadow-overlay);
    clip-path: inset(0 0 calc(100% - var(--cap-h, 62px)) 0 round var(--ph-r-md));
    transition: clip-path var(--mochi-duration-morph) var(--mochi-ease-morph);
  }
  .mobile-menu.is-open .mobile-menu-panel { clip-path: inset(0 0 0 0 round var(--ph-r-md)); }
  .mobile-menu.is-open.mobile-menu--closing .mobile-menu-panel { clip-path: inset(0 0 calc(100% - var(--cap-h, 62px)) 0 round var(--ph-r-md)); }

  .mobile-menu-inner {
    display: grid;
    gap: 8px;
    padding: calc(var(--cap-h, 62px) + 6px) 14px 14px;
  }
  .mobile-nav-list { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .mobile-nav-list li,
  .mobile-menu-foot {
    opacity: 0;
    filter: blur(6px);
    translate: 0 8px;
    transition:
      opacity var(--mochi-duration-fade-out) var(--mochi-ease-fade-out),
      filter var(--mochi-duration-fade-out) var(--mochi-ease-fade-out),
      translate var(--mochi-duration-fade-out) var(--mochi-ease-fade-out);
  }
  .mobile-menu.is-open .mobile-nav-list li,
  .mobile-menu.is-open .mobile-menu-foot {
    opacity: 1;
    filter: blur(0);
    translate: 0 0;
    transition:
      opacity var(--mochi-duration-fade-in) var(--mochi-ease-fade-in) calc(60ms + var(--i) * 30ms),
      filter var(--mochi-duration-fade-in) var(--mochi-ease-fade-in) calc(60ms + var(--i) * 30ms),
      translate var(--mochi-duration-morph) var(--mochi-ease-morph) calc(60ms + var(--i) * 30ms);
  }
  .mobile-menu.is-open.mobile-menu--closing .mobile-nav-list li,
  .mobile-menu.is-open.mobile-menu--closing .mobile-menu-foot {
    opacity: 0;
    filter: blur(6px);
    translate: 0 4px;
    transition:
      opacity var(--mochi-duration-fade-out) var(--mochi-ease-fade-out),
      filter var(--mochi-duration-fade-out) var(--mochi-ease-fade-out),
      translate var(--mochi-duration-fade-out) var(--mochi-ease-fade-out);
  }

  .mobile-link {
    display: block;
    padding: 12px 8px;
    border-radius: var(--ph-r-btn);
    font-family: var(--font-display);
    font-size: clamp(26px, 7vw, 32px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.86);
    transition: color var(--mochi-duration-color) var(--mochi-ease-color), background-color var(--mochi-duration-color) var(--mochi-ease-color);
  }
  .mobile-link:active { background: rgba(255, 255, 255, 0.05); }
  /* La página actual, como en escritorio: blanco pleno sobre una superficie
     suave, sin dorado (el dorado del panel es el botón de contacto). */
  .mobile-link--active { color: var(--color-ph-white); background: rgba(255, 255, 255, 0.06); }

  .mobile-menu-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 6px;
    padding: 14px 8px 4px;
    border-top: 1px solid var(--mochi-surface-border);
  }
  .lang-list--mobile { display: flex; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .lang-switch--mobile {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 10px;
    border-radius: var(--ph-r-sm);
    background: rgba(255, 255, 255, 0.06);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--color-ph-white);
    transition: background-color var(--mochi-duration-color) var(--mochi-ease-color), color var(--mochi-duration-color) var(--mochi-ease-color);
  }
  .lang-switch--mobile[aria-current='true'] {
    background: var(--mochi-thumb);
    color: var(--mochi-on-thumb);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .mobile-menu-backdrop, .mobile-menu-panel,
    .mobile-nav-list li, .mobile-menu-foot,
    .mobile-menu.is-open .mobile-nav-list li, .mobile-menu.is-open .mobile-menu-foot {
      transition: none !important;
    }
  }

  @media (min-width: 768px) {
    .mobile-menu { display: none; }
  }
</style>

<!-- View Transitions: estos pseudo-elementos cuelgan del documento (no del DOM
     scopeado del componente), por eso necesitan is:global. -->
<style is:global>
  /* Header: matamos su animación de VT para que la cápsula quede estable (no se
     funde) durante la navegación. Su contenido es idéntico entre páginas, así que
     no hay nada que animar; el indicador es un grupo aparte (ph-nav-indicator). */
  ::view-transition-group(ph-header),
  ::view-transition-old(ph-header),
  ::view-transition-new(ph-header) {
    animation: none;
  }

  /* Indicador: el morph por defecto (geometría vieja → nueva) es el deslizamiento,
     con el muelle «morph» de Mochi. La curva va escrita entera: las variables no
     heredan en el árbol de ::view-transition (docs/trampas-conocidas.md). */
  ::view-transition-group(ph-nav-indicator) {
    animation-duration: 586ms;
    animation-timing-function: linear(0, 0.015, 0.0541, 0.1097, 0.1756, 0.2474, 0.3213, 0.3946, 0.4654, 0.5325, 0.5947, 0.6518, 0.7034, 0.7496, 0.7905, 0.8263, 0.8574, 0.8843, 0.9071, 0.9265, 0.9428, 0.9563, 0.9674, 0.9764, 0.9837, 0.9895, 0.994, 0.9975, 1.0001, 1.002, 1.0033, 1.0042, 1.0047, 1.005, 1.005, 1.0049, 1.0047, 1.0044, 1.004, 1.0037, 1.0033, 1.0029, 1.0026, 1.0023, 1.0019, 1.0017, 1.0014, 1.0012, 1);
  }

  /* Sin movimiento: la pastilla aparece directamente en su sitio. */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(ph-nav-indicator),
    ::view-transition-old(ph-nav-indicator),
    ::view-transition-new(ph-nav-indicator) {
      animation: none;
    }
  }
</style>

<script>
  // ── Nav indicator deslizante ──────────────────────────────────────────────
  const wrap = document.querySelector<HTMLElement>('.header-nav-list-wrap');
  const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
  const desktopLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.header-nav .nav-link'),
  );

  let indicatorReady = false;

  // La pastilla se coloca con translateX + ancho (variables --x y --w del CSS).
  function setIndicatorToLink(link: HTMLElement) {
    if (!wrap || !indicator || !link) return;
    const wrapRect = wrap.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    indicator.style.setProperty('--x', `${linkRect.left - wrapRect.left}px`);
    indicator.style.setProperty('--w', `${linkRect.width}px`);
    indicator.classList.add('is-visible');
  }

  function hideIndicator() {
    indicator?.classList.remove('is-visible');
  }

  function activeDesktopLink() {
    return desktopLinks.find((link) => link.classList.contains('is-active'));
  }

  // ── Rutas derivadas de la fuente central (src/lib/navigation.ts) ────────
  // La cabecera persiste entre navegaciones (`transition:persist`): su HTML es el
  // de la primera página que se cargó, así que todo lo que depende del idioma o
  // de la página se reescribe aquí en cada navegación.
  import { NAV_ITEMS } from '@/lib/navigation';
  import {
    useTranslations,
    getLangFromUrl,
    getLangSwitchUrl,
    getHomePath,
    localizePath,
    LANG_NAMES,
    LANG_FLAGS,
    type Lang,
  } from '@/i18n/utils';

  function norm(p: string): string {
    return p === '/' ? '/' : p.replace(/\/+$/, '');
  }

  function syncHeaderToCurrentPage() {
    const pathname = window.location.pathname;
    const lang = getLangFromUrl(new URL(window.location.href));
    const t = useTranslations(lang);
    const currentPath = norm(pathname);
    const navHrefs = NAV_ITEMS.map((i) => i.href[lang]);
    const navLabels = NAV_ITEMS.map((i) => t(i.labelKey));

    // Actualizar hrefs, labels e is-active de los enlaces de escritorio
    desktopLinks.forEach((link, i) => {
      const href = navHrefs[i] ?? link.href;
      link.href = href;
      link.textContent = navLabels[i] ?? link.textContent;
      link.classList.toggle('is-active', norm(href) === currentPath);
    });

    // Actualizar hrefs, labels e is-active del menú móvil
    document
      .querySelectorAll<HTMLAnchorElement>('.mobile-nav-list .mobile-link')
      .forEach((link, i) => {
        const href = navHrefs[i];
        const label = navLabels[i];
        if (href) link.href = href;
        link.classList.toggle('mobile-link--active', norm(href ?? '') === currentPath);
        // Preservar el span numerador y actualizar solo el texto del label
        if (label) {
          const numSpan = link.querySelector('.mobile-link-num');
          link.textContent = label;
          if (numSpan) link.prepend(numSpan);
        }
      });

    // Logo
    const logo = document.querySelector<HTMLAnchorElement>('a.header-logo');
    if (logo) logo.href = getHomePath(lang);

    // Botón de contacto (cabecera y menú móvil): enlace y texto en el idioma actual.
    const contactLabel = t('footer.contact');
    document.querySelectorAll<HTMLAnchorElement>('[data-header-cta] a').forEach((cta) => {
      cta.href = localizePath('/#contacto', lang);
      cta.querySelectorAll('.mochi-button__label, .mochi-sr').forEach((el) => { el.textContent = contactLabel; });
    });

    // Selector de idioma: el botón muestra el idioma actual…
    setLangMenuOpen(false);
    const trigger = getLangTrigger();
    if (trigger) {
      trigger.setAttribute('aria-label', `${t('nav.lang.menu')}: ${LANG_NAMES[lang]}`);
      // El botón y la primera fila de la lista muestran el mismo idioma.
      const menu = trigger.closest<HTMLElement>('[data-lang-menu]');
      menu?.querySelectorAll<HTMLImageElement>('[data-lang-current-flag]').forEach((flag) => { flag.src = LANG_FLAGS[lang]; });
      menu?.querySelectorAll<HTMLElement>('[data-lang-current-label]').forEach((label) => { label.textContent = lang.toUpperCase(); });
      // La lista cerrada tiene la forma exacta del botón: su ancho va al recorte.
      menu?.style.setProperty('--bw', `${trigger.offsetWidth}px`);
    }

    // …y cada opción lleva a esta misma página en su idioma (o a la home de ese
    // idioma si la página no existe en él).
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-option]').forEach((option) => {
      const code = option.dataset.langOption as Lang;
      option.setAttribute('href', getLangSwitchUrl(pathname, code));
      if (code === lang) option.setAttribute('aria-current', 'true');
      else option.removeAttribute('aria-current');
    });
  }

  if (wrap && indicator && desktopLinks.length > 0) {
    document.addEventListener('astro:page-load', () => {
      syncHeaderToCurrentPage();
      const activeLink = desktopLinks.find((link) =>
        link.classList.contains('is-active'),
      );

      if (!indicatorReady) {
        // Primera carga: posicionar sin animación, luego activarla
        if (activeLink) setIndicatorToLink(activeLink);
        else hideIndicator();
        requestAnimationFrame(() => {
          indicator.classList.add('is-animated');
          indicatorReady = true;
        });
      } else {
        // Navegaciones posteriores: el header persiste, la barra ya está en la
        // posición anterior → animamos hasta el nuevo enlace activo
        if (activeLink) {
          setIndicatorToLink(activeLink);
        } else {
          hideIndicator();
        }
      }
    });

    // Navegación SPA: corre ANTES de que la View Transition capture el snapshot
    // nuevo, así la geometría nueva del indicador entra en ese snapshot y el
    // navegador la morfea desde la vieja → ese morph ES el deslizamiento. En la
    // carga inicial este evento no se dispara; de eso se encarga astro:page-load.
    document.addEventListener('astro:after-swap', () => {
      syncHeaderToCurrentPage();
      const activeLink = desktopLinks.find((link) =>
        link.classList.contains('is-active'),
      );
      if (activeLink) {
        setIndicatorToLink(activeLink);
      } else {
        hideIndicator();
      }
    });

    // Sólo cuando cambia el ancho: en móvil, un resize de sólo altura es la barra
    // del navegador entrando y saliendo durante el scroll, y la posición del
    // indicador —horizontal, dentro del header— no depende de la altura.
    let lastViewportWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastViewportWidth) return;
      lastViewportWidth = window.innerWidth;
      const activeLink = desktopLinks.find((link) =>
        link.classList.contains('is-active'),
      );
      if (activeLink) setIndicatorToLink(activeLink);
    });

    // La pastilla sigue al ratón por los enlaces y vuelve a la página actual al
    // salir del menú.
    desktopLinks.forEach((link) => {
      link.addEventListener('pointerenter', () => { if (indicatorReady) setIndicatorToLink(link); });
    });
    wrap.addEventListener('pointerleave', () => {
      const active = activeDesktopLink();
      if (active) setIndicatorToLink(active);
      else hideIndicator();
    });
  }

  // ── Desplegable de idioma (escritorio) ───────────────────────────────────
  // El estado vive en `aria-expanded` del botón y el CSS abre el panel a partir
  // de él. El botón está en la cabecera persistente: se reconsulta cada vez en
  // lugar de cachear el nodo, igual que el menú móvil.
  function getLangTrigger() {
    return document.querySelector<HTMLButtonElement>('[data-header] [data-lang-trigger]');
  }

  function isLangMenuOpen(): boolean {
    return getLangTrigger()?.getAttribute('aria-expanded') === 'true';
  }

  function setLangMenuOpen(open: boolean) {
    getLangTrigger()?.setAttribute('aria-expanded', String(open));
  }

  /**
   * Abre en `pointerup`, que iOS
   * Safari despacha de forma fiable al primer toque incluso cuando ignora el
   * `click` (iPad usa esta cabecera de escritorio). `click` queda para teclado y
   * lectores de pantalla, y se descarta si el puntero ya lo gestionó.
   */
  let langToggledByPointer = false;

  document.addEventListener('pointerup', (e) => {
    const target = e.target as Element | null;
    // La primera fila de la lista abierta es la cara del botón: pulsarla cierra.
    if (target?.closest('[data-lang-current]')) {
      setLangMenuOpen(false);
      getLangTrigger()?.focus();
      return;
    }
    if (!target?.closest('[data-lang-trigger]')) return;
    e.preventDefault();
    setLangMenuOpen(!isLangMenuOpen());
    langToggledByPointer = true;
    requestAnimationFrame(() => {
      langToggledByPointer = false;
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target?.closest('[data-lang-trigger]') || langToggledByPointer) return;
    setLangMenuOpen(!isLangMenuOpen());
  });

  // Se cierra al tocar fuera, al sacar el foco con el tabulador y al hacer
  // scroll (la cápsula se esconde al bajar y se llevaría el panel abierto).
  document.addEventListener('pointerdown', (e) => {
    if (!isLangMenuOpen()) return;
    const target = e.target as Element | null;
    if (target?.closest('[data-lang-menu]')) return;
    setLangMenuOpen(false);
  });

  document.addEventListener('focusout', (e) => {
    if (!isLangMenuOpen()) return;
    const menu = (e.target as Element | null)?.closest('[data-lang-menu]');
    if (menu && !menu.contains(e.relatedTarget as Node | null)) setLangMenuOpen(false);
  });

  document.addEventListener(
    'scroll',
    () => {
      if (isLangMenuOpen()) setLangMenuOpen(false);
    },
    { passive: true },
  );

  // Al empezar cualquier navegación (una opción del panel, atrás, otro enlace),
  // cerrarlo sin animación antes de que la View Transition fotografíe la
  // cabecera. Ver `.is-closing-instantly` en el CSS.
  document.addEventListener('astro:before-preparation', () => {
    if (!isLangMenuOpen()) return;
    const menu = document.querySelector<HTMLElement>('[data-header] [data-lang-menu]');
    menu?.classList.add('is-closing-instantly');
    setLangMenuOpen(false);
  });

  document.addEventListener('astro:page-load', () => {
    document
      .querySelector<HTMLElement>('[data-header] [data-lang-menu]')
      ?.classList.remove('is-closing-instantly');
  });

  // ── Menú móvil ───────────────────────────────────────────────────────────
  // El overlay [data-mobile-menu] está fuera del <header transition:persist> y se
  // reemplaza en cada navegación: no cachear el nodo; siempre reconsultar el DOM.
  function getMobileMenu() {
    return document.querySelector<HTMLElement>('[data-mobile-menu]');
  }

  // El panel del menú arranca recortado al alto de la cápsula (`--cap-h`): así la
  // isla de la cabecera parece crecer hasta ser el menú.
  function syncMobileMenuChromeOffset() {
    const shell = document.querySelector<HTMLElement>('[data-header] .header-shell');
    if (!shell) return;
    document.documentElement.style.setProperty('--cap-h', `${Math.round(shell.getBoundingClientRect().height)}px`);
  }

  function updateMenuToggleA11y(open: boolean) {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!toggle) return;
    const openLbl = toggle.getAttribute('data-label-open');
    const closeLbl = toggle.getAttribute('data-label-close');
    if (openLbl && closeLbl) {
      toggle.setAttribute('aria-label', open ? closeLbl : openLbl);
    }
  }

  /** Lo que tarda el recorte en volver a la cápsula (muelle «morph» de Mochi, 586 ms). */
  const MENU_CLOSE_TOTAL_MS = 620;

  let mobileMenuCloseTimer: ReturnType<typeof setTimeout> | null = null;

  function prefersReducedMotionMenu(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function finalizeMobileMenuClose() {
    if (mobileMenuCloseTimer) {
      clearTimeout(mobileMenuCloseTimer);
      mobileMenuCloseTimer = null;
    }
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;
    mobileMenu.classList.remove('is-open', 'mobile-menu--closing');
    mobileMenu.setAttribute('aria-hidden', 'true');
    document.querySelectorAll<HTMLElement>('[data-menu-toggle]').forEach((toggle) => {
      toggle.setAttribute('aria-expanded', 'false');
    });
    updateMenuToggleA11y(false);
    document.body.style.overflow = '';
  }

  function setMobileMenuOpen(open: boolean) {
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;

    if (open) {
      if (mobileMenuCloseTimer) {
        clearTimeout(mobileMenuCloseTimer);
        mobileMenuCloseTimer = null;
      }
      mobileMenu.classList.remove('mobile-menu--closing');
      syncMobileMenuChromeOffset();
      requestAnimationFrame(() => syncMobileMenuChromeOffset());
      mobileMenu.classList.add('is-open');
      mobileMenu.setAttribute('aria-hidden', 'false');
      document.querySelectorAll<HTMLElement>('[data-menu-toggle]').forEach((toggle) => {
        toggle.setAttribute('aria-expanded', 'true');
      });
      updateMenuToggleA11y(true);
      document.body.style.overflow = 'hidden';
      return;
    }

    if (!mobileMenu.classList.contains('is-open')) return;

    if (mobileMenu.classList.contains('mobile-menu--closing')) {
      finalizeMobileMenuClose();
      return;
    }

    if (prefersReducedMotionMenu()) {
      finalizeMobileMenuClose();
      return;
    }

    mobileMenu.classList.add('mobile-menu--closing');
    mobileMenuCloseTimer = setTimeout(() => {
      mobileMenuCloseTimer = null;
      finalizeMobileMenuClose();
    }, MENU_CLOSE_TOTAL_MS);
  }

  function onMobileMenuLayoutResize() {
    if (getMobileMenu()?.classList.contains('is-open')) {
      syncMobileMenuChromeOffset();
    }
  }

  function toggleMobileMenu() {
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;
    if (mobileMenu.classList.contains('mobile-menu--closing')) {
      if (mobileMenuCloseTimer) {
        clearTimeout(mobileMenuCloseTimer);
        mobileMenuCloseTimer = null;
      }
      mobileMenu.classList.remove('mobile-menu--closing');
      return;
    }
    if (mobileMenu.classList.contains('is-open')) {
      setMobileMenuOpen(false);
    } else {
      setMobileMenuOpen(true);
    }
  }

  /**
   * Handler principal: `pointerup` se dispara de forma fiable en
   * TODOS los dispositivos (touch + mouse) y NO requiere dos toques
   * en iOS Safari como `click` puede requerir con elementos con
   * :hover CSS o post-animación.
   */
  function onMobileMenuPointerUp(e: PointerEvent) {
    const target = e.target as Element | null;
    if (!target) return;

    if (target.closest('[data-menu-toggle]')) {
      e.preventDefault();
      toggleMobileMenu();
      return;
    }
    if (target.closest('[data-mobile-menu-dismiss]')) {
      setMobileMenuOpen(false);
      return;
    }
  }

  /**
   * `click` se mantiene para:
   * - Accesibilidad (teclado/screen reader)
   * - Enlaces de navegación del menú (.mobile-link)
   */
  function onMobileMenuClick(e: MouseEvent) {
    const target = e.target as Element | null;
    if (!target) return;

    if (target.closest('[data-mobile-link]')) {
      setMobileMenuOpen(false);
    }
  }

  document.addEventListener('pointerup', onMobileMenuPointerUp);
  document.addEventListener('click', onMobileMenuClick);

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (target?.closest('a.header-logo')) {
      try { sessionStorage.setItem('ph-logo-reveal-request', '1'); } catch {}
    }
  });

  document.addEventListener('astro:page-load', () => finalizeMobileMenuClose());

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    setMobileMenuOpen(false);
    if (isLangMenuOpen()) {
      setLangMenuOpen(false);
      getLangTrigger()?.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) setMobileMenuOpen(false);
    else onMobileMenuLayoutResize();
  });

  window.visualViewport?.addEventListener('resize', onMobileMenuLayoutResize);
  window.addEventListener('orientationchange', onMobileMenuLayoutResize);
</script>
