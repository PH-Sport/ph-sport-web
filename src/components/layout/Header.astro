---
import {
  useTranslations,
  getLangFromUrl,
  getLangSwitchUrl,
  getHomePath,
  supportedLangs,
  LANG_NAMES,
  LANG_FLAGS,
} from '@/i18n/utils';
import { NAV_ITEMS } from '@/lib/navigation';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const langOptions = supportedLangs.map((code) => ({
  code,
  name: LANG_NAMES[code],
  flag: LANG_FLAGS[code],
  href: getLangSwitchUrl(Astro.url.pathname, code),
  current: code === lang,
}));
const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');

const nav = NAV_ITEMS.map((item) => ({
  href: item.href[lang],
  label: t(item.labelKey),
}));

const isActive = (href: string): boolean => {
  const normalizedHref = href === '/' ? '/' : href.replace(/\/$/, '');
  return normalizedHref === currentPath;
};
---

<header data-header transition:persist>
  <div class="header-shell">
    <div class="header-inner">
      <a href={getHomePath(lang)} class="header-logo" aria-label={t('a11y.logo')}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 259.8 206.1" fill="currentColor" aria-hidden="true">
          <polygon points="0 206.1 58.2 206.1 57.9 145.5 158.1 45.4 112.7 0 0 0 0 52.6 76.9 52.6 0 128.7" />
          <polygon points="122.6 206.1 200.1 206.1 152.2 157.8 173 137.1 182.4 146.4 259.8 146.4 169.6 55.6 130.5 94.2 131.8 95.6 141.1 105.4 120.3 125.8 109.8 115.4 70.8 153.9" />
        </svg>
      </a>

      <nav class="header-nav hidden md:block" aria-label={t('nav.aria.main')}>
        <div class="header-nav-list-wrap">
          <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
          <ul class="header-nav-list">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-astro-prefetch="load"
                  class:list={['nav-link', isActive(item.href) && 'is-active']}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li class="lang-menu" data-lang-menu>
              {/* Desplegable de idioma: el botón muestra el idioma actual y abre los
                  tres. Es un botón que despliega enlaces normales (patrón
                  "disclosure"), no un role="menu": cada opción es navegación. */}
              <button
                type="button"
                class="lang-switch"
                data-lang-trigger
                aria-expanded="false"
                aria-controls="lang-panel"
                aria-label={`${t('nav.lang.menu')}: ${LANG_NAMES[lang]}`}
              >
                <img
                  src={LANG_FLAGS[lang]}
                  alt=""
                  width="20"
                  height="15"
                  class="lang-flag"
                  data-lang-current-flag
                />
                <span class="lang-label" data-lang-current-label>{lang.toUpperCase()}</span>
                <svg class="lang-chevron" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <ul id="lang-panel" class="lang-panel" data-lang-panel>
                {langOptions.map((option) => (
                  <li>
                    {/* hreflang = idioma del destino, no el de esta página: declara la
                        frontera entre versiones a buscadores y lectores de pantalla. */}
                    <a
                      href={option.href}
                      hreflang={option.code}
                      lang={option.code}
                      class="lang-option"
                      data-lang-option={option.code}
                      aria-current={option.current ? 'true' : undefined}
                    >
                      <img src={option.flag} alt="" width="20" height="15" class="lang-flag" />
                      <span>{option.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          </ul>
        </div>
      </nav>

      <button
        type="button"
        class="menu-toggle menu-toggle--hamburger md:hidden"
        data-menu-toggle
        data-label-open={t('a11y.menu.open')}
        data-label-close={t('a11y.menu.close')}
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('a11y.menu.open')}
      >
        <span class="menu-toggle__inner" aria-hidden="true">
          <span class="menu-toggle__bar"></span>
          <span class="menu-toggle__bar"></span>
          <span class="menu-toggle__bar"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Overlay fuera de [data-header]: evita que backdrop-filter del header ancle position:fixed al rectángulo de la barra. -->
<div id="mobile-menu" class="mobile-menu" data-mobile-menu aria-hidden="true">
  <div
    class="mobile-menu-backdrop"
    data-mobile-menu-dismiss
    aria-hidden="true"
  ></div>
  <div class="mobile-menu-inner">
    <nav aria-label={t('nav.aria.mobile')}>
      <ul class="mobile-nav-list">
        {nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              data-mobile-link
              data-astro-prefetch="load"
              class:list={[
                'mobile-link',
                isActive(item.href) && 'mobile-link--active',
              ]}
            >
              <span class="mobile-link-num">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ph-divider"></div>

    {/* En móvil no hay desplegable dentro del menú: el menú ya es el panel que se
        abre, así que los tres idiomas van en lista, con el actual marcado. */}
    <ul class="lang-list--mobile" aria-label={t('nav.lang.menu')}>
      {langOptions.map((option) => (
        <li>
          <a
            href={option.href}
            hreflang={option.code}
            lang={option.code}
            data-mobile-link
            data-lang-option={option.code}
            aria-current={option.current ? 'true' : undefined}
            class="lang-switch lang-switch--mobile"
          >
            <img src={option.flag} alt="" width="24" height="18" class="lang-flag" />
            <span class="lang-label">{option.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* ── Cápsula flotante (glass / sólido / hide-on-scroll en BaseLayout global) ── */
  /* Margen exterior y relleno interior a medias (½ del margen de sección cada uno):
     así el logo y la última opción del menú caen en la misma vertical que los
     textos de las páginas (que van a 1 margen del borde), y la cápsula sobresale
     un poco a cada lado. Antes eran un margen completo cada uno y el logo quedaba
     el doble de metido que el texto. */
  .header-shell {
    width: calc(100% - var(--ph-section-px));
    margin-inline: auto;
    /* Con `viewport-fit=cover` el `top: 0` del header queda debajo de la barra de
       estado: se le suma la zona segura para que la cápsula siga cayendo por debajo.
       Sin notch —escritorio, vertical sin isla— el inset es 0 y queda igual que antes. */
    margin-top: calc(0.875rem + env(safe-area-inset-top));
    border-radius: var(--radius-md);
    /* Nombre propio de View Transition: saca la cápsula del snapshot `root` para
       que no se funda (sale/entra) en cada navegación SPA. Ver bloque is:global. */
    view-transition-name: ph-header;
    transition:
      transform var(--ph-duration) var(--ease-ph),
      background-color var(--ph-duration) var(--ease-ph),
      border-color var(--ph-duration) var(--ease-ph),
      backdrop-filter var(--ph-duration) var(--ease-ph),
      -webkit-backdrop-filter var(--ph-duration) var(--ease-ph),
      box-shadow var(--ph-duration) var(--ease-ph);
  }

  @media (max-width: 767px) {
    .header-shell {
      margin-top: calc(0.5rem + env(safe-area-inset-top));
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: calc(var(--ph-section-px) / 2);
    padding-block: 1.25rem;
  }

  @media (max-width: 767px) {
    .header-inner {
      padding-block: 0.625rem;
    }
  }

  /* ── Logo ── */
  .header-logo {
    color: var(--color-ph-gold);
    transition: color var(--ph-duration) var(--ease-ph);
  }

  .header-logo svg {
    height: 1.75rem;
    width: auto;
  }

  @media (max-width: 767px) {
    .header-logo svg {
      height: 1.5rem;
    }
  }

  .header-logo:hover {
    color: var(--color-ph-gold-muted);
  }

  /* ── Desktop nav ── */
  .header-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .header-nav {
      display: block;
    }
  }

  .header-nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-ph-white-60);
    position: relative;
    padding-block: 0.25rem;
    transition: color var(--ph-duration) var(--ease-ph);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-ph-white);
  }

  .header-nav-list-wrap {
    position: relative;
  }

  .nav-indicator {
    position: absolute;
    bottom: -0.375rem;
    left: 0;
    /* Ancho base fijo de referencia: el posicionamiento real se hace con
       transform (translateX + scaleX) en JS → corre en compositor/GPU, ajeno al
       hilo principal, evitando el microcorte que daba animar left/width. */
    width: 100px;
    height: 1.5px;
    background: var(--color-ph-gold);
    border-radius: 1px;
    pointer-events: none;
    transform-origin: left center;
    transform: scaleX(0);
    /* Nombre propio de View Transition: el navegador morfea su geometría de la
       página vieja a la nueva → ESE morph es el deslizamiento, por encima del
       telón. La geometría nueva se fija en astro:after-swap, antes del snapshot. */
    view-transition-name: ph-nav-indicator;
  }

  .nav-indicator.is-animated {
    transition: transform 0.4s cubic-bezier(0.34, 1.2, 0.64, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-indicator.is-animated {
      transition: none;
    }
  }

  /* ── Language switch ── */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.625rem;
    border: 1px solid var(--color-ph-white-10);
    border-radius: var(--radius-sm);
    background-color: transparent;
    cursor: pointer;
    transition:
      border-color var(--ph-duration) var(--ease-ph),
      background-color var(--ph-duration) var(--ease-ph);
  }

  .lang-switch:hover,
  .lang-switch[aria-expanded='true'] {
    border-color: var(--color-ph-white-20);
    background-color: var(--color-ph-white-10);
  }

  /* ── Desplegable de idioma (escritorio) ──
     El estado lo lleva `aria-expanded` del botón: el CSS abre el panel a partir
     de él, así no hay dos fuentes de verdad. Misma animación que el desplegable
     de src/scripts/dropdown.ts (entra 220 ms, sale 160 ms), en CSS para no
     cargar GSAP en todas las páginas por la cabecera. */
  .lang-menu {
    position: relative;
  }

  .lang-chevron {
    display: block;
    color: var(--color-ph-white-60);
    transition: transform var(--ph-duration) var(--ease-ph);
  }

  .lang-switch[aria-expanded='true'] .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-panel {
    position: absolute;
    top: calc(100% + 0.625rem);
    right: 0;
    z-index: 1;
    min-width: 10rem;
    padding: 0.375rem;
    list-style: none;
    background-color: rgba(13, 15, 18, 0.94);
    border: 1px solid var(--ph-glass-border);
    border-radius: var(--radius-sm);
    backdrop-filter: var(--ph-glass-backdrop);
    -webkit-backdrop-filter: var(--ph-glass-backdrop);
    box-shadow: var(--ph-glass-highlight), 0 16px 40px rgba(0, 0, 0, 0.45);
    transform-origin: top right;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    pointer-events: none;
    transition:
      opacity 0.16s ease-in,
      transform 0.16s ease-in,
      visibility 0s linear 0.16s;
  }

  .lang-switch[aria-expanded='true'] + .lang-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition:
      opacity 0.22s ease-out,
      transform 0.22s ease-out,
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-panel,
    .lang-switch[aria-expanded='true'] + .lang-panel,
    .lang-chevron {
      transition: none;
    }
  }

  /* Al navegar se cierra en seco. La View Transition fotografía la cabecera antes
     del cambio de página y mantiene esa foto toda la transición: con el panel a
     medio fundir, se vería encima ~0,4 s. Lo comprueba el smoke. */
  .lang-menu.is-closing-instantly .lang-switch,
  .lang-menu.is-closing-instantly .lang-panel,
  .lang-menu.is-closing-instantly .lang-chevron {
    transition: none;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: calc(var(--radius-sm) - 2px);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-ph-white-60);
    transition:
      color var(--ph-duration) var(--ease-ph),
      background-color var(--ph-duration) var(--ease-ph);
  }

  .lang-option:hover,
  .lang-option:focus-visible {
    color: var(--color-ph-white);
    background-color: var(--color-ph-white-10);
  }

  /* El idioma en que se está leyendo: texto pleno y el punto dorado del indicador
     de la navegación. */
  .lang-option[aria-current='true'] {
    color: var(--color-ph-white);
  }

  .lang-option[aria-current='true']::after {
    content: '';
    width: 0.3125rem;
    height: 0.3125rem;
    margin-left: auto;
    border-radius: 50%;
    background: var(--color-ph-gold);
  }

  .lang-flag {
    display: block;
    height: 0.875rem;
    width: auto;
    border-radius: 1px;
  }

  .lang-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-ph-white-60);
  }

  .lang-list--mobile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: fit-content;
    list-style: none;
  }

  .lang-switch--mobile {
    width: 100%;
    padding: 0.5rem 0.875rem;
  }

  .lang-switch--mobile[aria-current='true'] {
    border-color: var(--color-ph-white-20);
  }

  .lang-switch--mobile[aria-current='true'] .lang-label {
    color: var(--color-ph-white);
  }

  .lang-switch--mobile .lang-flag {
    height: 1.125rem;
  }

  .lang-switch--mobile .lang-label {
    font-size: 0.875rem;
  }

  /* ── Mobile toggle: hamburguesa asimétrica → X (sin caja en móvil) ── */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-ph-white-10);
    border-radius: var(--radius-sm);
    color: var(--color-ph-white);
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color var(--ph-duration) var(--ease-ph),
      color var(--ph-duration) var(--ease-ph),
      background-color var(--ph-duration) var(--ease-ph);
  }

  @media (max-width: 767px) {
    .menu-toggle--hamburger {
      width: auto;
      height: auto;
      min-width: 2.75rem;
      min-height: 2.75rem;
      padding: 0.5rem;
      border: none;
      border-radius: 0;
      background: transparent;
    }

    .menu-toggle--hamburger:hover,
    .menu-toggle--hamburger:active {
      background: transparent;
    }

    .menu-toggle--hamburger:focus {
      outline: none;
    }

    .menu-toggle--hamburger:focus-visible {
      outline: 2px solid var(--color-ph-gold-muted);
      outline-offset: 4px;
      border-radius: var(--radius-sm);
    }
  }

  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }
  }

  @media (hover: hover) and (min-width: 768px) {
    .menu-toggle:hover {
      border-color: var(--color-ph-gold);
      color: var(--color-ph-gold);
      background-color: rgba(214, 178, 94, 0.05);
    }
  }

  @media (hover: hover) {
    .menu-toggle--hamburger:hover {
      color: var(--color-ph-gold);
    }
  }

  .menu-toggle:active {
    border-color: var(--color-ph-gold-muted);
    color: var(--color-ph-gold-muted);
    background-color: rgba(214, 178, 94, 0.08);
    transition-duration: 120ms;
  }

  @media (max-width: 767px) {
    .menu-toggle--hamburger:active {
      color: var(--color-ph-gold-muted);
      background: transparent;
    }
  }

  .menu-toggle__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 1.375rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  .menu-toggle__bar {
    display: block;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    align-self: flex-start;
    transform-origin: center;
    transition:
      transform 0.32s var(--ease-ph),
      opacity 0.22s var(--ease-ph),
      width 0.22s var(--ease-ph);
  }

  .menu-toggle__bar:nth-child(1) {
    width: 100%;
  }

  /* Barra central: sobresale a la izquierda y un poco más larga hacia la derecha que antes */
  .menu-toggle__bar:nth-child(2) {
    width: 78%;
    margin-left: -0.1875rem;
  }

  .menu-toggle__bar:nth-child(3) {
    width: 85%;
  }

  .menu-toggle--hamburger[aria-expanded='true'] .menu-toggle__bar:nth-child(1) {
    width: 100%;
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle--hamburger[aria-expanded='true'] .menu-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle--hamburger[aria-expanded='true'] .menu-toggle__bar:nth-child(3) {
    width: 100%;
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle__bar {
      transition: none;
    }
  }

  /* ── Mobile menu: base opaca + glass; overlay con opacity (visibility retardada al cerrar para permitir transición) ── */
  .mobile-menu {
    --menu-anim-duration: 420ms;
    --menu-nav-stagger-step: 0.04s;
    --menu-nav-li-duration: 0.38s;
    position: fixed;
    inset: 0;
    z-index: 100;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 32%),
      rgba(255, 255, 255, 0.03),
      var(--color-ph-black);
    backdrop-filter: var(--ph-glass-backdrop);
    -webkit-backdrop-filter: var(--ph-glass-backdrop);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 24px 80px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 280ms var(--ease-ph),
      visibility 0s linear 280ms;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .mobile-menu {
      background: var(--color-ph-black);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--menu-anim-duration) var(--ease-ph),
      visibility 0s linear 0s;
  }

  /* Capa detrás del contenido: recibe toques en el “vacío” (.mobile-menu-inner tiene pointer-events: none). */
  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: pointer;
  }

  .mobile-menu-inner {
    --menu-inner-duration: calc(var(--menu-anim-duration) + 40ms);
    position: relative;
    z-index: 1;
    pointer-events: none;
    max-width: none;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    margin-inline: auto;
    /* El overlay es `fixed`: no hereda las zonas seguras del body y las pide aparte.
       El hueco de arriba ya lo da `--mobile-menu-chrome-offset`, que se mide del
       header real y por tanto ya lleva el inset dentro. */
    padding-inline:
      calc(var(--ph-section-px) + env(safe-area-inset-left))
      calc(var(--ph-section-px) + env(safe-area-inset-right));
    /* padding-top explícito para poder interpolarlo al cerrar (evita el salto al quitar .is-open) */
    padding-top: 1.25rem;
    padding-bottom: calc(3rem + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 2rem;
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity var(--menu-inner-duration) var(--ease-ph),
      transform var(--menu-inner-duration) var(--ease-ph),
      padding-top var(--menu-inner-duration) var(--ease-ph);
  }

  .mobile-menu.is-open .mobile-menu-inner {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.04s;
    /* Contenido por debajo del header fijo (medido en JS → --mobile-menu-chrome-offset) */
    padding-top: calc(var(--mobile-menu-chrome-offset, 0px) + 0.75rem);
  }

  .mobile-menu-inner nav,
  .mobile-menu-inner .lang-list--mobile {
    pointer-events: auto;
  }

  /* Enlaces: entrada escalonada al abrir; cierre escalonado inverso con .mobile-menu--closing */
  .mobile-menu .mobile-nav-list li {
    opacity: 0;
    transform: translateX(-0.75rem);
    transition:
      opacity var(--menu-nav-li-duration) var(--ease-ph),
      transform var(--menu-nav-li-duration) var(--ease-ph);
  }

  .mobile-menu.is-open .mobile-nav-list li {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-menu.is-open .mobile-nav-list li:nth-child(1) {
    transition-delay: 0.1s;
  }
  .mobile-menu.is-open .mobile-nav-list li:nth-child(2) {
    transition-delay: 0.15s;
  }
  .mobile-menu.is-open .mobile-nav-list li:nth-child(3) {
    transition-delay: 0.2s;
  }
  .mobile-menu.is-open .mobile-nav-list li:nth-child(4) {
    transition-delay: 0.25s;
  }
  .mobile-menu.is-open .mobile-nav-list li:nth-child(5) {
    transition-delay: 0.3s;
  }

  @media (max-width: 767px) {
    .mobile-menu.is-open .mobile-nav-list li:nth-child(1) {
      transition-delay: 0.04s;
    }
    .mobile-menu.is-open .mobile-nav-list li:nth-child(2) {
      transition-delay: 0.08s;
    }
    .mobile-menu.is-open .mobile-nav-list li:nth-child(3) {
      transition-delay: 0.12s;
    }
    .mobile-menu.is-open .mobile-nav-list li:nth-child(4) {
      transition-delay: 0.16s;
    }
    .mobile-menu.is-open .mobile-nav-list li:nth-child(5) {
      transition-delay: 0.2s;
    }
  }

  /* Cierre inverso (5→1), mantiene .is-open hasta que JS quite ambas clases */
  .mobile-menu.is-open.mobile-menu--closing .mobile-nav-list li {
    opacity: 0;
    transform: translateX(-0.75rem);
    transition-duration: 0.2s;
  }

  .mobile-menu.is-open.mobile-menu--closing .mobile-nav-list li:nth-child(5) {
    transition-delay: 0s;
  }

  .mobile-menu.is-open.mobile-menu--closing .mobile-nav-list li:nth-child(4) {
    transition-delay: var(--menu-nav-stagger-step);
  }

  .mobile-menu.is-open.mobile-menu--closing .mobile-nav-list li:nth-child(3) {
    transition-delay: calc(2 * var(--menu-nav-stagger-step));
  }

  .mobile-menu.is-open.mobile-menu--closing .mobile-nav-list li:nth-child(2) {
    transition-delay: calc(3 * var(--menu-nav-stagger-step));
  }

  .mobile-menu.is-open.mobile-menu--closing .mobile-nav-list li:nth-child(1) {
    transition-delay: calc(4 * var(--menu-nav-stagger-step));
  }

  .mobile-menu.is-open.mobile-menu--closing .ph-divider {
    opacity: 0;
    transform: translateY(0.35rem);
    transition-delay: 0.14s;
    transition-duration: 0.2s;
  }

  .mobile-menu.is-open.mobile-menu--closing .lang-list--mobile {
    opacity: 0;
    transform: translateY(0.35rem);
    transition-delay: 0.18s;
    transition-duration: 0.2s;
  }

  .mobile-menu.mobile-menu--closing .mobile-menu-backdrop {
    pointer-events: none;
  }

  .mobile-menu.mobile-menu--closing .mobile-menu-inner nav,
  .mobile-menu.mobile-menu--closing .mobile-menu-inner .lang-list--mobile {
    pointer-events: none;
  }

  .mobile-menu .ph-divider {
    opacity: 0;
    transform: translateY(0.35rem);
    transition:
      opacity 0.35s var(--ease-ph),
      transform 0.35s var(--ease-ph);
  }

  .mobile-menu.is-open .ph-divider {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.34s;
  }

  .mobile-menu .lang-list--mobile {
    opacity: 0;
    transform: translateY(0.35rem);
    transition:
      opacity 0.38s var(--ease-ph),
      transform 0.38s var(--ease-ph);
  }

  .mobile-menu.is-open .lang-list--mobile {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.38s;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      --menu-anim-duration: 1ms;
      transition: none;
    }

    .mobile-menu.is-open {
      transition: none;
    }

    .mobile-menu-inner,
    .mobile-menu.is-open .mobile-menu-inner,
    .mobile-menu .mobile-nav-list li,
    .mobile-menu.is-open .mobile-nav-list li,
    .mobile-menu.is-open.mobile-menu--closing .mobile-nav-list li,
    .mobile-menu .ph-divider,
    .mobile-menu.is-open .ph-divider,
    .mobile-menu.is-open.mobile-menu--closing .ph-divider,
    .mobile-menu .lang-list--mobile,
    .mobile-menu.is-open .lang-list--mobile,
    .mobile-menu.is-open.mobile-menu--closing .lang-list--mobile {
      opacity: 1;
      transform: none;
      transition: none;
      transition-delay: 0s !important;
    }
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    list-style: none;
    padding-top: 0.25rem;
  }

  /* ── Mobile nav links ── */
  .mobile-link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ph-white-60);
    transition: color var(--ph-duration) var(--ease-ph);
  }

  .mobile-link:hover,
  .mobile-link--active {
    color: var(--color-ph-white);
  }

  .mobile-link:active {
    color: var(--color-ph-white);
    opacity: 0.88;
    transition-duration: 120ms;
  }

  .lang-switch--mobile:active {
    border-color: var(--color-ph-white-20);
    background-color: var(--color-ph-white-10);
    transition-duration: 120ms;
  }

  .mobile-link-num {
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--color-ph-gold);
    letter-spacing: 0;
    min-width: 1.5rem;
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }
</style>

<!-- View Transitions: estos pseudo-elementos cuelgan del documento (no del DOM
     scopeado del componente), por eso necesitan is:global. -->
<style is:global>
  /* Header: matamos su animación de VT para que la cápsula quede estable (no se
     funde) durante la navegación. Su contenido es idéntico entre páginas, así que
     no hay nada que animar; el indicador es un grupo aparte (ph-nav-indicator). */
  ::view-transition-group(ph-header),
  ::view-transition-old(ph-header),
  ::view-transition-new(ph-header) {
    animation: none;
  }

  /* Indicador: dejamos el morph por defecto (anima geometría vieja→nueva = el
     deslizamiento) y solo ajustamos duración/curva para igualar el feel previo
     de .nav-indicator.is-animated. */
  ::view-transition-group(ph-nav-indicator) {
    animation-duration: 0.4s;
    animation-timing-function: cubic-bezier(0.34, 1.2, 0.64, 1);
  }

  /* Sin movimiento: la barrita aparece directamente en su sitio, sin slide. */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(ph-nav-indicator),
    ::view-transition-old(ph-nav-indicator),
    ::view-transition-new(ph-nav-indicator) {
      animation: none;
    }
  }
</style>

<script>
  // ── Nav indicator deslizante ──────────────────────────────────────────────
  const wrap = document.querySelector<HTMLElement>('.header-nav-list-wrap');
  const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
  const desktopLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.header-nav .nav-link'),
  );

  let indicatorReady = false;

  // Ancho base del indicador (coincide con .nav-indicator { width }). El
  // posicionamiento se hace con transform sobre esa base: translateX fija el
  // borde izquierdo y scaleX el ancho (transform-origin: left) → compositor/GPU.
  const INDICATOR_BASE_WIDTH = 100;

  function setIndicatorToLink(link: HTMLElement) {
    if (!wrap || !indicator || !link) return;
    const wrapRect = wrap.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    const x = linkRect.left - wrapRect.left;
    const scaleX = linkRect.width / INDICATOR_BASE_WIDTH;
    indicator.style.transform = `translateX(${x}px) scaleX(${scaleX})`;
  }

  function hideIndicator() {
    if (indicator) indicator.style.transform = 'scaleX(0)';
  }

  // ── Rutas derivadas de la fuente central (src/lib/navigation.ts) ────────
  // La cabecera persiste entre navegaciones (`transition:persist`): su HTML es el
  // de la primera página que se cargó, así que todo lo que depende del idioma o
  // de la página se reescribe aquí en cada navegación.
  import { NAV_ITEMS } from '@/lib/navigation';
  import {
    useTranslations,
    getLangFromUrl,
    getLangSwitchUrl,
    getHomePath,
    LANG_NAMES,
    LANG_FLAGS,
    type Lang,
  } from '@/i18n/utils';

  function norm(p: string): string {
    return p === '/' ? '/' : p.replace(/\/+$/, '');
  }

  function syncHeaderToCurrentPage() {
    const pathname = window.location.pathname;
    const lang = getLangFromUrl(new URL(window.location.href));
    const t = useTranslations(lang);
    const currentPath = norm(pathname);
    const navHrefs = NAV_ITEMS.map((i) => i.href[lang]);
    const navLabels = NAV_ITEMS.map((i) => t(i.labelKey));

    // Actualizar hrefs, labels e is-active de los enlaces de escritorio
    desktopLinks.forEach((link, i) => {
      const href = navHrefs[i] ?? link.href;
      link.href = href;
      link.textContent = navLabels[i] ?? link.textContent;
      link.classList.toggle('is-active', norm(href) === currentPath);
    });

    // Actualizar hrefs, labels e is-active del menú móvil
    document
      .querySelectorAll<HTMLAnchorElement>('.mobile-nav-list .mobile-link')
      .forEach((link, i) => {
        const href = navHrefs[i];
        const label = navLabels[i];
        if (href) link.href = href;
        link.classList.toggle('mobile-link--active', norm(href ?? '') === currentPath);
        // Preservar el span numerador y actualizar solo el texto del label
        if (label) {
          const numSpan = link.querySelector('.mobile-link-num');
          link.textContent = label;
          if (numSpan) link.prepend(numSpan);
        }
      });

    // Logo
    const logo = document.querySelector<HTMLAnchorElement>('a.header-logo');
    if (logo) logo.href = getHomePath(lang);

    // Selector de idioma: el botón muestra el idioma actual…
    setLangMenuOpen(false);
    const trigger = getLangTrigger();
    if (trigger) {
      trigger.setAttribute('aria-label', `${t('nav.lang.menu')}: ${LANG_NAMES[lang]}`);
      const flag = trigger.querySelector<HTMLImageElement>('[data-lang-current-flag]');
      if (flag) flag.src = LANG_FLAGS[lang];
      const label = trigger.querySelector<HTMLElement>('[data-lang-current-label]');
      if (label) label.textContent = lang.toUpperCase();
    }

    // …y cada opción lleva a esta misma página en su idioma (o a la home de ese
    // idioma si la página no existe en él).
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-option]').forEach((option) => {
      const code = option.dataset.langOption as Lang;
      option.setAttribute('href', getLangSwitchUrl(pathname, code));
      if (code === lang) option.setAttribute('aria-current', 'true');
      else option.removeAttribute('aria-current');
    });
  }

  if (wrap && indicator && desktopLinks.length > 0) {
    document.addEventListener('astro:page-load', () => {
      syncHeaderToCurrentPage();
      const activeLink = desktopLinks.find((link) =>
        link.classList.contains('is-active'),
      );

      if (!indicatorReady) {
        // Primera carga: posicionar sin animación, luego activarla
        if (activeLink) setIndicatorToLink(activeLink);
        requestAnimationFrame(() => {
          indicator.classList.add('is-animated');
          indicatorReady = true;
        });
      } else {
        // Navegaciones posteriores: el header persiste, la barra ya está en la
        // posición anterior → animamos hasta el nuevo enlace activo
        if (activeLink) {
          setIndicatorToLink(activeLink);
        } else {
          hideIndicator();
        }
      }
    });

    // Navegación SPA: corre ANTES de que la View Transition capture el snapshot
    // nuevo, así la geometría nueva del indicador entra en ese snapshot y el
    // navegador la morfea desde la vieja → ese morph ES el deslizamiento. En la
    // carga inicial este evento no se dispara; de eso se encarga astro:page-load.
    document.addEventListener('astro:after-swap', () => {
      syncHeaderToCurrentPage();
      const activeLink = desktopLinks.find((link) =>
        link.classList.contains('is-active'),
      );
      if (activeLink) {
        setIndicatorToLink(activeLink);
      } else {
        hideIndicator();
      }
    });

    // Sólo cuando cambia el ancho: en móvil, un resize de sólo altura es la barra
    // del navegador entrando y saliendo durante el scroll, y la posición del
    // indicador —horizontal, dentro del header— no depende de la altura. Mismo
    // criterio que el `ignoreMobileResize` de ScrollTrigger.
    let lastViewportWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastViewportWidth) return;
      lastViewportWidth = window.innerWidth;
      const activeLink = desktopLinks.find((link) =>
        link.classList.contains('is-active'),
      );
      if (activeLink) setIndicatorToLink(activeLink);
    });
  }

  // ── Desplegable de idioma (escritorio) ───────────────────────────────────
  // El estado vive en `aria-expanded` del botón y el CSS abre el panel a partir
  // de él. El botón está en la cabecera persistente: se reconsulta cada vez en
  // lugar de cachear el nodo, igual que el menú móvil.
  function getLangTrigger() {
    return document.querySelector<HTMLButtonElement>('[data-header] [data-lang-trigger]');
  }

  function isLangMenuOpen(): boolean {
    return getLangTrigger()?.getAttribute('aria-expanded') === 'true';
  }

  function setLangMenuOpen(open: boolean) {
    getLangTrigger()?.setAttribute('aria-expanded', String(open));
  }

  /**
   * Mismo esquema que src/scripts/dropdown.ts: abre en `pointerup`, que iOS
   * Safari despacha de forma fiable al primer toque incluso cuando ignora el
   * `click` (iPad usa esta cabecera de escritorio). `click` queda para teclado y
   * lectores de pantalla, y se descarta si el puntero ya lo gestionó.
   */
  let langToggledByPointer = false;

  document.addEventListener('pointerup', (e) => {
    const target = e.target as Element | null;
    if (!target?.closest('[data-lang-trigger]')) return;
    e.preventDefault();
    setLangMenuOpen(!isLangMenuOpen());
    langToggledByPointer = true;
    requestAnimationFrame(() => {
      langToggledByPointer = false;
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target?.closest('[data-lang-trigger]') || langToggledByPointer) return;
    setLangMenuOpen(!isLangMenuOpen());
  });

  // Se cierra al tocar fuera, al sacar el foco con el tabulador y al hacer
  // scroll (la cápsula se esconde al bajar y se llevaría el panel abierto).
  document.addEventListener('pointerdown', (e) => {
    if (!isLangMenuOpen()) return;
    const target = e.target as Element | null;
    if (target?.closest('[data-lang-menu]')) return;
    setLangMenuOpen(false);
  });

  document.addEventListener('focusout', (e) => {
    if (!isLangMenuOpen()) return;
    const menu = (e.target as Element | null)?.closest('[data-lang-menu]');
    if (menu && !menu.contains(e.relatedTarget as Node | null)) setLangMenuOpen(false);
  });

  document.addEventListener(
    'scroll',
    () => {
      if (isLangMenuOpen()) setLangMenuOpen(false);
    },
    { passive: true },
  );

  // Al empezar cualquier navegación (una opción del panel, atrás, otro enlace),
  // cerrarlo sin animación antes de que la View Transition fotografíe la
  // cabecera. Ver `.is-closing-instantly` en el CSS.
  document.addEventListener('astro:before-preparation', () => {
    if (!isLangMenuOpen()) return;
    const menu = document.querySelector<HTMLElement>('[data-header] [data-lang-menu]');
    menu?.classList.add('is-closing-instantly');
    setLangMenuOpen(false);
  });

  document.addEventListener('astro:page-load', () => {
    document
      .querySelector<HTMLElement>('[data-header] [data-lang-menu]')
      ?.classList.remove('is-closing-instantly');
  });

  // ── Menú móvil ───────────────────────────────────────────────────────────
  // El overlay [data-mobile-menu] está fuera del <header transition:persist> y se
  // reemplaza en cada navegación: no cachear el nodo; siempre reconsultar el DOM.
  function getMobileMenu() {
    return document.querySelector<HTMLElement>('[data-mobile-menu]');
  }

  function syncMobileMenuChromeOffset() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;
    const bottom = header.getBoundingClientRect().bottom;
    const clamped = Math.max(48, Math.min(bottom, 220));
    document.documentElement.style.setProperty(
      '--mobile-menu-chrome-offset',
      `${Math.round(clamped * 10) / 10}px`,
    );
  }

  function updateMenuToggleA11y(open: boolean) {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!toggle) return;
    const openLbl = toggle.getAttribute('data-label-open');
    const closeLbl = toggle.getAttribute('data-label-close');
    if (openLbl && closeLbl) {
      toggle.setAttribute('aria-label', open ? closeLbl : openLbl);
    }
  }

  /** (n-1)*40ms + 200ms por ítem; divider/lang hasta ~380ms + margen */
  const MENU_CLOSE_TOTAL_MS = 420;

  let mobileMenuCloseTimer: ReturnType<typeof setTimeout> | null = null;

  function prefersReducedMotionMenu(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function finalizeMobileMenuClose() {
    if (mobileMenuCloseTimer) {
      clearTimeout(mobileMenuCloseTimer);
      mobileMenuCloseTimer = null;
    }
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;
    mobileMenu.classList.remove('is-open', 'mobile-menu--closing');
    mobileMenu.setAttribute('aria-hidden', 'true');
    document.querySelectorAll<HTMLElement>('[data-menu-toggle]').forEach((toggle) => {
      toggle.setAttribute('aria-expanded', 'false');
    });
    updateMenuToggleA11y(false);
    document.documentElement.style.removeProperty('--mobile-menu-chrome-offset');
    document.body.style.overflow = '';
  }

  function setMobileMenuOpen(open: boolean) {
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;

    if (open) {
      if (mobileMenuCloseTimer) {
        clearTimeout(mobileMenuCloseTimer);
        mobileMenuCloseTimer = null;
      }
      mobileMenu.classList.remove('mobile-menu--closing');
      syncMobileMenuChromeOffset();
      requestAnimationFrame(() => syncMobileMenuChromeOffset());
      mobileMenu.classList.add('is-open');
      mobileMenu.setAttribute('aria-hidden', 'false');
      document.querySelectorAll<HTMLElement>('[data-menu-toggle]').forEach((toggle) => {
        toggle.setAttribute('aria-expanded', 'true');
      });
      updateMenuToggleA11y(true);
      document.body.style.overflow = 'hidden';
      return;
    }

    if (!mobileMenu.classList.contains('is-open')) return;

    if (mobileMenu.classList.contains('mobile-menu--closing')) {
      finalizeMobileMenuClose();
      return;
    }

    if (prefersReducedMotionMenu()) {
      finalizeMobileMenuClose();
      return;
    }

    mobileMenu.classList.add('mobile-menu--closing');
    mobileMenuCloseTimer = setTimeout(() => {
      mobileMenuCloseTimer = null;
      finalizeMobileMenuClose();
    }, MENU_CLOSE_TOTAL_MS);
  }

  function onMobileMenuLayoutResize() {
    if (getMobileMenu()?.classList.contains('is-open')) {
      syncMobileMenuChromeOffset();
    }
  }

  function toggleMobileMenu() {
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;
    if (mobileMenu.classList.contains('mobile-menu--closing')) {
      if (mobileMenuCloseTimer) {
        clearTimeout(mobileMenuCloseTimer);
        mobileMenuCloseTimer = null;
      }
      mobileMenu.classList.remove('mobile-menu--closing');
      return;
    }
    if (mobileMenu.classList.contains('is-open')) {
      setMobileMenuOpen(false);
    } else {
      setMobileMenuOpen(true);
    }
  }

  /**
   * Handler principal: `pointerup` se dispara de forma fiable en
   * TODOS los dispositivos (touch + mouse) y NO requiere dos toques
   * en iOS Safari como `click` puede requerir con elementos con
   * :hover CSS o post-animación.
   */
  function onMobileMenuPointerUp(e: PointerEvent) {
    const target = e.target as Element | null;
    if (!target) return;

    if (target.closest('[data-menu-toggle]')) {
      e.preventDefault();
      toggleMobileMenu();
      return;
    }
    if (target.closest('[data-mobile-menu-dismiss]')) {
      setMobileMenuOpen(false);
      return;
    }
  }

  /**
   * `click` se mantiene para:
   * - Accesibilidad (teclado/screen reader)
   * - Enlaces de navegación del menú (.mobile-link)
   */
  function onMobileMenuClick(e: MouseEvent) {
    const target = e.target as Element | null;
    if (!target) return;

    if (target.closest('[data-mobile-link]')) {
      setMobileMenuOpen(false);
    }
  }

  document.addEventListener('pointerup', onMobileMenuPointerUp);
  document.addEventListener('click', onMobileMenuClick);

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (target?.closest('a.header-logo')) {
      try { sessionStorage.setItem('ph-logo-reveal-request', '1'); } catch {}
    }
  });

  document.addEventListener('astro:page-load', () => finalizeMobileMenuClose());

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    setMobileMenuOpen(false);
    if (isLangMenuOpen()) {
      setLangMenuOpen(false);
      getLangTrigger()?.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) setMobileMenuOpen(false);
    else onMobileMenuLayoutResize();
  });

  window.visualViewport?.addEventListener('resize', onMobileMenuLayoutResize);
  window.addEventListener('orientationchange', onMobileMenuLayoutResize);
</script>
