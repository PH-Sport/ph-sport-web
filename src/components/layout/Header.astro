---
import {
  useTranslations,
  getLangFromUrl,
  getLangSwitchUrl,
  getHomePath,
  localizePath,
  supportedLangs,
  LANG_NAMES,
  LANG_FLAGS,
} from '@/i18n/utils';
import { NAV_ITEMS } from '@/lib/navigation';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const langOptions = supportedLangs.map((code) => ({
  code,
  name: LANG_NAMES[code],
  flag: LANG_FLAGS[code],
  href: getLangSwitchUrl(Astro.url.pathname, code),
  current: code === lang,
}));
const norm = (p: string) => (p === '/' ? '/' : p.replace(/\/+$/, ''));
const currentPath = norm(Astro.url.pathname);

const nav = NAV_ITEMS.map((item) => ({
  href: item.href[lang],
  label: t(item.labelKey),
}));
const isActive = (href: string): boolean => norm(href) === currentPath;

/* La placa del marcador de esquina dice en qué página se está: la etiqueta del
   menú, o la del pie en los textos legales. Van todas apiladas en la misma celda
   (así la placa mide lo que la más larga y no cambia de ancho al navegar) y solo
   se ve la actual. */
const pageLabels = [
  ...nav.map((item) => ({ href: item.href, label: item.label })),
  { href: localizePath('/aviso-legal', lang), label: t('footer.legal.notice') },
  { href: localizePath('/privacidad', lang), label: t('footer.legal.privacy') },
];
---

<header data-header transition:persist>
  <div class="hdr">
    {/* Marcador de esquina: el logo y el nombre de la página, como el rótulo fijo
        de una retransmisión. */}
    <div class="hdr__bug">
      <a href={getHomePath(lang)} class="hdr__logo" aria-label={t('a11y.logo')}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 259.8 206.1" fill="currentColor" aria-hidden="true">
          <polygon points="0 206.1 58.2 206.1 57.9 145.5 158.1 45.4 112.7 0 0 0 0 52.6 76.9 52.6 0 128.7" />
          <polygon points="122.6 206.1 200.1 206.1 152.2 157.8 173 137.1 182.4 146.4 259.8 146.4 169.6 55.6 130.5 94.2 131.8 95.6 141.1 105.4 120.3 125.8 109.8 115.4 70.8 153.9" />
        </svg>
      </a>
      <span class="hdr__page" aria-hidden="true">
        <span class="hdr__page-tab"></span>
        <span class="hdr__page-stack">
          {pageLabels.map((item, i) => (
            <span class:list={['hdr__page-label', isActive(item.href) && 'is-current']} data-page-label={i}>{item.label}</span>
          ))}
        </span>
      </span>
    </div>

    <nav class="hdr__nav" aria-label={t('nav.aria.main')}>
      {/* La barra de canales: las cuatro páginas como celdas de una misma placa.
          La actual, en blanco y con la barra dorada debajo, que se desliza de una
          a otra al navegar. */}
      <div class="hdr__channels" data-channels>
        <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
        <ul class="hdr__list">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-astro-prefetch="load"
                class:list={['nav-link', isActive(item.href) && 'is-active']}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span class="nav-link__text">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Selector de idioma: un bug «ES ▾» que despliega los tres como placas
          apiladas. Es un botón que despliega enlaces normales (patrón
          "disclosure"), no un role="menu": cada opción es navegación. */}
      <div class="lang-menu" data-lang-menu>
        <button
          type="button"
          class="lang-switch"
          data-lang-trigger
          aria-expanded="false"
          aria-controls="lang-panel"
          aria-label={`${t('nav.lang.menu')}: ${LANG_NAMES[lang]}`}
        >
          <span class="lang-switch__code" data-lang-current-label>{lang.toUpperCase()}</span>
          <svg class="lang-chevron" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
            <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
          </svg>
        </button>
        <ul id="lang-panel" class="lang-panel" data-lang-panel>
          {langOptions.map((option, i) => (
            <li style={`--i: ${i}`}>
              {/* hreflang = idioma del destino, no el de esta página: declara la
                  frontera entre versiones a buscadores y lectores de pantalla. */}
              <a
                href={option.href}
                hreflang={option.code}
                lang={option.code}
                class="lang-option"
                data-lang-option={option.code}
                aria-current={option.current ? 'true' : undefined}
              >
                <img src={option.flag} alt="" width="20" height="15" class="lang-flag" />
                <span>{option.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <button
      type="button"
      class="menu-toggle"
      data-menu-toggle
      data-label-open={t('a11y.menu.open')}
      data-label-close={t('a11y.menu.close')}
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label={t('a11y.menu.open')}
    >
      <span class="menu-toggle__icon" aria-hidden="true">
        <span></span><span></span>
      </span>
    </button>
  </div>
</header>

{/* Menú móvil, fuera de [data-header]: se sustituye en cada navegación (la
    cabecera persiste). Al abrir, una banda dorada lo cruza en diagonal y las
    cuatro páginas entran como placas grandes, en cascada; abajo, los tres idiomas
    como una barra de tres segmentos. */}
<div id="mobile-menu" class="mobile-menu" data-mobile-menu aria-hidden="true" inert>
  <div class="mobile-menu-backdrop" data-mobile-menu-dismiss aria-hidden="true"></div>
  <span class="mobile-menu__band" aria-hidden="true"></span>
  <div class="mobile-menu-inner">
    <nav aria-label={t('nav.aria.mobile')}>
      <ul class="mobile-nav-list">
        {nav.map((item, i) => (
          <li style={`--d: ${130 + i * 60}ms`}>
            <a
              href={item.href}
              data-mobile-link
              data-astro-prefetch="load"
              class:list={['mobile-link', isActive(item.href) && 'mobile-link--active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="ph-plate ph-plate--display ph-plate--tab mobile-link__plate">
                <span class="ph-plate__tab" aria-hidden="true"></span>
                <span class="ph-plate__t"><span class="ph-plate__in mobile-link__label">{item.label}</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* En móvil no hay desplegable dentro del menú: el menú ya es el panel que se
        abre, así que los tres idiomas van en una barra, con el actual marcado. */}
    <ul class="lang-bar" aria-label={t('nav.lang.menu')}>
      {langOptions.map((option) => (
        <li>
          <a
            href={option.href}
            hreflang={option.code}
            lang={option.code}
            data-mobile-link
            data-lang-option={option.code}
            aria-current={option.current ? 'true' : undefined}
            class="lang-bar__seg"
          >
            <img src={option.flag} alt="" width="20" height="15" class="lang-flag" />
            <span class="lang-bar__name">{option.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* ── El marcador de esquina ──────────────────────────────────────────────
     Placas de 44 px: el logo, el nombre de la página y, en escritorio, la barra
     de canales y el idioma. La cabecera entera es transparente a los toques;
     solo las placas los reciben. */
  .hdr {
    --hh: 44px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: calc(14px + env(safe-area-inset-top)) var(--ph-section-px) 0;
    pointer-events: none;
    /* Nombre propio de View Transition: saca la cabecera de la foto `root` para
       que no se funda en cada navegación. Ver el bloque is:global. */
    view-transition-name: ph-header;
    transition: transform var(--ph-dur-wipe) var(--ph-ease-out);
  }
  .hdr > * { pointer-events: auto; }

  .hdr__bug {
    display: flex;
    align-items: stretch;
    height: var(--hh);
    min-width: 0;
  }

  .hdr__logo {
    position: relative;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 54px;
    height: var(--hh);
    color: var(--color-ph-gold);
    background: var(--ph-plate);
    box-shadow: inset 0 0 0 1px var(--ph-plate-edge);
    transition: color var(--ph-dur-state) var(--ph-ease-std), background-color var(--ph-dur-state) var(--ph-ease-std);
  }
  .hdr__logo svg { width: 26px; height: auto; display: block; }
  @media (hover: hover) and (pointer: fine) {
    .hdr__logo:hover { color: var(--color-ph-black); background: var(--color-ph-gold); }
  }
  .hdr__logo:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: 2px; }

  /* La placa con el nombre de la página: la pestaña dorada encima, que dice
     «en directo». */
  .hdr__page {
    --cut: var(--hh);
    position: relative;
    z-index: 0;
    display: flex;
    align-items: center;
    min-width: 0;
    height: var(--hh);
    margin-left: -1px;
    padding: 0 calc(var(--cut) * 0.72) 0 14px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1;
    color: var(--color-ph-white);
  }
  .hdr__page::before,
  .hdr__page::after {
    content: '';
    position: absolute;
    z-index: -1;
  }
  .hdr__page::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, 0 100%);
  }
  .hdr__page::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, calc(100% - 0.41px) 0, calc(100% - var(--cut) + 1.59px) 100%, 0 100%);
  }
  .hdr__page-tab {
    position: absolute;
    left: 0;
    bottom: 100%;
    width: 28px;
    height: 4px;
    background: var(--color-ph-gold);
  }
  /* Las etiquetas, apiladas en la misma celda: la placa mide lo que la más
     larga. Al navegar, la vieja sale hacia arriba y entra la nueva (script). */
  .hdr__page-stack {
    display: grid;
    overflow: hidden;
    padding-block: 0.2em;
  }
  .hdr__page-label {
    grid-area: 1 / 1;
    white-space: nowrap;
    visibility: hidden;
  }
  .hdr__page-label.is-current { visibility: visible; }

  /* En tableta la barra de canales ya dice dónde se está y no caben las dos: la
     placa de la página vuelve a partir de 1000 px. */
  @media (min-width: 768px) and (max-width: 999px) {
    .hdr__page { display: none; }
  }

  /* ── Barra de canales (escritorio) ─────────────────────────────────────── */
  .hdr__nav { display: none; }

  @media (min-width: 768px) {
    .hdr__nav {
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }
  }

  .hdr__channels {
    --cut: var(--hh);
    position: relative;
    z-index: 0;
    height: var(--hh);
    padding-right: calc(var(--cut) * 0.62);
  }
  .hdr__channels::before,
  .hdr__channels::after {
    content: '';
    position: absolute;
    z-index: -1;
  }
  .hdr__channels::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, 0 100%);
  }
  .hdr__channels::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, calc(100% - 0.41px) 0, calc(100% - var(--cut) + 1.59px) 100%, 0 100%);
  }

  .hdr__list {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hdr__list li { display: flex; }
  .hdr__list li + li { box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.1); }

  .nav-link {
    position: relative;
    z-index: 0;
    display: flex;
    align-items: center;
    padding: 0 clamp(12px, 1.4vw, 20px);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.005em;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.72);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }
  /* Al señalar una celda, una veladura blanca la barre de izquierda a derecha. */
  .nav-link::before {
    content: '';
    position: absolute;
    inset: 1px 0;
    z-index: -1;
    background: rgba(255, 255, 255, 0.08);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 140ms var(--ph-ease-in);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover { color: var(--color-ph-white); }
    .nav-link:hover::before {
      transform: scaleX(1);
      transition: transform var(--ph-dur-state) var(--ph-ease-out);
    }
  }
  .nav-link.is-active { color: var(--color-ph-white); }
  .nav-link:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: -3px; }

  /* La barra dorada de la celda activa. Se coloca con transform (translateX +
     scaleX sobre una base de 100 px) y su nombre de View Transition hace que el
     navegador la deslice de la página vieja a la nueva. */
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: 1px;
    z-index: 1;
    width: 100px;
    height: 3px;
    background: var(--color-ph-gold);
    pointer-events: none;
    transform-origin: left center;
    transform: scaleX(0);
    view-transition-name: ph-nav-indicator;
  }
  /* Misma curva de llegada que el resto, sin rebote. Escrita en literal porque
     el grupo de View Transition no hereda `var()`. */
  .nav-indicator.is-animated {
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── Idioma: el bug «ES ▾» y sus placas apiladas ─────────────────────────── */
  .lang-menu { position: relative; }

  .lang-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: var(--hh);
    padding: 0 14px;
    border: 0;
    color: var(--color-ph-white);
    background: var(--ph-plate);
    box-shadow: inset 0 0 0 1px var(--ph-plate-edge);
    cursor: pointer;
    transition: box-shadow var(--ph-dur-state) var(--ph-ease-std);
  }
  .lang-switch__code {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .lang-chevron {
    display: block;
    color: var(--color-ph-gold);
    transition: transform var(--ph-dur-state) var(--ph-ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .lang-switch:hover { box-shadow: inset 0 0 0 1px rgba(214, 178, 94, 0.7); }
  }
  .lang-switch[aria-expanded='true'] { box-shadow: inset 0 0 0 1px var(--color-ph-gold); }
  .lang-switch[aria-expanded='true'] .lang-chevron { transform: rotate(180deg); }
  .lang-switch:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: 2px; }

  /* El estado lo lleva `aria-expanded` del botón: el CSS abre el panel a partir
     de él, así no hay dos fuentes de verdad. */
  .lang-panel {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 140ms;
  }
  .lang-panel li {
    --d: calc(var(--i, 0) * 50ms);
    display: flex;
    justify-content: flex-end;
  }
  .lang-option {
    --cut: 42px;
    position: relative;
    z-index: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 168px;
    height: 42px;
    padding: 0 calc(var(--cut) * 0.7) 0 14px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.78);
    clip-path: polygon(0 0, 0 0, calc(0px - var(--cut)) 100%, 0 100%);
    transition: clip-path 140ms var(--ph-ease-in), color var(--ph-dur-state) var(--ph-ease-std);
  }
  .lang-option::before,
  .lang-option::after {
    content: '';
    position: absolute;
    z-index: -1;
  }
  .lang-option::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, 0 100%);
  }
  .lang-option::after {
    inset: 1px;
    background: #121418;
    clip-path: polygon(0 0, calc(100% - 0.41px) 0, calc(100% - var(--cut) + 1.59px) 100%, 0 100%);
    transition: background-color var(--ph-dur-state) var(--ph-ease-std);
  }
  .lang-switch[aria-expanded='true'] + .lang-panel {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s linear 0s;
  }
  .lang-switch[aria-expanded='true'] + .lang-panel .lang-option {
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, 0 100%);
    transition: clip-path var(--ph-dur-wipe) var(--ph-ease-out) var(--d), color var(--ph-dur-state) var(--ph-ease-std);
  }
  .lang-option:hover,
  .lang-option:focus-visible { color: var(--color-ph-white); }
  .lang-option:hover::after,
  .lang-option:focus-visible::after { background: #1c1f24; }
  .lang-option:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: -2px; }
  /* El idioma en que se está leyendo: texto pleno y la pestaña dorada. */
  .lang-option[aria-current='true'] { color: var(--color-ph-white); }
  .lang-option[aria-current='true']::after {
    background:
      linear-gradient(var(--color-ph-gold), var(--color-ph-gold)) 0 0 / 26px 4px no-repeat,
      #121418;
  }

  /* Al navegar se cierra en seco. La View Transition fotografía la cabecera antes
     del cambio de página y mantiene esa foto toda la transición: con el panel a
     medio cerrar, se vería encima. Lo comprueba el smoke. */
  .lang-menu.is-closing-instantly .lang-panel,
  .lang-menu.is-closing-instantly .lang-option,
  .lang-menu.is-closing-instantly .lang-chevron {
    transition: none;
  }

  .lang-flag {
    display: block;
    height: 13px;
    width: auto;
  }

  /* ── Botón del menú móvil: una placa cuadrada ──────────────────────────── */
  .menu-toggle {
    position: relative;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 48px;
    height: var(--hh);
    padding: 0;
    border: 0;
    color: var(--color-ph-white);
    background: var(--ph-plate);
    box-shadow: inset 0 0 0 1px var(--ph-plate-edge);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: box-shadow var(--ph-dur-state) var(--ph-ease-std);
  }
  .menu-toggle:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: 2px; }
  .menu-toggle[aria-expanded='true'] { box-shadow: inset 0 0 0 1px var(--color-ph-gold); }

  .menu-toggle__icon {
    position: relative;
    display: block;
    width: 20px;
    height: 12px;
  }
  .menu-toggle__icon span {
    position: absolute;
    left: 0;
    height: 2px;
    background: currentColor;
    transition: transform var(--ph-dur-state) var(--ph-ease-out), width var(--ph-dur-state) var(--ph-ease-out);
  }
  .menu-toggle__icon span:first-child { top: 0; width: 20px; }
  /* La de abajo, más corta y desplazada: un paso de escalera, como el rótulo. */
  .menu-toggle__icon span:last-child { bottom: 0; left: 6px; width: 14px; background: var(--color-ph-gold); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span:first-child { transform: translateY(5px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span:last-child { left: 0; width: 20px; transform: translateY(-5px) rotate(-45deg); }

  @media (min-width: 768px) {
    .menu-toggle { display: none; }
  }

  /* ── Menú móvil ─────────────────────────────────────────────────────────
     Al abrir: una banda dorada cruza la pantalla en diagonal (hacia arriba a la
     derecha) y descubre el panel detrás de ella; las cuatro páginas entran como
     placas grandes, en cascada de 60 ms; al final, la barra de idiomas. Al cerrar
     se va todo en 240 ms, más rápido de lo que llegó. El JS solo pone y quita
     clases (`is-open`, `mobile-menu--closing`). */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    isolation: isolate;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 240ms;
  }
  .mobile-menu.is-open {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s linear 0s;
  }

  /* El fondo del panel se descubre detrás de la banda: un recorte con el frente a
     45° que avanza desde la esquina de abajo a la izquierda. */
  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-ph-black);
    cursor: pointer;
    clip-path: polygon(-100vh 0, 0 100%, -100vh 100%, -100vh 0);
    transition: clip-path 200ms var(--ph-ease-in) 40ms;
  }
  /* El frente del recorte y la banda recorren lo mismo con la misma curva: la
     banda va montada en el borde (como en la intro de la portada). */
  .mobile-menu.is-open .mobile-menu-backdrop {
    clip-path: polygon(100vw 0, calc(100vw + 100vh) 100%, -100vh 100%, -100vh 0);
    transition: clip-path 360ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .mobile-menu__band {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 10px;
    height: 300vmax;
    margin: -150vmax 0 0 -5px;
    background: var(--color-ph-gold);
    pointer-events: none;
    opacity: 0;
    transform: rotate(-45deg) translateX(calc((100vw + 100vh) * -0.3536));
  }
  .mobile-menu.is-open .mobile-menu__band {
    animation: ph-menu-band 360ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  @keyframes ph-menu-band {
    0% { opacity: 1; transform: rotate(-45deg) translateX(calc((100vw + 100vh) * -0.3536)); }
    96% { opacity: 1; }
    100% { opacity: 0; transform: rotate(-45deg) translateX(calc((100vw + 100vh) * 0.3536)); }
  }

  .mobile-menu-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 100%;
    padding:
      calc(var(--mobile-menu-chrome-offset, 64px) + 28px)
      calc(var(--ph-section-px) + env(safe-area-inset-right))
      calc(24px + env(safe-area-inset-bottom))
      calc(var(--ph-section-px) + env(safe-area-inset-left));
    pointer-events: none;
  }
  .mobile-menu-inner nav,
  .mobile-menu-inner .lang-bar { pointer-events: auto; }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mobile-nav-list li { display: flex; }

  /* Cada página es una placa grande; la fila entera es el objetivo táctil. */
  .mobile-link {
    display: flex;
    width: 100%;
    padding-block: 2px;
    -webkit-tap-highlight-color: transparent;
  }
  .mobile-link__plate {
    font-size: clamp(36px, 10.6vw, 44px);
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }
  .mobile-link--active .mobile-link__plate { color: var(--color-ph-white); }
  .mobile-link:active .mobile-link__plate { color: var(--color-ph-gold); }
  .mobile-link:focus-visible { outline: none; }
  .mobile-link:focus-visible .mobile-link__plate { outline: 2px solid var(--color-ph-gold); outline-offset: 3px; }
  /* La pestaña dorada solo en la página actual. */
  .mobile-link:not(.mobile-link--active) .ph-plate__tab { display: none; }

  /* Cerrado, las placas están recogidas: entran al abrir con su `--d` (la
     cascada). Al cerrar no se recogen: la lista entera se apaga en 120 ms. */
  .mobile-menu:not(.is-open):not(.mobile-menu--closing) .ph-plate::before {
    clip-path: polygon(0 0, 0 0, 0 calc(100% - var(--cut)), calc(0px - var(--cut)) 100%, 0 100%);
    transition: none;
  }
  .mobile-menu:not(.is-open):not(.mobile-menu--closing) .ph-plate__t {
    clip-path: polygon(1px 1px, 1px 1px, 1px calc(100% - var(--cut) - 0.41px), calc(1.59px - var(--cut)) calc(100% - 1px), 1px calc(100% - 1px));
    transition: none;
  }
  .mobile-menu:not(.is-open):not(.mobile-menu--closing) .ph-plate__in { transform: translateY(calc(100% + 0.3em)); transition: none; }
  .mobile-menu:not(.is-open):not(.mobile-menu--closing) .ph-plate__tab { transform: scaleX(0); transition: none; }

  .mobile-nav-list,
  .lang-bar {
    transition: opacity 120ms var(--ph-ease-in);
  }
  .mobile-menu.mobile-menu--closing .mobile-nav-list,
  .mobile-menu.mobile-menu--closing .lang-bar {
    opacity: 0;
  }

  /* Los tres idiomas, como una barra de tres segmentos: el actual, en blanco con
     el texto en negro. */
  .lang-bar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    box-shadow: inset 0 0 0 1px var(--ph-plate-edge);
    opacity: 0;
    transform: translateY(8px);
  }
  .mobile-menu.is-open:not(.mobile-menu--closing) .lang-bar {
    opacity: 1;
    transform: none;
    transition: opacity 260ms var(--ph-ease-out) 340ms, transform 320ms var(--ph-ease-out) 340ms;
  }
  .lang-bar li { display: flex; min-width: 0; }
  .lang-bar li + li { box-shadow: inset 1px 0 0 var(--ph-plate-edge); }
  .lang-bar__seg {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 52px;
    padding: 0 6px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--ph-dur-state) var(--ph-ease-std), color var(--ph-dur-state) var(--ph-ease-std);
  }
  .lang-bar__name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lang-bar__seg[aria-current='true'] {
    color: var(--color-ph-black);
    background: var(--color-ph-white);
  }
  .lang-bar__seg:active { background: rgba(214, 178, 94, 0.2); }
  .lang-bar__seg:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: -2px; }

  @media (min-width: 768px) {
    .mobile-menu { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr,
    .nav-link,
    .nav-link::before,
    .nav-indicator.is-animated,
    .lang-chevron,
    .lang-option,
    .menu-toggle__icon span,
    .mobile-menu-backdrop,
    .mobile-menu.is-open .mobile-menu-backdrop,
    .lang-bar,
    .mobile-menu.is-open:not(.mobile-menu--closing) .lang-bar {
      transition: none;
    }
    /* Sin barridos: el menú aparece con un fundido corto. */
    .mobile-menu-backdrop,
    .mobile-menu.is-open .mobile-menu-backdrop { clip-path: none; }
    .mobile-menu.is-open .mobile-menu__band { animation: none; }
    .mobile-menu { opacity: 0; transition: opacity 150ms linear, visibility 0s linear 150ms; }
    .mobile-menu.is-open { opacity: 1; transition: opacity 150ms linear, visibility 0s linear 0s; }
    .mobile-menu .ph-plate::before,
    .mobile-menu .ph-plate__t,
    .mobile-menu .ph-plate__in,
    .mobile-menu .ph-plate__tab,
    .mobile-menu:not(.is-open) .ph-plate::before,
    .mobile-menu:not(.is-open) .ph-plate__t,
    .mobile-menu:not(.is-open) .ph-plate__in,
    .mobile-menu:not(.is-open) .ph-plate__tab {
      clip-path: none;
      transform: none;
      transition: none;
    }
    .lang-bar { opacity: 1; transform: none; }
    .lang-option,
    .lang-switch[aria-expanded='true'] + .lang-panel .lang-option { clip-path: none; transition: none; }
  }
</style>

<!-- View Transitions: estos pseudo-elementos cuelgan del documento (no del DOM
     scopeado del componente), por eso necesitan is:global. -->
<style is:global>
  /* Cabecera: sin animación de View Transition, para que el marcador quede
     estable durante la navegación. Lo que cambia dentro (la etiqueta que rueda)
     se ve en vivo en `::view-transition-new`. */
  ::view-transition-group(ph-header),
  ::view-transition-old(ph-header),
  ::view-transition-new(ph-header) {
    animation: none;
  }
  ::view-transition-old(ph-header) { display: none; }

  /* Indicador: el morph por defecto (geometría vieja → nueva) es el
     deslizamiento; solo se ajustan duración y curva, en literal. */
  ::view-transition-group(ph-nav-indicator) {
    animation-duration: 0.32s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(ph-nav-indicator),
    ::view-transition-old(ph-nav-indicator),
    ::view-transition-new(ph-nav-indicator) {
      animation: none;
    }
  }
</style>

<script>
  // El núcleo de movimiento (sin GSAP) se carga con la cabecera, que está en
  // todas las páginas: vigila lo que entra en pantalla y arranca la cortinilla
  // entre páginas (src/scripts/ph-motion.ts).
  import '@/scripts/ph-motion';
  import { NAV_ITEMS } from '@/lib/navigation';
  import {
    useTranslations,
    getLangFromUrl,
    getLangSwitchUrl,
    getHomePath,
    localizePath,
    LANG_NAMES,
    type Lang,
  } from '@/i18n/utils';

  const reduceMotion = (): boolean => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Barra dorada de la barra de canales ────────────────────────────────────
  const wrap = document.querySelector<HTMLElement>('[data-header] [data-channels]');
  const indicator = document.querySelector<HTMLElement>('[data-header] [data-nav-indicator]');
  const desktopLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-header] .nav-link'));
  let indicatorReady = false;

  // Ancho base del indicador (coincide con `.nav-indicator { width }`). Se coloca
  // con transform: translateX fija el borde izquierdo y scaleX el ancho.
  const INDICATOR_BASE_WIDTH = 100;

  function setIndicatorToLink(link: HTMLElement): void {
    if (!wrap || !indicator) return;
    const wrapRect = wrap.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    if (!wrapRect.width) return;
    indicator.style.transform = `translateX(${linkRect.left - wrapRect.left}px) scaleX(${linkRect.width / INDICATOR_BASE_WIDTH})`;
  }

  function placeIndicator(): void {
    const active = desktopLinks.find((l) => l.classList.contains('is-active'));
    if (active) setIndicatorToLink(active);
    else if (indicator) indicator.style.transform = 'scaleX(0)';
  }

  // ── Todo lo que depende de la página y del idioma ──────────────────────────
  // La cabecera persiste entre navegaciones (`transition:persist`): su HTML es el
  // de la primera página que se cargó, así que se reescribe aquí en cada
  // navegación.
  function norm(p: string): string {
    return p === '/' ? '/' : p.replace(/\/+$/, '');
  }

  let currentLabelIdx = -2;

  /** La etiqueta de la placa de la página: la vieja sale hacia arriba y entra la
   *  nueva, 200 ms. */
  function setPageLabel(idx: number): void {
    const labels = Array.from(document.querySelectorAll<HTMLElement>('[data-header] [data-page-label]'));
    const prev = labels[currentLabelIdx];
    const next = labels[idx];
    labels.forEach((l, i) => l.classList.toggle('is-current', i === idx));
    const animate = currentLabelIdx >= -1 && prev !== next && !reduceMotion();
    currentLabelIdx = idx;
    if (!animate) return;
    const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';
    prev?.animate(
      [{ transform: 'translateY(0)', visibility: 'visible' }, { transform: 'translateY(-115%)', visibility: 'visible' }],
      { duration: 160, easing: 'cubic-bezier(0.3, 0, 0.8, 0.15)' },
    );
    next?.animate([{ transform: 'translateY(115%)' }, { transform: 'translateY(0)' }], { duration: 200, easing: ease });
  }

  function syncHeaderToCurrentPage(): void {
    const pathname = window.location.pathname;
    const lang = getLangFromUrl(new URL(window.location.href));
    const t = useTranslations(lang);
    const currentPath = norm(pathname);
    const navHrefs = NAV_ITEMS.map((i) => i.href[lang]);
    const navLabels = NAV_ITEMS.map((i) => t(i.labelKey));

    // Barra de canales
    desktopLinks.forEach((link, i) => {
      const href = navHrefs[i] ?? link.href;
      link.href = href;
      const text = link.querySelector('.nav-link__text');
      if (text && navLabels[i]) text.textContent = navLabels[i];
      const active = norm(href) === currentPath;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });

    // La placa de la página: las cuatro del menú y las dos legales.
    const pageHrefs = [...navHrefs, localizePath('/aviso-legal', lang), localizePath('/privacidad', lang)];
    const pageTexts = [...navLabels, t('footer.legal.notice'), t('footer.legal.privacy')];
    document.querySelectorAll<HTMLElement>('[data-header] [data-page-label]').forEach((el, i) => {
      if (pageTexts[i]) el.textContent = pageTexts[i];
    });
    setPageLabel(pageHrefs.findIndex((h) => norm(h) === currentPath));

    // Logo
    const logo = document.querySelector<HTMLAnchorElement>('[data-header] .hdr__logo');
    if (logo) logo.href = getHomePath(lang);

    // Selector de idioma: el bug muestra el idioma actual…
    setLangMenuOpen(false);
    const trigger = getLangTrigger();
    if (trigger) {
      trigger.setAttribute('aria-label', `${t('nav.lang.menu')}: ${LANG_NAMES[lang]}`);
      const label = trigger.querySelector<HTMLElement>('[data-lang-current-label]');
      if (label) label.textContent = lang.toUpperCase();
    }

    // …y cada opción lleva a esta misma página en su idioma (o a la home de ese
    // idioma si la página no existe en él).
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-option]').forEach((option) => {
      const code = option.dataset.langOption as Lang;
      option.setAttribute('href', getLangSwitchUrl(pathname, code));
      if (code === lang) option.setAttribute('aria-current', 'true');
      else option.removeAttribute('aria-current');
    });
  }

  document.addEventListener('astro:page-load', () => {
    syncHeaderToCurrentPage();
    if (!indicatorReady) {
      // Primera carga: colocar sin animación, luego activarla.
      placeIndicator();
      requestAnimationFrame(() => {
        indicator?.classList.add('is-animated');
        indicatorReady = true;
      });
    } else {
      placeIndicator();
    }
  });

  // Navegación del ClientRouter: corre ANTES de que la View Transition tome la
  // foto nueva, así la geometría nueva del indicador entra en ella y el navegador
  // la desliza desde la vieja.
  document.addEventListener('astro:after-swap', () => {
    syncHeaderToCurrentPage();
    placeIndicator();
  });

  // Solo cuando cambia el ancho: en móvil, un resize de solo alto es la barra del
  // navegador entrando y saliendo.
  let lastViewportWidth = window.innerWidth;
  window.addEventListener('resize', () => {
    if (window.innerWidth === lastViewportWidth) return;
    lastViewportWidth = window.innerWidth;
    placeIndicator();
  });
  // La barra mide con Söhne ya cargada: si la fuente llega después del primer
  // cálculo, se recoloca.
  document.fonts?.ready.then(placeIndicator);

  // ── Desplegable de idioma (escritorio) ───────────────────────────────────
  // El estado vive en `aria-expanded` del botón y el CSS abre el panel a partir
  // de él. El botón está en la cabecera persistente: se reconsulta cada vez.
  function getLangTrigger(): HTMLButtonElement | null {
    return document.querySelector<HTMLButtonElement>('[data-header] [data-lang-trigger]');
  }

  function isLangMenuOpen(): boolean {
    return getLangTrigger()?.getAttribute('aria-expanded') === 'true';
  }

  function setLangMenuOpen(open: boolean): void {
    getLangTrigger()?.setAttribute('aria-expanded', String(open));
  }

  /**
   * Abre en `pointerup`, que iOS Safari despacha de forma fiable al primer toque
   * incluso cuando ignora el `click` (el iPad usa esta cabecera de escritorio).
   * `click` queda para teclado y lectores de pantalla, y se descarta si el
   * puntero ya lo gestionó.
   */
  let langToggledByPointer = false;

  document.addEventListener('pointerup', (e) => {
    const target = e.target as Element | null;
    if (!target?.closest('[data-lang-trigger]')) return;
    e.preventDefault();
    setLangMenuOpen(!isLangMenuOpen());
    langToggledByPointer = true;
    requestAnimationFrame(() => {
      langToggledByPointer = false;
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target?.closest('[data-lang-trigger]') || langToggledByPointer) return;
    setLangMenuOpen(!isLangMenuOpen());
  });

  // Se cierra al tocar fuera, al sacar el foco con el tabulador y al hacer
  // scroll (la cabecera se esconde al bajar y se llevaría el panel abierto).
  document.addEventListener('pointerdown', (e) => {
    if (!isLangMenuOpen()) return;
    const target = e.target as Element | null;
    if (target?.closest('[data-lang-menu]')) return;
    setLangMenuOpen(false);
  });

  document.addEventListener('focusout', (e) => {
    if (!isLangMenuOpen()) return;
    const menu = (e.target as Element | null)?.closest('[data-lang-menu]');
    if (menu && !menu.contains(e.relatedTarget as Node | null)) setLangMenuOpen(false);
  });

  document.addEventListener(
    'scroll',
    () => {
      if (isLangMenuOpen()) setLangMenuOpen(false);
    },
    { passive: true },
  );

  // Al empezar cualquier navegación, cerrarlo sin animación antes de que la View
  // Transition fotografíe la cabecera. Ver `.is-closing-instantly` en el CSS.
  document.addEventListener('astro:before-preparation', () => {
    if (!isLangMenuOpen()) return;
    const menu = document.querySelector<HTMLElement>('[data-header] [data-lang-menu]');
    menu?.classList.add('is-closing-instantly');
    setLangMenuOpen(false);
  });

  document.addEventListener('astro:page-load', () => {
    document.querySelector<HTMLElement>('[data-header] [data-lang-menu]')?.classList.remove('is-closing-instantly');
  });

  // ── Menú móvil ───────────────────────────────────────────────────────────
  // El overlay [data-mobile-menu] está fuera del <header transition:persist> y se
  // reemplaza en cada navegación: no se cachea el nodo, se reconsulta siempre.
  function getMobileMenu(): HTMLElement | null {
    return document.querySelector<HTMLElement>('[data-mobile-menu]');
  }

  function getMenuToggle(): HTMLButtonElement | null {
    return document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  }

  function syncMobileMenuChromeOffset(): void {
    const bug = document.querySelector<HTMLElement>('[data-header] .hdr__bug');
    if (!bug) return;
    const bottom = bug.getBoundingClientRect().bottom;
    const clamped = Math.max(48, Math.min(bottom, 220));
    document.documentElement.style.setProperty('--mobile-menu-chrome-offset', `${Math.round(clamped)}px`);
  }

  function updateMenuToggleA11y(open: boolean): void {
    const toggle = getMenuToggle();
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    const openLbl = toggle.getAttribute('data-label-open');
    const closeLbl = toggle.getAttribute('data-label-close');
    if (openLbl && closeLbl) toggle.setAttribute('aria-label', open ? closeLbl : openLbl);
  }

  /** Lo que tarda en irse: las placas se apagan en 120 ms y el fondo se recoge
   *  en 220 ms desde los 40. */
  const MENU_CLOSE_TOTAL_MS = 260;

  let mobileMenuCloseTimer: ReturnType<typeof setTimeout> | null = null;

  function finalizeMobileMenuClose(): void {
    if (mobileMenuCloseTimer) {
      clearTimeout(mobileMenuCloseTimer);
      mobileMenuCloseTimer = null;
    }
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;
    const hadFocus = mobileMenu.contains(document.activeElement);
    mobileMenu.classList.remove('is-open', 'mobile-menu--closing');
    mobileMenu.setAttribute('aria-hidden', 'true');
    mobileMenu.setAttribute('inert', '');
    updateMenuToggleA11y(false);
    document.documentElement.style.removeProperty('--mobile-menu-chrome-offset');
    document.body.style.overflow = '';
    // El foco vuelve al botón que abrió el menú, si estaba dentro.
    if (hadFocus) getMenuToggle()?.focus();
  }

  function setMobileMenuOpen(open: boolean): void {
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;

    if (open) {
      if (mobileMenuCloseTimer) {
        clearTimeout(mobileMenuCloseTimer);
        mobileMenuCloseTimer = null;
      }
      mobileMenu.classList.remove('mobile-menu--closing');
      syncMobileMenuChromeOffset();
      mobileMenu.removeAttribute('inert');
      mobileMenu.classList.add('is-open');
      mobileMenu.setAttribute('aria-hidden', 'false');
      updateMenuToggleA11y(true);
      document.body.style.overflow = 'hidden';
      return;
    }

    if (!mobileMenu.classList.contains('is-open')) return;
    if (mobileMenu.classList.contains('mobile-menu--closing') || reduceMotion()) {
      finalizeMobileMenuClose();
      return;
    }
    // Mientras se va, el foco ya no está en el menú: se devuelve al botón.
    if (mobileMenu.contains(document.activeElement)) getMenuToggle()?.focus();
    updateMenuToggleA11y(false);
    mobileMenu.classList.add('mobile-menu--closing');
    mobileMenu.classList.remove('is-open');
    mobileMenuCloseTimer = setTimeout(() => {
      mobileMenuCloseTimer = null;
      finalizeMobileMenuClose();
    }, MENU_CLOSE_TOTAL_MS);
  }

  function toggleMobileMenu(): void {
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;
    setMobileMenuOpen(!mobileMenu.classList.contains('is-open'));
  }

  /**
   * Handler principal: `pointerup` se dispara de forma fiable en todos los
   * dispositivos y no pide dos toques en iOS Safari como puede pedir `click`.
   */
  let menuToggledByPointer = false;
  document.addEventListener('pointerup', (e) => {
    const target = e.target as Element | null;
    if (!target) return;
    if (target.closest('[data-menu-toggle]')) {
      e.preventDefault();
      toggleMobileMenu();
      menuToggledByPointer = true;
      requestAnimationFrame(() => {
        menuToggledByPointer = false;
      });
      return;
    }
    if (target.closest('[data-mobile-menu-dismiss]')) setMobileMenuOpen(false);
  });

  /** `click`: teclado y lectores de pantalla en el botón, y los enlaces del menú. */
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target) return;
    if (target.closest('[data-menu-toggle]')) {
      if (!menuToggledByPointer) toggleMobileMenu();
      return;
    }
    if (target.closest('[data-mobile-link]')) setMobileMenuOpen(false);
    if (target.closest('[data-header] .hdr__logo')) {
      try { sessionStorage.setItem('ph-logo-reveal-request', '1'); } catch {}
    }
  });

  document.addEventListener('astro:page-load', () => finalizeMobileMenuClose());

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMobileMenuOpen(false);
      if (isLangMenuOpen()) {
        setLangMenuOpen(false);
        getLangTrigger()?.focus();
      }
      return;
    }
    // Con el menú abierto, el tabulador da la vuelta dentro de él (el botón de
    // cerrar incluido): lo de detrás está tapado.
    if (event.key !== 'Tab') return;
    const mobileMenu = getMobileMenu();
    if (!mobileMenu?.classList.contains('is-open')) return;
    const toggle = getMenuToggle();
    const items = [toggle, ...mobileMenu.querySelectorAll<HTMLElement>('a[href]')].filter(Boolean) as HTMLElement[];
    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement as HTMLElement | null;
    if (!active || !items.includes(active)) {
      event.preventDefault();
      first.focus();
    } else if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) setMobileMenuOpen(false);
    else if (getMobileMenu()?.classList.contains('is-open')) syncMobileMenuChromeOffset();
  });
</script>
