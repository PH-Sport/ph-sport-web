---
import {
  useTranslations,
  getLangFromUrl,
  getLangSwitchUrl,
  getHomePath,
  supportedLangs,
  LANG_NAMES,
} from '@/i18n/utils';
import { NAV_ITEMS } from '@/lib/navigation';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const langOptions = supportedLangs.map((code) => ({
  code,
  name: LANG_NAMES[code],
  href: getLangSwitchUrl(Astro.url.pathname, code),
  current: code === lang,
}));
const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');

const nav = NAV_ITEMS.map((item) => ({
  href: item.href[lang],
  label: t(item.labelKey),
}));

const isActive = (href: string): boolean => {
  const normalizedHref = href === '/' ? '/' : href.replace(/\/$/, '');
  return normalizedHref === currentPath;
};

/** Las letras de un enlace, una a una, para su cascada de 10 ms al señalarlo. */
const letters = (text: string) => [...text].map((ch) => (ch === ' ' ? ' ' : ch));
---

{/* Cabecera «casi invisible, como los créditos»: el logo a la izquierda y, en
    escritorio, las cuatro páginas en Söhne 600 con un hilo dorado bajo la
    actual (el indicador que se desliza al cambiar de página). Persiste entre
    navegaciones (`transition:persist`): su HTML es el de la primera página
    cargada y el script de abajo reescribe enlaces, idioma y activo en cada
    navegación. */}
<header data-header transition:persist>
  <div class="header-shell">
    <div class="header-inner">
      <a href={getHomePath(lang)} class="header-logo" aria-label={t('a11y.logo')}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 259.8 206.1" fill="currentColor" aria-hidden="true">
          <polygon points="0 206.1 58.2 206.1 57.9 145.5 158.1 45.4 112.7 0 0 0 0 52.6 76.9 52.6 0 128.7" />
          <polygon points="122.6 206.1 200.1 206.1 152.2 157.8 173 137.1 182.4 146.4 259.8 146.4 169.6 55.6 130.5 94.2 131.8 95.6 141.1 105.4 120.3 125.8 109.8 115.4 70.8 153.9" />
        </svg>
      </a>

      <nav class="header-nav hidden md:block" aria-label={t('nav.aria.main')}>
        <div class="header-nav-list-wrap">
          <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
          <ul class="header-nav-list">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-astro-prefetch="load"
                  aria-label={item.label}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={['nav-link', isActive(item.href) && 'is-active']}
                >
                  {/* Letra a letra para la cascada; el nombre accesible va en
                      `aria-label`. */}
                  <span class="nav-link__text" aria-hidden="true">
                    {letters(item.label).map((ch, i) => <span class="ph-ltr" style={`--i:${i}`}>{ch}</span>)}
                  </span>
                </a>
              </li>
            ))}
            <li class="lang-menu" data-lang-menu>
              {/* Desplegable de idioma: el botón muestra el idioma actual («ES») y
                  abre los tres. Es un botón que despliega enlaces normales (patrón
                  "disclosure"), no un role="menu": cada opción es navegación. */}
              <button
                type="button"
                class="lang-switch"
                data-lang-trigger
                aria-expanded="false"
                aria-controls="lang-panel"
                aria-label={`${t('nav.lang.menu')}: ${LANG_NAMES[lang]}`}
              >
                <span class="lang-label" data-lang-current-label>{lang.toUpperCase()}</span>
              </button>
              <ul id="lang-panel" class="lang-panel" data-lang-panel>
                {langOptions.map((option, i) => (
                  <li style={`--i:${i}`}>
                    {/* hreflang = idioma del destino, no el de esta página: declara la
                        frontera entre versiones a buscadores y lectores de pantalla. */}
                    <a
                      href={option.href}
                      hreflang={option.code}
                      lang={option.code}
                      class="lang-option"
                      data-lang-option={option.code}
                      aria-current={option.current ? 'true' : undefined}
                    >
                      <span class="lang-option__text">{option.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          </ul>
        </div>
      </nav>

      <button
        type="button"
        class="menu-toggle md:hidden"
        data-menu-toggle
        data-label-open={t('a11y.menu.open')}
        data-label-close={t('a11y.menu.close')}
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('a11y.menu.open')}
      >
        <span class="menu-toggle__inner" aria-hidden="true">
          <span class="menu-toggle__bar"></span>
          <span class="menu-toggle__bar"></span>
        </span>
      </button>
    </div>
  </div>
</header>

{/* Menú móvil: negro a pantalla completa, las cuatro páginas como palabras
    gigantes que suben de su máscara en cascada (la actual en oro) y los tres
    idiomas en una línea pequeña abajo. Va fuera de [data-header] y se reemplaza
    en cada navegación. */}
<div id="mobile-menu" class="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu-backdrop" data-mobile-menu-dismiss aria-hidden="true"></div>
  <div class="mobile-menu-inner">
    <nav aria-label={t('nav.aria.mobile')}>
      <ul class="mobile-nav-list">
        {nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a
              href={item.href}
              data-mobile-link
              data-astro-prefetch="load"
              class:list={['mobile-link', isActive(item.href) && 'mobile-link--active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="mobile-link__mask"><span class="mobile-link__label">{item.label}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* En móvil no hay desplegable dentro del menú: el menú ya es el panel que se
        abre, así que los tres idiomas van en una línea, con el actual marcado. */}
    <ul class="lang-list--mobile" aria-label={t('nav.lang.menu')}>
      {langOptions.map((option) => (
        <li>
          <a
            href={option.href}
            hreflang={option.code}
            lang={option.code}
            data-mobile-link
            data-lang-option={option.code}
            aria-current={option.current ? 'true' : undefined}
            class="lang-mobile"
          >
            {option.name}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* ── La franja de la cabecera ──
     Sin cápsula ni cristal: los elementos van sobre la escena, en la retícula
     (el logo cae en el margen, como los textos). Al bajar aparece detrás una
     franja negra con un hilo debajo, para que se lean sobre lo que pasa; al
     seguir bajando se esconde y vuelve al subir (BaseLayout). */
  .header-shell {
    padding-top: env(safe-area-inset-top);
    /* Nombre propio de View Transition: la cabecera no se funde al navegar. */
    view-transition-name: ph-header;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 8px var(--ph-section-px);
  }

  @media (min-width: 768px) {
    .header-inner {
      padding-block: 18px;
    }
  }

  /* ── Logo ── */
  .header-logo {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ph-gold);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  .header-logo svg {
    height: 1.375rem;
    width: auto;
  }

  @media (min-width: 768px) {
    .header-logo svg {
      height: 1.625rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .header-logo:hover {
      color: var(--color-ph-white);
    }
  }

  /* ── Navegación de escritorio ── */
  .header-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .header-nav {
      display: block;
    }
  }

  .header-nav-list-wrap {
    position: relative;
  }

  .header-nav-list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
    list-style: none;
  }

  /* Cada página: Söhne 600, al 62 % y en blanco la actual. Al señalarla, las
     letras suben 2 px en cascada de 10 ms y un hilo se dibuja debajo. */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: rgba(255, 255, 255, 0.62);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.4);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--ph-dur-state) var(--ph-ease-out);
  }

  .nav-link.is-active {
    color: var(--color-ph-white);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--color-ph-white);
    }
    .nav-link:hover :global(.ph-ltr) {
      transform: translateY(-2px);
    }
    .nav-link:not(.is-active):hover::after {
      transform: scaleX(1);
    }
  }

  .nav-link:focus-visible :global(.ph-ltr) {
    transform: translateY(-2px);
  }

  /* El hilo de la página actual: dorado, de 1 px. Se coloca con transform
     (translateX + scaleX) en JS, en el compositor, y se desliza al cambiar de
     página porque tiene su propio nombre de View Transition. */
  .nav-indicator {
    position: absolute;
    bottom: 0.55rem;
    left: 0;
    width: 100px;
    height: 1px;
    background: var(--color-ph-gold);
    pointer-events: none;
    transform-origin: left center;
    transform: scaleX(0);
    view-transition-name: ph-nav-indicator;
  }

  /* Literal: el grupo de View Transition no hereda `var()`. */
  .nav-indicator.is-animated {
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-indicator.is-animated {
      transition: none;
    }
  }

  /* ── Selector de idioma (escritorio) ──
     «ES» con su hilo; el panel cae como una lista de títulos. El estado lo lleva
     `aria-expanded` del botón y el CSS abre el panel a partir de él. */
  .lang-menu {
    position: relative;
  }

  .lang-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .lang-switch::after {
    content: '';
    position: absolute;
    left: 0.25rem;
    right: 0.25rem;
    bottom: 0.55rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.4);
    transition: background-color var(--ph-dur-state) var(--ph-ease-std);
  }

  .lang-label {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-ph-white);
  }

  @media (hover: hover) and (pointer: fine) {
    .lang-switch:hover::after {
      background: var(--color-ph-white);
    }
  }

  .lang-switch[aria-expanded='true']::after {
    background: var(--color-ph-gold);
  }

  .lang-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 1;
    min-width: 11rem;
    margin: 0;
    padding: 0.75rem 1.125rem 0.875rem;
    list-style: none;
    background-color: var(--color-ph-black);
    border-top: 1px solid var(--ph-hair-strong);
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.16s;
  }

  .lang-switch[aria-expanded='true'] + .lang-panel {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s linear 0s;
  }

  .lang-panel li {
    overflow: hidden; /* Safari < 16 no conoce `clip` */
    overflow: clip;
  }

  .lang-option {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: rgba(255, 255, 255, 0.62);
    transform: translateY(110%);
    transition:
      transform 0.14s var(--ph-ease-in),
      color var(--ph-dur-state) var(--ph-ease-std);
  }

  .lang-switch[aria-expanded='true'] + .lang-panel .lang-option {
    transform: none;
    transition:
      transform 0.32s var(--ph-ease-emph) calc(var(--i, 0) * 40ms),
      color var(--ph-dur-state) var(--ph-ease-std);
  }

  .lang-panel li:nth-child(2) { --i: 1; }
  .lang-panel li:nth-child(3) { --i: 2; }

  .lang-option:hover,
  .lang-option:focus-visible {
    color: var(--color-ph-white);
  }

  /* El idioma en que se está leyendo: en oro. */
  .lang-option[aria-current='true'] {
    color: var(--color-ph-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-panel,
    .lang-option,
    .lang-switch[aria-expanded='true'] + .lang-panel .lang-option {
      transform: none;
      transition: none;
    }
  }

  /* Al navegar se cierra en seco. La View Transition fotografía la cabecera antes
     del cambio de página y mantiene esa foto toda la transición: con el panel a
     medio cerrar, se vería encima. Lo comprueba el smoke. */
  .lang-menu.is-closing-instantly .lang-panel,
  .lang-menu.is-closing-instantly .lang-option {
    transition: none;
  }

  /* ── Botón del menú móvil: dos hilos que se cruzan en una X ── */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.625rem;
    padding: 0;
    border: 0;
    color: var(--color-ph-white);
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }
  }

  .menu-toggle__inner {
    position: relative;
    display: block;
    width: 1.5rem;
    height: 0.5rem;
  }

  .menu-toggle__bar {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--ph-dur-move) var(--ph-ease-out);
  }

  .menu-toggle__bar:first-child { top: 0; }
  .menu-toggle__bar:last-child { bottom: 0; }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:first-child {
    transform: translateY(0.1875rem) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:last-child {
    transform: translateY(-0.1875rem) rotate(-45deg);
  }

  .menu-toggle:active {
    color: var(--color-ph-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle__bar {
      transition: none;
    }
  }

  /* ── Menú móvil ──
     El negro entra en seco (120 ms) y las palabras suben de su máscara en
     cascada de 50 ms. Al cerrar, bajan todas a la vez en 160 ms y el negro se va
     detrás. El JS solo pone y quita clases (`is-open`, `mobile-menu--closing`). */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    isolation: isolate;
    background: var(--color-ph-black);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 100ms linear 150ms,
      visibility 0s linear 250ms;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 120ms linear,
      visibility 0s linear 0s;
  }

  .mobile-menu.is-open.mobile-menu--closing {
    opacity: 0;
    transition: opacity 100ms linear 150ms;
  }

  /* Capa detrás del contenido: recibe los toques en el «vacío». */
  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: pointer;
  }

  .mobile-menu-inner {
    position: relative;
    z-index: 1;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    /* El overlay es `fixed`: no hereda las zonas seguras del body y las pide aparte.
       El hueco de arriba lo da `--mobile-menu-chrome-offset`, medido del header. */
    padding-inline:
      calc(var(--ph-section-px) + env(safe-area-inset-left))
      calc(var(--ph-section-px) + env(safe-area-inset-right));
    padding-top: calc(var(--mobile-menu-chrome-offset, 64px) + 1.5rem);
    padding-bottom: calc(2rem + env(safe-area-inset-bottom));
  }

  .mobile-menu-inner nav a,
  .mobile-menu-inner .lang-list--mobile a {
    pointer-events: auto;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    list-style: none;
  }

  .mobile-link {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(44px, 13vw, 72px);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: var(--color-ph-white);
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-link--active {
    color: var(--color-ph-gold);
  }

  .mobile-link__mask {
    display: block;
    overflow: hidden; /* Safari < 16 no conoce `clip` */
    overflow: clip;
    padding-block: 0.06em 0.12em;
  }

  .mobile-link__label {
    display: inline-block;
    transform: translateY(115%);
    transition: transform 160ms var(--ph-ease-in);
  }

  .mobile-menu.is-open .mobile-link__label {
    transform: none;
    transition: transform 560ms var(--ph-ease-emph) calc(60ms + var(--i, 0) * 50ms);
  }

  .mobile-menu.is-open.mobile-menu--closing .mobile-link__label {
    transform: translateY(115%);
    transition: transform 160ms var(--ph-ease-in) 0ms;
  }

  .mobile-link:active .mobile-link__label {
    color: var(--color-ph-gold);
  }

  /* Los tres idiomas, en una línea pequeña. */
  .lang-list--mobile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ph-hair);
    list-style: none;
    opacity: 0;
    transition: opacity 120ms linear;
  }

  .mobile-menu.is-open .lang-list--mobile {
    opacity: 1;
    transition: opacity 300ms var(--ph-ease-out) 260ms;
  }

  .mobile-menu.is-open.mobile-menu--closing .lang-list--mobile {
    opacity: 0;
    transition: opacity 120ms linear;
  }

  .lang-mobile {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.62);
  }

  .lang-mobile[aria-current='true'] {
    color: var(--color-ph-white);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    text-decoration-color: var(--color-ph-gold);
  }

  .mobile-menu.mobile-menu--closing .mobile-menu-backdrop,
  .mobile-menu.mobile-menu--closing .mobile-menu-inner a {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu.is-open,
    .mobile-menu.is-open.mobile-menu--closing,
    .mobile-menu .lang-list--mobile {
      transition: opacity 120ms linear, visibility 0s;
    }

    .mobile-menu .mobile-link__label,
    .mobile-menu.is-open .mobile-link__label,
    .mobile-menu.is-open.mobile-menu--closing .mobile-link__label {
      transform: none;
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }
</style>

<!-- Estado de la cabecera al hacer scroll (clases que pone BaseLayout) y sus
     grupos de View Transition: van sin scope porque cuelgan del documento. -->
<style is:global>
  [data-header] {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* Por encima del menú móvil (100) y del cartón entre páginas (105): la
       cabecera persiste y se ve mientras el cartón tapa la página. */
    z-index: 110;
    pointer-events: none;
  }

  [data-header] .header-shell {
    pointer-events: auto;
    background-color: transparent;
    box-shadow: none;
    transition:
      transform var(--ph-dur-move) var(--ph-ease-out),
      background-color var(--ph-dur-state) var(--ph-ease-std),
      box-shadow var(--ph-dur-state) var(--ph-ease-std);
  }

  [data-header].header--solid .header-shell {
    background-color: rgba(13, 15, 18, 0.94);
    box-shadow: inset 0 -1px 0 var(--ph-hair);
  }

  [data-header].header--scroll-hidden,
  [data-header].header--scroll-hidden .header-shell {
    pointer-events: none;
  }

  [data-header].header--scroll-hidden .header-shell {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-header].header--scroll-hidden .header-shell {
      transform: none;
      pointer-events: auto;
    }
  }

  /* Menú móvil abierto: la franja se funde con el negro del menú. */
  html:has(#mobile-menu.is-open) [data-header] .header-shell {
    background-color: transparent;
    box-shadow: none;
    transform: none;
  }

  /* La cabecera no se funde al navegar: su contenido es el mismo entre páginas.
     El indicador es un grupo aparte (ph-nav-indicator) que se desliza. */
  ::view-transition-group(ph-header),
  ::view-transition-old(ph-header),
  ::view-transition-new(ph-header) {
    animation: none;
  }

  ::view-transition-group(ph-nav-indicator) {
    animation-duration: 0.32s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(ph-nav-indicator),
    ::view-transition-old(ph-nav-indicator),
    ::view-transition-new(ph-nav-indicator) {
      animation: none;
    }
  }
</style>

<script>
  // ── Nav indicator deslizante ──────────────────────────────────────────────
  const wrap = document.querySelector<HTMLElement>('.header-nav-list-wrap');
  const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
  const desktopLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.header-nav .nav-link'),
  );

  let indicatorReady = false;

  // Ancho base del indicador (coincide con .nav-indicator { width }). El
  // posicionamiento se hace con transform sobre esa base: translateX fija el
  // borde izquierdo y scaleX el ancho (transform-origin: left) → compositor/GPU.
  const INDICATOR_BASE_WIDTH = 100;

  function setIndicatorToLink(link: HTMLElement) {
    if (!wrap || !indicator || !link) return;
    const wrapRect = wrap.getBoundingClientRect();
    const textRect = (link.querySelector('.nav-link__text') ?? link).getBoundingClientRect();
    const x = textRect.left - wrapRect.left;
    const scaleX = textRect.width / INDICATOR_BASE_WIDTH;
    indicator.style.transform = `translateX(${x}px) scaleX(${scaleX})`;
  }

  function hideIndicator() {
    if (indicator) indicator.style.transform = 'scaleX(0)';
  }

  // ── Rutas derivadas de la fuente central (src/lib/navigation.ts) ────────
  // La cabecera persiste entre navegaciones (`transition:persist`): su HTML es el
  // de la primera página que se cargó, así que todo lo que depende del idioma o
  // de la página se reescribe aquí en cada navegación.
  import { NAV_ITEMS } from '@/lib/navigation';
  // El núcleo de movimiento (sin GSAP) se carga con la cabecera, que está en
  // todas las páginas: vigila lo que entra en pantalla y mueve el cartón entre
  // páginas (src/scripts/ph-motion.ts).
  import { setLetters } from '@/scripts/ph-motion';
  import {
    useTranslations,
    getLangFromUrl,
    getLangSwitchUrl,
    getHomePath,
    LANG_NAMES,
    type Lang,
  } from '@/i18n/utils';

  function norm(p: string): string {
    return p === '/' ? '/' : p.replace(/\/+$/, '');
  }

  function syncHeaderToCurrentPage() {
    const pathname = window.location.pathname;
    const lang = getLangFromUrl(new URL(window.location.href));
    const t = useTranslations(lang);
    const currentPath = norm(pathname);
    const navHrefs = NAV_ITEMS.map((i) => i.href[lang]);
    const navLabels = NAV_ITEMS.map((i) => t(i.labelKey));

    // Enlaces de escritorio: destino, nombre (letra a letra) y página actual.
    desktopLinks.forEach((link, i) => {
      const href = navHrefs[i] ?? link.href;
      link.href = href;
      const label = navLabels[i];
      if (label && link.getAttribute('aria-label') !== label) {
        link.setAttribute('aria-label', label);
        const text = link.querySelector<HTMLElement>('.nav-link__text');
        if (text) setLetters(text, label);
      }
      const active = norm(href) === currentPath;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });

    // Menú móvil (se reemplaza en cada navegación, pero puede venir de otro idioma
    // si la página nueva es la misma en HTML: se reescribe igual).
    document
      .querySelectorAll<HTMLAnchorElement>('.mobile-nav-list .mobile-link')
      .forEach((link, i) => {
        const href = navHrefs[i];
        const label = navLabels[i];
        if (href) link.href = href;
        const active = norm(href ?? '') === currentPath;
        link.classList.toggle('mobile-link--active', active);
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
        if (label) {
          const labelEl = link.querySelector('.mobile-link__label');
          if (labelEl) labelEl.textContent = label;
        }
      });

    // Logo
    const logo = document.querySelector<HTMLAnchorElement>('a.header-logo');
    if (logo) {
      logo.href = getHomePath(lang);
      logo.setAttribute('aria-label', t('a11y.logo'));
    }

    // Selector de idioma: el botón muestra el idioma actual…
    setLangMenuOpen(false);
    const trigger = getLangTrigger();
    if (trigger) {
      trigger.setAttribute('aria-label', `${t('nav.lang.menu')}: ${LANG_NAMES[lang]}`);
      const label = trigger.querySelector<HTMLElement>('[data-lang-current-label]');
      if (label) label.textContent = lang.toUpperCase();
    }

    // …y cada opción lleva a esta misma página en su idioma (o a la home de ese
    // idioma si la página no existe en él).
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-option]').forEach((option) => {
      const code = option.dataset.langOption as Lang;
      option.setAttribute('href', getLangSwitchUrl(pathname, code));
      if (code === lang) option.setAttribute('aria-current', 'true');
      else option.removeAttribute('aria-current');
    });
  }

  if (wrap && indicator && desktopLinks.length > 0) {
    document.addEventListener('astro:page-load', () => {
      syncHeaderToCurrentPage();
      const activeLink = desktopLinks.find((link) => link.classList.contains('is-active'));

      if (!indicatorReady) {
        // Primera carga: posicionar sin animación (con la fuente ya puesta, que
        // cambia el ancho de las palabras), luego activarla.
        const place = () => { if (activeLink) setIndicatorToLink(activeLink); };
        place();
        document.fonts?.ready.then(place);
        requestAnimationFrame(() => {
          indicator.classList.add('is-animated');
          indicatorReady = true;
        });
      } else if (activeLink) {
        setIndicatorToLink(activeLink);
      } else {
        hideIndicator();
      }
    });

    // Navegación SPA: corre ANTES de que la View Transition capture el snapshot
    // nuevo, así la geometría nueva del indicador entra en ese snapshot y el
    // navegador la morfea desde la vieja → ese morph ES el deslizamiento.
    document.addEventListener('astro:after-swap', () => {
      syncHeaderToCurrentPage();
      const activeLink = desktopLinks.find((link) => link.classList.contains('is-active'));
      if (activeLink) setIndicatorToLink(activeLink);
      else hideIndicator();
    });

    // Sólo cuando cambia el ancho: un resize de sólo altura es la barra del
    // navegador del móvil, y el indicador no depende de la altura.
    let lastViewportWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastViewportWidth) return;
      lastViewportWidth = window.innerWidth;
      const activeLink = desktopLinks.find((link) => link.classList.contains('is-active'));
      if (activeLink) setIndicatorToLink(activeLink);
    });
  }

  // ── Desplegable de idioma (escritorio) ───────────────────────────────────
  // El estado vive en `aria-expanded` del botón y el CSS abre el panel a partir
  // de él. El botón está en la cabecera persistente: se reconsulta cada vez.
  function getLangTrigger() {
    return document.querySelector<HTMLButtonElement>('[data-header] [data-lang-trigger]');
  }

  function isLangMenuOpen(): boolean {
    return getLangTrigger()?.getAttribute('aria-expanded') === 'true';
  }

  function setLangMenuOpen(open: boolean) {
    getLangTrigger()?.setAttribute('aria-expanded', String(open));
  }

  /**
   * Abre en `pointerup`, que iOS Safari despacha de forma fiable al primer toque
   * incluso cuando ignora el `click` (iPad usa esta cabecera de escritorio).
   * `click` queda para teclado y lectores de pantalla, y se descarta si el
   * puntero ya lo gestionó.
   */
  let langToggledByPointer = false;

  document.addEventListener('pointerup', (e) => {
    const target = e.target as Element | null;
    if (!target?.closest('[data-lang-trigger]')) return;
    e.preventDefault();
    setLangMenuOpen(!isLangMenuOpen());
    langToggledByPointer = true;
    requestAnimationFrame(() => {
      langToggledByPointer = false;
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target?.closest('[data-lang-trigger]') || langToggledByPointer) return;
    setLangMenuOpen(!isLangMenuOpen());
  });

  // Se cierra al tocar fuera, al sacar el foco con el tabulador y al hacer
  // scroll (la cabecera se esconde al bajar y se llevaría el panel abierto).
  document.addEventListener('pointerdown', (e) => {
    if (!isLangMenuOpen()) return;
    const target = e.target as Element | null;
    if (target?.closest('[data-lang-menu]')) return;
    setLangMenuOpen(false);
  });

  document.addEventListener('focusout', (e) => {
    if (!isLangMenuOpen()) return;
    const menu = (e.target as Element | null)?.closest('[data-lang-menu]');
    if (menu && !menu.contains(e.relatedTarget as Node | null)) setLangMenuOpen(false);
  });

  document.addEventListener(
    'scroll',
    () => {
      if (isLangMenuOpen()) setLangMenuOpen(false);
    },
    { passive: true },
  );

  // Al empezar cualquier navegación (una opción del panel, atrás, otro enlace),
  // cerrarlo sin animación antes de que la View Transition fotografíe la
  // cabecera. Ver `.is-closing-instantly` en el CSS.
  document.addEventListener('astro:before-preparation', () => {
    if (!isLangMenuOpen()) return;
    const menu = document.querySelector<HTMLElement>('[data-header] [data-lang-menu]');
    menu?.classList.add('is-closing-instantly');
    setLangMenuOpen(false);
  });

  document.addEventListener('astro:page-load', () => {
    document
      .querySelector<HTMLElement>('[data-header] [data-lang-menu]')
      ?.classList.remove('is-closing-instantly');
  });

  // ── Menú móvil ───────────────────────────────────────────────────────────
  // El overlay [data-mobile-menu] está fuera del <header transition:persist> y se
  // reemplaza en cada navegación: no cachear el nodo; siempre reconsultar el DOM.
  function getMobileMenu() {
    return document.querySelector<HTMLElement>('[data-mobile-menu]');
  }

  function getMenuToggle() {
    return document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  }

  function syncMobileMenuChromeOffset() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;
    const bottom = header.getBoundingClientRect().bottom;
    const clamped = Math.max(48, Math.min(bottom, 220));
    document.documentElement.style.setProperty(
      '--mobile-menu-chrome-offset',
      `${Math.round(clamped * 10) / 10}px`,
    );
  }

  function updateMenuToggleA11y(open: boolean) {
    const toggle = getMenuToggle();
    if (!toggle) return;
    const openLbl = toggle.getAttribute('data-label-open');
    const closeLbl = toggle.getAttribute('data-label-close');
    if (openLbl && closeLbl) {
      toggle.setAttribute('aria-label', open ? closeLbl : openLbl);
    }
  }

  /** Mientras el menú está abierto, la página de detrás no se lee ni recibe el
   *  foco: `inert` en <main> y en el pie. */
  function setPageInert(inert: boolean) {
    document.querySelectorAll<HTMLElement>('#main-content, body > footer').forEach((el) => {
      el.inert = inert;
    });
  }

  /** Lo que tarda en irse: las palabras bajan en 160 ms y el negro se va detrás. */
  const MENU_CLOSE_TOTAL_MS = 260;

  let mobileMenuCloseTimer: ReturnType<typeof setTimeout> | null = null;

  function prefersReducedMotionMenu(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function finalizeMobileMenuClose() {
    if (mobileMenuCloseTimer) {
      clearTimeout(mobileMenuCloseTimer);
      mobileMenuCloseTimer = null;
    }
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;
    mobileMenu.classList.remove('is-open', 'mobile-menu--closing');
    mobileMenu.setAttribute('aria-hidden', 'true');
    getMenuToggle()?.setAttribute('aria-expanded', 'false');
    updateMenuToggleA11y(false);
    document.documentElement.style.removeProperty('--mobile-menu-chrome-offset');
    document.body.style.overflow = '';
    setPageInert(false);
  }

  function setMobileMenuOpen(open: boolean, { restoreFocus = true } = {}) {
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;

    if (open) {
      if (mobileMenuCloseTimer) {
        clearTimeout(mobileMenuCloseTimer);
        mobileMenuCloseTimer = null;
      }
      mobileMenu.classList.remove('mobile-menu--closing');
      syncMobileMenuChromeOffset();
      requestAnimationFrame(() => syncMobileMenuChromeOffset());
      mobileMenu.classList.add('is-open');
      mobileMenu.setAttribute('aria-hidden', 'false');
      getMenuToggle()?.setAttribute('aria-expanded', 'true');
      updateMenuToggleA11y(true);
      document.body.style.overflow = 'hidden';
      setPageInert(true);
      return;
    }

    if (!mobileMenu.classList.contains('is-open')) return;

    // El foco vuelve al botón si estaba dentro del menú (cerrar con Escape, con
    // el botón o tocando el fondo).
    if (restoreFocus && mobileMenu.contains(document.activeElement)) getMenuToggle()?.focus();

    if (mobileMenu.classList.contains('mobile-menu--closing') || prefersReducedMotionMenu()) {
      finalizeMobileMenuClose();
      return;
    }

    mobileMenu.classList.add('mobile-menu--closing');
    mobileMenuCloseTimer = setTimeout(() => {
      mobileMenuCloseTimer = null;
      finalizeMobileMenuClose();
    }, MENU_CLOSE_TOTAL_MS);
  }

  function onMobileMenuLayoutResize() {
    if (getMobileMenu()?.classList.contains('is-open')) {
      syncMobileMenuChromeOffset();
    }
  }

  function toggleMobileMenu() {
    const mobileMenu = getMobileMenu();
    if (!mobileMenu) return;
    if (mobileMenu.classList.contains('mobile-menu--closing')) {
      if (mobileMenuCloseTimer) {
        clearTimeout(mobileMenuCloseTimer);
        mobileMenuCloseTimer = null;
      }
      mobileMenu.classList.remove('mobile-menu--closing');
      return;
    }
    setMobileMenuOpen(!mobileMenu.classList.contains('is-open'));
  }

  /**
   * Handler principal: `pointerup` se dispara de forma fiable en TODOS los
   * dispositivos (touch + mouse) y no requiere dos toques en iOS Safari como
   * `click` puede requerir. Con teclado, Enter o Espacio sobre el botón llegan
   * como `click` sin `pointerup`: se atienden abajo.
   */
  let menuToggledByPointer = false;

  function onMobileMenuPointerUp(e: PointerEvent) {
    const target = e.target as Element | null;
    if (!target) return;

    if (target.closest('[data-menu-toggle]')) {
      e.preventDefault();
      toggleMobileMenu();
      menuToggledByPointer = true;
      requestAnimationFrame(() => {
        menuToggledByPointer = false;
      });
      return;
    }
    if (target.closest('[data-mobile-menu-dismiss]')) {
      setMobileMenuOpen(false);
    }
  }

  function onMobileMenuClick(e: MouseEvent) {
    const target = e.target as Element | null;
    if (!target) return;

    if (target.closest('[data-menu-toggle]')) {
      if (!menuToggledByPointer) toggleMobileMenu();
      return;
    }
    // Un enlace del menú: el menú se cierra detrás del cartón, sin devolver el
    // foco (la página cambia).
    if (target.closest('[data-mobile-link]')) {
      setMobileMenuOpen(false, { restoreFocus: false });
    }
  }

  document.addEventListener('pointerup', onMobileMenuPointerUp);
  document.addEventListener('click', onMobileMenuClick);

  // Al abrir con el teclado, el foco entra en el menú (la primera palabra).
  getMenuToggle()?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    requestAnimationFrame(() => {
      if (getMobileMenu()?.classList.contains('is-open')) {
        getMobileMenu()?.querySelector<HTMLElement>('.mobile-link')?.focus();
      }
    });
  });

  // Con el menú abierto, el tabulador da la vuelta entre el botón y los enlaces
  // del menú: no se escapa a la página de detrás. El ciclo se hace a mano porque
  // Safari, por defecto, no lleva el tabulador a los enlaces.
  document.addEventListener('keydown', (event) => {
    const mobileMenu = getMobileMenu();
    if (event.key !== 'Tab' || !mobileMenu?.classList.contains('is-open')) return;
    const toggle = getMenuToggle();
    const items = [toggle, ...mobileMenu.querySelectorAll<HTMLElement>('a[href]')].filter(Boolean) as HTMLElement[];
    if (!items.length) return;
    event.preventDefault();
    const i = items.indexOf(document.activeElement as HTMLElement);
    const next = event.shiftKey
      ? (i <= 0 ? items.length - 1 : i - 1)
      : (i < 0 || i === items.length - 1 ? 0 : i + 1);
    items[next].focus();
  });

  // Selector de idioma con las flechas: abre el panel y recorre las opciones
  // (también en Safari, que no lleva el tabulador a los enlaces).
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
    const target = event.target as Element | null;
    if (!target?.closest('[data-header] [data-lang-menu]')) return;
    const options = Array.from(document.querySelectorAll<HTMLElement>('[data-header] [data-lang-panel] [data-lang-option]'));
    if (!options.length) return;
    event.preventDefault();
    if (!isLangMenuOpen()) setLangMenuOpen(true);
    const i = options.indexOf(document.activeElement as HTMLElement);
    const next = event.key === 'ArrowDown'
      ? (i + 1) % options.length
      : (i <= 0 ? options.length - 1 : i - 1);
    // El panel pasa a visible en el mismo fotograma: el foco, en el siguiente.
    requestAnimationFrame(() => options[next].focus());
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (target?.closest('a.header-logo')) {
      try { sessionStorage.setItem('ph-logo-reveal-request', '1'); } catch {}
    }
  });

  document.addEventListener('astro:page-load', () => finalizeMobileMenuClose());

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    setMobileMenuOpen(false);
    if (isLangMenuOpen()) {
      setLangMenuOpen(false);
      getLangTrigger()?.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) setMobileMenuOpen(false, { restoreFocus: false });
    else onMobileMenuLayoutResize();
  });

  window.visualViewport?.addEventListener('resize', onMobileMenuLayoutResize);
  window.addEventListener('orientationchange', onMobileMenuLayoutResize);
</script>
