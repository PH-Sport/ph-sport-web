---
import { useTranslations, type Lang } from '@/i18n/utils';
import { getTeamMembers } from '@/lib/teamMembers';
import Bug from '@/components/ui/Bug.astro';
import Plate from '@/components/ui/Plate.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const teamMembers = getTeamMembers(lang);

const internationalCountries = [
  { key: 'portugal' as const, iso: 'PT' },
  { key: 'uk' as const, iso: 'UK' },
  { key: 'alemania' as const, iso: 'DE' },
  { key: 'italia' as const, iso: 'IT' },
  { key: 'arabia' as const, iso: 'KSA' },
  { key: 'uruguay' as const, iso: 'UY' },
];

const philosophy = [
  { idx: t('about.manifesto.blocks.now.idx'), title: t('about.manifesto.blocks.now.title'), body: t('about.manifesto.blocks.now.body') },
  { idx: t('about.manifesto.blocks.next.idx'), title: t('about.manifesto.blocks.next.title'), body: t('about.manifesto.blocks.next.body') },
  { idx: t('about.manifesto.blocks.forever.idx'), title: t('about.manifesto.blocks.forever.title'), body: t('about.manifesto.blocks.forever.body') },
];

const titlePre = t('about.hero.titlePre');
---

<section class="about-section" aria-labelledby="about-hero-title">
  {/* 01 — Cabecera: «Representar» (en oro) y «con propósito.» en dos placas en
      escalera y la entradilla; debajo, los valores y el pie como dos bugs en una
      barra, y los párrafos 2 y 3 en dos paneles. */}
  <header class="ph-head abt-head" data-inview>
    <Bug text={t('about.hero.eyebrow')} inview={false} />
    <h1 id="about-hero-title" class="ph-head__title abt-head__title ph-lt">
      <Plate tab d={60}>{titlePre}<em>{t('about.hero.titleAccent')}</em></Plate>{' '}
      <Plate d={140} step={1}>{t('about.hero.titlePost').trim()}</Plate>
    </h1>
    <p class="ph-head-lead ph-in-rise" style="--d: 320ms">{t('about.hero.body1')}</p>
  </header>

  <div class="abt-bar" data-inview>
    <Bug as="div" text={t('about.hero.values')} inview={false} />
    <Bug as="div" text={t('about.hero.caption')} inview={false} d={80} />
  </div>

  <div class="abt-intro" data-inview>
    <Plate as="p" variant="text" class="abt-intro__panel">{t('about.hero.body2')}</Plate>
    <Plate as="p" variant="text" d={100} class="abt-intro__panel">{t('about.hero.body3')}</Plate>
  </div>

  {/* 02 — Filosofía: tres cartones de título a todo lo ancho, Now, Next y
      Forever Football, cada uno con su texto. Entran barriendo al llegar. */}
  <div class="abt-philo" id="historia">
    <Bug text={t('about.manifesto.eyebrow')} />
    <div class="abt-philo__cards">
      {philosophy.map((block) => (
        <article class="ph-plate title-card" data-inview>
          <span class="ph-plate__tab" aria-hidden="true"></span>
          <div class="ph-plate__t">
            <div class="ph-plate__in title-card__in">
              <div class="title-card__head">
                <span class="title-card__idx ph-num">{block.idx}</span>
                <h3 class="title-card__title">{block.title}</h3>
              </div>
              <p class="title-card__body">{block.body}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  {/* 03 — Equipo: la hoja de alineación. Cada integrante, una fila en placa
      (número, nombre, cargo y la sede en su placa pequeña); en el móvil, el
      nombre y debajo «cargo · sede». */}
  <div class="abt-team" id="equipo">
    <div class="abt-team__bugs">
      <Bug as="div" text={t('about.team.eyebrow')} />
      <Bug as="div" text={t('about.team.meta')} d={80} />
    </div>
    <h2 id="about-team-title" class="abt-team__title" data-inview>
      <Plate tab lines>{t('about.team.titlePre')}<em>{t('about.team.titleAccent')}</em>{t('about.team.titlePost')}</Plate>
    </h2>

    <ol class="sheet" role="list">
      {teamMembers.map((m) => {
        const place = m.country ?? m.defaultLocation;
        return (
          <li class="sheet__row" data-id={m.id} data-inview data-cascade="40">
            <span class="sheet__idx ph-num">{m.index}</span>
            <span class="sheet__who">
              <span class="sheet__name">{m.name}</span>
              <span class="sheet__mobile">{m.role} · {place.toUpperCase()}</span>
            </span>
            <span class="sheet__role">{m.role}</span>
            <span class="sheet__loc">{place.toUpperCase()}</span>
          </li>
        );
      })}
    </ol>
  </div>

  {/* 04 — Presencia: «Madrid.» en su placa con el bug de la sede central, y los
      seis países como una lista de señales, cada uno con su código en su celda. */}
  <div class="abt-presence" id="presencia">
    <Bug text={t('about.presencia.eyebrow')} />
    <div class="abt-presence__grid">
      <div class="abt-presence__hq" data-inview>
        <h3 id="about-presencia-title" class="abt-presence__madrid">
          <Plate tab>{t('about.presencia.madridTitle')}</Plate>
        </h3>
        <Bug as="div" text={t('about.presencia.madridLabel')} code inview={false} d={260} />
      </div>
      <div class="abt-presence__intl" data-inview>
        <Bug as="div" text={t('about.presencia.internationalLabel')} inview={false} />
        <ul class="signals" role="list">
          {internationalCountries.map((c) => (
            <li class="signal" data-inview data-cascade="50">
              <span class="signal__name">{t(`about.presencia.country.${c.key}` as const)}</span>
              <span class="signal__code ph-num">{c.iso}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    background: transparent;
    padding-bottom: clamp(72px, 10vw, 140px);
  }

  /* «Rappresentare» y «con uno scopo.» (las más largas, en italiano) más su
     escalera caben a 360 px. */
  .abt-head__title { font-size: clamp(38px, 11.2vw, 106px); }

  /* Valores y pie: dos bugs en una barra. */
  .abt-bar {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin: var(--ph-head-after) var(--ph-section-px) 0;
  }

  /* Los párrafos 2 y 3, en dos paneles. */
  .abt-intro {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 6px;
    margin: 14px var(--ph-section-px) 0;
  }
  .abt-intro__panel { width: 100%; max-width: none; }
  @media (min-width: 900px) {
    .abt-intro { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px; }
  }

  /* ── 02 Filosofía ────────────────────────────────────────────────────── */
  .abt-philo {
    position: relative;
    z-index: 1;
    padding: clamp(80px, 11vw, 150px) var(--ph-section-px) 0;
  }
  .abt-philo__cards {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vw, 22px);
    margin-top: clamp(30px, 4vw, 48px);
  }
  /* El cartón: una placa a todo lo ancho, con el corte en la esquina. */
  .title-card {
    --pt: clamp(26px, 3vw, 40px);
    --pb: clamp(26px, 3vw, 40px);
    --pl: clamp(18px, 2.4vw, 36px);
    --pr: clamp(40px, 5vw, 84px);
    --cut: clamp(36px, 4vw, 64px);
    width: 100%;
    max-width: none;
    line-height: normal;
  }
  .title-card .ph-plate__tab { width: 72px; }
  .title-card__in {
    display: grid;
    gap: 18px 40px;
  }
  @media (min-width: 900px) {
    .title-card__in {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
    }
  }
  .title-card__head {
    display: flex;
    align-items: flex-start;
    gap: clamp(12px, 1.6vw, 22px);
    min-width: 0;
  }
  .title-card__idx {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-width: 42px;
    height: 36px;
    margin-top: 0.3em;
    font-size: 14px;
    color: var(--color-ph-gold);
    box-shadow: inset 0 0 0 1px var(--color-ph-gold);
  }
  .title-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(40px, 10vw, 104px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: var(--color-ph-white);
    min-width: 0;
  }
  .title-card:last-child .title-card__title { color: var(--color-ph-gold); }
  .title-card__body {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(16px, calc(0.19vw + 15.3px), 18px);
    line-height: 1.65;
    color: var(--ph-ink-body);
  }

  /* ── 03 Equipo ───────────────────────────────────────────────────────── */
  .abt-team {
    position: relative;
    z-index: 1;
    padding: clamp(80px, 11vw, 150px) var(--ph-section-px) 0;
  }
  .abt-team__bugs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
  }
  .abt-team__title {
    margin: clamp(26px, 3.4vw, 44px) 0 clamp(26px, 3.4vw, 44px);
    font-size: clamp(38px, 9.4vw, 96px);
  }

  /* La hoja de alineación. */
  .sheet {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sheet__row {
    --cut: 30px;
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    min-height: 62px;
    padding: 10px calc(var(--cut) + 8px) 10px 10px;
    transition: clip-path var(--ph-dur-wipe) var(--ph-ease-out) var(--cd, 0ms);
    clip-path: inset(-6px -6px -6px -6px);
  }
  .sheet__row::before,
  .sheet__row::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .sheet__row::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%);
  }
  .sheet__row::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut) + 0.59px), calc(100% - var(--cut) + 0.59px) 100%, 0 100%);
    transition: background-color var(--ph-dur-state) var(--ph-ease-std);
  }
  :global(html.ph-anim) .sheet__row:not(.is-inview) { clip-path: inset(-6px 100% -6px -6px); }
  :global(html.ph-anim:not(.ph-motion)) .sheet__row { animation: ph-failsafe-unclip 0s linear 2.5s forwards; }
  @media (hover: hover) and (pointer: fine) {
    .sheet__row:hover::after { background: #15171b; }
    .sheet__row:hover .sheet__name { color: var(--color-ph-gold); }
  }
  .sheet__idx {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    font-size: 13px;
    color: var(--color-ph-gold);
    box-shadow: inset 0 0 0 1px rgba(214, 178, 94, 0.7);
  }
  .sheet__who {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .sheet__name {
    font-family: var(--font-display);
    font-size: clamp(18px, calc(0.6vw + 15.6px), 24px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.15;
    color: var(--color-ph-white);
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }
  .sheet__mobile {
    font-size: 14px;
    line-height: 1.45;
    color: var(--ph-ink-meta);
  }
  .sheet__role,
  .sheet__loc { display: none; }

  @media (min-width: 900px) {
    .sheet__row {
      /* La sede, en una columna fija: con `auto`, cada fila medía distinto y el
         cargo no caía en la misma vertical. 132 px caben «PORTOGALLO». */
      grid-template-columns: 46px minmax(0, 1.2fr) minmax(0, 1.3fr) 132px;
      gap: 24px;
    }
    .sheet__mobile { display: none; }
    .sheet__role {
      display: block;
      font-size: 14px;
      line-height: 1.4;
      color: var(--ph-ink-lead);
    }
    /* La sede, en su placa pequeña. */
    .sheet__loc {
      --c: 26px;
      position: relative;
      z-index: 0;
      display: inline-flex;
      align-items: center;
      justify-self: end;
      height: 26px;
      padding: 0 calc(var(--c) * 0.8) 0 10px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: rgba(255, 255, 255, 0.86);
    }
    .sheet__loc::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: rgba(255, 255, 255, 0.07);
      clip-path: polygon(0 0, 100% 0, calc(100% - var(--c)) 100%, 0 100%);
    }
  }

  /* ── 04 Presencia ────────────────────────────────────────────────────── */
  .abt-presence {
    position: relative;
    z-index: 1;
    padding: clamp(80px, 11vw, 150px) var(--ph-section-px) 0;
  }
  .abt-presence__grid {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    margin-top: clamp(30px, 4vw, 48px);
  }
  @media (min-width: 900px) {
    .abt-presence__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
    }
  }
  .abt-presence__hq {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .abt-presence__madrid {
    margin: 0;
    font-size: clamp(64px, 17vw, 144px);
  }
  .abt-presence__intl {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  /* La lista de señales: cada país en su fila, con su código en una celda de filo
     dorado. */
  .signals {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .signal {
    --cut: 48px;
    position: relative;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 6px calc(var(--cut) * 0.96) 6px 16px;
    transition: clip-path var(--ph-dur-wipe) var(--ph-ease-out) var(--cd, 0ms);
    clip-path: inset(-4px -4px -4px -4px);
  }
  .signal::before,
  .signal::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .signal::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, 0 100%);
  }
  .signal::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, calc(100% - 0.41px) 0, calc(100% - var(--cut) + 1.59px) 100%, 0 100%);
  }
  :global(html.ph-anim) .signal:not(.is-inview) { clip-path: inset(-4px 100% -4px -4px); }
  :global(html.ph-anim:not(.ph-motion)) .signal { animation: ph-failsafe-unclip 0s linear 2.5s forwards; }
  .signal__name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--color-ph-white);
  }
  .signal__code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 46px;
    height: 30px;
    padding: 0 8px;
    font-size: 13px;
    color: var(--color-ph-gold);
    box-shadow: inset 0 0 0 1px var(--color-ph-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet__row,
    .sheet__row::after,
    .sheet__name,
    .signal { transition: none; }
  }
</style>

<script>
  import { mountSection, afterTransitionPaint } from '@/scripts/ph-text-animations';

  function initAbout(): void {
    const section = document.querySelector<HTMLElement>('.about-section');
    if (section) mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initAbout));
</script>

