---
import { useTranslations, type Lang } from '@/i18n/utils';
import { getTeamMembers } from '@/lib/teamMembers';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const teamMembers = getTeamMembers(lang);

const internationalCountries = [
  { key: 'portugal' as const, iso: 'PT' },
  { key: 'uk' as const,       iso: 'UK' },
  { key: 'alemania' as const, iso: 'DE' },
  { key: 'italia' as const,   iso: 'IT' },
  { key: 'arabia' as const,   iso: 'KSA' },
  { key: 'uruguay' as const,  iso: 'UY' },
];

---

<section class="about-section" aria-labelledby="about-hero-title">
  <!-- 01 HERO: cabecera «Escenario», como Talentos y Servicios. La luz animada
       la llena entera; titular e introducción se apoyan abajo. -->
  <div class="abt-hero">
    <div class="ph-stage-bg" aria-hidden="true">
      <canvas class="ph-ambient" data-ambient="calidez"></canvas>
    </div>
    <div class="abt-hero__grid">
      <div class="abt-eyebrow abt-hero__eyebrow" data-reveal>{t('about.hero.eyebrow')}</div>
      <h1 id="about-hero-title" class="abt-hero__title" data-reveal>
        {t('about.hero.titlePre')}<span class="abt-gold">{t('about.hero.titleAccent')}</span>{t('about.hero.titlePost')}
      </h1>
      <p class="abt-hero__body abt-hero__lead" data-reveal>{t('about.hero.body1')}</p>
    </div>
  </div>

  <!-- Bajo la línea de la cabecera: valores y pie en una franja, y el resto de la
       presentación en dos columnas. Mismo texto y mismo orden que antes. -->
  <div class="abt-hero__rail">
    <div class="abt-hero__values" data-reveal>{t('about.hero.values')}</div>
    <div class="abt-hero__caption">{t('about.hero.caption')}</div>
  </div>
  <div class="abt-intro">
    <p class="abt-hero__body" data-reveal>{t('about.hero.body2')}</p>
    <p class="abt-hero__body" data-reveal>{t('about.hero.body3')}</p>
  </div>

  <!-- 02 MANIFESTO (Now. Next. Forever Football. — explicado por bloques) -->
  <div class="abt-manifesto" id="historia">
    <div class="abt-manifesto__head">
      <div class="abt-eyebrow">{t('about.manifesto.eyebrow')}</div>
    </div>

    <div class="abt-manifesto__rows">
      {[
        { idx: t('about.manifesto.blocks.now.idx'),     title: t('about.manifesto.blocks.now.title'),     body: t('about.manifesto.blocks.now.body') },
        { idx: t('about.manifesto.blocks.next.idx'),    title: t('about.manifesto.blocks.next.title'),    body: t('about.manifesto.blocks.next.body') },
        { idx: t('about.manifesto.blocks.forever.idx'), title: t('about.manifesto.blocks.forever.title'), body: t('about.manifesto.blocks.forever.body') },
      ].map((row) => (
        <article class="abt-manifesto__row">
          <span class="abt-manifesto__idx">{row.idx}</span>
          <h3 class="abt-manifesto__title">{row.title}</h3>
          <p class="abt-manifesto__body">{row.body}</p>
        </article>
      ))}
    </div>
  </div>

  <!-- 03 EQUIPO -->
  <div class="abt-team" id="equipo" aria-labelledby="about-team-title">
    <div class="abt-team__head">
      <div>
        <div class="abt-eyebrow">{t('about.team.eyebrow')}</div>
        <h2 id="about-team-title" class="abt-team__title">
          {t('about.team.titlePre')}<span class="abt-gold">{t('about.team.titleAccent')}</span>{t('about.team.titlePost')}
        </h2>
      </div>
      <div class="abt-team__meta">{t('about.team.meta')}</div>
    </div>

    <div class="abt-team-table" role="list">
      {teamMembers.map((m) => (
        <div class="abt-team-row" role="listitem" data-id={m.id}>
          <span class="abt-team-row__idx">{m.index}</span>
          <div class="abt-team-row__name">
            <span class="abt-team-row__name-text">{m.name}</span>
            <span class="abt-team-row__mobile-extras">
              {m.role} · {m.country ?? m.defaultLocation}
            </span>
          </div>
          <span class="abt-team-row__role">{m.role}</span>
          <span class="abt-team-row__flag">
            <span>{(m.country ?? m.defaultLocation).toUpperCase()}</span>
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- 04 PRESENCIA -->
  <div class="abt-presencia" id="presencia" aria-labelledby="about-presencia-title">
    <div class="abt-presencia__eyebrow-row">
      <div class="abt-eyebrow">{t('about.presencia.eyebrow')}</div>
    </div>
    <div class="abt-presencia__grid">
      <div class="abt-presencia__left">
        <h3 id="about-presencia-title" class="abt-presencia__madrid">
          {t('about.presencia.madridTitle')}
        </h3>
        <div class="abt-presencia__madrid-label">{t('about.presencia.madridLabel')}</div>
      </div>
      <div class="abt-presencia__right">
        <div class="abt-presencia__intl-label">{t('about.presencia.internationalLabel')}</div>
        <div class="abt-presencia__countries">
          {internationalCountries.map((c) => (
            <div class="abt-presencia__country">
              <span>{t(`about.presencia.country.${c.key}` as const)}</span>
              <span class="abt-presencia__iso">{c.iso}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  .about-section {
    --abt-gold: var(--color-ph-gold);
    --abt-ink: var(--color-ph-white);
    --abt-ink-soft: var(--color-ph-white-80);
    --abt-ink-faint: var(--color-ph-white-60);
    --abt-line: var(--color-ph-white-10);
    --abt-line-strong: var(--color-ph-white-20);
    --abt-bg: transparent;
    --abt-bg-2: rgba(255, 255, 255, 0.02);
    --edge: var(--ph-section-px);

    position: relative;
    background: var(--abt-bg);
    color: var(--abt-ink);
  }

  .about-section .abt-gold {
    color: var(--abt-gold);
    font-weight: 400;
    font-style: italic;
  }

  /* Shared eyebrow pattern (mono). */
  .about-section .abt-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--abt-gold);
  }

  /* Rótulo de la cabecera: barra dorada de 28px delante, como en Servicios y Talentos. */
  .about-section .abt-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    grid-column: 1 / -1;
    justify-self: start;
    margin-bottom: var(--ph-stage-eyebrow-gap);
  }
  .about-section .abt-hero__eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--abt-gold);
  }

  /* ── 01 HERO: cabecera «Escenario» (cifras en global.css, `--ph-stage-*`) ── */
  .abt-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: var(--ph-stage-min-h);
    padding: var(--ph-stage-pad-top) var(--edge) var(--ph-stage-pad-bottom);
    border-bottom: 1px solid var(--abt-line);
  }
  /* Rejilla de 12 columnas: titular en las 8 primeras, introducción en las 4
     últimas, con su última línea a la altura de la del titular. */
  .abt-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--ph-stage-gap);
    align-items: end;
    align-items: last baseline;
  }
  .abt-hero__title {
    grid-column: 1 / 9;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--ph-stage-title-size);
    letter-spacing: -0.03em;
    line-height: 0.96;
    margin: 0;
    text-wrap: balance;
  }
  .abt-hero__body {
    color: var(--abt-ink-soft);
    font-size: 16px;
    line-height: 1.65;
    max-width: 42ch;
    margin: 0;
  }
  .abt-hero__lead { grid-column: 9 / 13; }

  /* Franja bajo la línea de la cabecera: valores a un lado y pie al otro, en la
     misma voz mono. */
  .abt-hero__rail {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    padding: 18px var(--edge);
    border-bottom: 1px solid var(--abt-line);
  }
  .abt-hero__values,
  .abt-hero__caption {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--abt-ink-faint);
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  /* El resto de la presentación, en dos columnas alineadas con la introducción. */
  .abt-intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--ph-stage-gap);
    row-gap: 16px;
    padding: clamp(48px, 6vw, 88px) var(--edge);
    border-bottom: 1px solid var(--abt-line);
  }
  .abt-intro .abt-hero__body:nth-child(1) { grid-column: 5 / 9; }
  .abt-intro .abt-hero__body:nth-child(2) { grid-column: 9 / 13; }

  /* Móvil: la luz queda detrás del texto, que se apoya abajo en una sola columna. */
  @media (max-width: 900px) {
    .abt-hero {
      min-height: var(--ph-stage-min-h-mobile);
      padding-top: clamp(110px, 26vw, 150px);
    }
    .abt-hero__grid { grid-template-columns: minmax(0, 1fr); row-gap: 18px; }
    .abt-hero__title,
    .abt-hero__lead { grid-column: 1 / -1; }
    .abt-intro { grid-template-columns: minmax(0, 1fr); }
    .abt-intro .abt-hero__body:nth-child(1),
    .abt-intro .abt-hero__body:nth-child(2) { grid-column: 1 / -1; }
  }

  /* ── 02 MANIFESTO (Now. Next. Forever Football.) ── */
  .abt-manifesto {
    padding: clamp(72px, 10vw, 140px) var(--edge);
    border-bottom: 1px solid var(--abt-line);
  }
  .abt-manifesto__head {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .abt-manifesto__rows {
    border-top: 1px solid var(--abt-line-strong);
  }
  .abt-manifesto__row {
    display: grid;
    grid-template-columns: 80px 1.3fr 1.7fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
    padding-block: clamp(36px, 5vw, 64px);
    border-bottom: 1px solid var(--abt-line);
    transition: padding 300ms var(--ease-ph, ease), background 300ms var(--ease-ph, ease);
  }
  .abt-manifesto__idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--abt-ink-faint);
    letter-spacing: 0.2em;
    /* Compensar el desplazamiento del baseline tipográfico para que el "01"
       quede ópticamente alineado con la cap-height del título. */
    padding-top: 0.6em;
  }
  /* Estado base (desktop con puntero): blanco display 500, sin itálica.
     El lockup de marca (oro + itálico, idéntico a .hero-claim__accent) se
     "desbloquea" al hacer hover. En mobile / touch (sin hover disponible)
     se aplica directamente como base — ver media queries más abajo. */
  .abt-manifesto__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 5.5vw, 72px);
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
    color: var(--abt-ink);
    transition: color 300ms var(--ease-ph, ease);
  }
  .abt-manifesto__body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--abt-ink-soft);
    margin: 0;
    max-width: 480px;
    /* El body alinea ópticamente con el primer descender del título. */
    padding-top: 0.4em;
  }

  @media (hover: hover) {
    .abt-manifesto__row:hover {
      padding-inline: 18px;
      background: rgba(201, 164, 90, 0.04);
    }
    /* Hover desbloquea el lockup de marca: gold + itálico + weight 400
       (firma del eslogan, idéntica a .hero-claim__accent del home/footer). */
    .abt-manifesto__row:hover .abt-manifesto__title {
      color: var(--abt-gold);
      font-style: italic;
      font-weight: 400;
    }
  }

  @media (max-width: 900px) {
    .abt-manifesto__head {
      margin-bottom: 40px;
    }
    .abt-manifesto__row {
      grid-template-columns: 1fr;
      gap: 14px;
      padding-block: 32px;
    }
    /* Sin hover disponible: el lockup gold + itálico aplica como estado base
       para que la firma de marca sea visible en touch sin necesidad de gesto. */
    .abt-manifesto__title {
      color: var(--abt-gold);
      font-style: italic;
      font-weight: 400;
      font-size: clamp(34px, 9vw, 44px);
    }
    .abt-manifesto__body {
      max-width: none;
    }
    .abt-manifesto__idx {
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .abt-manifesto__idx::after {
      content: '';
      width: 18px;
      height: 1px;
      background: var(--abt-gold);
      opacity: 0.6;
    }
  }

  /* ── 03 EQUIPO ── */
  .abt-team {
    padding: clamp(72px, 10vw, 140px) var(--edge);
    border-bottom: 1px solid var(--abt-line);
  }
  .abt-team__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .abt-team__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(36px, 5vw, 64px);
    letter-spacing: -0.02em;
    margin: 10px 0 0;
    line-height: 1;
  }
  .abt-team__meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--abt-ink-faint);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .abt-team-table {
    border-top: 1px solid var(--abt-line-strong);
  }
  .abt-team-row {
    display: grid;
    grid-template-columns: 60px 1.4fr 1.2fr;
    gap: 24px;
    align-items: center;
    padding-block: clamp(18px, 2.5vw, 28px);
    border-bottom: 1px solid var(--abt-line);
    transition: padding 300ms var(--ease-ph, ease), background 300ms var(--ease-ph, ease);
  }
  @media (hover: hover) {
    .abt-team-row:hover {
      padding-inline: 18px;
      background: rgba(201, 164, 90, 0.04);
    }
    .abt-team-row:hover .abt-team-row__name-text {
      color: var(--abt-gold);
    }
  }
  .abt-team-row__idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--abt-gold);
    letter-spacing: 0.15em;
  }
  .abt-team-row__name-text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    transition: color 300ms var(--ease-ph, ease);
  }
  .abt-team-row__role {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--abt-ink-soft);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .abt-team-row__flag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--abt-ink-soft);
    letter-spacing: 0.1em;
  }
  .abt-team-row__mobile-extras {
    display: none;
  }

  @media (max-width: 900px) {
    .abt-team-row {
      grid-template-columns: 40px 1fr;
      gap: 10px;
      padding-block: 18px;
    }
    .abt-team-row__role,
    .abt-team-row__flag {
      display: none;
    }
    .abt-team-row__name {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .abt-team-row__mobile-extras {
      display: block;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--abt-ink-soft);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-style: normal;
      line-height: 1.5;
    }
  }

  /* ── 04 PRESENCIA ── */
  .abt-presencia {
    padding: clamp(60px, 9vw, 100px) var(--edge);
    border-bottom: 1px solid var(--abt-line);
  }
  .abt-presencia__eyebrow-row {
    margin-bottom: 32px;
  }
  .abt-presencia__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: end;
    border-top: 1px solid var(--abt-line);
    padding-top: clamp(32px, 4vw, 48px);
  }
  .abt-presencia__madrid {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(36px, 5vw, 56px);
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }
  .abt-presencia__madrid-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--abt-ink-faint);
    text-transform: uppercase;
    margin-top: 12px;
  }
  .abt-presencia__intl-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--abt-ink-faint);
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .abt-presencia__countries {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .abt-presencia__country {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--abt-ink);
    border-bottom: 1px solid var(--abt-line);
    padding-bottom: 6px;
  }
  .abt-presencia__iso {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--abt-gold);
    letter-spacing: 0.15em;
  }

  @media (max-width: 900px) {
    .abt-presencia__grid {
      grid-template-columns: 1fr;
      align-items: stretch;
      gap: 32px;
    }
    .abt-presencia__madrid {
      font-size: 40px;
    }
  }

</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion,
    wrapWords,
    splitWords,
    trackingReveal,
    scheduleScrollTriggerRefresh,
    afterTransitionPaint,
    revealReveals,
    revealOnView,
  } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(ScrollTrigger);

  function initAboutAnimations(): void {
    const section = document.querySelector<HTMLElement>('.about-section');
    if (!section) return;

    if (reducedMotion()) {
      // Ensure all content is visible without animating.
      section.querySelectorAll<HTMLElement>('.abt-team-row').forEach((r) => {
        r.style.opacity = '1';
        r.style.transform = 'none';
      });
      return;
    }

    // ── Hero ──
    // El hero está above-the-fold: lo animamos de forma INMEDIATA (sin scrollTrigger).
    // Con scrollTrigger `once` para contenido ya visible en la carga, el trigger
    // fallaba intermitentemente al disparar y los títulos quedaban congelados
    // (invisibles). Mismo patrón fiable que el hero de la home / Servicios.
    const heroEyebrow = section.querySelector<HTMLElement>('.abt-hero .abt-eyebrow');
    if (heroEyebrow) trackingReveal(heroEyebrow);

    const heroTitle = section.querySelector<HTMLElement>('.abt-hero__title');
    if (heroTitle) {
      const words = wrapWords(heroTitle);
      gsap.from(words, {
        yPercent: 115,
        duration: 0.85,
        stagger: 0.07,
        ease: 'power4.out',
        delay: 0.1,
      });
    }

    section.querySelectorAll<HTMLElement>('.abt-hero__body').forEach((body, i) => {
      const spans = splitWords(body);
      gsap.from(spans, {
        opacity: 0,
        filter: 'blur(6px)',
        y: 6,
        duration: 0.6,
        stagger: 0.025,
        ease: 'power2.out',
        delay: 0.3 + i * 0.1,
      });
    });

    const heroValues = section.querySelector<HTMLElement>('.abt-hero__values');
    if (heroValues) trackingReveal(heroValues);

    // ── Manifesto ──
    const manifestoEyebrow = section.querySelector<HTMLElement>('.abt-manifesto .abt-eyebrow');
    if (manifestoEyebrow) trackingReveal(manifestoEyebrow, { trigger: manifestoEyebrow, start: 'top 92%', once: true });

    section.querySelectorAll<HTMLElement>('.abt-manifesto__row').forEach((row) => {
      const idx = row.querySelector<HTMLElement>('.abt-manifesto__idx');
      const title = row.querySelector<HTMLElement>('.abt-manifesto__title');
      const body = row.querySelector<HTMLElement>('.abt-manifesto__body');

      if (idx) {
        gsap.from(idx, {
          opacity: 0,
          y: 8,
          duration: 0.5,
          ease: 'power2.out',
          scrollTrigger: { trigger: row, start: 'top 88%', once: true },
        });
      }
      if (title) {
        revealOnView(title, { y: 18, duration: 0.7 });
      }
      if (body) {
        const spans = splitWords(body);
        gsap.from(spans, {
          opacity: 0,
          filter: 'blur(6px)',
          y: 5,
          duration: 0.55,
          stagger: 0.02,
          ease: 'power2.out',
          scrollTrigger: { trigger: row, start: 'top 88%', once: true },
        });
      }
    });

    // ── Equipo ──
    const teamEyebrow = section.querySelector<HTMLElement>('.abt-team .abt-eyebrow');
    if (teamEyebrow) trackingReveal(teamEyebrow, { trigger: teamEyebrow, start: 'top 88%', once: true });

    const teamTitle = section.querySelector<HTMLElement>('.abt-team__title');
    if (teamTitle) {
      revealOnView(teamTitle, { y: 22, duration: 0.8 });
    }

    const teamMeta = section.querySelector<HTMLElement>('.abt-team__meta');
    if (teamMeta) trackingReveal(teamMeta, { trigger: teamMeta, start: 'top 92%', once: true });

    const teamTable = section.querySelector<HTMLElement>('.abt-team-table');
    const teamRows = section.querySelectorAll<HTMLElement>('.abt-team-row');
    if (teamTable && teamRows.length) {
      gsap.set(teamRows, { opacity: 0, y: 14 });
      gsap.to(teamRows, {
        opacity: 1,
        y: 0,
        duration: 0.45,
        stagger: { each: 0.04, from: 'start' },
        ease: 'power3.out',
        scrollTrigger: { trigger: teamTable, start: 'top 88%', once: true },
        onComplete: () => {
          gsap.set(teamRows, { clearProps: 'opacity,transform' });
        },
      });
      // Safety net — ensure rows are visible even if ScrollTrigger misfires.
      window.setTimeout(() => {
        teamRows.forEach((r) => {
          r.style.opacity = '1';
          r.style.transform = 'none';
        });
      }, 2200);
    }

    // ── Presencia ──
    const presenciaEyebrow = section.querySelector<HTMLElement>('.abt-presencia .abt-eyebrow');
    if (presenciaEyebrow) trackingReveal(presenciaEyebrow, { trigger: presenciaEyebrow, start: 'top 92%', once: true });

    const presenciaLeft = section.querySelector<HTMLElement>('.abt-presencia__left');
    const presenciaRight = section.querySelector<HTMLElement>('.abt-presencia__right');
    if (presenciaLeft && presenciaRight) {
      gsap.from([presenciaLeft, presenciaRight], {
        opacity: 0,
        y: 20,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power2.out',
        scrollTrigger: { trigger: presenciaLeft, start: 'top 88%', once: true },
      });
    }

    revealReveals(section);
    scheduleScrollTriggerRefresh();
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initAboutAnimations));
</script>

<script>
  // Fondo animado de la cabecera (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
