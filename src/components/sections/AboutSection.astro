---
import { useTranslations, type Lang } from '@/i18n/utils';
import { getTeamMembers } from '@/lib/teamMembers';
import SceneLabel from '@/components/ui/SceneLabel.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const teamMembers = getTeamMembers(lang);

const manifesto = [
  { idx: t('about.manifesto.blocks.now.idx'), title: t('about.manifesto.blocks.now.title'), body: t('about.manifesto.blocks.now.body') },
  { idx: t('about.manifesto.blocks.next.idx'), title: t('about.manifesto.blocks.next.title'), body: t('about.manifesto.blocks.next.body') },
  { idx: t('about.manifesto.blocks.forever.idx'), title: t('about.manifesto.blocks.forever.title'), body: t('about.manifesto.blocks.forever.body') },
];

const internationalCountries = [
  { key: 'portugal' as const, iso: 'PT' },
  { key: 'uk' as const,       iso: 'UK' },
  { key: 'alemania' as const, iso: 'DE' },
  { key: 'italia' as const,   iso: 'IT' },
  { key: 'arabia' as const,   iso: 'KSA' },
  { key: 'uruguay' as const,  iso: 'UY' },
];
---

<section class="ab" aria-labelledby="about-hero-title">
  <div class="ph-page-bg" aria-hidden="true">
    <canvas class="ph-ambient" data-ambient="proyeccion"></canvas>
  </div>

  {/* 01 — Cabecera: «Representar con propósito.» gigante («Representar» en oro;
      en italiano «Rappresentare», la palabra que manda en el tamaño), la
      entradilla, los dos rótulos y la presentación en dos columnas suizas. */}
  <header class="ab-hero">
    <SceneLabel text={t('about.hero.eyebrow')} />
    <h1 id="about-hero-title" class="ab-hero__title ph-giant" data-reveal>
      {t('about.hero.titlePre')}<span class="ph-gold">{t('about.hero.titleAccent')}</span>{t('about.hero.titlePost')}
    </h1>
    <p class="ab-hero__lead ph-lead" data-reveal>{t('about.hero.body1')}</p>
    <div class="ab-hero__rail ph-rule" data-inview>
      <span>{t('about.hero.values')}</span>
      <span>{t('about.hero.caption')}</span>
    </div>
    <div class="ab-intro ph-grid">
      <p class="ab-intro__p ph-body" data-reveal>{t('about.hero.body2')}</p>
      <p class="ab-intro__p ph-body" data-reveal>{t('about.hero.body3')}</p>
    </div>
  </header>

  {/* 02 — Filosofía, la pieza de autor de la página: tres cartones de título,
      «Now.», «Next.» y «Forever Football.», cada uno a pantalla completa con su
      índice; el siguiente corta al anterior subiendo por encima con un borde
      duro. Es la respuesta narrativa al lema de la portada. Los cartones se fijan
      con `position: sticky` (sin JS); con movimiento reducido van apilados. */}
  <div class="ab-philo" id="historia">
    <div class="ab-philo__head">
      <SceneLabel text={t('about.manifesto.eyebrow')} />
    </div>
    <div class="ab-philo__cards">
      {manifesto.map((block, i) => (
        <article class="ab-card" style={`--i:${i}`} data-card>
          <div class="ab-card__inner" data-card-inner>
            <p class="ab-card__idx ph-index">{block.idx}</p>
            <h3 class:list={['ab-card__title ph-giant', i === 2 && 'ph-gold']} data-card-title>{block.title}</h3>
            <p class="ab-card__body ph-lead" data-card-body>{block.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  {/* 03 — El equipo, como créditos de película: en escritorio, el cargo alineado a
      la derecha en la columna izquierda y el nombre a la izquierda en la derecha,
      con un canal en medio; en el móvil, una columna centrada. Entran en cascada
      suave según se ven, como un rodillo de créditos (sin moverse solos). */}
  <div class="ab-team" id="equipo" aria-labelledby="about-team-title">
    <SceneLabel text={t('about.team.eyebrow')} meta={t('about.team.meta')} />
    <h2 id="about-team-title" class="ab-team__title ph-giant" data-reveal>
      {t('about.team.titlePre')}<span class="ph-gold">{t('about.team.titleAccent')}</span>{t('about.team.titlePost')}
    </h2>
    <ol class="ab-credits" role="list">
      {teamMembers.map((m) => (
        <li class="ab-credit" data-id={m.id} data-credit>
          <span class="ab-credit__left">
            <span class="ab-credit__idx ph-index">{m.index}</span>
            <span class="ab-credit__role">{m.role}</span>
          </span>
          <span class="ab-credit__right">
            <span class="ab-credit__name">{m.name}</span>
            <span class="ab-credit__loc">{(m.country ?? m.defaultLocation).toUpperCase()}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>

  {/* 04 — Presencia: «Madrid.» gigante con su rótulo y los seis países como
      palabras grandes que alternan izquierda y derecha y entran desde su lado con
      el scroll, con el código ISO en pequeño. */}
  <div class="ab-pres" id="presencia" aria-labelledby="about-presencia-title">
    <SceneLabel text={t('about.presencia.eyebrow')} />
    <div class="ab-pres__hq">
      <h3 id="about-presencia-title" class="ab-pres__madrid ph-giant" data-reveal>{t('about.presencia.madridTitle')}</h3>
      <p class="ab-pres__label">{t('about.presencia.madridLabel')}</p>
    </div>
    <p class="ab-pres__label ab-pres__label--intl">{t('about.presencia.internationalLabel')}</p>
    <ul class="ab-pres__list" role="list">
      {internationalCountries.map((c, i) => (
        <li class:list={['ab-pres__country ph-rule', i % 2 === 1 && 'is-right']} data-country data-inview>
          <span class="ab-pres__name">{t(`about.presencia.country.${c.key}` as const)}</span>
          <span class="ab-pres__iso ph-index">{c.iso}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ab {
    position: relative;
    background: transparent;
    color: var(--color-ph-white);
  }

  .ab-hero,
  .ab-philo,
  .ab-team,
  .ab-pres {
    position: relative;
    z-index: 1;
    padding-inline: var(--ph-section-px);
  }

  /* ── 01 Cabecera ── */
  .ab-hero {
    padding-top: var(--ph-head-top);
    padding-bottom: clamp(64px, 8vw, 120px);
  }

  .ab-hero__title {
    max-width: 12ch;
    margin-top: clamp(20px, 2.6vw, 36px);
    font-size: clamp(46px, 13.2vw, 200px);
  }

  .ab-hero__lead {
    max-width: 40ch;
    margin-top: clamp(18px, 2vw, 28px);
  }

  .ab-hero__rail {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    margin-top: clamp(36px, 4vw, 56px);
    padding-top: 14px;
    font-family: var(--font-body);
    font-size: var(--ph-small);
    letter-spacing: 0.04em;
    color: var(--ph-ink-meta);
  }

  .ab-intro {
    row-gap: 18px;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .ab-intro__p {
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .ab-hero__lead {
      margin-left: calc((100% - 11 * var(--ph-gutter)) / 12 + var(--ph-gutter));
    }

    .ab-intro__p:nth-child(1) { grid-column: 1 / 7; }
    .ab-intro__p:nth-child(2) { grid-column: 7 / 13; }
  }

  /* ── 02 Filosofía: los cartones ── */
  .ab-philo {
    padding-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--ph-hair);
  }

  .ab-philo__cards {
    margin-inline: calc(-1 * var(--ph-section-px));
  }

  /* Sin movimiento: los tres, apilados. */
  .ab-card {
    position: relative;
    z-index: calc(1 + var(--i, 0));
    background: var(--color-ph-black);
  }

  .ab-card__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(16px, 2vw, 28px);
    padding: clamp(56px, 8vw, 104px) var(--ph-section-px);
  }

  .ab-card__idx {
    margin: 0;
  }

  .ab-card__title {
    font-size: min(36vw, calc(var(--ph-viewport-h) * 0.42));
    line-height: 0.84;
    transform-origin: 0% 100%;
  }

  /* «Forever Football.» es más larga: va en dos líneas, a menos tamaño. */
  .ab-card:last-child .ab-card__title {
    font-size: min(18vw, calc(var(--ph-viewport-h) * 0.2));
  }

  .ab-card__body {
    max-width: 34ch;
    transition:
      opacity 420ms var(--ph-ease-out),
      transform 520ms var(--ph-ease-out);
  }

  @media (min-width: 1024px) {
    .ab-card__title {
      font-size: min(30vw, calc(var(--ph-viewport-h) * 0.6));
    }

    .ab-card:last-child .ab-card__title {
      font-size: min(15vw, calc(var(--ph-viewport-h) * 0.32));
    }

    .ab-card__body {
      margin-left: calc((100% - 11 * var(--ph-gutter)) / 12 * 7 + var(--ph-gutter) * 7);
    }
  }

  /* Con movimiento: cada cartón ocupa la pantalla y se queda fijado; el
     siguiente sube por encima con un borde duro (el corte). El margen de debajo
     de cada uno es lo que dura en pantalla antes del corte. El contenido va al
     centro, y el índice arriba a la izquierda, como el rótulo de escena. */
  :global(html.ph-anim) .ab-philo__cards {
    padding-bottom: calc(var(--ph-viewport-h) * 0.4);
  }

  :global(html.ph-anim) .ab-card {
    position: sticky;
    top: 0;
    height: var(--ph-viewport-h);
    overflow: hidden; /* Safari < 16 no conoce `clip` */
    overflow: clip;
  }

  :global(html.ph-anim) .ab-card + .ab-card {
    margin-top: calc(var(--ph-viewport-h) * 0.4);
    box-shadow: inset 0 1px 0 var(--ph-hair-strong);
  }

  :global(html.ph-anim) .ab-card__inner {
    position: relative;
    height: 100%;
    justify-content: center;
    padding-block: calc(var(--ph-head-top) + 28px) 40px;
  }

  :global(html.ph-anim) .ab-card__idx {
    position: absolute;
    top: var(--ph-head-top);
    left: var(--ph-section-px);
  }

  /* El texto de cada cartón aparece cuando el título asienta (lo marca el JS con
     `is-set`). Sin JS, siempre a la vista. */
  :global(html.ph-anim.ph-motion) .ab-card:not(.is-set) .ab-card__body {
    opacity: 0;
    transform: translateY(14px);
  }

  /* ── 03 Equipo: créditos ── */
  .ab-team {
    padding-top: clamp(72px, 10vw, 144px);
    padding-bottom: clamp(72px, 10vw, 144px);
  }

  .ab-team__title {
    margin-top: clamp(28px, 4vw, 56px);
    font-size: clamp(56px, 16vw, 220px);
  }

  .ab-credits {
    display: flex;
    flex-direction: column;
    gap: clamp(22px, 2.6vw, 30px);
    margin: clamp(48px, 7vw, 104px) 0 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  /* Móvil: una columna centrada; el cargo encima y el nombre debajo, con la sede
     pequeña detrás. */
  .ab-credit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .ab-credit__left {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }

  .ab-credit__role {
    font-family: var(--font-body);
    font-size: var(--ph-small);
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: var(--ph-ink-meta);
  }

  .ab-credit__right {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 4px 10px;
  }

  .ab-credit__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, calc(0.4vw + 18.4px), 24px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-ph-white);
  }

  .ab-credit__loc {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ph-ink-meta);
  }

  /* Escritorio: dos columnas con un canal central. Cargo a la derecha (y el
     índice al borde izquierdo), nombre a la izquierda. */
  @media (min-width: 768px) {
    .ab-credits {
      gap: clamp(14px, 1.4vw, 20px);
      text-align: left;
    }

    .ab-credit {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(32px, 5vw, 80px);
      align-items: baseline;
    }

    .ab-credit__left {
      display: flex;
      justify-content: space-between;
      gap: 24px;
    }

    .ab-credit__role {
      text-align: right;
    }

    .ab-credit__right {
      justify-content: flex-start;
    }
  }

  /* ── 04 Presencia ── */
  .ab-pres {
    padding-top: clamp(72px, 10vw, 144px);
    padding-bottom: clamp(96px, 12vw, 176px);
    border-top: 1px solid var(--ph-hair);
  }

  .ab-pres__hq {
    margin-top: clamp(28px, 4vw, 56px);
  }

  /* «Madrid.» mide 3,3 em de Söhne 700: a 26vw cabe con sus márgenes. */
  .ab-pres__madrid {
    font-size: clamp(72px, 26vw, 380px);
  }

  .ab-pres__label {
    margin: 14px 0 0;
    font-family: var(--font-body);
    font-size: var(--ph-small);
    letter-spacing: 0.04em;
    color: var(--ph-ink-lead);
  }

  .ab-pres__label--intl {
    margin-top: clamp(48px, 7vw, 96px);
  }

  .ab-pres__list {
    margin: 16px calc(-1 * var(--ph-section-px)) 0;
    padding: 0 var(--ph-section-px);
    list-style: none;
    overflow-x: hidden; /* Safari < 16 no conoce `clip` */
    overflow-x: clip;
  }

  .ab-pres__country {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-block: clamp(10px, 1.4vw, 18px);
  }

  .ab-pres__country.is-right {
    flex-direction: row-reverse;
  }

  .ab-pres__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(36px, 10vw, 150px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--color-ph-white);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, riseWords, fadeUp, mountSection, afterTransitionPaint,
  } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(ScrollTrigger);

  function initAbout(): void {
    const section = document.querySelector<HTMLElement>('.ab');
    if (!section) return;

    if (!reducedMotion()) {
      // Cabecera: el titular sube por palabras; detrás, la entradilla y los dos
      // párrafos.
      const title = section.querySelector<HTMLElement>('.ab-hero__title');
      if (title) riseWords(title, { delay: 0.06, stagger: 0.06 });
      fadeUp(section.querySelectorAll<HTMLElement>('.ab-hero__lead'), { delay: 0.32 });
      fadeUp(section.querySelectorAll<HTMLElement>('.ab-intro__p'), { delay: 0.42, stagger: 0.1 });

      // Filosofía: cada cartón asienta su título mientras sube (ligado al scroll)
      // y su contenido va por detrás del borde, como una máscara. El texto
      // aparece cuando el cartón llega arriba.
      section.querySelectorAll<HTMLElement>('[data-card]').forEach((card, i) => {
        const inner = card.querySelector<HTMLElement>('[data-card-inner]');
        const cardTitle = card.querySelector<HTMLElement>('[data-card-title]');
        if (i > 0 && inner) {
          gsap.fromTo(
            inner,
            { y: () => -window.innerHeight * 0.3 },
            { y: 0, ease: 'none', scrollTrigger: { trigger: card, start: 'top bottom', end: 'top top', scrub: true, invalidateOnRefresh: true } },
          );
        }
        if (cardTitle) {
          gsap.fromTo(
            cardTitle,
            { scale: 1.08 },
            { scale: 1, ease: 'none', scrollTrigger: { trigger: card, start: 'top bottom', end: 'top top', scrub: 0.3 } },
          );
        }
        ScrollTrigger.create({
          trigger: card,
          start: 'top 12%',
          onEnter: () => card.classList.add('is-set'),
          onLeaveBack: () => card.classList.remove('is-set'),
        });
      });

      // El equipo: titular por palabras y los créditos entrando en tandas, según
      // aparecen (un rodillo que mueve el scroll, no el tiempo).
      const teamTitle = section.querySelector<HTMLElement>('.ab-team__title');
      if (teamTitle) riseWords(teamTitle, { stagger: 0.06 });
      const credits = section.querySelectorAll<HTMLElement>('[data-credit]');
      gsap.set(credits, { opacity: 0, y: 14 });
      ScrollTrigger.batch(credits, {
        start: 'top 92%',
        once: true,
        onEnter: (batch) => gsap.to(batch, { opacity: 1, y: 0, duration: 0.5, ease: 'ph-out', stagger: 0.06, overwrite: true }),
      });

      // Presencia: «Madrid.» sube y cada país entra desde su lado con el scroll.
      const madrid = section.querySelector<HTMLElement>('.ab-pres__madrid');
      if (madrid) riseWords(madrid);
      section.querySelectorAll<HTMLElement>('[data-country]').forEach((country) => {
        const fromRight = country.classList.contains('is-right');
        gsap.fromTo(
          country.children,
          { x: () => (fromRight ? 1 : -1) * window.innerWidth * 0.22, opacity: 0.2 },
          {
            x: 0,
            opacity: 1,
            ease: 'none',
            scrollTrigger: { trigger: country, start: 'top 98%', end: 'top 62%', scrub: 0.3, invalidateOnRefresh: true },
          },
        );
      });
    }

    mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initAbout));
</script>

<script>
  // Fondo vivo de la página (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
