---
import { useTranslations, type Lang } from '@/i18n/utils';
import { getTeamMembers } from '@/lib/teamMembers';
import Zone from '@/components/ui/Zone.astro';
import Visor from '@/components/ui/Visor.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const teamMembers = getTeamMembers(lang);

const steps = [
  { idx: t('about.manifesto.blocks.now.idx'), title: t('about.manifesto.blocks.now.title'), body: t('about.manifesto.blocks.now.body') },
  { idx: t('about.manifesto.blocks.next.idx'), title: t('about.manifesto.blocks.next.title'), body: t('about.manifesto.blocks.next.body') },
  { idx: t('about.manifesto.blocks.forever.idx'), title: t('about.manifesto.blocks.forever.title'), body: t('about.manifesto.blocks.forever.body') },
];

// El mapa de sedes: un esquema, no un mapa. Madrid en el centro y cada sede en
// su dirección aproximada, con un arco de trayectoria desde Madrid. Uruguay está
// al otro lado del Atlántico: su arco sale por la izquierda del esquema.
// Coordenadas del dibujo (400 × 400); `side` dice dónde va la etiqueta.
const HUB = { x: 214, y: 196 };
const offices = [
  { key: 'portugal' as const, iso: 'PT', x: 152, y: 214, side: 'left' },
  { key: 'uk' as const, iso: 'UK', x: 186, y: 104, side: 'top' },
  { key: 'alemania' as const, iso: 'DE', x: 268, y: 116, side: 'right' },
  { key: 'italia' as const, iso: 'IT', x: 288, y: 190, side: 'right' },
  { key: 'arabia' as const, iso: 'KSA', x: 366, y: 300, side: 'left' },
  { key: 'uruguay' as const, iso: 'UY', x: 52, y: 346, side: 'bottom' },
];
const r2 = (v: number) => Math.round(v * 10) / 10;
/** Arco de Madrid a la sede: una curva que se levanta del suelo, como un vuelo. */
function arc(o: { x: number; y: number; key: string }): string {
  const dx = o.x - HUB.x;
  const dy = o.y - HUB.y;
  const len = Math.hypot(dx, dy);
  // La normal hacia arriba (y negativa); Uruguay, más alta y por fuera.
  let nx = -dy / len;
  let ny = dx / len;
  if (ny > 0) { nx = -nx; ny = -ny; }
  const lift = o.key === 'uruguay' ? len * 0.62 : len * 0.32;
  const cx = HUB.x + dx / 2 + nx * lift;
  const cy = HUB.y + dy / 2 + ny * lift;
  return `M${HUB.x} ${HUB.y}Q${r2(cx)} ${r2(cy)} ${o.x} ${o.y}`;
}
---

<section class="about-section" aria-labelledby="about-hero-title">
  <div class="ph-page-bg" aria-hidden="true">
    <canvas class="ph-ambient" data-ambient="calidez"></canvas>
  </div>

  <!-- 01 Cabecera: zona, titular fijado por un visor y entradilla. -->
  <div class="abt-hero">
    <Zone text={t('about.hero.eyebrow')} />
    <h1 id="about-hero-title" class="abt-hero__title ph-head-title" data-inview>
      <span class="ph-enter">{t('about.hero.titlePre')}<span class="ph-accent abt-hero__line">{t('about.hero.titleAccent')}</span>{t('about.hero.titlePost')}</span>
      <Visor mode="view" arm={20} inset={-12} />
    </h1>
    <p class="abt-hero__lead ph-head-lead" data-inview><span class="ph-enter">{t('about.hero.body1')}</span></p>
  </div>

  <!-- Identidad: los valores y el pie, como etiquetas sobre una regla; los dos
       párrafos, en dos columnas con un divisor que se dibuja. -->
  <div class="abt-id" data-inview>
    <span class="abt-id__rule" aria-hidden="true"></span>
    <p class="abt-id__tag ph-enter"><span class="ph-node ph-node--sm" aria-hidden="true"></span>{t('about.hero.values')}</p>
    <p class="abt-id__tag abt-id__tag--right ph-enter"><span class="ph-node ph-node--sm" aria-hidden="true"></span>{t('about.hero.caption')}</p>
  </div>
  <div class="abt-intro" data-inview>
    <p class="abt-intro__body ph-enter">{t('about.hero.body2')}</p>
    <span class="abt-intro__divider" aria-hidden="true"></span>
    <p class="abt-intro__body ph-enter">{t('about.hero.body3')}</p>
  </div>

  <!-- 02 Filosofía: Now → Next → Forever Football., una línea de tiempo que se
       dibuja con el scroll; cada nodo descubre su título y su texto al pasar. -->
  <div class="abt-line" id="historia" data-abt-line>
    <Zone text={t('about.manifesto.eyebrow')} />
    <div class="abt-line__track" data-abt-track>
      <span class="abt-line__axis" aria-hidden="true"><span class="abt-line__axis-fill" data-abt-axis></span></span>
      <ol class="abt-line__steps" role="list">
        {steps.map((s, i) => (
          <li class="abt-step" data-abt-step style={`--i: ${i}`}>
            <span class="abt-step__node" aria-hidden="true"><span class="ph-node ph-node--lg"></span></span>
            <span class="abt-step__idx ph-num">{s.idx}</span>
            <h3 class="abt-step__title">{s.title}</h3>
            <p class="abt-step__body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- 03 Equipo: la hoja de plantilla. -->
  <div class="abt-team" id="equipo" aria-labelledby="about-team-title">
    <div class="abt-team__head" data-inview>
      <Zone as="div" text={t('about.team.eyebrow')} meta={t('about.team.meta')} />
      <h2 id="about-team-title" class="abt-team__title ph-enter">
        {t('about.team.titlePre')}<span class="ph-accent">{t('about.team.titleAccent')}</span>{t('about.team.titlePost')}
      </h2>
    </div>

    <div class="abt-sheet" role="list">
      {teamMembers.map((m, i) => (
        <div class="abt-row" role="listitem" data-id={m.id} data-inview style={`--r: ${i % 8}`}>
          <span class="abt-row__idx ph-num">{m.index}</span>
          <span class="abt-row__name">{m.name}</span>
          <span class="abt-row__role">{m.role}</span>
          <span class="abt-row__place">{(m.country ?? m.defaultLocation).toUpperCase()}</span>
          <span class="abt-row__mobile">{m.role} · {(m.country ?? m.defaultLocation).toUpperCase()}</span>
          <span class="ph-visor ph-visor--hover abt-row__visor" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        </div>
      ))}
    </div>
  </div>

  <!-- 04 Presencia: el esquema de sedes, la pieza de autor de la página. -->
  <div class="abt-presencia" id="presencia" aria-labelledby="about-presencia-title">
    <Zone text={t('about.presencia.eyebrow')} />
    <div class="abt-map" data-inview data-abt-map>
      <h3 id="about-presencia-title" class="abt-map__title ph-enter">{t('about.presencia.madridTitle')}</h3>
      <p class="abt-map__hq ph-enter"><span class="ph-node ph-node--sm ph-node--filled" aria-hidden="true"></span>{t('about.presencia.madridLabel')}</p>
      <div class="abt-map__fig" aria-hidden="true">
        <svg class="abt-map__svg" viewBox="0 0 400 400" data-hairline>
          <circle class="abt-map__ring" cx={HUB.x} cy={HUB.y} r="128" />
          <circle class="abt-map__ring abt-map__ring--far" cx={HUB.x} cy={HUB.y} r="196" />
          {offices.map((o, i) => (
            <path class="abt-map__arc ph-draw" d={arc(o)} style={`--draw-delay: ${200 + i * 110}ms`} data-arc={i} />
          ))}
          {offices.map((o, i) => (
            <g class="abt-map__node" style={`--i: ${i}`}>
              <circle cx={o.x} cy={o.y} r="8" />
              <circle class="abt-map__dot" cx={o.x} cy={o.y} r="2.4" />
            </g>
          ))}
          <circle class="abt-map__hub" cx={HUB.x} cy={HUB.y} r="12" />
          <circle class="abt-map__dot" cx={HUB.x} cy={HUB.y} r="3.6" />
          {offices.map((_, i) => (
            <circle class="abt-map__ball" r="3.4" cx={HUB.x} cy={HUB.y} data-ball={i} />
          ))}
        </svg>
      </div>
      <p class="abt-map__intl ph-enter">{t('about.presencia.internationalLabel')}</p>
      <ul class="abt-map__list" role="list">
        {offices.map((o, i) => (
          <li
            class={`abt-map__place abt-map__place--${o.side}`}
            style={`--x: ${(o.x / 400) * 100}%; --y: ${(o.y / 400) * 100}%; --i: ${i}`}
          >
            <span class="ph-node ph-node--sm abt-map__place-node" aria-hidden="true"></span>
            <span class="abt-map__place-name">{t(`about.presencia.country.${o.key}`)}</span>
            <span class="abt-map__place-iso ph-num">{o.iso}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    color: var(--color-ph-white);
  }

  .about-section > * { position: relative; z-index: 1; }
  .about-section > .ph-page-bg { position: fixed; z-index: -1; }

  /* ── 01 Cabecera ── */
  .abt-hero {
    padding: var(--ph-head-top) var(--ph-section-px) 0;
  }

  .abt-hero__title {
    position: relative;
    display: inline-block;
  }

  .abt-hero__title .ph-enter { display: block; }
  /* «Representar» en su línea: así la caja del titular (y su visor) se ciñe a
     las dos líneas en vez de al ancho máximo del bloque. */
  .abt-hero__line { display: block; }
  .abt-hero__lead .ph-enter { --enter-delay: 90ms; display: block; }

  /* Identidad: dos etiquetas sobre una regla. */
  .abt-id {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    margin: var(--ph-head-after) var(--ph-section-px) 0;
    padding-top: 14px;
  }

  .abt-id__rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--ph-struct);
    transform-origin: 0 50%;
    transition: transform var(--ph-dur-field) var(--ph-ease-out);
  }

  :global(html.ph-anim) .abt-id:not(.is-inview) .abt-id__rule { transform: scaleX(0); }
  :global(html.ph-anim:not(.ph-motion)) .abt-id__rule { animation: ph-motion-failsafe 0s linear 2.5s forwards; }

  .abt-id__tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: none;
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--ph-ink-meta);
  }

  .abt-id__tag--right { --enter-delay: 80ms; }

  /* Los dos párrafos, a dos columnas con un divisor vertical que se dibuja. */
  .abt-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 22px;
    padding: clamp(24px, calc(1.14vw + 19.5px), 36px) var(--ph-section-px) clamp(64px, 8vw, 112px);
  }

  .abt-intro__body {
    max-width: 62ch;
    margin: 0;
    font-size: clamp(16px, calc(0.19vw + 15.3px), 18px);
    line-height: 1.65;
    color: var(--ph-ink-body);
    text-wrap: pretty;
  }

  .abt-intro__body + .abt-intro__divider + .abt-intro__body { --enter-delay: 120ms; }

  .abt-intro__divider {
    display: block;
    width: 48px;
    height: 1.5px;
    background: rgba(214, 178, 94, 0.6);
    transform-origin: 0 50%;
    transition: transform var(--ph-dur-field) var(--ph-ease-out) 120ms;
  }

  :global(html.ph-anim) .abt-intro:not(.is-inview) .abt-intro__divider { transform: scaleX(0); }

  @media (min-width: 900px) {
    .abt-intro {
      grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
      column-gap: clamp(24px, 3.4vw, 56px);
    }
    .abt-intro__divider {
      width: 1px;
      height: auto;
      align-self: stretch;
      background: var(--ph-struct);
      transform-origin: 50% 0;
    }
    :global(html.ph-anim) .abt-intro:not(.is-inview) .abt-intro__divider { transform: scaleY(0); }
  }

  :global(html.ph-anim:not(.ph-motion)) .abt-intro__divider { animation: ph-motion-failsafe 0s linear 2.5s forwards; }

  /* ── 02 Filosofía: la línea de tiempo ── */
  .abt-line {
    padding: clamp(56px, 8vw, 104px) var(--ph-section-px) clamp(72px, 10vw, 128px);
  }

  .abt-line__track {
    position: relative;
    margin-top: clamp(36px, 5vw, 56px);
  }

  /* El eje: crece con el scroll (ph-scroll-draw.ts). En el móvil, vertical a la
     izquierda; en escritorio, horizontal sobre los tres pasos. */
  .abt-line__axis {
    position: absolute;
    left: 10px;
    top: 10px;
    bottom: 10px;
    width: 1.5px;
    background: var(--ph-struct-soft);
  }

  .abt-line__axis-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ph-gold);
    transform-origin: 50% 0;
  }

  .abt-line__steps {
    display: grid;
    gap: clamp(40px, 6vw, 56px);
    margin: 0;
    padding: 0 0 0 52px;
    list-style: none;
  }

  .abt-step {
    position: relative;
  }

  .abt-step__node {
    position: absolute;
    left: -52px;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
  }

  .abt-step__node .ph-node {
    background-color: var(--color-ph-black);
    transition: background-color var(--ph-dur-state) var(--ph-ease-std);
  }

  .abt-step__idx {
    display: block;
    font-size: 13px;
    line-height: 22px;
    color: var(--color-ph-gold);
  }

  .abt-step__title {
    margin: 10px 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(36px, 5.4vw, 72px);
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--color-ph-white);
  }

  .abt-step__body {
    max-width: 44ch;
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ph-ink-body);
  }

  .abt-step__title,
  .abt-step__body {
    transition:
      opacity 360ms var(--ph-ease-out),
      transform 360ms var(--ph-ease-out);
  }

  .abt-step__body { transition-delay: 90ms; }

  /* Con el script en marcha (`is-armed` en la pista, ph-scroll-draw.ts), cada
     paso espera a que la punta del eje llegue a su nodo; sin él, se ve todo. */
  .abt-line__track.is-armed .abt-step:not(.is-reached) .abt-step__title,
  .abt-line__track.is-armed .abt-step:not(.is-reached) .abt-step__body {
    opacity: 0;
    transform: translateX(-6px);
  }

  .abt-step.is-reached .abt-step__node .ph-node {
    background-color: var(--color-ph-gold);
  }

  .abt-step.is-reached .abt-step__node .ph-node::after {
    background-color: var(--color-ph-black);
  }

  .abt-step.is-reached .abt-step__title { color: var(--color-ph-gold); }

  @media (min-width: 900px) {
    .abt-line__axis {
      left: 0;
      right: 0;
      top: 10px;
      bottom: auto;
      width: auto;
      height: 1.5px;
    }
    .abt-line__axis-fill { transform-origin: 0 50%; }
    .abt-line__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(24px, 3.4vw, 56px);
      padding: 0;
    }
    .abt-step { padding-top: 40px; }
    .abt-step__node { left: 0; top: 0; }
    .abt-step__idx { position: absolute; left: 34px; top: 0; }
    .abt-step__title { margin-top: 0; }
  }

  /* ── 03 Equipo: la hoja de plantilla ── */
  .abt-team {
    padding: clamp(56px, 8vw, 104px) var(--ph-section-px) clamp(72px, 10vw, 128px);
  }

  .abt-team__title {
    --enter-delay: 80ms;
    margin: clamp(22px, 3vw, 32px) 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(40px, 8.4vw, 76px);
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .abt-sheet {
    margin-top: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--ph-struct-soft);
  }

  /* Cada fila: índice, nombre, cargo y sede. Al señalarla, un visor la fija. */
  .abt-row {
    position: relative;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    column-gap: 12px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--ph-struct-soft);
  }

  .abt-row > :not(.abt-row__visor) {
    transition:
      opacity 360ms var(--ph-ease-out) calc(var(--r, 0) * 45ms),
      transform 360ms var(--ph-ease-out) calc(var(--r, 0) * 45ms);
  }

  :global(html.ph-anim) .abt-row:not(.is-inview) > :not(.abt-row__visor) {
    opacity: 0;
    transform: translateX(-6px);
  }

  :global(html.ph-anim:not(.ph-motion)) .abt-row > * {
    animation: ph-motion-failsafe 0s linear 2.5s forwards;
  }

  .abt-row__visor {
    --visor-arm: 10px;
    --visor-inset: 0px -8px;
  }

  .abt-row__idx {
    font-size: 13px;
    color: var(--color-ph-gold);
  }

  .abt-row__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, calc(0.9vw + 16.5px), 30px);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .abt-row__role,
  .abt-row__place {
    display: none;
  }

  .abt-row__mobile {
    grid-column: 2;
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ph-ink-meta);
  }

  @media (hover: hover) and (pointer: fine) {
    .abt-row:hover .abt-row__name { color: var(--color-ph-gold); }
  }

  @media (min-width: 900px) {
    .abt-row {
      grid-template-columns: 52px minmax(0, 1.3fr) minmax(0, 1.2fr) minmax(7em, auto);
      column-gap: 24px;
      align-items: center;
      padding: clamp(14px, 1.6vw, 20px) 0;
    }
    .abt-row__role,
    .abt-row__place { display: block; }
    .abt-row__role {
      font-size: 14px;
      line-height: 1.4;
      color: var(--ph-ink-lead);
    }
    /* La sede en mayúsculas, como «ESPAÑA» en los textos, para que la columna
       sea una sola; a 14 px y sin espaciar: nada de mayúsculas diminutas muy
       espaciadas, que es lo que Mario no quiere leer. */
    .abt-row__place {
      justify-self: end;
      font-size: 14px;
      color: var(--ph-ink-meta);
    }
    .abt-row__mobile { display: none; }
  }

  /* ── 04 Presencia: el esquema de sedes ── */
  .abt-presencia {
    padding: clamp(56px, 8vw, 104px) var(--ph-section-px) clamp(80px, 10vw, 140px);
  }

  .abt-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'title'
      'hq'
      'fig'
      'intl'
      'list';
    margin-top: clamp(28px, 4vw, 48px);
  }

  .abt-map__title {
    grid-area: title;
    margin: 0 0 0 -0.04em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(64px, 14vw, 144px);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .abt-map__hq {
    --enter-delay: 80ms;
    grid-area: hq;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 16px 0 0;
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--ph-ink-meta);
  }

  .abt-map__fig {
    grid-area: fig;
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    margin: clamp(28px, 5vw, 40px) auto 0;
  }

  .abt-map__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Los anillos de distancia, sin números: solo estructura. */
  .abt-map__ring {
    fill: none;
    stroke: var(--ph-struct-soft);
    stroke-width: calc(1 * var(--k, 1));
    stroke-dasharray: calc(2 * var(--k, 1)) calc(6 * var(--k, 1));
  }

  .abt-map__arc {
    fill: none;
    stroke: var(--color-ph-gold);
    stroke-width: calc(1.5 * var(--k, 1));
    --draw-dur: 640ms;
    --draw-ease: cubic-bezier(0.05, 0.7, 0.1, 1);
  }

  .abt-map__node circle:first-child,
  .abt-map__hub {
    fill: var(--color-ph-black);
    stroke: var(--color-ph-gold);
    stroke-width: calc(1.5 * var(--k, 1));
  }

  .abt-map__dot,
  .abt-map__ball { fill: var(--color-ph-gold); }

  .abt-map__ball { opacity: 0; }

  .abt-map__node {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 180ms var(--ph-ease-out) calc(640ms + var(--i, 0) * 110ms),
      transform 180ms var(--ph-ease-out) calc(640ms + var(--i, 0) * 110ms);
  }

  :global(html.ph-anim) .abt-map:not(.is-inview) .abt-map__node {
    opacity: 0;
    transform: scale(0.6);
  }

  .abt-map__intl {
    --enter-delay: 120ms;
    grid-area: intl;
    margin: clamp(24px, 4vw, 36px) 0 10px;
    max-width: none;
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--ph-ink-meta);
  }

  /* Móvil: la lista de sedes, debajo del esquema. */
  .abt-map__list {
    grid-area: list;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ph-struct-soft);
  }

  .abt-map__place {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    border-bottom: 1px solid var(--ph-struct-soft);
    font-size: 15px;
    color: var(--color-ph-white);
    transition: opacity 300ms var(--ph-ease-out) calc(700ms + var(--i, 0) * 70ms);
  }

  .abt-map__place-node { background-color: var(--color-ph-black); }

  .abt-map__place-iso {
    margin-left: auto;
    font-size: 13px;
    color: var(--color-ph-gold);
  }

  :global(html.ph-anim) .abt-map:not(.is-inview) .abt-map__place { opacity: 0; }

  :global(html.ph-anim:not(.ph-motion)) .abt-map__place,
  :global(html.ph-anim:not(.ph-motion)) .abt-map__node {
    animation: ph-motion-failsafe 0s linear 2.5s forwards;
  }

  /* Escritorio: Madrid y sus rótulos a la izquierda; el esquema a la derecha,
     con cada sede rotulada junto a su nodo (la lista se coloca encima). */
  @media (min-width: 900px) {
    .abt-map {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'title fig'
        'hq fig'
        'intl fig';
      column-gap: clamp(40px, 6vw, 96px);
      align-items: start;
    }
    .abt-map__fig {
      width: 100%;
      max-width: 560px;
      margin: 0 0 0 auto;
    }
    /* Debajo de la sede central, para que se lea como la entrada al esquema de
       la derecha: abajo del todo quedaba lejos de los rótulos de las sedes. */
    .abt-map__intl { align-self: start; margin: clamp(28px, 3vw, 44px) 0 0; }
    .abt-map__list {
      grid-area: fig;
      position: relative;
      width: 100%;
      max-width: 560px;
      aspect-ratio: 1;
      margin: 0 0 0 auto;
      border: 0;
      pointer-events: none;
    }
    /* Con fondo del negro de la página detrás del rótulo, como en los mapas: un
       arco que pase por debajo (el de Uruguay cruza el de Portugal) no tacha el
       nombre. */
    .abt-map__place {
      position: absolute;
      left: var(--x);
      top: var(--y);
      min-height: 0;
      gap: 8px;
      padding: 2px 6px;
      border: 0;
      background: rgba(13, 15, 18, 0.88);
      font-size: 14px;
      white-space: nowrap;
    }
    .abt-map__place-node { display: none; }
    .abt-map__place-iso { margin-left: 0; }
    .abt-map__place--right { transform: translate(16px, -50%); }
    .abt-map__place--left { transform: translate(calc(-100% - 16px), -50%); }
    .abt-map__place--top { transform: translate(-50%, calc(-100% - 16px)); }
    .abt-map__place--bottom { transform: translate(-50%, 16px); }
    .abt-map__place--bottom:last-child { transform: translate(-14px, 16px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .abt-row > :not(.abt-row__visor),
    .abt-step__title,
    .abt-step__body,
    .abt-map__node,
    .abt-map__place { transition: none; }
    .abt-map__ball { display: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  // Desde `gsap/all`, como Flip en Talentos: mismo tamaño y sin el aviso de
  // mayúsculas de los tipos en macOS.
  import { MotionPathPlugin } from 'gsap/all';
  import { mountSection, afterTransitionPaint, EASE } from '@/scripts/ph-text-animations';
  import { whenInView, prefersReducedMotion, ping } from '@/scripts/ph-motion';
  import { scrollDraw } from '@/scripts/ph-scroll-draw';

  gsap.registerPlugin(MotionPathPlugin);

  /** La línea de tiempo: el eje crece con el scroll y cada nodo se enciende al
   *  llegarle la punta. Horizontal en escritorio, vertical en el móvil. */
  function initTimeline(section: HTMLElement): void {
    const line = section.querySelector<HTMLElement>('[data-abt-line]');
    const track = line?.querySelector<HTMLElement>('[data-abt-track]');
    const fill = line?.querySelector<HTMLElement>('[data-abt-axis]');
    if (!line || !track || !fill) return;
    const horizontal = () => window.matchMedia('(min-width: 900px)').matches;
    const steps = Array.from(line.querySelectorAll<HTMLElement>('[data-abt-step]'));
    const stops = steps.map((el) => ({
      el,
      // Dónde cae su nodo a lo largo del eje, en fracción.
      at: () => {
        const t = track.getBoundingClientRect();
        const n = el.querySelector('.abt-step__node')!.getBoundingClientRect();
        return horizontal()
          ? Math.max(0.02, (n.left + n.width / 2 - t.left) / Math.max(1, t.width))
          : Math.max(0.02, (n.top + n.height / 2 - t.top) / Math.max(1, t.height));
      },
    }));
    // En escritorio el eje se dibuja de izquierda a derecha; en el móvil, de
    // arriba abajo (se decide en cada medida, así sigue al girar o redimensionar).
    scrollDraw(track, fill, stops, () => (horizontal() ? 'x' : 'y'));
    // Al llegar a un nodo, su anillo se expande una vez.
    const seen = new Set<HTMLElement>();
    const observer = new MutationObserver(() => {
      steps.forEach((s) => {
        if (s.classList.contains('is-reached') && !seen.has(s)) {
          seen.add(s);
          ping(s.querySelector('.ph-node'));
        } else if (!s.classList.contains('is-reached')) {
          seen.delete(s);
        }
      });
    });
    steps.forEach((s) => observer.observe(s, { attributes: true, attributeFilter: ['class'] }));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  /** El mapa: los arcos se dibujan en cascada (CSS) y una bola recorre cada uno
   *  una vez, detrás de su trazo. */
  function initMap(section: HTMLElement): void {
    const map = section.querySelector<HTMLElement>('[data-abt-map]');
    if (!map || prefersReducedMotion()) return;
    whenInView(map, () => {
      map.querySelectorAll<SVGCircleElement>('[data-ball]').forEach((ball) => {
        const i = Number(ball.dataset.ball);
        const arc = map.querySelector<SVGPathElement>(`[data-arc="${i}"]`);
        if (!arc) return;
        gsap.timeline({ delay: 0.32 + i * 0.11 })
          .set(ball, { opacity: 1 })
          .to(ball, {
            duration: 0.72,
            ease: EASE.std,
            motionPath: { path: arc, align: arc, alignOrigin: [0.5, 0.5] },
          })
          .to(ball, { opacity: 0, duration: 0.18, ease: EASE.in });
      });
      // La sede central se activa cuando salen los arcos.
      window.setTimeout(() => ping(map.querySelector('.abt-map__hq .ph-node')), 200);
    });
  }

  function initAbout(): void {
    const section = document.querySelector<HTMLElement>('.about-section');
    if (!section || section.dataset.ready) return;
    section.dataset.ready = '1';
    mountSection(section);
    initTimeline(section);
    initMap(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initAbout));
</script>

<script>
  // Fondo animado de la página (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
