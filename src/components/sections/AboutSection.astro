---
import { useTranslations, type Lang } from '@/i18n/utils';
import { getTeamMembers } from '@/lib/teamMembers';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const teamMembers = getTeamMembers(lang);

/** «05 · Presencia» → «Presencia»: nombre del encabezado (solo para lectores de
    pantalla) sin el número de sección. */
const presenciaLabel = t('about.presencia.eyebrow').split(' · ').slice(1).join(' · ');

/* Los tres bloques se leen de arriba abajo como el lema de la marca
   («Now. Next. Forever Football.»), así que el último lleva el mismo acento
   que el lema en la portada y el pie: oro e itálica. Sin número delante
   (`…blocks.*.idx` sigue en el i18n, sin usar): el orden ya lo da el lema. */
const manifestoBlocks = [
  { title: t('about.manifesto.blocks.now.title'),     body: t('about.manifesto.blocks.now.body'),     accent: false },
  { title: t('about.manifesto.blocks.next.title'),    body: t('about.manifesto.blocks.next.body'),    accent: false },
  { title: t('about.manifesto.blocks.forever.title'), body: t('about.manifesto.blocks.forever.body'), accent: true },
];

const internationalCountries = [
  { key: 'portugal' as const, iso: 'PT' },
  { key: 'uk' as const,       iso: 'UK' },
  { key: 'alemania' as const, iso: 'DE' },
  { key: 'italia' as const,   iso: 'IT' },
  { key: 'arabia' as const,   iso: 'KSA' },
  { key: 'uruguay' as const,  iso: 'UY' },
];

---

<section class="about-section" aria-labelledby="about-hero-title">

  <!-- 01 HERO: misma cabecera que Talentos y Servicios (global.css): titular y
       entradilla debajo. -->
  <div class="abt-hero">
    <h1 id="about-hero-title" class="abt-hero__title ph-head-title">
      {t('about.hero.titlePre')}<span class="abt-gold">{t('about.hero.titleAccent')}</span>{t('about.hero.titlePost')}
    </h1>
    <p class="abt-hero__lead ph-head-lead">{t('about.hero.body1')}</p>
  </div>

  <!-- El resto de la presentación, en dos columnas. -->
  <div class="abt-intro">
    <p class="abt-hero__body">{t('about.hero.body2')}</p>
    <p class="abt-hero__body">{t('about.hero.body3')}</p>
  </div>

  <!-- 02 FILOSOFÍA (Now. Next. Forever Football.). Su h2 no se ve (el lema habla
       solo), pero está: así el h1 no salta directo a los h3 de los bloques. -->
  <section class="abt-block abt-manifesto" id="historia" aria-labelledby="about-manifesto-title">
    <h2 id="about-manifesto-title" class="sr-only">{t('about.manifesto.eyebrow')}</h2>

    <ol class="abt-manifesto__blocks" role="list">
      {manifestoBlocks.map((block) => (
        <li class="abt-manifesto__row">
          <h3 class:list={['abt-manifesto__title', block.accent && 'is-accent']}>{block.title}</h3>
          <p class="abt-manifesto__body">{block.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 03 EQUIPO: el titular habla solo, sin rótulo encima. -->
  <section class="abt-block abt-team" id="equipo" aria-labelledby="about-team-title">
    <h2 id="about-team-title" class="ph-h2 abt-block__title">
      {t('about.team.titlePre')}<span class="ph-accent">{t('about.team.titleAccent')}</span>{t('about.team.titlePost')}
    </h2>

    <ol class="abt-team__list" role="list">
      {teamMembers.map((m) => (
        <li class="abt-team__row" data-id={m.id}>
          <span class="abt-team__name">{m.name}</span>
          <span class="abt-team__role">{m.role}</span>
          {/* El país va en mayúsculas como antes: `team.defaultLocation` viene
              así en el i18n y los demás países no, y sin igualarlos la columna
              mezclaría «ESPAÑA» con «Arabia». */}
          <span class="abt-team__place">{(m.country ?? m.defaultLocation).toUpperCase()}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- 04 PRESENCIA: una sola lista sobre el fondo, con Madrid como encabezado. -->
  <section class="abt-block abt-presencia" id="presencia" aria-labelledby="about-presencia-title">
    <h2 id="about-presencia-title" class="sr-only">{presenciaLabel}</h2>

    <div class="abt-presencia__hq">
      <h3 class="abt-presencia__madrid">{t('about.presencia.madridTitle')}</h3>
      <p class="abt-presencia__label">{t('about.presencia.madridLabel')}</p>
    </div>
    <p class="abt-presencia__label abt-presencia__intl-label">{t('about.presencia.internationalLabel')}</p>
    <ul class="abt-presencia__countries" role="list">
      {internationalCountries.map((c) => (
        <li class="abt-presencia__country">
          <span>{t(`about.presencia.country.${c.key}` as const)}</span>
          <span class="abt-presencia__iso">{c.iso}</span>
        </li>
      ))}
    </ul>
  </section>

</section>

<style>
  /* Mismo sistema que el resto de páginas (global.css: `.ph-head-*`; ph-ui.css:
     `.ph-h2`). Todo se ve nada más cargar:
     sin titulares palabra a palabra, sin párrafos que se desenfocan ni filas que
     aparecen al hacer scroll. Lo único que se mueve responde al ratón. */
  .about-section {
    --abt-gold: var(--color-ph-gold);
    --abt-line: var(--color-ph-white-10);
    --edge: var(--ph-section-px);
    /* Espacio entre bloques: el mismo que separa las secciones de la portada. */
    --abt-block-gap: clamp(88px, 9vw, 156px);

    position: relative;
    background: transparent;
    color: var(--color-ph-white);
  }

  .about-section .abt-gold {
    color: var(--abt-gold);
    font-weight: 400;
    font-style: italic;
  }

  /* ── 01 HERO: misma cabecera que Talentos y Servicios (estilos y cifras en
     global.css: `.ph-head-*`) ── */
  .abt-hero {
    position: relative;
    padding: var(--ph-head-top) var(--edge) 0;
  }

  /* El resto de la presentación, en dos columnas de lectura cómoda. */
  .abt-intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 18px;
    margin-top: var(--ph-head-after);
    padding: 0 var(--edge);
  }
  .abt-hero__body {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(16px, calc(0.19vw + 15.3px), 18px);
    line-height: 1.65;
    letter-spacing: 0.003em;
    color: var(--ph-ink-body);
    text-wrap: pretty;
  }
  .abt-intro .abt-hero__body:nth-child(1) { grid-column: 1 / 7; }
  .abt-intro .abt-hero__body:nth-child(2) { grid-column: 7 / 13; }

  @media (max-width: 900px) {
    .abt-intro { grid-template-columns: minmax(0, 1fr); }
    .abt-intro .abt-hero__body:nth-child(1),
    .abt-intro .abt-hero__body:nth-child(2) { grid-column: 1 / -1; }
  }

  /* ── Bloques (Filosofía, Equipo, Presencia): sin rótulo encima ── */
  .abt-block {
    padding: var(--abt-block-gap) var(--edge) 0;
  }
  /* Abajo menos aire que entre bloques: el pie trae el suyo, y sumados dejaban un
     hueco de casi 300 px antes del lema. */
  .abt-block:last-of-type {
    padding-bottom: clamp(48px, 4vw, 88px);
  }
  .abt-block__title {
    margin-top: 0;
  }

  /* ── 02 FILOSOFÍA: el lema puesto en filas, sin cajas ──
     Cada palabra del lema a la izquierda, en grande, y su texto a la derecha:
     se lee de arriba abajo como «Now. Next. Forever Football.». */
  .abt-manifesto__blocks {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .abt-manifesto__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 14px;
    align-items: baseline;
    padding-block: clamp(28px, calc(2vw + 20px), 48px);
    border-top: 1px solid var(--abt-line);
  }
  .abt-manifesto__row:last-child { border-bottom: 1px solid var(--abt-line); }
  .abt-manifesto__title {
    grid-column: 1 / 7;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(44px, calc(3vw + 30px), 88px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--color-ph-white);
    text-wrap: balance;
  }
  /* El acento del lema (como `.ph-h2 em`). */
  .abt-manifesto__title.is-accent {
    font-style: italic;
    font-weight: 400;
    color: var(--abt-gold);
  }
  .abt-manifesto__body {
    grid-column: 7 / 13;
    margin: 0;
    max-width: 46ch;
    font-size: clamp(16px, calc(0.19vw + 15.3px), 18px);
    line-height: 1.6;
    color: var(--ph-ink-body);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .abt-manifesto__title,
    .abt-manifesto__body { grid-column: 1 / -1; }
  }

  /* ── 03 EQUIPO: tabla de filas limpias con línea fina ── */
  .abt-team__list {
    margin: clamp(36px, 3vw, 56px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--abt-line);
  }
  .abt-team__row {
    --abt-row-bleed: 14px;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.2fr) minmax(110px, auto);
    column-gap: clamp(16px, 2vw, 32px);
    align-items: baseline;
    padding-block: clamp(16px, 1.4vw, 22px);
    border-bottom: 1px solid var(--abt-line);
  }
  /* Resalte al pasar el ratón: una superficie suave detrás de la fila que solo
     cambia de opacidad. Desborda un poco hacia los lados para que el texto no
     quede pegado al canto; nada cambia de tamaño ni de sitio. */
  .abt-team__row::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--abt-row-bleed));
    z-index: -1;
    border-radius: var(--ph-r-md);
    background: var(--mochi-solid-subtle);
    opacity: 0;
    transition: opacity var(--mochi-duration-color) var(--mochi-ease-color);
  }
  @media (hover: hover) {
    .abt-team__row:hover::before { opacity: 1; }
  }
  .abt-team__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, calc(0.8vw + 15px), 28px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ph-white);
  }
  .abt-team__role {
    font-size: 15px;
    line-height: 1.4;
    color: var(--ph-ink-body);
  }
  .abt-team__place {
    justify-self: end;
    font-size: 13px;
    letter-spacing: 0.05em;
    white-space: nowrap;
    color: var(--ph-ink-meta);
  }

  /* En móvil el país sube a la derecha del nombre y el cargo baja a una
     segunda línea a todo lo ancho: así un cargo largo no deja el país colgando. */
  @media (max-width: 900px) {
    .abt-team__row {
      --abt-row-bleed: 10px;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 12px;
      row-gap: 6px;
      padding-block: 16px;
    }
    .abt-team__name { grid-area: 1 / 1; }
    .abt-team__place { grid-area: 1 / 2; }
    .abt-team__role { grid-area: 2 / 1 / 3 / 3; font-size: 14px; }
  }

  /* ── 04 PRESENCIA: una lista sobre el fondo, con Madrid de encabezado ── */
  .abt-presencia__hq {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
  }
  .abt-presencia__madrid {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, calc(2.6vw + 28px), 72px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--color-ph-white);
  }
  /* Etiquetas que ya vienen en mayúsculas en el i18n: tamaño legible y poco aire. */
  .abt-presencia__label {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.05em;
    color: var(--ph-ink-meta);
    text-wrap: balance;
  }
  .abt-presencia__intl-label {
    margin-top: clamp(40px, calc(2vw + 32px), 64px);
  }
  .abt-presencia__countries {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .abt-presencia__country {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: 14px;
    border-top: 1px solid var(--abt-line);
    font-size: 17px;
    line-height: 1.3;
    color: var(--color-ph-white);
  }
  .abt-presencia__iso {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ph-ink-meta);
  }

  @media (max-width: 900px) {
    .abt-presencia__countries { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* «Reducir movimiento»: el resalte de la fila aparece sin transición. */
  @media (prefers-reduced-motion: reduce) {
    .abt-team__row::before { transition-duration: 1ms; }
  }
</style>

