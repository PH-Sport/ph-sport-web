---
import { useTranslations, type Lang } from '@/i18n/utils';
import { getTeamMembers } from '@/lib/teamMembers';
import Slate from '@/components/ui/Slate.astro';
import Flap from '@/components/ui/Flap.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const teamMembers = getTeamMembers(lang);

const internationalCountries = [
  { key: 'portugal' as const, iso: 'PT' },
  { key: 'uk' as const,       iso: 'UK' },
  { key: 'alemania' as const, iso: 'DE' },
  { key: 'italia' as const,   iso: 'IT' },
  { key: 'arabia' as const,   iso: 'KSA' },
  { key: 'uruguay' as const,  iso: 'UY' },
];

---

<section class="about-section" aria-labelledby="about-hero-title">
  <div class="ph-page-bg" aria-hidden="true">
    <canvas class="ph-ambient" data-ambient="calidez"></canvas>
  </div>

  <!-- 01 HERO: misma cabecera que Talentos y Servicios (global.css): fila índice,
       titular y entradilla debajo. -->
  <div class="abt-hero">
    <Slate text={t('about.hero.eyebrow')} class="abt-hero__index" />
    <h1 id="about-hero-title" class="abt-hero__title ph-head-title" data-m="title" data-reveal>
      {t('about.hero.titlePre')}<span class="abt-gold" data-glint>{t('about.hero.titleAccent')}</span>{t('about.hero.titlePost')}
    </h1>
    <p class="abt-hero__lead ph-head-lead" data-m="lead" data-reveal>{t('about.hero.body1')}</p>
  </div>

  <!-- Valores y pie en una fila índice, y el resto de la presentación en dos
       columnas. Mismo texto y mismo orden que antes. Los valores y el pie son
       letras de tablero: pasan por el abecedario hasta la suya al entrar. -->
  <div class="ph-rowline abt-hero__rail" data-inview>
    <span class="ph-rowline__meta abt-hero__values" data-cycle>{t('about.hero.values')}</span>
    <span class="ph-rowline__meta abt-hero__caption" data-cycle>{t('about.hero.caption')}</span>
  </div>
  <div class="abt-intro">
    <p class="abt-hero__body" data-m="body" data-reveal>{t('about.hero.body2')}</p>
    <p class="abt-hero__body" data-m="body" data-reveal>{t('about.hero.body3')}</p>
  </div>

  <!-- 02 MANIFESTO (Now. Next. Forever Football. — explicado por bloques) -->
  <div class="abt-manifesto" id="historia">
    <div class="abt-manifesto__head">
      <Slate text={t('about.manifesto.eyebrow')} />
    </div>

    <div class="abt-manifesto__rows">
      {[
        { idx: t('about.manifesto.blocks.now.idx'),     title: t('about.manifesto.blocks.now.title'),     body: t('about.manifesto.blocks.now.body') },
        { idx: t('about.manifesto.blocks.next.idx'),    title: t('about.manifesto.blocks.next.title'),    body: t('about.manifesto.blocks.next.body') },
        { idx: t('about.manifesto.blocks.forever.idx'), title: t('about.manifesto.blocks.forever.title'), body: t('about.manifesto.blocks.forever.body') },
      ].map((row) => (
        <article class="abt-manifesto__row ph-seam" data-inview>
          <span class="abt-manifesto__idx"><Flap value={row.idx} size="md" /></span>
          <h3 class="abt-manifesto__title" data-m="title" data-reveal>{row.title}</h3>
          <p class="abt-manifesto__body" data-m="body" data-reveal>{row.body}</p>
        </article>
      ))}
    </div>
  </div>

  <!-- 03 EQUIPO -->
  <div class="abt-team" id="equipo" aria-labelledby="about-team-title">
    <div class="abt-team__head">
      <Slate text={t('about.team.eyebrow')} meta={t('about.team.meta')} />
      <h2 id="about-team-title" class="abt-team__title" data-m="title" data-reveal>
        {t('about.team.titlePre')}<span class="abt-gold" data-glint>{t('about.team.titleAccent')}</span>{t('about.team.titlePost')}
      </h2>
    </div>

    {/* Tablero de salidas: cada fila entra detrás de su línea, con el número en
        paletas y el destino en letras de tablero. */}
    <div class="abt-team-table" role="list">
      {teamMembers.map((m) => (
        <div class="abt-team-row ph-seam" role="listitem" data-id={m.id} data-inview>
          <span class="abt-team-row__idx"><Flap value={m.index} /></span>
          <div class="abt-team-row__name">
            <span class="abt-team-row__slot"><span class="abt-team-row__name-text">{m.name}</span></span>
            <span class="abt-team-row__mobile-extras">
              {m.role} · {m.country ?? m.defaultLocation}
            </span>
          </div>
          <span class="abt-team-row__role">{m.role}</span>
          <span class="abt-team-row__flag">
            <span data-cycle>{(m.country ?? m.defaultLocation).toUpperCase()}</span>
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- 04 PRESENCIA -->
  <div class="abt-presencia" id="presencia" aria-labelledby="about-presencia-title">
    <div class="abt-presencia__eyebrow-row">
      <Slate text={t('about.presencia.eyebrow')} />
    </div>
    <div class="abt-presencia__grid">
      <div class="abt-presencia__left">
        <h3 id="about-presencia-title" class="abt-presencia__madrid" data-m="title" data-reveal>
          {t('about.presencia.madridTitle')}
        </h3>
        <div class="abt-presencia__madrid-label" data-m="item" data-reveal>{t('about.presencia.madridLabel')}</div>
      </div>
      <div class="abt-presencia__right">
        <div class="abt-presencia__intl-label" data-m="item" data-reveal>{t('about.presencia.internationalLabel')}</div>
        {/* Las sedes como un tablero: cada país con su código en paletas. */}
        <div class="abt-presencia__countries">
          {internationalCountries.map((c) => (
            <div class="abt-presencia__country ph-seam" data-inview>
              <span class="abt-presencia__country-name">{t(`about.presencia.country.${c.key}` as const)}</span>
              <Flap value={c.iso} class="abt-presencia__iso" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  .about-section {
    --abt-gold: var(--color-ph-gold);
    --abt-ink: var(--color-ph-white);
    --abt-ink-soft: var(--color-ph-white-80);
    --abt-ink-faint: var(--color-ph-white-60);
    --abt-line: var(--color-ph-white-10);
    --abt-line-strong: var(--color-ph-white-20);
    --abt-bg: transparent;
    --abt-bg-2: rgba(255, 255, 255, 0.02);
    --edge: var(--ph-section-px);

    position: relative;
    background: var(--abt-bg);
    color: var(--abt-ink);
  }

  .about-section .abt-gold {
    color: var(--abt-gold);
    font-weight: 400;
    font-style: italic;
  }


  /* ── 01 HERO: misma cabecera que Talentos y Servicios (estilos y cifras en
     global.css: `.ph-rowline`, `.ph-head-*`) ── */
  .abt-hero {
    position: relative;
    padding: var(--ph-head-top) var(--edge) 0;
  }

  /* Valores y pie en una fila índice, nada más acabar la entradilla. Son letras
     de tablero: cambian al entrar. */
  .abt-hero__rail {
    margin: var(--ph-head-after) var(--edge) 0;
  }

  /* El resto de la presentación, en dos columnas de lectura cómoda. */
  .abt-intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 18px;
    margin-top: clamp(24px, calc(1.14vw + 19.5px), 36px);
    padding: 0 var(--edge) clamp(48px, 6vw, 88px);
    border-bottom: 1px solid var(--abt-line);
  }
  .abt-hero__body {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(16px, calc(0.19vw + 15.3px), 18px);
    line-height: 1.65;
    letter-spacing: 0.003em;
    color: var(--ph-ink-body);
    text-wrap: pretty;
  }
  .abt-intro .abt-hero__body:nth-child(1) { grid-column: 1 / 7; }
  .abt-intro .abt-hero__body:nth-child(2) { grid-column: 7 / 13; }

  @media (max-width: 900px) {
    .abt-intro { grid-template-columns: minmax(0, 1fr); }
    .abt-intro .abt-hero__body:nth-child(1),
    .abt-intro .abt-hero__body:nth-child(2) { grid-column: 1 / -1; }
  }

  /* ── 02 MANIFESTO (Now. Next. Forever Football.) ── */
  .abt-manifesto {
    padding: clamp(72px, 10vw, 140px) var(--edge);
    border-bottom: 1px solid var(--abt-line);
  }
  .abt-manifesto__head {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .abt-manifesto__rows {
    border-bottom: 1px solid var(--abt-line);
  }
  /* Tres filas del tablero: Now, Next, Forever Football. Cada una con su línea
     arriba, que se dibuja al entrar, y su número en paletas. */
  .abt-manifesto__row {
    --ph-seam-color: var(--abt-line-strong);
    display: grid;
    grid-template-columns: 80px 1.3fr 1.7fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
    padding-block: clamp(36px, 5vw, 64px);
    transition: background var(--ph-dur-move) var(--ph-ease-std);
  }
  .abt-manifesto__idx {
    display: flex;
    /* Alinea las paletas con la altura de las mayúsculas del título. */
    padding-top: 0.35em;
  }
  /* Estado base (desktop con puntero): blanco display 500, sin itálica.
     El lockup de marca (oro + itálico, idéntico a .hero-claim__accent) se
     "desbloquea" al hacer hover. En mobile / touch (sin hover disponible)
     se aplica directamente como base — ver media queries más abajo. */
  .abt-manifesto__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 5.5vw, 72px);
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
    color: var(--abt-ink);
    transition: color var(--ph-dur-move) var(--ph-ease-std);
  }
  .abt-manifesto__body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--abt-ink-soft);
    margin: 0;
    max-width: 480px;
    /* El body alinea ópticamente con el primer descender del título. */
    padding-top: 0.4em;
  }

  @media (hover: hover) {
    .abt-manifesto__row:hover {
      background: rgba(214, 178, 94, 0.04);
    }
    /* Hover desbloquea el lockup de marca: gold + itálico + weight 400
       (firma del eslogan, idéntica a .hero-claim__accent del home/footer). */
    .abt-manifesto__row:hover .abt-manifesto__title {
      color: var(--abt-gold);
      font-style: italic;
      font-weight: 400;
    }
  }
  /* La fila que se está leyendo (la del centro de la pantalla) se enciende en
     dorado: el tablero marca la línea en curso. La pone el script. */
  .abt-manifesto__row.is-current .abt-manifesto__title {
    color: var(--abt-gold);
  }

  @media (max-width: 900px) {
    .abt-manifesto__head {
      margin-bottom: 40px;
    }
    .abt-manifesto__row {
      grid-template-columns: 1fr;
      gap: 14px;
      padding-block: 32px;
    }
    /* Sin hover disponible: el lockup gold + itálico aplica como estado base
       para que la firma de marca sea visible en touch sin necesidad de gesto. */
    .abt-manifesto__title {
      color: var(--abt-gold);
      font-style: italic;
      font-weight: 400;
      font-size: clamp(34px, 9vw, 44px);
    }
    .abt-manifesto__body {
      max-width: none;
    }
    .abt-manifesto__idx {
      padding-top: 0;
    }
  }

  /* ── 03 EQUIPO ── */
  .abt-team {
    padding: clamp(72px, 10vw, 140px) var(--edge);
    border-bottom: 1px solid var(--abt-line);
  }
  .abt-team__head {
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .abt-team__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 9vw, 72px);
    letter-spacing: -0.035em;
    margin: clamp(24px, 3vw, 36px) 0 0;
    line-height: 0.98;
  }

  .abt-team-table {
    border-bottom: 1px solid var(--abt-line);
  }
  /* Tablero de salidas: cada fila con su línea arriba. La fila entra detrás de
     su línea; el nombre sube por su ranura y el destino pasa por el abecedario. */
  /* Cuatro columnas: número, nombre, cargo y sede. Con tres, la sede caía en una
     línea aparte debajo del número. */
  .abt-team-row {
    display: grid;
    grid-template-columns: 60px minmax(0, 1.4fr) minmax(0, 1.2fr) minmax(7em, auto);
    gap: 24px;
    align-items: center;
    padding-block: clamp(18px, 2.5vw, 28px);
    transition: background var(--ph-dur-move) var(--ph-ease-std);
  }
  .abt-team-row > * {
    transition: opacity 480ms var(--ph-ease-out) calc(var(--ph-seam-delay, 0ms) + 100ms);
  }
  :global(html.ph-anim) .abt-team-row:not(.is-inview) > * {
    opacity: 0;
  }
  .abt-team-row__slot {
    display: block;
    overflow: hidden;
  }
  .abt-team-row__name-text {
    display: block;
    transition:
      transform var(--ph-dur-roll) var(--ph-ease-out) calc(var(--ph-seam-delay, 0ms) + 120ms),
      color var(--ph-dur-move) var(--ph-ease-std);
  }
  :global(html.ph-anim) .abt-team-row:not(.is-inview) .abt-team-row__name-text {
    transform: translateY(110%);
  }
  /* Sin el JS de movimiento, a los 2,5 s en su sitio (global.css, «Red de
     seguridad»). */
  :global(html.ph-anim:not(.ph-motion)) .abt-team-row__name-text {
    animation: ph-motion-failsafe 0s linear 2.5s forwards;
  }
  @media (hover: hover) {
    .abt-team-row:hover {
      background: rgba(214, 178, 94, 0.04);
    }
    .abt-team-row:hover .abt-team-row__name-text {
      color: var(--abt-gold);
    }
  }
  .abt-team-row__idx {
    display: flex;
  }
  .abt-team-row__name-text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    transition: color 300ms var(--ease-ph, ease);
  }
  .abt-team-row__role {
    font-size: 13px;
    line-height: 1.4;
    color: var(--ph-ink-lead);
  }
  .abt-team-row__flag {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--ph-ink-meta);
  }
  .abt-team-row__mobile-extras {
    display: none;
  }

  @media (max-width: 900px) {
    .abt-team-row {
      grid-template-columns: 40px 1fr;
      gap: 10px;
      padding-block: 18px;
    }
    .abt-team-row__role,
    .abt-team-row__flag {
      display: none;
    }
    .abt-team-row__name {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .abt-team-row__mobile-extras {
      display: block;
      font-size: 13px;
      color: var(--ph-ink-meta);
      font-style: normal;
      line-height: 1.5;
    }
  }

  /* ── 04 PRESENCIA ── */
  .abt-presencia {
    padding: clamp(60px, 9vw, 100px) var(--edge);
    border-bottom: 1px solid var(--abt-line);
  }
  .abt-presencia__eyebrow-row {
    margin-bottom: 32px;
  }
  .abt-presencia__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: end;
    padding-top: clamp(32px, 4vw, 48px);
  }
  .abt-presencia__madrid {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(64px, 12vw, 144px);
    letter-spacing: -0.05em;
    line-height: 0.9;
    margin: 0 0 0 -0.04em;
  }
  .abt-presencia__madrid-label {
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--ph-ink-meta);
    margin-top: 16px;
  }
  .abt-presencia__intl-label {
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--ph-ink-meta);
    margin-bottom: 12px;
  }
  .abt-presencia__countries {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--abt-line);
  }
  /* Las sedes, como filas de tablero: el país a la izquierda y su código en
     paletas a la derecha. */
  .abt-presencia__countries {
    gap: 0;
  }
  .abt-presencia__country {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 10px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--abt-ink);
  }
  .abt-presencia__country-name {
    transition: opacity 480ms var(--ph-ease-out) calc(var(--ph-seam-delay, 0ms) + 100ms);
  }
  :global(html.ph-anim) .abt-presencia__country:not(.is-inview) .abt-presencia__country-name {
    opacity: 0;
  }

  @media (max-width: 900px) {
    .abt-presencia__grid {
      grid-template-columns: 1fr;
      align-items: stretch;
      gap: 32px;
    }

  }

</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, stage, rollIn, riseIn, mountSection, afterTransitionPaint,
  } from '@/scripts/ph-text-animations';
  import { cascade } from '@/scripts/ph-motion';

  gsap.registerPlugin(ScrollTrigger);

  let currentRowObserver: IntersectionObserver | null = null;

  function initAboutAnimations(): void {
    const section = document.querySelector<HTMLElement>('.about-section');
    if (!section) return;

    if (!reducedMotion()) {
      // Cabecera: pizarra, «Representar» rodando con su luz y la entradilla.
      const hero = section.querySelector<HTMLElement>('.abt-hero');
      if (hero) stage(hero, { glint: true });
      // Los dos párrafos de la presentación suben enteros, uno tras otro. Antes
      // entraban palabra a palabra con desenfoque (135 piezas con `filter: blur`):
      // era el tirón de 217-359 ms al entrar en la página (docs/rendimiento.md).
      riseIn(section.querySelectorAll<HTMLElement>('.abt-intro [data-m="body"]'), { delay: 0.45, stagger: 0.1 });

      // Manifiesto: cada fila rueda su título y sube su texto al entrar.
      section.querySelectorAll<HTMLElement>('.abt-manifesto__row').forEach((row) => {
        const title = row.querySelector<HTMLElement>('[data-m="title"]');
        const body = row.querySelector<HTMLElement>('[data-m="body"]');
        if (title) rollIn(title, { trigger: row, delay: 0.12 });
        if (body) riseIn(body, { trigger: row, delay: 0.26 });
      });

      const team = section.querySelector<HTMLElement>('.abt-team');
      if (team) stage(team, { glint: true });
      cascade(section.querySelectorAll<HTMLElement>('.abt-team-row'), 45);

      const presencia = section.querySelector<HTMLElement>('.abt-presencia');
      if (presencia) stage(presencia);
      cascade(section.querySelectorAll<HTMLElement>('.abt-presencia__country'), 70);

      // La fila del manifiesto que está en el centro de la pantalla se enciende.
      currentRowObserver?.disconnect();
      currentRowObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) entry.target.classList.toggle('is-current', entry.isIntersecting);
        },
        { rootMargin: '-45% 0px -45% 0px' },
      );
      section.querySelectorAll('.abt-manifesto__row').forEach((row) => currentRowObserver!.observe(row));
    }

    mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initAboutAnimations));
  document.addEventListener('astro:before-swap', () => {
    currentRowObserver?.disconnect();
    currentRowObserver = null;
  });
</script>

<script>
  // Fondo animado de la cabecera (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
