---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '@/i18n/utils';
import { HERO_IMAGE, HERO_IMAGE_QUALITY, HERO_IMAGE_SIZES, HERO_IMAGE_WIDTHS } from '@/lib/heroMedia';

interface Props {
  lang: Lang;
  sectionId?: string;
}

const { lang, sectionId } = Astro.props;
const t = useTranslations(lang);
---

<section
  id={sectionId}
  class="hero hero--home"
>
  <div class="hero-media" aria-hidden="true">
    <div class="hero-backdrop" />
    <Image
      class="hero-image"
      src={HERO_IMAGE}
      widths={HERO_IMAGE_WIDTHS}
      sizes={HERO_IMAGE_SIZES}
      format="webp"
      quality={HERO_IMAGE_QUALITY}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content">
    <h1 class="hero-claim">
      <span class="hero-claim__lead">{t('hero.claim.lead')}</span>
      <span class="hero-claim__accent">{t('hero.claim.accent')}</span>
    </h1>
  </div>

  <a class="hero-scroll" href="#talentos" data-hero-scroll-indicator>
    <span class="hero-scroll__label">{t('hero.scroll.label')}</span>
    <span class="hero-scroll__line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero--home {
    position: relative;
    width: 100%;
    /* Alto de pantalla congelado (ver `--ph-viewport-h` en global.css): con `svh`
       a secas, el vaivén de la barra del navegador en iPhone cambiaba el alto del
       hero y arrastraba el documento entero. */
    min-height: var(--ph-viewport-h);
    overflow: hidden;
    background: var(--color-ph-black, #0d0f12);
    color: var(--color-ph-white, #ffffff);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  /* Fondo bajo la foto: se ve mientras carga y, en vertical, por encima y por
     debajo de la franja de la foto. */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse at 70% 80%, rgba(214, 178, 94, 0.06) 0%, transparent 42%),
      radial-gradient(ellipse at 30% 20%, rgba(214, 178, 94, 0.10) 0%, transparent 48%),
      radial-gradient(ellipse at 50% 100%, rgba(13, 15, 18, 0.9) 0%, transparent 55%),
      var(--ph-section-bg, #0d0f12);
  }

  /* En horizontal, la foto llena el hero. `object-position` es el centro del
     logo de neón en la foto (53,1 % × 50,8 %, medido sobre los píxeles del
     neón): si `cover` recorta, recorta alrededor del logo. */
  .hero-image {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 53.1% 50.8%;
  }

  /* En vertical (móviles y tablets), `cover` ajustaría la foto al alto y solo
     se vería el centro del logo, ampliado 2,7× en un iPhone. Se pinta en una
     franja en la que el logo entero ocupa el 88 % del ancho: la foto al 192 %
     del ancho (el logo es el 45,7 % de ella), con el centro del logo en el
     42 % del alto, por encima del titular. Los bordes de arriba y abajo se
     funden con el fondo; el logo va del 7,8 % al 93,9 % del alto de la foto,
     así que el fundido no lo toca.

     Todas estas cifras son de ESTA foto. Si se cambia por otra, hay que volver
     a medir el logo. El 9/10 es el punto en el que `cover` ya no cabe el
     logo; debe coincidir con `HERO_IMAGE_SIZES` en `heroMedia.ts`. */
  @media (max-aspect-ratio: 9/10) {
    .hero-image {
      inset: auto;
      top: 42%;
      left: 50%;
      width: 192%;
      /* El preflight de Tailwind pone `max-width: 100%` a todo `img`. */
      max-width: none;
      height: auto;
      transform: translate(-53.1%, -50.8%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 7%, #000 93%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 7%, #000 93%, transparent 100%);
    }
  }

  /* Dark gradient overlay for legibility of the claim over the photo */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      linear-gradient(180deg,
        rgba(13,15,18,0.55) 0%,
        rgba(13,15,18,0) 30%,
        rgba(13,15,18,0) 55%,
        rgba(13,15,18,0.85) 100%),
      linear-gradient(90deg,
        rgba(13,15,18,0.35) 0%,
        rgba(13,15,18,0) 55%);
  }

  .hero-content {
    position: absolute;
    left: var(--ph-section-px, clamp(20px, 4vw, 48px));
    right: var(--ph-section-px, clamp(20px, 4vw, 48px));
    bottom: clamp(72px, 10vw, 140px);
    z-index: 4;
    max-width: 980px;
  }

  .hero-claim {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-weight: 500;
    font-size: clamp(44px, 8.5vw, 132px);
    letter-spacing: -0.03em;
    line-height: 0.96;
    margin: 0;
    text-wrap: balance;
  }
  .hero-claim__lead {
    display: block;
    color: var(--color-ph-white, #ffffff);
  }
  .hero-claim__accent {
    display: block;
    color: var(--color-ph-gold, #d6b25e);
    font-style: italic;
    font-weight: 400;
  }

  /* Vertical scroll cue — bottom-right */
  .hero-scroll {
    position: absolute;
    right: var(--ph-section-px, clamp(20px, 4vw, 48px));
    bottom: clamp(24px, 4vw, 48px);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--color-ph-white, #ffffff);
    opacity: 0.7;
    transition: opacity 0.2s ease, color 0.2s ease;
    text-decoration: none;
  }
  .hero-scroll:hover {
    opacity: 1;
    color: var(--color-ph-gold, #d6b25e);
  }
  .hero-scroll__label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hero-scroll__line {
    position: relative;
    width: 1px;
    height: 56px;
    background: currentColor;
    overflow: hidden;
  }
  .hero-scroll__line::after {
    content: "";
    position: absolute;
    top: -100%;
    left: 0;
    width: 1px;
    height: 60%;
    background: var(--color-ph-gold, #d6b25e);
    animation: heroScrollCue 2.4s linear infinite;
  }
  @keyframes heroScrollCue {
    0% { transform: translateY(0); }
    100% { transform: translateY(400%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll__line::after { animation: none; }
  }

  .hero-scroll.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Mientras el indicador está oculto (usuario ya scrolleó), pausar la
     animación CSS infinita evita que mantenga el compositor activo
     gastando ciclos de GPU para algo invisible. */
  .hero-scroll.is-hidden .hero-scroll__line::after {
    animation-play-state: paused;
  }

  @media (max-width: 720px) {
    .hero-content {
      bottom: clamp(24px, 4vw, 48px);
      right: 64px;
    }
  }

  @media (min-width: 1024px) {
    .hero-content {
      bottom: clamp(40px, 5vw, 72px);
    }
    .hero-claim {
      font-size: clamp(56px, 6.2vw, 96px);
    }
  }

  /* El titular arranca oculto para que GSAP controle su primer fotograma, con una
     red de seguridad en CSS: pase lo que pase, a 1,1 s se muestra.

     Antes no hacía falta porque el telón de intro y este titular colgaban del
     mismo evento (`astro:page-load` = `window.load`): cuando el telón se
     levantaba, el titular ya estaba puesto. Ahora el telón es CSS y termina a
     1,26 s por su cuenta, así que son dos relojes distintos: si el JS se retrasa
     —y `window.load` es mucho más variable que el primer pintado—, el telón se
     abriría sobre un hero mudo.

     El retardo hace que esto no estorbe cuando todo va bien: durante la espera la
     animación no aplica nada (no es `backwards`), así que el `visibility` que
     pone GSAP manda y el efecto de entrada se ve igual que siempre. */
  .hero-claim__lead,
  .hero-claim__accent {
    visibility: hidden;
    animation: ph-hero-claim-visible 0s linear 1.1s forwards;
  }

  @keyframes ph-hero-claim-visible {
    to { visibility: visible; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-claim__lead,
    .hero-claim__accent { visibility: visible; animation: none; }
  }
</style>

<script>
  function initHeroScrollCue(): void {
    const cue = document.querySelector<HTMLElement>('[data-hero-scroll-indicator]');
    if (!cue) return;
    const toggle = () => cue.classList.toggle('is-hidden', window.scrollY > 48);
    toggle();
    document.addEventListener('scroll', toggle, { passive: true });
  }

  document.addEventListener('astro:page-load', initHeroScrollCue);
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, wrapWords, scheduleScrollTriggerRefresh, afterTransitionPaint,
  } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(ScrollTrigger);

  function initHeroAnimations(): void {
    const hero = document.querySelector<HTMLElement>('.hero--home');
    if (!hero) return;
    if (reducedMotion()) return;

    const lead = hero.querySelector<HTMLElement>('.hero-claim__lead');
    const accent = hero.querySelector<HTMLElement>('.hero-claim__accent');
    const claim = hero.querySelector<HTMLElement>('.hero-claim');

    // Reveal now so GSAP controls the first visible frame.
    if (lead) lead.style.visibility = 'visible';
    if (accent) accent.style.visibility = 'visible';

    if (lead) {
      const words = wrapWords(lead);
      gsap.from(words, {
        yPercent: 115,
        duration: 1.0,
        ease: 'power4.out',
        stagger: 0.08,
        delay: 0.2,
      });
    }
    if (accent) {
      const words = wrapWords(accent);
      gsap.from(words, {
        yPercent: 115,
        duration: 1.0,
        ease: 'power4.out',
        stagger: 0.08,
        delay: 0.4,
      });
    }
    if (claim) {
      ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: 'bottom top',
        scrub: 0.8,
        onUpdate: (self) => {
          gsap.set(claim, { yPercent: self.progress * 20 });
        },
      });
    }

    scheduleScrollTriggerRefresh();
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHeroAnimations));
</script>
