---
import { useTranslations, type Lang } from '@/i18n/utils';
import { HERO_STATIC_IMAGE, HERO_VIDEO_POSTER, HERO_VIDEO_SOURCES } from '@/lib/heroMedia';

interface Props {
  lang: Lang;
  sectionId?: string;
}

const { lang, sectionId } = Astro.props;
const t = useTranslations(lang);
const staticBackdrop = HERO_STATIC_IMAGE.trim().length > 0 ? HERO_STATIC_IMAGE : null;
const videoPoster = HERO_VIDEO_POSTER.trim().length > 0 ? HERO_VIDEO_POSTER : undefined;
---

<section
  id={sectionId}
  class="hero hero--home"
>
  <div class="hero-media" aria-hidden="true">
    <div class="hero-video-fallback" />
    {staticBackdrop && (
      <img class="hero-static-image" src={staticBackdrop} alt="" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async" />
    )}
    <video class="hero-video" data-hero-video muted loop playsinline preload="none" poster={videoPoster}>
      {HERO_VIDEO_SOURCES.map((s) => (
        <source src={s.src} type={s.type} media={s.media} />
      ))}
    </video>
  </div>

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content">
    <h1 class="hero-claim">
      <span class="hero-claim__lead">{t('hero.claim.lead')}</span>
      <span class="hero-claim__accent">{t('hero.claim.accent')}</span>
    </h1>
  </div>

  <a class="hero-scroll" href="#talentos" data-hero-scroll-indicator>
    <span class="hero-scroll__label">{t('hero.scroll.label')}</span>
    <span class="hero-scroll__line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero--home {
    position: relative;
    width: 100%;
    /* Alto de pantalla congelado (ver `--ph-viewport-h` en global.css): con `svh`
       a secas, el vaivén de la barra del navegador en iPhone cambiaba el alto del
       hero y arrastraba el documento entero. */
    min-height: var(--ph-viewport-h);
    overflow: hidden;
    background: var(--color-ph-black, #0d0f12);
    color: var(--color-ph-white, #ffffff);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-video-fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse at 70% 80%, rgba(214, 178, 94, 0.06) 0%, transparent 42%),
      radial-gradient(ellipse at 30% 20%, rgba(214, 178, 94, 0.10) 0%, transparent 48%),
      radial-gradient(ellipse at 50% 100%, rgba(13, 15, 18, 0.9) 0%, transparent 55%),
      var(--ph-section-bg, #0d0f12);
  }

  .hero-static-image {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero--home .hero-video { display: none; }
  }
  .hero--home.hero--video-error .hero-video { display: none; }

  /* Una vez el vídeo está reproduciendo, el poster ya no aporta nada visible
     pero seguía siendo una capa compositada bajo el vídeo en cada frame.
     Ocultarlo libera al compositor (importante en GPUs viejas tipo Intel HD). */
  .hero--home.hero--video-playing .hero-static-image { display: none; }

  /* Dark gradient overlay for legibility of the claim over the video */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      linear-gradient(180deg,
        rgba(13,15,18,0.55) 0%,
        rgba(13,15,18,0) 30%,
        rgba(13,15,18,0) 55%,
        rgba(13,15,18,0.85) 100%),
      linear-gradient(90deg,
        rgba(13,15,18,0.35) 0%,
        rgba(13,15,18,0) 55%);
  }

  .hero-content {
    position: absolute;
    left: var(--ph-section-px, clamp(20px, 4vw, 48px));
    right: var(--ph-section-px, clamp(20px, 4vw, 48px));
    bottom: clamp(72px, 10vw, 140px);
    z-index: 4;
    max-width: 980px;
  }

  .hero-claim {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-weight: 500;
    font-size: clamp(44px, 8.5vw, 132px);
    letter-spacing: -0.03em;
    line-height: 0.96;
    margin: 0;
    text-wrap: balance;
  }
  .hero-claim__lead {
    display: block;
    color: var(--color-ph-white, #ffffff);
  }
  .hero-claim__accent {
    display: block;
    color: var(--color-ph-gold, #d6b25e);
    font-style: italic;
    font-weight: 400;
  }

  /* Vertical scroll cue — bottom-right */
  .hero-scroll {
    position: absolute;
    right: var(--ph-section-px, clamp(20px, 4vw, 48px));
    bottom: clamp(24px, 4vw, 48px);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--color-ph-white, #ffffff);
    opacity: 0.7;
    transition: opacity 0.2s ease, color 0.2s ease;
    text-decoration: none;
  }
  .hero-scroll:hover {
    opacity: 1;
    color: var(--color-ph-gold, #d6b25e);
  }
  .hero-scroll__label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hero-scroll__line {
    position: relative;
    width: 1px;
    height: 56px;
    background: currentColor;
    overflow: hidden;
  }
  .hero-scroll__line::after {
    content: "";
    position: absolute;
    top: -100%;
    left: 0;
    width: 1px;
    height: 60%;
    background: var(--color-ph-gold, #d6b25e);
    animation: heroScrollCue 2.4s linear infinite;
  }
  @keyframes heroScrollCue {
    0% { transform: translateY(0); }
    100% { transform: translateY(400%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll__line::after { animation: none; }
  }

  .hero-scroll.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Mientras el indicador está oculto (usuario ya scrolleó), pausar la
     animación CSS infinita evita que mantenga el compositor activo
     gastando ciclos de GPU para algo invisible. */
  .hero-scroll.is-hidden .hero-scroll__line::after {
    animation-play-state: paused;
  }

  @media (max-width: 720px) {
    .hero-content {
      bottom: clamp(24px, 4vw, 48px);
      right: 64px;
    }
  }

  @media (min-width: 1024px) {
    .hero-content {
      bottom: clamp(40px, 5vw, 72px);
    }
    .hero-claim {
      font-size: clamp(56px, 6.2vw, 96px);
    }
  }

  /* El titular arranca oculto para que GSAP controle su primer fotograma, con una
     red de seguridad en CSS: pase lo que pase, a 1,1 s se muestra.

     Antes no hacía falta porque el telón de intro y este titular colgaban del
     mismo evento (`astro:page-load` = `window.load`): cuando el telón se
     levantaba, el titular ya estaba puesto. Ahora el telón es CSS y termina a
     1,26 s por su cuenta, así que son dos relojes distintos: si el JS se retrasa
     —y `window.load` es mucho más variable que el primer pintado—, el telón se
     abriría sobre un hero mudo.

     El retardo hace que esto no estorbe cuando todo va bien: durante la espera la
     animación no aplica nada (no es `backwards`), así que el `visibility` que
     pone GSAP manda y el efecto de entrada se ve igual que siempre. */
  .hero-claim__lead,
  .hero-claim__accent {
    visibility: hidden;
    animation: ph-hero-claim-visible 0s linear 1.1s forwards;
  }

  @keyframes ph-hero-claim-visible {
    to { visibility: visible; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-claim__lead,
    .hero-claim__accent { visibility: visible; animation: none; }
  }
</style>

<script>
  function initHeroScrollCue(): void {
    const cue = document.querySelector<HTMLElement>('[data-hero-scroll-indicator]');
    if (!cue) return;
    const toggle = () => cue.classList.toggle('is-hidden', window.scrollY > 48);
    toggle();
    document.addEventListener('scroll', toggle, { passive: true });
  }

  function initHeroVideo(): void {
    const hero = document.querySelector<HTMLElement>('.hero--home');
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!hero || !video) return;
    const markStatic = () => {
      hero.classList.add('hero--video-error');
      hero.classList.remove('hero--video-playing');
    };
    video.addEventListener('error', markStatic);
    video.addEventListener(
      'playing',
      () => hero.classList.add('hero--video-playing'),
      { once: true },
    );
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const retryOnGesture = () => {
      window.removeEventListener('pointerdown', retryOnGesture);
      window.removeEventListener('touchstart', retryOnGesture);
      window.removeEventListener('scroll', retryOnGesture);
      void video.play().catch(() => {});
    };

    /* El vídeo se arranca a mano, no con el atributo `autoplay`.
     *
     * Con `autoplay` el navegador se baja el archivo entero nada más encontrarlo
     * (el `preload="metadata"` no lo impide), y en móvil eso es 1 MB peleándose
     * por el ancho de banda con el póster —que es el LCP real de la home— y con
     * el JS. Medido: retrasaba el evento `load` 504 ms y el póster tardaba 2.381
     * ms en bajar en vez de 1.878.
     *
     * Esperando a que el resto haya cargado, el vídeo no le quita sitio a nada.
     * El hueco lo cubre el póster, que es literalmente su primer fotograma.
     * En navegación SPA el documento ya está cargado, así que arranca directo. */
    const startVideo = () => {
      void video.play().catch(() => {
        window.addEventListener('pointerdown', retryOnGesture, { passive: true });
        window.addEventListener('touchstart', retryOnGesture, { passive: true });
        window.addEventListener('scroll', retryOnGesture, { passive: true });
      });
    };

    if (document.readyState === 'complete') startVideo();
    else window.addEventListener('load', startVideo, { once: true });
  }

  document.addEventListener('astro:page-load', () => {
    initHeroScrollCue();
    initHeroVideo();
  });
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, wrapWords, scheduleScrollTriggerRefresh, afterTransitionPaint,
  } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(ScrollTrigger);

  function initHeroAnimations(): void {
    const hero = document.querySelector<HTMLElement>('.hero--home');
    if (!hero) return;
    if (reducedMotion()) return;

    const lead = hero.querySelector<HTMLElement>('.hero-claim__lead');
    const accent = hero.querySelector<HTMLElement>('.hero-claim__accent');
    const claim = hero.querySelector<HTMLElement>('.hero-claim');

    // Reveal now so GSAP controls the first visible frame.
    if (lead) lead.style.visibility = 'visible';
    if (accent) accent.style.visibility = 'visible';

    if (lead) {
      const words = wrapWords(lead);
      gsap.from(words, {
        yPercent: 115,
        duration: 1.0,
        ease: 'power4.out',
        stagger: 0.08,
        delay: 0.2,
      });
    }
    if (accent) {
      const words = wrapWords(accent);
      gsap.from(words, {
        yPercent: 115,
        duration: 1.0,
        ease: 'power4.out',
        stagger: 0.08,
        delay: 0.4,
      });
    }
    if (claim) {
      ScrollTrigger.create({
        trigger: hero,
        start: 'top top',
        end: 'bottom top',
        scrub: 0.8,
        onUpdate: (self) => {
          gsap.set(claim, { yPercent: self.progress * 20 });
        },
      });
    }

    scheduleScrollTriggerRefresh();
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHeroAnimations));
</script>
