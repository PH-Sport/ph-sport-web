---
import { useTranslations, type Lang } from '@/i18n/utils';
import {
  HERO_INTRO_SOURCES, HERO_LOOP_SOURCES, HERO_PORTRAIT_MEDIA, HERO_POSTER, HERO_SIZE,
} from '@/lib/heroMedia';

interface Props {
  lang: Lang;
  sectionId?: string;
}

const { lang, sectionId } = Astro.props;
const t = useTranslations(lang);
---

<section
  id={sectionId}
  class="hero hero--home"
>
  <div class="hero-media" aria-hidden="true">
    <div class="hero-backdrop" />
    {/* El póster es un fotograma exacto del vídeo con el mismo encuadre: apagado
        mientras el vídeo no arranca, encendido con movimiento reducido. Los
        <video> no llevan atributo `poster` a propósito: el navegador lo
        descarga nada más crear el elemento. Sin datos ni póster, un <video> es
        transparente y se ve esta imagen de debajo. */}
    <picture>
      <source srcset={HERO_POSTER.on.portrait} media={`${HERO_PORTRAIT_MEDIA} and (prefers-reduced-motion: reduce)`} width={HERO_SIZE.portrait.width} height={HERO_SIZE.portrait.height} />
      <source srcset={HERO_POSTER.on.landscape} media="(prefers-reduced-motion: reduce)" width={HERO_SIZE.landscape.width} height={HERO_SIZE.landscape.height} />
      <source srcset={HERO_POSTER.off.portrait} media={HERO_PORTRAIT_MEDIA} width={HERO_SIZE.portrait.width} height={HERO_SIZE.portrait.height} />
      <img class="hero-poster" data-hero-poster src={HERO_POSTER.off.landscape} alt="" width={HERO_SIZE.landscape.width} height={HERO_SIZE.landscape.height} loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    {/* Sin JavaScript nadie arrancaría el vídeo: el rótulo se queda encendido. */}
    <noscript>
      <picture>
        <source srcset={HERO_POSTER.on.portrait} media={HERO_PORTRAIT_MEDIA} />
        <img class="hero-poster hero-poster--noscript" src={HERO_POSTER.on.landscape} alt="" width={HERO_SIZE.landscape.width} height={HERO_SIZE.landscape.height} />
      </picture>
    </noscript>
    <video class="hero-video hero-video--loop" data-hero-loop muted loop playsinline preload="none">
      {HERO_LOOP_SOURCES.map((s) => (
        <source src={s.src} type={s.type} media={s.media} />
      ))}
    </video>
    <video class="hero-video hero-video--intro" data-hero-intro muted playsinline preload="none">
      {HERO_INTRO_SOURCES.map((s) => (
        <source src={s.src} type={s.type} media={s.media} />
      ))}
    </video>
  </div>

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content">
    <h1 class="hero-claim">
      <span class="hero-claim__lead">{t('hero.claim.lead')}</span>
      <span class="hero-claim__accent">{t('hero.claim.accent')}</span>
    </h1>
  </div>
</section>

<style>
  .hero--home {
    position: relative;
    width: 100%;
    /* Alto de pantalla congelado (ver `--ph-viewport-h` en global.css): con `svh`
       a secas, el vaivén de la barra del navegador en iPhone cambiaba el alto del
       hero y arrastraba el documento entero. */
    min-height: var(--ph-viewport-h);
    overflow: hidden;
    background: var(--color-ph-black, #0d0f12);
    color: var(--color-ph-white, #ffffff);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  /* Fondo bajo el póster: se ve mientras carga. */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse at 70% 80%, rgba(214, 178, 94, 0.06) 0%, transparent 42%),
      radial-gradient(ellipse at 30% 20%, rgba(214, 178, 94, 0.10) 0%, transparent 48%),
      radial-gradient(ellipse at 50% 100%, rgba(13, 15, 18, 0.9) 0%, transparent 55%),
      var(--ph-section-bg, #0d0f12);
  }

  /* Póster y vídeos llenan el hero con `cover`, centrados. El render
     (scripts/hero-neon/neon.html) pone el logo en el centro del encuadre y la
     cámara orbita a su alrededor, así que sigue en el centro aunque gire. En el
     apaisado, en su plano más cercano, el logo ocupa el ~45 % del ancho: cabe
     entero hasta la proporción 9:10, donde pasa al encuadre vertical (9:19,5,
     con el logo al 70 % del ancho): en pantallas menos alargadas que ese,
     `cover` recorta pared por arriba y por abajo, nunca logo. */
  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .hero-poster { z-index: 1; }
  .hero-poster--noscript { z-index: 2; }

  /* Los vídeos aparecen cuando ya están pintando (`is-on`, desde el script de
     abajo): hasta entonces se ve el póster. El encendido va encima del bucle y
     se retira cuando el bucle ya se ve; como su último fotograma es el primero
     del bucle, el relevo no se nota. */
  .hero-video {
    z-index: 2;
    opacity: 0;
  }
  .hero-video--intro { z-index: 3; }
  .hero-video.is-on { opacity: 1; }

  /* Dark gradient overlay for legibility of the claim over the photo */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      linear-gradient(180deg,
        rgba(13,15,18,0.55) 0%,
        rgba(13,15,18,0) 30%,
        rgba(13,15,18,0) 55%,
        rgba(13,15,18,0.85) 100%),
      linear-gradient(90deg,
        rgba(13,15,18,0.35) 0%,
        rgba(13,15,18,0) 55%);
  }

  .hero-content {
    position: absolute;
    left: var(--ph-section-px, clamp(20px, 4vw, 48px));
    right: var(--ph-section-px, clamp(20px, 4vw, 48px));
    bottom: clamp(72px, 10vw, 140px);
    z-index: 4;
    max-width: 980px;
  }

  .hero-claim {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-weight: 500;
    font-size: clamp(44px, 8.5vw, 132px);
    letter-spacing: -0.04em;
    line-height: 0.92;
    margin: 0;
    text-wrap: balance;
  }
  .hero-claim__lead {
    display: block;
    color: var(--color-ph-white, #ffffff);
  }
  .hero-claim__accent {
    display: block;
    color: var(--color-ph-gold, #d6b25e);
    font-style: italic;
    font-weight: 400;
  }

  @media (max-width: 720px) {
    .hero-content {
      bottom: clamp(24px, 4vw, 48px);
    }
  }

  @media (min-width: 1024px) {
    .hero-content {
      bottom: clamp(40px, 5vw, 72px);
    }
    .hero-claim {
      font-size: clamp(56px, 6.2vw, 96px);
    }
  }
</style>

<script>
  /* El rótulo se enciende una vez (vídeo de encendido) y luego queda encendido en
   * bucle (otro vídeo). Si algo impide reproducir, la portada pasa al póster
   * encendido: nunca se queda con el rótulo apagado. */
  function initHeroNeon(): void {
    const hero = document.querySelector<HTMLElement>('.hero--home');
    const intro = document.querySelector<HTMLVideoElement>('[data-hero-intro]');
    const loop = document.querySelector<HTMLVideoElement>('[data-hero-loop]');
    if (!hero || !intro || !loop) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // El póster encendido sustituye al apagado (mismo encuadre, mismo fotograma
    // que el arranque del bucle).
    const showLitPoster = () => {
      hero.querySelectorAll<HTMLSourceElement | HTMLImageElement>('picture > source, [data-hero-poster]').forEach((el) => {
        if (el instanceof HTMLSourceElement) el.srcset = el.srcset.replace('/off-', '/on-');
        else el.src = el.src.replace('/off-', '/on-');
      });
    };

    const playLoop = () => {
      loop.addEventListener('playing', () => {
        loop.classList.add('is-on');
        intro.classList.remove('is-on');
      }, { once: true });
      void loop.play().catch(() => {});
    };

    // Autoplay bloqueado (p. ej., modo de bajo consumo en iPhone): rótulo
    // encendido fijo y, al primer gesto, el bucle directamente. Empieza en el
    // mismo fotograma que el póster encendido, así que no hay salto.
    const fallBackToLoop = () => {
      showLitPoster();
      const stop = () => {
        window.removeEventListener('pointerdown', retry);
        window.removeEventListener('touchstart', retry);
        window.removeEventListener('scroll', retry);
      };
      const retry = () => { stop(); playLoop(); };
      window.addEventListener('pointerdown', retry, { passive: true });
      window.addEventListener('touchstart', retry, { passive: true });
      window.addEventListener('scroll', retry, { passive: true });
      // Al navegar a otra página, estos elementos dejan de existir.
      document.addEventListener('astro:before-swap', stop, { once: true });
    };

    // Si ninguna fuente sirve, el error salta en la última `<source>`, no en el `<video>`.
    for (const video of [intro, loop]) {
      video.addEventListener('error', showLitPoster);
      video.querySelector('source:last-of-type')?.addEventListener('error', showLitPoster);
    }
    intro.addEventListener('playing', () => {
      intro.classList.add('is-on');
      // El bucle se baja mientras se ve el encendido, para tenerlo listo al acabar.
      loop.preload = 'auto';
      loop.load();
    }, { once: true });
    intro.addEventListener('ended', playLoop, { once: true });

    /* Los vídeos se arrancan a mano tras `load`, no con `autoplay`: con
     * `autoplay` el navegador se baja el archivo nada más encontrarlo y le quita
     * ancho de banda al póster, que es el LCP (medido con el vídeo anterior:
     * retrasaba `load` 504 ms; ver ARCHITECTURE.md, reglas de rendimiento).
     * En navegación SPA el documento ya está cargado y arranca directo. */
    // Al volver a la home con el ClientRouter, los <video> llegan de un documento
    // aparte (el de la página nueva) y WebKit los deja sin reproductor: `play()`
    // no da error pero el vídeo no avanza y se queda el póster apagado. `load()`
    // repite la elección de fuente y lo arregla; con `preload="none"` no descarga
    // nada. Medido en WebKit el 2026-10-01; en Chromium no pasa.
    intro.load();
    loop.load();
    const start = () => { void intro.play().catch(fallBackToLoop); };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }

  document.addEventListener('astro:page-load', () => {
    initHeroNeon();
  });
</script>
