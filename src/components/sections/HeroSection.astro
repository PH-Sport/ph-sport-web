---
import { useTranslations, type Lang } from '@/i18n/utils';
import {
  HERO_INTRO_SOURCES, HERO_LOOP_SOURCES, HERO_PORTRAIT_MEDIA, HERO_POSTER, HERO_SIZE,
} from '@/lib/heroMedia';
import Plate from '@/components/ui/Plate.astro';

interface Props {
  lang: Lang;
  sectionId?: string;
}

const { lang, sectionId } = Astro.props;
const t = useTranslations(lang);
---

{/* La señal en directo: el vídeo del neón a sangre y, en el tercio de abajo, el
    lema como rótulo inferior de retransmisión (pestaña dorada, «Now. Next.» y
    «Forever Football.» en dos placas en escalera). Abajo a la derecha, el bug
    «Scroll», cuya línea se llena con el scroll de la portada. */}
<section
  id={sectionId}
  class="hero hero--home"
>
  <div class="hero-media" aria-hidden="true">
    <div class="hero-backdrop" />
    {/* El póster es un fotograma exacto del vídeo con el mismo encuadre: apagado
        mientras el vídeo no arranca, encendido con movimiento reducido. Los
        <video> no llevan atributo `poster` a propósito: el navegador lo
        descarga nada más crear el elemento. Sin datos ni póster, un <video> es
        transparente y se ve esta imagen de debajo. */}
    <picture>
      <source srcset={HERO_POSTER.on.portrait} media={`${HERO_PORTRAIT_MEDIA} and (prefers-reduced-motion: reduce)`} width={HERO_SIZE.portrait.width} height={HERO_SIZE.portrait.height} />
      <source srcset={HERO_POSTER.on.landscape} media="(prefers-reduced-motion: reduce)" width={HERO_SIZE.landscape.width} height={HERO_SIZE.landscape.height} />
      <source srcset={HERO_POSTER.off.portrait} media={HERO_PORTRAIT_MEDIA} width={HERO_SIZE.portrait.width} height={HERO_SIZE.portrait.height} />
      <img class="hero-poster" data-hero-poster src={HERO_POSTER.off.landscape} alt="" width={HERO_SIZE.landscape.width} height={HERO_SIZE.landscape.height} loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    {/* Sin JavaScript nadie arrancaría el vídeo: el rótulo se queda encendido. */}
    <noscript>
      <picture>
        <source srcset={HERO_POSTER.on.portrait} media={HERO_PORTRAIT_MEDIA} />
        <img class="hero-poster hero-poster--noscript" src={HERO_POSTER.on.landscape} alt="" width={HERO_SIZE.landscape.width} height={HERO_SIZE.landscape.height} />
      </picture>
    </noscript>
    <video class="hero-video hero-video--loop" data-hero-loop muted loop playsinline preload="none">
      {HERO_LOOP_SOURCES.map((s) => (
        <source src={s.src} type={s.type} media={s.media} />
      ))}
    </video>
    <video class="hero-video hero-video--intro" data-hero-intro muted playsinline preload="none">
      {HERO_INTRO_SOURCES.map((s) => (
        <source src={s.src} type={s.type} media={s.media} />
      ))}
    </video>
  </div>


  <div class="hero-shade" aria-hidden="true"></div>
  {/* Velo que oscurece la señal al bajar: la portada cede el paso al bloque
      siguiente. Lo mueve el scroll (script de abajo). */}
  <div class="hero-veil" aria-hidden="true"></div>

  {/* El rótulo espera a que se abra la intro: lo destapa el script, no el
      observador de pantalla (`data-inview-manual`). */}
  <div class="hero-lt" data-inview data-inview-manual>
    <h1 class="hero-claim ph-lt">
      <Plate tab class="hero-claim__plate">{t('hero.claim.lead')}</Plate>{' '}
      <Plate gold d={80} step={1} class="hero-claim__plate">{t('hero.claim.accent')}</Plate>
    </h1>
  </div>

  <a class="hero-scroll" href="#talentos" data-hero-scroll-indicator>
    <span class="hero-scroll__label">{t('hero.scroll.label')}</span>
    <span class="hero-scroll__track" aria-hidden="true"><span class="hero-scroll__fill" data-hero-scroll-fill></span></span>
  </a>
</section>

<style>
  .hero--home {
    position: relative;
    width: 100%;
    /* Alto de pantalla congelado (ver `--ph-viewport-h` en global.css): con `svh`
       a secas, el vaivén de la barra del navegador en iPhone cambiaba el alto del
       hero y arrastraba el documento entero. */
    min-height: var(--ph-viewport-h);
    overflow: hidden;
    background: var(--color-ph-black);
    color: var(--color-ph-white);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    transform-origin: 50% 50%;
  }

  /* Fondo bajo el póster: se ve mientras carga. */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(214, 178, 94, 0.08) 0%, transparent 46%),
      var(--color-ph-black);
  }

  /* Póster y vídeos llenan el hero con `cover`, centrados. El render
     (scripts/hero-neon/neon.html) pone el logo en el centro del encuadre y la
     cámara orbita a su alrededor, así que sigue en el centro aunque gire. En el
     apaisado, en su plano más cercano, el logo ocupa el ~45 % del ancho: cabe
     entero hasta la proporción 9:10, donde pasa al encuadre vertical (9:19,5,
     con el logo al 70 % del ancho): en pantallas menos alargadas que ese,
     `cover` recorta pared por arriba y por abajo, nunca logo. */
  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .hero-poster { z-index: 1; }
  .hero-poster--noscript { z-index: 2; }

  /* Los vídeos aparecen cuando ya están pintando (`is-on`, desde el script de
     abajo): hasta entonces se ve el póster. El encendido va encima del bucle y
     se retira cuando el bucle ya se ve; como su último fotograma es el primero
     del bucle, el relevo no se nota. */
  .hero-video {
    z-index: 2;
    opacity: 0;
  }
  .hero-video--intro { z-index: 3; }
  .hero-video.is-on { opacity: 1; }

  /* Sombra abajo: asienta el rótulo y el bug sobre la señal. */
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      linear-gradient(0deg, rgba(13, 15, 18, 0.78) 0%, rgba(13, 15, 18, 0) 42%),
      linear-gradient(180deg, rgba(13, 15, 18, 0.5) 0%, rgba(13, 15, 18, 0) 18%);
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--color-ph-black);
    opacity: 0;
    pointer-events: none;
  }

  /* El rótulo inferior, en el tercio de abajo y a la izquierda. Cada placa, una
     línea: el tamaño sale de «Forever Football.» más su escalera, que tiene que
     caber en 360 px. */
  .hero-lt {
    position: absolute;
    left: var(--ph-section-px);
    right: var(--ph-section-px);
    bottom: clamp(92px, 12vh, 132px);
    z-index: 4;
  }
  .hero-claim {
    margin: 0;
    font-size: clamp(34px, 10.2vw, 88px);
  }

  /* El bug «Scroll»: su línea se llena con el scroll de la portada y lleva a
     Talentos. */
  .hero-scroll {
    --cut: 40px;
    position: absolute;
    right: var(--ph-section-px);
    bottom: clamp(24px, 4vh, 40px);
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 calc(var(--cut) * 0.7) 0 14px;
    color: var(--color-ph-white);
    text-decoration: none;
    isolation: isolate;
  }
  .hero-scroll::before,
  .hero-scroll::after {
    content: '';
    position: absolute;
    z-index: -1;
  }
  .hero-scroll::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, 0 100%);
  }
  .hero-scroll::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, calc(100% - 0.41px) 0, calc(100% - var(--cut) + 1.59px) 100%, 0 100%);
  }
  .hero-scroll__label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }
  .hero-scroll__track {
    position: relative;
    width: 44px;
    height: 2px;
    background: rgba(255, 255, 255, 0.24);
    overflow: hidden;
  }
  .hero-scroll__fill {
    position: absolute;
    inset: 0;
    background: var(--color-ph-gold);
    transform: scaleX(0.12);
    transform-origin: 0 50%;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-scroll:hover .hero-scroll__label { color: var(--color-ph-gold); }
  }
  .hero-scroll:active .hero-scroll__label { color: var(--color-ph-gold); }
  .hero-scroll:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: 3px; }

  /* En escritorio el rótulo baja hasta casi el borde, para pisar lo menos
     posible el pie del neón. */
  @media (min-width: 768px) {
    .hero-lt { bottom: clamp(56px, 8vh, 96px); }
  }

  /* Red de seguridad propia: el rótulo lo destapa el script de la portada al
     abrirse la intro, no el observador de pantalla. Si ese script no llega, a
     los 2,6 s se ve igual (la intro termina a 1,3 s). */
  :global(html.ph-anim) .hero-lt:not(.is-inview) :global(.ph-plate::before) {
    animation: ph-failsafe-plate-edge 0s linear 2.6s forwards;
  }
  :global(html.ph-anim) .hero-lt:not(.is-inview) :global(.ph-plate__t) {
    animation: ph-failsafe-plate-fill 0s linear 2.6s forwards;
  }
  :global(html.ph-anim) .hero-lt:not(.is-inview) :global(.ph-plate__in),
  :global(html.ph-anim) .hero-lt:not(.is-inview) :global(.ph-plate__tab) {
    animation: ph-motion-failsafe 0s linear 2.6s forwards;
  }
</style>

<script>
  /* El rótulo se enciende una vez (vídeo de encendido) y luego queda encendido en
   * bucle (otro vídeo). Si algo impide reproducir, la portada pasa al póster
   * encendido: nunca se queda con el rótulo apagado. */
  function initHeroNeon(): void {
    const hero = document.querySelector<HTMLElement>('.hero--home');
    const intro = document.querySelector<HTMLVideoElement>('[data-hero-intro]');
    const loop = document.querySelector<HTMLVideoElement>('[data-hero-loop]');
    if (!hero || !intro || !loop) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // El póster encendido sustituye al apagado (mismo encuadre, mismo fotograma
    // que el arranque del bucle).
    const showLitPoster = () => {
      hero.querySelectorAll<HTMLSourceElement | HTMLImageElement>('picture > source, [data-hero-poster]').forEach((el) => {
        if (el instanceof HTMLSourceElement) el.srcset = el.srcset.replace('/off-', '/on-');
        else el.src = el.src.replace('/off-', '/on-');
      });
    };

    const playLoop = () => {
      loop.addEventListener('playing', () => {
        loop.classList.add('is-on');
        intro.classList.remove('is-on');
      }, { once: true });
      void loop.play().catch(() => {});
    };

    // Autoplay bloqueado (p. ej., modo de bajo consumo en iPhone): rótulo
    // encendido fijo y, al primer gesto, el bucle directamente. Empieza en el
    // mismo fotograma que el póster encendido, así que no hay salto.
    const fallBackToLoop = () => {
      showLitPoster();
      const stop = () => {
        window.removeEventListener('pointerdown', retry);
        window.removeEventListener('touchstart', retry);
        window.removeEventListener('scroll', retry);
      };
      const retry = () => { stop(); playLoop(); };
      window.addEventListener('pointerdown', retry, { passive: true });
      window.addEventListener('touchstart', retry, { passive: true });
      window.addEventListener('scroll', retry, { passive: true });
      // Al navegar a otra página, estos elementos dejan de existir.
      document.addEventListener('astro:before-swap', stop, { once: true });
    };

    // Si ninguna fuente sirve, el error salta en la última `<source>`, no en el `<video>`.
    for (const video of [intro, loop]) {
      video.addEventListener('error', showLitPoster);
      video.querySelector('source:last-of-type')?.addEventListener('error', showLitPoster);
    }
    intro.addEventListener('playing', () => {
      intro.classList.add('is-on');
      // El bucle se baja mientras se ve el encendido, para tenerlo listo al acabar.
      loop.preload = 'auto';
      loop.load();
    }, { once: true });
    intro.addEventListener('ended', playLoop, { once: true });

    /* Los vídeos se arrancan a mano tras `load`, no con `autoplay`: con
     * `autoplay` el navegador se baja el archivo nada más encontrarlo y le quita
     * ancho de banda al póster, que es el LCP (medido con el vídeo anterior:
     * retrasaba `load` 504 ms; ver ARCHITECTURE.md, reglas de rendimiento).
     * En navegación SPA el documento ya está cargado y arranca directo. */
    // Al volver a la home con el ClientRouter, los <video> llegan de un documento
    // aparte (el de la página nueva) y WebKit los deja sin reproductor: `play()`
    // no da error pero el vídeo no avanza y se queda el póster apagado. `load()`
    // repite la elección de fuente y lo arregla; con `preload="none"` no descarga
    // nada. Medido en WebKit el 2026-10-01; en Chromium no pasa.
    intro.load();
    loop.load();
    const start = () => { void intro.play().catch(fallBackToLoop); };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }

  document.addEventListener('astro:page-load', initHeroNeon);
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { reducedMotion, scheduleScrollTriggerRefresh, afterTransitionPaint } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(ScrollTrigger);

  /** Segundos que faltan para que la cortinilla de la intro pase por la esquina
   *  de abajo a la izquierda, donde va el rótulo (0 si no hay intro). */
  function introRemaining(): number {
    const overlay = document.querySelector<HTMLElement>('[data-logo-reveal-overlay]');
    if (!overlay || document.documentElement.classList.contains('ph-sin-intro')) return 0;
    const salida = overlay
      .getAnimations()
      .find((a) => (a as CSSAnimation).animationName === 'ph-intro-salir');
    if (!salida) return 0;
    const elapsed = Number(salida.currentTime ?? 0) / 1000;
    // El barrido empieza a 0,9 s desde esa esquina: el rótulo entra detrás de él.
    return Math.max(0, 1.0 - elapsed);
  }

  function initHeroAnimations(): void {
    const hero = document.querySelector<HTMLElement>('.hero--home');
    const lt = hero?.querySelector<HTMLElement>('.hero-lt');
    if (!hero || !lt) return;
    if (reducedMotion()) {
      lt.classList.add('is-inview');
      return;
    }

    // El momento de autor de la portada: la pestaña, «Now. Next.» y «Forever
    // Football.» entran como el rótulo de una retransmisión (CSS, global.css).
    window.setTimeout(() => lt.classList.add('is-inview'), introRemaining() * 1000 + 60);

    // Al bajar, las placas salen hacia la izquierda en escalera, la señal se
    // oscurece y la línea del bug se llena: todo al ritmo del dedo.
    const plates = Array.from(lt.querySelectorAll<HTMLElement>('.ph-plate'));
    const media = hero.querySelector<HTMLElement>('.hero-media');
    const veil = hero.querySelector<HTMLElement>('.hero-veil');
    const fill = hero.querySelector<HTMLElement>('[data-hero-scroll-fill]');
    const tl = gsap.timeline({
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.5, invalidateOnRefresh: true },
    });
    plates.forEach((plate, i) => {
      tl.to(plate, { x: () => -(plate.getBoundingClientRect().right + 24), ease: 'none', duration: 0.7 }, i * 0.12);
    });
    if (veil) tl.to(veil, { opacity: 0.72, ease: 'none', duration: 1 }, 0);
    if (media) tl.to(media, { scale: 1.08, ease: 'none', duration: 1 }, 0);
    if (fill) tl.fromTo(fill, { scaleX: 0.12 }, { scaleX: 1, ease: 'none', duration: 1 }, 0);

    scheduleScrollTriggerRefresh();
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHeroAnimations));
</script>
