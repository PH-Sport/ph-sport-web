---
import { useTranslations, type Lang } from '@/i18n/utils';
import {
  HERO_INTRO_SOURCES, HERO_LOOP_SOURCES, HERO_PORTRAIT_MEDIA, HERO_POSTER, HERO_SIZE,
} from '@/lib/heroMedia';

interface Props {
  lang: Lang;
  sectionId?: string;
}

const { lang, sectionId } = Astro.props;
const t = useTranslations(lang);

// El lema, palabra a palabra: «Now.» y «Next.» van cada una a un lado y
// «Forever Football.» abajo, en oro.
const leadWords = t('hero.claim.lead').split(/\s+/).filter(Boolean);
const accentWords = t('hero.claim.accent').split(/\s+/).filter(Boolean);
---

{/* Primera escena de la portada: el rótulo de neón a sangre y la secuencia del
    lema. Con movimiento, la escena se queda fijada (sticky) durante 1,5
    pantallas de scroll: «Now.» sale por la izquierda, «Next.» por la derecha,
    «Forever Football.» crece, el neón se oscurece y la escena siguiente sube
    por encima con un borde duro (el corte). El alto de la pista depende de
    `html.ph-anim`, que se decide antes del primer pintado: así la restauración
    del scroll al volver atrás cae en su sitio. */}
<section id={sectionId} class="hero" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__media" aria-hidden="true">
      <div class="hero__backdrop"></div>
      {/* El póster es un fotograma exacto del vídeo con el mismo encuadre: apagado
          mientras el vídeo no arranca, encendido con movimiento reducido. Los
          <video> no llevan atributo `poster` a propósito: el navegador lo
          descarga nada más crear el elemento. Sin datos ni póster, un <video> es
          transparente y se ve esta imagen de debajo. */}
      <picture>
        <source srcset={HERO_POSTER.on.portrait} media={`${HERO_PORTRAIT_MEDIA} and (prefers-reduced-motion: reduce)`} width={HERO_SIZE.portrait.width} height={HERO_SIZE.portrait.height} />
        <source srcset={HERO_POSTER.on.landscape} media="(prefers-reduced-motion: reduce)" width={HERO_SIZE.landscape.width} height={HERO_SIZE.landscape.height} />
        <source srcset={HERO_POSTER.off.portrait} media={HERO_PORTRAIT_MEDIA} width={HERO_SIZE.portrait.width} height={HERO_SIZE.portrait.height} />
        <img class="hero__poster" data-hero-poster src={HERO_POSTER.off.landscape} alt="" width={HERO_SIZE.landscape.width} height={HERO_SIZE.landscape.height} loading="eager" fetchpriority="high" decoding="async" />
      </picture>
      {/* Sin JavaScript nadie arrancaría el vídeo: el rótulo se queda encendido. */}
      <noscript>
        <picture>
          <source srcset={HERO_POSTER.on.portrait} media={HERO_PORTRAIT_MEDIA} />
          <img class="hero__poster hero__poster--noscript" src={HERO_POSTER.on.landscape} alt="" width={HERO_SIZE.landscape.width} height={HERO_SIZE.landscape.height} />
        </picture>
      </noscript>
      <video class="hero__video hero__video--loop" data-hero-loop muted loop playsinline preload="none">
        {HERO_LOOP_SOURCES.map((s) => (
          <source src={s.src} type={s.type} media={s.media} />
        ))}
      </video>
      <video class="hero__video hero__video--intro" data-hero-intro muted playsinline preload="none">
        {HERO_INTRO_SOURCES.map((s) => (
          <source src={s.src} type={s.type} media={s.media} />
        ))}
      </video>
    </div>

    <div class="hero__shade" aria-hidden="true"></div>
    {/* Velo que oscurece el neón al bajar: lo mueve el scroll (script de abajo). */}
    <div class="hero__veil" aria-hidden="true"></div>

    <h1 class="hero__claim" id="hero-title">
      <span class="hero__lead">
        {leadWords.map((word, i) => (
          <>
            <span class:list={['hero__w', i === 0 ? 'hero__w--now' : 'hero__w--next']}>
              <span class="hero__wm"><span class="hero__wi">{word}</span></span>
            </span>{' '}
          </>
        ))}
      </span>
      <span class="hero__accent ph-gold">
        {accentWords.map((word, i) => (
          <>
            <span class="hero__wm"><span class="hero__wi">{word}</span></span>{i < accentWords.length - 1 ? ' ' : ''}
          </>
        ))}
      </span>
    </h1>

    <a class="hero__scroll" href="#talentos" data-hero-scroll-indicator>
      <span class="hero__scroll-label">{t('hero.scroll.label')}</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 0;
    background: var(--color-ph-black);
  }

  /* La pista de la escena fijada: 2,5 pantallas (1,5 de recorrido; la última la
     comparte con la escena siguiente, que sube por encima). */
  :global(html.ph-anim) .hero {
    height: calc(var(--ph-viewport-h) * 2.5);
  }

  .hero__stage {
    position: sticky;
    top: 0;
    /* Alto de pantalla congelado (ver `--ph-viewport-h` en global.css): con `svh`
       a secas, el vaivén de la barra del navegador en iPhone cambiaba el alto del
       hero y arrastraba el documento entero. */
    height: var(--ph-viewport-h);
    overflow: hidden; /* Safari < 16 no conoce `clip` */
    overflow: clip;
    color: var(--color-ph-white);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    transform-origin: 50% 50%;
  }

  /* Fondo bajo el póster: se ve mientras carga. */
  .hero__backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(214, 178, 94, 0.08) 0%, transparent 46%),
      var(--color-ph-black);
  }

  /* Póster y vídeos llenan la escena con `cover`, centrados. El render
     (scripts/hero-neon/neon.html) pone el logo en el centro del encuadre y la
     cámara orbita a su alrededor, así que sigue en el centro aunque gire. Por
     debajo de 9:10 pasa al encuadre vertical (9:19,5, con el logo al 70 % del
     ancho): en pantallas menos alargadas, `cover` recorta pared, nunca logo. */
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .hero__poster { z-index: 1; }
  .hero__poster--noscript { z-index: 2; }

  /* Los vídeos aparecen cuando ya están pintando (`is-on`, desde el script de
     abajo): hasta entonces se ve el póster. El encendido va encima del bucle y
     se retira cuando el bucle ya se ve; como su último fotograma es el primero
     del bucle, el relevo no se nota. */
  .hero__video {
    z-index: 2;
    opacity: 0;
  }
  .hero__video--intro { z-index: 3; }
  .hero__video.is-on { opacity: 1; }

  /* Sombra arriba y abajo para que el lema se lea sobre el neón. */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(13, 15, 18, 0.62) 0%,
      rgba(13, 15, 18, 0) 34%,
      rgba(13, 15, 18, 0) 58%,
      rgba(13, 15, 18, 0.74) 100%
    );
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--color-ph-black);
    opacity: 0;
    pointer-events: none;
  }

  /* ── El lema ──
     Móvil: «Now.» arriba a la izquierda, «Next.» debajo a la derecha (34vw) y
     «Forever Football.» en oro abajo, en dos líneas (17vw). Escritorio: «Now.» y
     «Next.» en la misma línea base (16vw) y «Forever Football.» en una (11vw). */
  .hero__claim {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: 0;
    padding:
      calc(68px + env(safe-area-inset-top)) var(--ph-section-px)
      calc(28px + env(safe-area-inset-bottom));
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: var(--ph-giant-track);
    pointer-events: none;
  }

  .hero__lead {
    display: block;
  }

  .hero__w {
    display: block;
    font-size: min(34vw, calc(var(--ph-viewport-h) * 0.3));
  }

  .hero__w--next {
    text-align: right;
  }

  .hero__accent {
    display: block;
    font-size: min(17vw, calc(var(--ph-viewport-h) * 0.15));
  }

  .hero__accent .hero__wm {
    display: block;
    width: fit-content;
  }

  /* Cada palabra en su máscara: sube desde la línea base al entrar. El recorte
     se abre por arriba y por abajo para no comerse acentos ni descendentes. */
  .hero__wm {
    display: inline-block;
    clip-path: inset(-0.4em -0.2em -0.26em -0.2em);
  }

  .hero__wi {
    display: inline-block;
  }

  @media (min-width: 1024px) {
    .hero__claim {
      padding-top: calc(104px + env(safe-area-inset-top));
      padding-bottom: calc(40px + env(safe-area-inset-bottom));
    }

    .hero__lead {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }

    .hero__w {
      font-size: min(16vw, calc(var(--ph-viewport-h) * 0.26));
    }

    .hero__accent {
      font-size: min(11vw, calc(var(--ph-viewport-h) * 0.18));
      white-space: nowrap;
    }

    .hero__accent .hero__wm {
      display: inline-block;
    }
  }

  /* El lema espera al JS (que lo hace subir cuando corta la intro), con su red de
     seguridad: pase lo que pase, a 1,6 s está a la vista. */
  :global(html.ph-anim) .hero__wi {
    visibility: hidden;
    animation: ph-hero-claim-visible 0s linear 1.6s forwards;
  }

  @keyframes ph-hero-claim-visible {
    to { visibility: visible; }
  }

  /* ── «Scroll»: pequeño, abajo a la derecha, con un hilo ── */
  .hero__scroll {
    position: absolute;
    right: var(--ph-section-px);
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-width: 44px;
    padding-top: 8px;
    color: var(--color-ph-white);
    text-decoration: none;
    transition: opacity var(--ph-dur-state) var(--ph-ease-std), color var(--ph-dur-state) var(--ph-ease-std);
  }

  .hero__scroll-label {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ph-ink-lead);
  }

  /* El hilo se dibuja una vez y una luz lo recorre dos veces hacia abajo; luego
     se queda quieto (nada se mueve solo más de 5 s). */
  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.4);
    transform-origin: 50% 0;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--color-ph-gold);
    transform: translateY(-100%);
  }

  :global(html.ph-anim) .hero__scroll-line {
    animation: ph-cue-draw 0.6s var(--ph-ease-out) 1.6s both;
  }

  :global(html.ph-anim) .hero__scroll-line::after {
    animation: ph-cue-light 1.4s var(--ph-ease-std) 2.3s 2 both;
  }

  @keyframes ph-cue-draw {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @keyframes ph-cue-light {
    from { transform: translateY(0); }
    to { transform: translateY(360%); }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__scroll:hover { color: var(--color-ph-gold); }
    .hero__scroll:hover .hero__scroll-label { color: var(--color-ph-gold); }
  }

  .hero__scroll.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  /* La señal de scroll se esconde al bajar. Un solo listener para toda la sesión
     que mira la señal de la página actual: antes se añadía uno nuevo en cada
     visita a la home y se acumulaban (3 → 4 → 6). */
  let scrollCue: HTMLElement | null = null;
  const syncScrollCue = () => scrollCue?.classList.toggle('is-hidden', window.scrollY > 48);
  document.addEventListener('scroll', syncScrollCue, { passive: true });

  function initHeroScrollCue(): void {
    scrollCue = document.querySelector<HTMLElement>('[data-hero-scroll-indicator]');
    syncScrollCue();
  }

  /* El rótulo se enciende una vez (vídeo de encendido) y luego queda encendido en
   * bucle (otro vídeo). Si algo impide reproducir, la portada pasa al póster
   * encendido: nunca se queda con el rótulo apagado. */
  function initHeroNeon(): void {
    const hero = document.querySelector<HTMLElement>('.hero');
    const intro = document.querySelector<HTMLVideoElement>('[data-hero-intro]');
    const loop = document.querySelector<HTMLVideoElement>('[data-hero-loop]');
    if (!hero || !intro || !loop) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // El póster encendido sustituye al apagado (mismo encuadre, mismo fotograma
    // que el arranque del bucle).
    const showLitPoster = () => {
      hero.querySelectorAll<HTMLSourceElement | HTMLImageElement>('picture > source, [data-hero-poster]').forEach((el) => {
        if (el instanceof HTMLSourceElement) el.srcset = el.srcset.replace('/off-', '/on-');
        else el.src = el.src.replace('/off-', '/on-');
      });
    };

    const playLoop = () => {
      loop.addEventListener('playing', () => {
        loop.classList.add('is-on');
        intro.classList.remove('is-on');
      }, { once: true });
      void loop.play().catch(() => {});
    };

    // Autoplay bloqueado (p. ej., modo de bajo consumo en iPhone): rótulo
    // encendido fijo y, al primer gesto, el bucle directamente. Empieza en el
    // mismo fotograma que el póster encendido, así que no hay salto.
    const fallBackToLoop = () => {
      showLitPoster();
      const stop = () => {
        window.removeEventListener('pointerdown', retry);
        window.removeEventListener('touchstart', retry);
        window.removeEventListener('scroll', retry);
      };
      const retry = () => { stop(); playLoop(); };
      window.addEventListener('pointerdown', retry, { passive: true });
      window.addEventListener('touchstart', retry, { passive: true });
      window.addEventListener('scroll', retry, { passive: true });
      // Al navegar a otra página, estos elementos dejan de existir.
      document.addEventListener('astro:before-swap', stop, { once: true });
    };

    // Si ninguna fuente sirve, el error salta en la última `<source>`, no en el `<video>`.
    for (const video of [intro, loop]) {
      video.addEventListener('error', showLitPoster);
      video.querySelector('source:last-of-type')?.addEventListener('error', showLitPoster);
    }
    intro.addEventListener('playing', () => {
      intro.classList.add('is-on');
      // El bucle se baja mientras se ve el encendido, para tenerlo listo al acabar.
      loop.preload = 'auto';
      loop.load();
    }, { once: true });
    intro.addEventListener('ended', playLoop, { once: true });

    /* Los vídeos se arrancan a mano tras `load`, no con `autoplay`: con
     * `autoplay` el navegador se baja el archivo nada más encontrarlo y le quita
     * ancho de banda al póster, que es el LCP (medido con el vídeo anterior:
     * retrasaba `load` 504 ms; ver ARCHITECTURE.md, reglas de rendimiento).
     * En navegación SPA el documento ya está cargado y arranca directo. */
    // Al volver a la home con el ClientRouter, los <video> llegan de un documento
    // aparte (el de la página nueva) y WebKit los deja sin reproductor: `play()`
    // no da error pero el vídeo no avanza y se queda el póster apagado. `load()`
    // repite la elección de fuente y lo arregla; con `preload="none"` no descarga
    // nada. Medido en WebKit el 2026-10-01; en Chromium no pasa.
    intro.load();
    loop.load();
    const start = () => { void intro.play().catch(fallBackToLoop); };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }

  document.addEventListener('astro:page-load', () => {
    initHeroScrollCue();
    initHeroNeon();
  });
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, scheduleScrollTriggerRefresh, afterTransitionPaint, EASE,
  } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(ScrollTrigger);

  /** Segundos que faltan para que la intro corte al neón (0 si no hay intro).
   *  El lema entra justo después del corte, no debajo del telón. */
  function introRemaining(): number {
    const overlay = document.querySelector<HTMLElement>('[data-logo-reveal-overlay]');
    if (!overlay || document.documentElement.classList.contains('ph-sin-intro')) return 0;
    const salida = overlay
      .getAnimations()
      .find((a) => (a as CSSAnimation).animationName === 'ph-intro-salir');
    if (!salida) return 0;
    // `ph-intro-salir` empieza a 1,2 s y dura 0,04: el corte es a 1,24 s.
    const elapsed = Number(salida.currentTime ?? 0) / 1000;
    return Math.max(0, 1.24 - elapsed);
  }

  function initHeroAnimations(): void {
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero) return;
    if (reducedMotion()) return;

    const words = Array.from(hero.querySelectorAll<HTMLElement>('.hero__wi'));
    const now = hero.querySelector<HTMLElement>('.hero__w--now');
    const next = hero.querySelector<HTMLElement>('.hero__w--next');
    const accent = hero.querySelector<HTMLElement>('.hero__accent');
    const media = hero.querySelector<HTMLElement>('.hero__media');
    const veil = hero.querySelector<HTMLElement>('.hero__veil');

    // La secuencia del lema: cada palabra sube de su línea base (700 ms) con
    // escalones de 120 ms, en el orden en que se lee.
    gsap.set(words, { visibility: 'visible' });
    gsap.from(words, {
      yPercent: 150,
      duration: 0.7,
      ease: EASE.emph,
      stagger: 0.12,
      delay: introRemaining() + 0.06,
    });

    // Al bajar, con la escena fijada: «Now.» sale por la izquierda, «Next.» por la
    // derecha, «Forever Football.» crece un poco y el neón se oscurece y se
    // acerca. Ligado al scroll: avanza al ritmo del dedo.
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom bottom', scrub: 0.5 },
    });
    if (now) tl.to(now, { xPercent: -135, duration: 0.42 }, 0);
    if (next) tl.to(next, { xPercent: 135, duration: 0.42 }, 0.02);
    if (accent) tl.to(accent, { scale: 1.12, transformOrigin: '0% 100%', duration: 1 }, 0);
    if (media) tl.to(media, { scale: 1.08, duration: 1 }, 0);
    if (veil) tl.to(veil, { opacity: 0.72, duration: 0.8 }, 0.2);

    scheduleScrollTriggerRefresh();
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHeroAnimations));
</script>
