---
import { useTranslations, localizePath, type Lang } from '@/i18n/utils';
import { LinkButton, ArrowRightIcon } from 'mochi-ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const aboutHref = localizePath('/sobre-nosotros/', lang);
// Países donde opera PHSPORT: sale del texto traducido, la misma fuente que el
// resto de menciones (ver la nota de `about.team.meta` en es.ts).
const countriesValue = Number(t('home.about.stats.countries.value'));

/** «04 · Sobre PHSPORT»: el número y la etiqueta van en estilos distintos en la fila índice. */
const [eyebrowNum, ...eyebrowRest] = t('home.about.eyebrow').split(' · ');
const eyebrowLabel = eyebrowRest.join(' · ');
---

<section class="home-about" id="sobre-nosotros" aria-labelledby="home-about-title">
  <p class="ph-rowline">
    <span class="ph-rowline__group">
      <span class="ph-rowline__num">{eyebrowNum}</span>
      <span class="ph-rowline__sep" aria-hidden="true">·</span>
      <span class="ph-rowline__label">{eyebrowLabel}</span>
    </span>
  </p>

  <div class="home-about__grid">
    <h2 class="ph-h2 home-about__title" id="home-about-title">
      <span>{t('home.about.title')}</span>
      <em>{t('home.about.titleAccent')}</em>
    </h2>

    <div class="home-about__body">
      <p class="ph-body">{t('home.about.body')}</p>
      <LinkButton href={aboutHref} variant="surface">
        {t('home.about.cta')}
        <ArrowRightIcon slot="icon" />
      </LinkButton>
    </div>

    <dl class="home-about__stats" aria-label={t('home.about.stats.aria')}>
      <div class="home-about__stat">
        <dt class="home-about__stat-value">{countriesValue}</dt>
        <dd class="home-about__stat-label">{t('home.about.stats.countries.label')}</dd>
      </div>
      <div class="home-about__stat">
        <dt class="home-about__stat-value">360<span class="home-about__stat-unit" aria-hidden="true">°</span></dt>
        <dd class="home-about__stat-label">{t('home.about.stats.service.label')}</dd>
      </div>
    </dl>

    <ul class="ph-rowline home-about__values" aria-label={t('home.about.values.aria')} role="list">
      <li class="ph-rowline__meta">{t('home.about.values.v1')}</li>
      <li class="ph-rowline__meta">{t('home.about.values.v2')}</li>
      <li class="ph-rowline__meta">{t('home.about.values.v3')}</li>
    </ul>
  </div>
</section>

<style>
  /* Mismo sistema que el resto de secciones (global.css y ph-ui.css). Las cifras
     se ven tal cual desde el principio: sin contadores que suben desde cero. */
  .home-about {
    position: relative;
    padding: clamp(88px, 9vw, 156px) var(--ph-section-px) 0;
    color: var(--color-ph-white);
  }

  .home-about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: clamp(28px, 3vw, 48px);
    margin-top: var(--ph-head-title-gap);
  }
  .home-about__title { grid-column: 1 / 11; }
  .home-about__title span,
  .home-about__title em { display: block; }

  .home-about__body { grid-column: 1 / 6; display: grid; gap: 28px; align-content: start; justify-items: start; }

  .home-about__stats { grid-column: 7 / 13; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 0; }
  .home-about__stat {
    display: grid;
    gap: 10px;
    padding: clamp(20px, 1.6vw, 24px);
    border: 1px solid var(--mochi-surface-border);
    border-radius: var(--ph-r-lg);
    background: var(--mochi-surface);
    box-shadow: var(--mochi-shadow-surface);
  }
  .home-about__stat-value {
    font: 500 clamp(56px, calc(3vw + 40px), 88px)/0.9 var(--font-display);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ph-white);
  }
  .home-about__stat-unit { margin-left: 2px; font-size: 0.45em; vertical-align: top; color: var(--color-ph-gold); }
  .home-about__stat-label { margin: 0; font-size: 14px; color: var(--ph-ink-meta); }

  .home-about__values { grid-column: 1 / 13; justify-content: flex-start; gap: 6px 32px; margin: 0; list-style: none; }

  @media (max-width: 900px) {
    .home-about__grid { display: flex; flex-direction: column; }
  }
</style>
