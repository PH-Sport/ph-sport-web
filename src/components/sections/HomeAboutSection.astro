---
import { useTranslations, localizePath, type Lang } from '@/i18n/utils';
import SceneLabel from '@/components/ui/SceneLabel.astro';
import TitleLink from '@/components/ui/TitleLink.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const aboutHref = localizePath('/sobre-nosotros/', lang);
const values = [t('home.about.values.v1'), t('home.about.values.v2'), t('home.about.values.v3')];
---

{/* Cuarta escena de la portada: la declaración de la agencia a escala gigante,
    que se enciende al leerla («pero las personas marcan.» en oro); el texto y el
    enlace; y las cifras —7 y 360°— enormes, cada una con su etiqueta a la altura
    de su línea base, en una composición asimétrica que entra de desenfoque a
    nítido. Los valores cierran en una línea que también se lee encendiéndose. */}
<section class="ha" id="sobre-nosotros" aria-labelledby="home-about-title">
  <SceneLabel text={t('home.about.eyebrow')} />

  <h2 class="ha__title ph-giant" id="home-about-title" data-kinetic>
    {t('home.about.title')} <span class="ph-gold">{t('home.about.titleAccent')}</span>
  </h2>

  <div class="ha__grid ph-grid">
    <div class="ha__text">
      <p class="ha__body ph-lead" data-reveal>{t('home.about.body')}</p>
      <div class="ha__cta">
        <TitleLink href={aboutHref} label={t('home.about.cta')} />
      </div>
    </div>

    <dl class="ha__stats" aria-label={t('home.about.stats.aria')}>
      <div class="ha__stat ha__stat--countries">
        <dt class="ha__num" data-focus>{t('home.about.stats.countries.value')}</dt>
        <dd class="ha__label">{t('home.about.stats.countries.label')}</dd>
      </div>
      <div class="ha__stat ha__stat--service">
        <dt class="ha__num" data-focus>{t('home.about.stats.service.value')}</dt>
        <dd class="ha__label">{t('home.about.stats.service.label')}</dd>
      </div>
    </dl>
  </div>

  <ul class="ha__values" aria-label={t('home.about.values.aria')} role="list" data-kinetic>
    {values.map((v, i) => (
      <>
        {i > 0 && <li class="ha__values-sep" aria-hidden="true">·</li>}
        <li>{v}</li>
      </>
    ))}
  </ul>
</section>

<style>
  .ha {
    position: relative;
    z-index: 2;
    background: var(--color-ph-black);
    padding: clamp(72px, 10vw, 144px) var(--ph-section-px) clamp(96px, 12vw, 168px);
  }

  .ha__title {
    max-width: 14ch;
    margin-top: clamp(32px, 5vw, 64px);
    font-size: 13vw;
    line-height: 0.88;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .ha__title {
      max-width: 16ch;
      font-size: 7.5vw;
    }
  }

  .ha__grid {
    row-gap: clamp(56px, 8vw, 96px);
    margin-top: clamp(48px, 6vw, 88px);
  }

  .ha__text {
    grid-column: 1 / -1;
  }

  .ha__cta {
    margin-top: clamp(28px, 3vw, 40px);
  }

  /* Las cifras: Söhne 700 enorme, la etiqueta pequeña en su línea base.
     Asimétricas: el 7 a la izquierda con la etiqueta a su derecha; el 360° contra
     el margen derecho, con la etiqueta a su izquierda. */
  .ha__stats {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
  }

  .ha__stat {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0;
  }

  .ha__stat--service {
    flex-direction: row-reverse;
  }

  .ha__num {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 44vw;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--color-ph-white);
    transform-origin: 0% 100%;
  }

  .ha__stat--service .ha__num {
    font-size: 26vw;
    transform-origin: 100% 100%;
  }

  .ha__label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--ph-small);
    letter-spacing: 0.02em;
    color: var(--ph-ink-lead);
  }

  @media (min-width: 1024px) {
    .ha__text {
      grid-column: 1 / 6;
      align-self: end;
    }

    .ha__stats {
      grid-column: 7 / 13;
    }

    .ha__num {
      font-size: 22vw;
    }

    .ha__stat--service .ha__num {
      font-size: 14vw;
    }
  }

  /* Los valores: una línea de tamaño medio. */
  .ha__values {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5em;
    margin: clamp(56px, 8vw, 104px) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--ph-mid);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ph-white);
  }

  .ha__values li {
    margin: 0;
  }

  .ha__values-sep {
    color: var(--color-ph-gold);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, kinetic, fadeUp, rackFocus, mountSection, afterTransitionPaint,
  } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(ScrollTrigger);

  function initHomeAbout(): void {
    const section = document.querySelector<HTMLElement>('.ha');
    if (!section) return;
    if (!reducedMotion()) {
      section.querySelectorAll<HTMLElement>('[data-kinetic]').forEach((el) => kinetic(el));
      fadeUp(section.querySelectorAll<HTMLElement>('.ha__body'));
      // Las cifras entran de desenfoque a nítido, una detrás de otra.
      rackFocus(section.querySelectorAll<HTMLElement>('[data-focus]'), { trigger: section.querySelector('.ha__stats') ?? section });
    }
    mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHomeAbout));
</script>
