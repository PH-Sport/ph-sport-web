---
import { useTranslations, localizePath, type Lang } from '@/i18n/utils';
import { LinkButton, ArrowRightIcon } from 'mochi-ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const aboutHref = localizePath('/sobre-nosotros/', lang);
// Países donde opera PHSPORT: sale del texto traducido, la misma fuente que el
// resto de menciones (ver la nota de `about.team.meta` en es.ts).
const countriesValue = Number(t('home.about.stats.countries.value'));

---

<section class="home-about" id="sobre-nosotros" aria-labelledby="home-about-title">
  <div class="home-about__grid">
    <h2 class="ph-h2 home-about__title" id="home-about-title">
      <span>{t('home.about.title')}</span>
      <em>{t('home.about.titleAccent')}</em>
    </h2>

    <div class="home-about__body">
      <p class="ph-body">{t('home.about.body')}</p>
      <LinkButton href={aboutHref} variant="surface">
        {t('home.about.cta')}
        <ArrowRightIcon slot="icon" />
      </LinkButton>
    </div>

    {/* Las dos cifras como una sola línea de texto, no como dos cajas de
        «número grande + etiqueta»: se leen como una frase. */}
    <dl class="home-about__figures" aria-label={t('home.about.stats.aria')}>
      <div class="home-about__figure">
        <dt>{countriesValue}</dt>
        <dd>{t('home.about.stats.countries.label')}</dd>
      </div>
      <span class="home-about__figure-sep" aria-hidden="true">·</span>
      <div class="home-about__figure">
        <dt>360°</dt>
        <dd>{t('home.about.stats.service.label')}</dd>
      </div>
    </dl>

  </div>
</section>

<style>
  /* Mismo sistema que el resto de secciones (global.css y ph-ui.css). Las cifras
     se ven tal cual desde el principio: sin contadores que suben desde cero, y sin
     caja. */
  .home-about {
    position: relative;
    padding: clamp(88px, 9vw, 156px) var(--ph-section-px) 0;
    color: var(--color-ph-white);
  }

  .home-about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: clamp(28px, 3vw, 48px);
  }
  .home-about__title { grid-column: 1 / 11; }
  .home-about__title span,
  .home-about__title em { display: block; }

  .home-about__body { grid-column: 1 / 6; display: grid; gap: 28px; align-content: start; justify-items: start; }

  .home-about__figures {
    grid-column: 7 / 13;
    align-self: start;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    margin: 0;
    font: 500 clamp(28px, calc(1.4vw + 22px), 44px)/1.1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ph-white);
  }
  .home-about__figure { display: flex; align-items: baseline; gap: 0.3em; }
  .home-about__figure dt { font-variant-numeric: tabular-nums; }
  .home-about__figure dd { margin: 0; color: var(--ph-ink-lead); }
  .home-about__figure-sep { color: var(--color-ph-gold); }


  @media (max-width: 900px) {
    .home-about__grid { display: flex; flex-direction: column; }
  }
  /* En estrecho las dos cifras no caben en una línea: una debajo de otra y sin
     el punto, que se quedaba colgando al final del renglón. */
  @media (max-width: 600px) {
    .home-about__figures { flex-direction: column; align-items: flex-start; }
    .home-about__figure-sep { display: none; }
  }
</style>
