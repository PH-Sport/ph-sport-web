---
import { useTranslations, localizePath, type Lang } from '@/i18n/utils';
import Bug from '@/components/ui/Bug.astro';
import Plate from '@/components/ui/Plate.astro';
import KeyPlate from '@/components/ui/KeyPlate.astro';
import Ticker from '@/components/ui/Ticker.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const aboutHref = localizePath('/sobre-nosotros/', lang);
// Países donde opera PHSPORT: sale del texto traducido, la misma fuente que el
// resto de menciones (ver la nota de `about.team.meta` en es.ts). La barra lleva
// un segmento por país.
const countriesValue = t('home.about.stats.countries.value');
const countrySegments = Math.max(1, Number.parseInt(countriesValue, 10) || 1);
---

{/* «Rótulo de cita» y «estadísticas del partido»: la frase de la agencia a toda
    pantalla en dos placas, el texto con su placa llave, la tabla de cifras como
    la de un partido (cada fila con su barra) y los valores en la cinta de abajo,
    que corre con el scroll. */}
<section class="home-about" id="sobre-nosotros" aria-labelledby="home-about-title">
  <div class="home-about__inner">
    <Bug text={t('home.about.eyebrow')} />
    <div class="home-about__quote" data-inview>
      <h2 class="home-about__title ph-lt" id="home-about-title">
        <Plate tab lines>{t('home.about.title')}</Plate>{' '}
        <Plate gold d={110} step={1} lines>{t('home.about.titleAccent')}</Plate>
      </h2>
    </div>

    <div class="home-about__grid">
      <div class="home-about__text" data-inview>
        <p class="home-about__body ph-in-rise">{t('home.about.body')}</p>
        <div class="home-about__cta ph-in-rise" style="--d: 100ms">
          <KeyPlate href={aboutHref} label={t('home.about.cta')} />
        </div>
      </div>

      {/* La tabla de estadísticas de un partido: etiqueta a la izquierda, cifra a
          la derecha y su barra debajo, que se enciende al entrar. */}
      <dl class="stats" aria-label={t('home.about.stats.aria')} data-inview>
        <div class="stats__row">
          <dt class="stats__label">{t('home.about.stats.countries.label')}</dt>
          <dd class="stats__value">
            <span class="stats__num">{countriesValue}</span>
            <span class="stats__bar stats__bar--seg" aria-hidden="true">
              {Array.from({ length: countrySegments }, (_, i) => <i style={`--i: ${i}`}></i>)}
            </span>
          </dd>
        </div>
        <div class="stats__row" style="--row: 1">
          <dt class="stats__label">{t('home.about.stats.service.label')}</dt>
          <dd class="stats__value">
            <span class="stats__num">{t('home.about.stats.service.value')}</span>
            <span class="stats__bar stats__bar--full" aria-hidden="true"><i></i></span>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <Ticker
    as="ul"
    label={t('home.about.values.aria')}
    items={[t('home.about.values.v1'), t('home.about.values.v2'), t('home.about.values.v3')]}
    class="home-about__ticker"
  />
</section>

<style>
  .home-about {
    position: relative;
    padding: clamp(64px, 7vw, 104px) 0 0;
    /* Transparente: el fondo es la luz animada de toda la página (`.ph-page-bg`). */
    background: transparent;
  }
  .home-about__inner {
    padding: 0 var(--ph-section-px) clamp(64px, 8vw, 112px);
  }

  .home-about__quote { margin-top: clamp(30px, 4vw, 52px); }
  /* La cita a toda pantalla: cada mitad de la frase en su placa. La segunda se
     parte en dos líneas en el móvil (el italiano es el más largo). */
  .home-about__title {
    margin: 0;
    font-size: clamp(30px, 8.6vw, 92px);
  }

  .home-about__grid {
    display: grid;
    gap: clamp(40px, 5vw, 64px);
    margin-top: clamp(36px, 5vw, 64px);
  }
  @media (min-width: 1024px) {
    .home-about__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: end;
    }
  }

  .home-about__body {
    margin: 0;
    max-width: 50ch;
    font-size: clamp(16px, calc(0.19vw + 15.3px), 18px);
    line-height: 1.65;
    color: var(--ph-ink-body);
  }
  .home-about__cta { margin-top: clamp(24px, 3vw, 36px); }

  /* ── La tabla de estadísticas ─────────────────────────────────────────── */
  .stats {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
  }
  .stats__row {
    --cut: 34px;
    position: relative;
    z-index: 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 18px calc(var(--cut) + 6px) 42px 18px;
  }
  .stats__row::before,
  .stats__row::after {
    content: '';
    position: absolute;
    z-index: -1;
  }
  .stats__row::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%);
  }
  .stats__row::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut) + 0.59px), calc(100% - var(--cut) + 0.59px) 100%, 0 100%);
  }
  .stats__label {
    font-family: var(--font-display);
    font-size: clamp(17px, calc(0.6vw + 15px), 22px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ph-white);
  }
  .stats__value { margin: 0; }
  .stats__num {
    font-family: var(--font-mono);
    font-size: clamp(30px, calc(1.6vw + 24px), 46px);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--color-ph-white);
    transition:
      opacity 320ms var(--ph-ease-out) calc(var(--row, 0) * 120ms + 80ms),
      transform 420ms var(--ph-ease-out) calc(var(--row, 0) * 120ms + 80ms);
  }
  /* La barra, debajo, de lado a lado. */
  .stats__bar {
    position: absolute;
    left: 18px;
    right: calc(var(--cut) + 6px);
    bottom: 18px;
    display: flex;
    gap: 4px;
    height: 8px;
  }
  .stats__bar i {
    position: relative;
    flex: 1 1 0;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }
  .stats__bar i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-ph-gold);
    transform-origin: 0 50%;
  }
  /* Los países: un segmento por país, que se encienden en cascada de 60 ms. */
  .stats__bar--seg i::after {
    transition: transform 180ms var(--ph-ease-out) calc(var(--i, 0) * 60ms + 160ms);
  }
  /* El acompañamiento: una barra continua que se llena entera. */
  .stats__bar--full i::after {
    transition: transform 640ms var(--ph-ease-out) 300ms;
  }
  :global(html.ph-anim) .stats:not(.is-inview) .stats__bar i::after { transform: scaleX(0); }
  :global(html.ph-anim) .stats:not(.is-inview) .stats__num { opacity: 0; transform: translateY(0.4em); }
  :global(html.ph-anim:not(.ph-motion)) .stats__bar i::after,
  :global(html.ph-anim:not(.ph-motion)) .stats__num { animation: ph-motion-failsafe 0s linear 2.5s forwards; }

  .home-about__ticker { margin-top: 0; }

  @media (prefers-reduced-motion: reduce) {
    .stats__num,
    .stats__bar i::after { transition: none; }
  }
</style>

<script>
  import { mountSection, afterTransitionPaint } from '@/scripts/ph-text-animations';

  function initHomeAbout(): void {
    const section = document.querySelector<HTMLElement>('.home-about');
    if (section) mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHomeAbout));
</script>
