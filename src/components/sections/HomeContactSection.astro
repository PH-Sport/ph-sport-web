---
import { useTranslations, type Lang } from '@/i18n/utils';
import Bug from '@/components/ui/Bug.astro';
import Plate from '@/components/ui/Plate.astro';
import KeyPlate from '@/components/ui/KeyPlate.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/* «Final del partido»: «Hablemos.» a escala de rótulo, el correo como la placa
    llave grande y la imagen en una ventana de repetición con marco de placa, que
    se descubre en diagonal al entrar. */}
<section class="home-contact" id="contacto" aria-labelledby="home-contact-title">
  <Bug text={t('home.contact.eyebrow')} />
  <div class="home-contact__grid">
    <div class="home-contact__head" data-inview>
      <h2 class="home-contact__title" id="home-contact-title">
        <Plate tab>{t('home.contact.title')}</Plate>
      </h2>
      <div class="home-contact__mail">
        <Bug text={t('home.contact.emailLabel')} inview={false} d={200} />
        <div class="home-contact__key ph-in-rise" style="--d: 280ms">
          <KeyPlate href={`mailto:${t('home.contact.email')}`} label={t('home.contact.email')} size="xl" />
        </div>
      </div>
    </div>

    {/* La ventana de repetición: el marco es una placa con el corte a 45° y la
        imagen se descubre desde la esquina de abajo a la izquierda. */}
    <div class="home-contact__window" aria-hidden="true" data-inview>
      <div class="replay ph-reveal" style="--d: 120ms">
        <div class="replay__img ph-reveal__img"></div>
      </div>
      <span class="replay__tab"></span>
    </div>
  </div>
</section>

<style>
  .home-contact {
    position: relative;
    padding: clamp(64px, 7vw, 104px) var(--ph-section-px) clamp(72px, 8vw, 120px);
    background: var(--color-ph-black);
  }

  .home-contact__grid {
    display: grid;
    gap: clamp(44px, 6vw, 72px);
    margin-top: clamp(30px, 4vw, 52px);
  }

  /* «Parliamone.» (la palabra más larga de los tres idiomas) cabe en una placa a
     360 px. */
  .home-contact__title {
    margin: 0;
    font-size: clamp(50px, 14.2vw, 144px);
  }

  .home-contact__mail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: clamp(32px, 4.5vw, 56px);
  }
  .home-contact__key { max-width: 100%; }

  .home-contact__window { position: relative; }
  /* El marco de la ventana: filo blanco al 12 % con el corte en la esquina. */
  .replay {
    --arh: 62.5%;
    --c: clamp(28px, 4vw, 52px);
    aspect-ratio: 16 / 10;
  }
  .replay::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: var(--ph-plate-edge);
    clip-path: polygon(evenodd,
      0 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%, 0 0,
      1px 1px, 1px calc(100% - 1px), calc(100% - var(--c) - 0.41px) calc(100% - 1px), calc(100% - 1px) calc(100% - var(--c) - 0.41px), calc(100% - 1px) 1px, 1px 1px);
  }
  .replay__img {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.18)),
      url('/contact-image.webp') center / cover no-repeat,
      #15171b;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, 0 100%);
  }
  .replay__tab {
    position: absolute;
    left: 0;
    bottom: 100%;
    width: var(--ph-tab-w);
    height: var(--ph-tab-h);
    background: var(--color-ph-gold);
    transform-origin: 0 50%;
    transition: transform var(--ph-dur-tab) var(--ph-ease-out) 80ms;
  }
  :global(html.ph-anim) .home-contact__window:not(.is-inview) .replay__tab { transform: scaleX(0); }
  :global(html.ph-anim:not(.ph-motion)) .replay__tab { animation: ph-motion-failsafe 0s linear 2.5s forwards; }

  @media (min-width: 1024px) {
    .home-contact__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
    .home-contact__title { font-size: clamp(64px, 7.6vw, 132px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .replay__tab { transition: none; }
  }
</style>

<script>
  import { mountSection, afterTransitionPaint } from '@/scripts/ph-text-animations';

  function initHomeContact(): void {
    const section = document.querySelector<HTMLElement>('.home-contact');
    if (section) mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHomeContact));
</script>
