---
import { useTranslations, type Lang } from '@/i18n/utils';
import Button from '@/components/ui/Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const email = t('home.contact.email');

/** Foto de la sección. **Sin foto a propósito** (2026-10-02): la que había era una
 *  ilustración generada por IA y se quitó hasta tener una real (`DECISIONS.md`).
 *  Mientras tanto se ve su hueco: un recuadro oscuro del mismo tamaño, para que la
 *  maqueta no cambie al llegar la foto (lo pidió Mario). Para ponerla: dejar en
 *  `public/` una imagen cuadrada de unos 1200 px con un nombre NUEVO —no
 *  `contact-image.webp`: `public/` se sirve con 7 días de caché y quien ya visitó
 *  la web seguiría viendo la vieja— y escribir aquí su ruta, p. ej.
 *  `'/contacto/2026-11.webp'`. */
const contactImage: string | null = null;
---

<section class="home-contact" id="contacto" aria-labelledby="home-contact-title">
  <div class="home-contact__grid">
    <div class="home-contact__main">
      <h2 class="home-contact__title" id="home-contact-title">{t('home.contact.title')}</h2>
      <div class="home-contact__mail">
        <span class="home-contact__label">{t('home.contact.emailLabel')}</span>
        <div class="home-contact__actions">
          {/* Escribir es un enlace (abre el correo); copiar es una acción en la
              página: el icono se convierte en un check y vuelve. */}
          <Button href={`mailto:${email}`} variant="accent" size="lg">{email}</Button>
          <button type="button" class="ph-icon-btn home-contact__copy" data-ph-copy={email} data-status="idle" aria-label={t('a11y.copyEmail')}>
            <svg class="ph-ico home-contact__copy-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="3" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
            <svg class="ph-ico home-contact__copy-done" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
          </button>
          <span class="sr-only" aria-live="polite" data-ph-copy-live></span>
        </div>
      </div>
    </div>

    <div class:list={['home-contact__image', { 'is-empty': !contactImage }]} aria-hidden="true">
      {contactImage && <img src={contactImage} alt="" width="1200" height="1200" loading="lazy" decoding="async" />}
    </div>
  </div>
</section>

<style>
  /* Mismo sistema que el resto de secciones (global.css y ph-ui.css). */
  .home-contact {
    position: relative;
    /* Abajo menos aire: el pie trae el suyo y, sin foto, sobraba hueco antes. */
    padding: clamp(88px, 9vw, 156px) var(--ph-section-px) clamp(48px, 4vw, 88px);
    color: var(--color-ph-white);
  }

  .home-contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 40px;
    align-items: end;
  }
  .home-contact__main { grid-column: 1 / 8; display: grid; gap: clamp(28px, 2.5vw, 44px); }
  .home-contact__title {
    margin: 0;
    font: 500 clamp(72px, calc(9vw + 20px), 176px)/0.9 var(--font-display);
    letter-spacing: -0.045em;
    color: var(--color-ph-white);
  }
  .home-contact__mail { display: grid; gap: 14px; justify-items: start; }
  .home-contact__label { font-size: 14px; color: var(--ph-ink-meta); }
  .home-contact__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .home-contact__copy { width: 56px; height: 56px; border-radius: var(--ph-r-btn-lg); }

  /* El icono de copiar sale y entra el check, sin solaparse. */
  .home-contact__copy { position: relative; }
  .home-contact__copy-ico,
  .home-contact__copy-done { position: absolute; transition: opacity var(--ph-duration-fade-out) var(--ph-ease-fade-out), filter var(--ph-duration-fade-out) var(--ph-ease-fade-out); }
  .home-contact__copy-done { opacity: 0; filter: blur(4px); color: var(--color-ph-gold); stroke-width: 2; }
  .home-contact__copy-done path { stroke-dasharray: 24; stroke-dashoffset: 24; }
  .home-contact__copy[data-status='success'] .home-contact__copy-ico { opacity: 0; filter: blur(4px); }
  .home-contact__copy[data-status='success'] .home-contact__copy-done { opacity: 1; filter: blur(0); transition: opacity var(--ph-duration-fade-in) var(--ph-ease-fade-in) 60ms, filter var(--ph-duration-fade-in) var(--ph-ease-fade-in) 60ms; }
  .home-contact__copy[data-status='success'] .home-contact__copy-done path { stroke-dashoffset: 0; transition: stroke-dashoffset var(--ph-duration-draw) var(--ph-ease-draw) 120ms; }

  .home-contact__image {
    grid-column: 8 / 13;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: var(--ph-r-xl);
    background: var(--ph-surface);
  }
  /* El hueco de la foto, mientras no llegue: la superficie lisa, sin filo. */
  .home-contact__image img { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 900px) {
    .home-contact__grid { display: flex; flex-direction: column; align-items: stretch; }
    .home-contact__title { font-size: clamp(64px, 18vw, 120px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-contact__copy-ico, .home-contact__copy-done, .home-contact__copy-done path { transition: none !important; }
  }
</style>
