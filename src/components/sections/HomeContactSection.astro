---
import { useTranslations, type Lang } from '@/i18n/utils';
import Zone from '@/components/ui/Zone.astro';
import Visor from '@/components/ui/Visor.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/* El cierre de la portada: «Hablemos.» fijado por un visor y el correo como
    la acción. La línea de pase termina aquí, en el nodo del correo: el gol. La
    foto va enmarcada por escuadras y se descubre con un escaneo; en el móvil,
    debajo. Hoy el marco está vacío: la imagen del sobre se retiró y el hueco
    espera la nueva (DECISIONS.md, 2026-10-05). */}
<section class="home-contact ph-pass-host" id="contacto" aria-labelledby="home-contact-title" data-pass-section data-pass-goal>
  <svg class="ph-pass" aria-hidden="true" data-pass-seg><path /></svg>
  <div class="hc-grid">
    <header class="hc-head">
      <Zone text={t('home.contact.eyebrow')} />
      <h2 class="hc-title" id="home-contact-title" data-inview>
        <span class="hc-title__text ph-enter">{t('home.contact.title')}</span>
        <Visor mode="view" arm={22} inset={-14} />
      </h2>
      <div class="hc-email" data-inview>
        <span class="hc-email__label ph-enter">{t('home.contact.emailLabel')}</span>
        <a href={`mailto:${t('home.contact.email')}`} class="hc-email__link ph-enter">
          <span class="ph-node ph-node--lg hc-email__node" aria-hidden="true" data-pass-node></span>
          <span class="hc-email__text">{t('home.contact.email')}</span>
          <svg class="hc-email__arrow" viewBox="0 0 40 12" aria-hidden="true"><path d="M0 6H38M32.5 1.5 38 6l-5.5 4.5" /></svg>
        </a>
      </div>
    </header>

    <div class="hc-photo">
      {/* El hueco: la imagen nueva va aquí como `<img class="ph-scan__media">`. */}
      <div class="hc-photo__frame ph-scan" data-inview></div>
      <Visor mode="view" arm={24} inset={-12} />
    </div>
  </div>
</section>

<style>
  .home-contact {
    padding: 0 var(--ph-section-px) clamp(72px, 9vw, 120px);
    color: var(--color-ph-white);
  }

  .hc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(48px, 7vw, 72px);
  }

  .hc-head {
    padding-top: clamp(72px, 9vw, 120px);
  }

  .hc-title {
    position: relative;
    display: inline-block;
    margin: clamp(40px, 5vw, 64px) 0 0 -0.04em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(60px, 18vw, 136px);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .hc-title__text {
    display: block;
    padding-right: 0.04em;
  }

  .hc-email {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: clamp(40px, 6vw, 64px);
  }

  .hc-email__label {
    font-size: 15px;
    color: var(--ph-ink-meta);
  }

  /* El correo es la acción de la página: grande, con su nodo (donde acaba la
     línea de pase) y una flecha que se dibuja al señalarlo. */
  .hc-email__link {
    --enter-delay: 80ms;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    width: fit-content;
    min-height: 48px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(24px, 6.4vw, 42px);
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-ph-white);
    text-decoration: none;
    transition: color var(--ph-dur-state) var(--ph-ease-std);
    -webkit-tap-highlight-color: transparent;
  }

  .hc-email__text {
    text-decoration: underline;
    text-decoration-color: rgba(214, 178, 94, 0.5);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .hc-email__arrow {
    display: block;
    width: 40px;
    height: 12px;
    flex: none;
    overflow: visible;
    color: var(--color-ph-gold);
  }

  .hc-email__arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
    stroke-dasharray: 60 60;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--ph-dur-leader) var(--ph-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hc-email__arrow path {
      stroke-dashoffset: 60;
      transition-duration: 150ms;
      transition-timing-function: var(--ph-ease-in);
    }
    .hc-email__link:hover,
    .hc-email__link:focus-visible { color: var(--color-ph-gold); }
    .hc-email__link:hover .hc-email__arrow path,
    .hc-email__link:focus-visible .hc-email__arrow path {
      stroke-dashoffset: 0;
      transition-duration: var(--ph-dur-leader);
      transition-timing-function: var(--ph-ease-out);
    }
    .hc-email__link:hover .hc-email__node::before { animation: ph-ping 320ms var(--ph-ease-out) both; }
  }

  .hc-email__link:active { color: var(--color-ph-gold); }

  /* ── La foto, enmarcada ── */
  .hc-photo {
    position: relative;
    align-self: center;
  }

  /* Con el tono de espera de las fotos: hoy es el hueco a la vista. */
  .hc-photo__frame {
    aspect-ratio: 16 / 10;
    background: #15171b;
  }

  /* Para la imagen nueva, cuando llegue. */
  .hc-photo__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.82);
  }

  @media (min-width: 901px) {
    .hc-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      column-gap: clamp(48px, 6vw, 96px);
    }
    .hc-photo {
      margin-bottom: clamp(6px, 1vw, 12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hc-email__link,
    .hc-email__arrow path { transition: none; }
    .hc-email__arrow path { stroke-dashoffset: 0 !important; }
    .hc-email__link:hover .hc-email__node::before { animation: none; }
  }
</style>

<script>
  import { mountSection, afterTransitionPaint } from '@/scripts/ph-text-animations';

  function initHomeContact(): void {
    const section = document.querySelector<HTMLElement>('.home-contact');
    if (section) mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHomeContact));
</script>
