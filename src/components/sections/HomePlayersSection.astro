---
import { useTranslations, localizePath, type Lang } from '@/i18n/utils';
import Bug from '@/components/ui/Bug.astro';
import Plate from '@/components/ui/Plate.astro';
import KeyPlate from '@/components/ui/KeyPlate.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const listHref = localizePath('/talentos/', lang);
---

{/* «A continuación»: el paso hacia /talentos, como el rótulo que anuncia el
    siguiente programa. «El roster.» a escala de rótulo en su placa, la
    entradilla y la placa llave. Sin fotos a propósito: el grid destacado de la
    portada se quitó en abril para llevar a la lista completa (commit 453e928). */}
<section class="home-players" id="talentos" aria-labelledby="home-players-title">
  <Bug text={t('home.players.eyebrow')} />
  <div class="home-players__row" data-inview>
    <h2 class="home-players__title" id="home-players-title">
      <Plate tab>{t('talents.title')}<em>{t('home.players.titleAccent')}</em>.</Plate>
    </h2>
    <div class="home-players__side">
      <p class="home-players__lead ph-in-rise" style="--d: 300ms">{t('home.players.lead')}</p>
      <div class="home-players__cta ph-in-rise" style="--d: 380ms">
        <KeyPlate href={listHref} label={t('home.players.cta')} size="wide" />
      </div>
    </div>
  </div>
</section>

<style>
  .home-players {
    position: relative;
    padding: clamp(72px, 9vw, 120px) var(--ph-section-px) clamp(64px, 7vw, 104px);
    /* Transparente: el fondo es la luz animada de toda la página (`.ph-page-bg`). */
    background: transparent;
  }

  .home-players__row {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
    margin-top: clamp(30px, 4vw, 52px);
  }

  /* El titular a escala de rótulo: «The roster.» (la palabra más larga de los tres
     idiomas) tiene que caber en una placa a 360 px. */
  .home-players__title {
    margin: 0;
    font-size: clamp(54px, 15.5vw, 144px);
  }

  .home-players__side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .home-players__lead {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: var(--ph-head-lead-size);
    line-height: 1.45;
    color: var(--ph-ink-lead);
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .home-players__row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: clamp(32px, 5vw, 72px);
    }
    .home-players__title { font-size: clamp(96px, 10vw, 144px); }
    .home-players__side {
      flex: 0 0 auto;
      width: min(380px, 34vw);
      padding-bottom: 4px;
    }
  }
</style>

<script>
  import { mountSection, afterTransitionPaint } from '@/scripts/ph-text-animations';

  function initHomePlayers(): void {
    const section = document.querySelector<HTMLElement>('.home-players');
    if (section) mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHomePlayers));
</script>
