---
import { useTranslations, localizePath, type Lang } from '@/i18n/utils';
import Slate from '@/components/ui/Slate.astro';
import Key from '@/components/ui/Key.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const listHref = localizePath('/talentos/', lang);
---

{/* Bloque de paso hacia /talentos: la pizarra abre el segmento y el titular
    ocupa la pantalla del móvil. Sin fotos a propósito: el grid destacado de la
    portada se quitó en abril para llevar a la lista completa (commit 453e928). */}
<section class="home-players" id="talentos" aria-labelledby="home-players-title">
  <Slate text={t('home.players.eyebrow')} />
  <div class="home-players__row">
    <header class="home-players__head">
      <h2 class="home-players__title" id="home-players-title" data-m="title" data-reveal>
        {t('talents.title')}<em>{t('home.players.titleAccent')}</em>.
      </h2>
      <p class="home-players__lead" data-m="lead" data-reveal>{t('home.players.lead')}</p>
    </header>

    <div class="home-players__cta-wrap" data-m="item" data-reveal>
      <Key href={listHref} label={t('home.players.cta')} tone="gold" />
    </div>
  </div>
</section>

<style>
  .home-players {
    padding: clamp(64px, 9vw, 128px) var(--ph-section-px, clamp(20px, 4vw, 48px)) clamp(72px, 10vw, 136px);
    background: var(--color-ph-black, #0d0f12);
    color: var(--color-ph-white, #ffffff);
  }

  .home-players__row {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 48px);
    align-items: flex-start;
    margin-top: clamp(28px, 4vw, 48px);
  }

  .home-players__head { max-width: 980px; }

  /* El titular a escala de rótulo: «El roster.» llena el ancho del móvil. */
  .home-players__title {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-weight: 500;
    font-size: clamp(72px, 24vw, 144px);
    letter-spacing: -0.045em;
    line-height: 0.86;
    margin: 0 0 0 -0.04em;
  }
  .home-players__title em {
    color: var(--color-ph-gold, #d6b25e);
    font-style: italic;
    font-weight: 400;
  }

  .home-players__lead {
    margin: clamp(20px, 2.5vw, 28px) 0 0;
    color: var(--ph-ink-lead);
    font-family: var(--font-display);
    font-size: var(--ph-head-lead-size);
    line-height: 1.45;
    max-width: 30ch;
    text-wrap: balance;
  }

  .home-players__cta-wrap {
    display: flex;
  }

  @media (min-width: 900px) {
    .home-players__row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: clamp(32px, 5vw, 72px);
    }
    .home-players__title {
      font-size: clamp(96px, 10vw, 144px);
    }
    .home-players__cta-wrap {
      flex-shrink: 0;
      padding-bottom: 8px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, stage, mountSection, afterTransitionPaint,
  } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(ScrollTrigger);

  function initHomePlayersAnimations(): void {
    const section = document.querySelector<HTMLElement>('.home-players');
    if (!section) return;
    if (!reducedMotion()) stage(section, { glint: true });
    mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHomePlayersAnimations));
</script>
