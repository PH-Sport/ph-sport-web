---
import { useTranslations, localizePath, type Lang } from '@/i18n/utils';
import SceneLabel from '@/components/ui/SceneLabel.astro';
import TitleLink from '@/components/ui/TitleLink.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const areas = [
  { key: 'management', title: t('home.services.area.management.title'), body: t('home.services.area.management.body') },
  { key: 'career', title: t('home.services.area.career.title'), body: t('home.services.area.career.body') },
  { key: 'international', title: t('home.services.area.international.title'), body: t('home.services.area.international.body') },
  { key: 'comms', title: t('home.services.area.comms.title'), body: t('home.services.area.comms.body') },
  { key: 'legal', title: t('home.services.area.legal.title'), body: t('home.services.area.legal.body') },
];

const actionPlanSub = [
  {
    title: t('home.services.actionPlan.press.title'),
    bullets: [t('home.services.actionPlan.press.b1'), t('home.services.actionPlan.press.b2'), t('home.services.actionPlan.press.b3')],
  },
  {
    title: t('home.services.actionPlan.media.title'),
    bullets: [t('home.services.actionPlan.media.b1'), t('home.services.actionPlan.media.b2'), t('home.services.actionPlan.media.b3')],
  },
  {
    title: t('home.services.actionPlan.psych.title'),
    bullets: [t('home.services.actionPlan.psych.b1'), t('home.services.actionPlan.psych.b2'), t('home.services.actionPlan.psych.b3')],
  },
  {
    title: t('home.services.actionPlan.performance.title'),
    bullets: [t('home.services.actionPlan.performance.b1'), t('home.services.actionPlan.performance.b2'), t('home.services.actionPlan.performance.b3')],
  },
  {
    title: t('home.services.actionPlan.familyOffice.title'),
    bullets: [t('home.services.actionPlan.familyOffice.b1'), t('home.services.actionPlan.familyOffice.b2'), t('home.services.actionPlan.familyOffice.b3')],
  },
];

const servicesHref = localizePath('/servicios/', lang);
---

{/* Tercera escena de la portada: «Representamos con propósito.» se enciende
    palabra a palabra mientras se lee (lectura cinética) y las cinco áreas son un
    índice tipográfico: índice pequeño en la columna 1, título grande, «+» que
    gira a «−». El Plan de Acción, con «Además de» como rótulo, abre sus cinco
    sub-áreas en columnas que entran desde la izquierda. */}
<section class="hs" id="servicios" aria-labelledby="home-services-title">
  <SceneLabel text={t('home.services.eyebrow')} />
  <div class="hs__head ph-grid">
    <h2 class="hs__title ph-giant" id="home-services-title" data-kinetic>{t('home.services.title')}</h2>
    <p class="hs__lead ph-lead" data-reveal>{t('home.services.lead')}</p>
  </div>

  <ol class="hs-index" role="list" data-accordion>
    {areas.map((item, idx) => (
      <li class="hs-row ph-rule" data-acc-row data-inview>
        <h3 class="hs-row__h">
          <button
            type="button"
            class="hs-row__btn"
            id={`hs-btn-${item.key}`}
            aria-expanded="false"
            aria-controls={`hs-panel-${item.key}`}
            data-acc-toggle
          >
            <span class="hs-row__idx ph-index">{String(idx + 1).padStart(2, '0')}</span>
            <span class="hs-row__title">{item.title}</span>
            <span class="hs-row__sign" aria-hidden="true"><span></span><span></span></span>
          </button>
        </h3>
        <div class="hs-row__panel" id={`hs-panel-${item.key}`} role="region" aria-labelledby={`hs-btn-${item.key}`} hidden data-acc-panel>
          <div class="hs-row__body">
            <p class="ph-body">{item.body}</p>
          </div>
        </div>
      </li>
    ))}

    <li class="hs-row hs-row--plan ph-rule" data-acc-row data-inview>
      <h3 class="hs-row__h">
        <button
          type="button"
          class="hs-row__btn"
          id="hs-btn-plan"
          aria-expanded="false"
          aria-controls="hs-panel-plan"
          data-acc-toggle
        >
          <span class="hs-row__idx" aria-hidden="true"></span>
          <span class="hs-row__stack">
            <span class="hs-row__over">{t('home.services.actionPlan.eyebrow')}</span>
            <span class="hs-row__title">{t('home.services.actionPlan.title')}</span>
          </span>
          <span class="hs-row__sign" aria-hidden="true"><span></span><span></span></span>
        </button>
      </h3>
      <div class="hs-row__panel" id="hs-panel-plan" role="region" aria-labelledby="hs-btn-plan" hidden data-acc-panel>
        <div class="hs-row__body hs-row__body--plan">
          <ul class="hs-plan" role="list">
            {actionPlanSub.map((card) => (
              <li class="hs-plan__col" data-acc-col>
                <h4 class="hs-plan__title">{card.title}</h4>
                <ul class="hs-plan__list" role="list">
                  {card.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </li>
  </ol>

  <div class="hs__cta">
    <TitleLink href={servicesHref} label={t('home.services.cta')} />
  </div>

  {/* Sin JavaScript nadie abriría los paneles: se ven todos abiertos. El
      preflight de Tailwind oculta `[hidden]` con `!important` dentro de
      `@layer base`, y un `!important` de capa gana a uno sin capa: la regla va en
      la misma capa, donde decide la especificidad. */}
  <noscript><style>@layer base { .hs-row__panel[hidden] { display: block !important; } }</style></noscript>
</section>

<style>
  .hs {
    position: relative;
    z-index: 2;
    background: var(--color-ph-black);
    padding: clamp(72px, 10vw, 144px) var(--ph-section-px) clamp(96px, 12vw, 168px);
  }

  .hs__head {
    row-gap: clamp(20px, 2.4vw, 32px);
    margin-top: clamp(32px, 5vw, 64px);
  }

  .hs__title {
    grid-column: 1 / -1;
    font-size: clamp(32px, 9vw, 140px);
    line-height: 0.92;
    text-wrap: balance;
  }

  .hs__lead {
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .hs__title {
      grid-column: 1 / 12;
      font-size: 5.5vw;
    }

    .hs__lead {
      grid-column: 2 / 7;
    }
  }

  /* ── El índice tipográfico ── */
  .hs-index {
    margin: clamp(48px, 7vw, 96px) 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--ph-hair);
  }

  .hs-row {
    --ph-rule-color: var(--ph-hair-strong);
  }

  .hs-row__h {
    margin: 0;
    font: inherit;
    letter-spacing: normal;
  }

  /* La primera columna (el índice) mide lo que una columna de la retícula, para
     que los títulos caigan en la columna 2. */
  .hs-row__btn {
    --col1: 2.75rem;
    display: grid;
    grid-template-columns: var(--col1) minmax(0, 1fr) 1.5rem;
    align-items: baseline;
    column-gap: 0;
    width: 100%;
    padding: clamp(18px, 2.2vw, 30px) 0;
    border: 0;
    background: transparent;
    color: var(--color-ph-white);
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  @media (min-width: 1024px) {
    .hs-row__btn {
      --col1: calc((100% - 11 * var(--ph-gutter)) / 12 + var(--ph-gutter));
    }
  }

  .hs-row__idx {
    align-self: baseline;
  }

  .hs-row__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 7.2vw, 40px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
    transition: opacity var(--ph-dur-state) var(--ph-ease-std), transform var(--ph-dur-state) var(--ph-ease-out);
  }

  @media (min-width: 1024px) {
    .hs-row__title {
      font-size: clamp(48px, 4.2vw, 64px);
    }
  }

  .hs-row__stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .hs-row__over {
    font-family: var(--font-body);
    font-size: var(--ph-small);
    letter-spacing: 0.02em;
    color: var(--ph-ink-meta);
  }

  /* «+» que gira a «−»: dos hilos; el vertical gira hasta tumbarse. */
  .hs-row__sign {
    position: relative;
    align-self: center;
    justify-self: end;
    width: 1.25rem;
    height: 1.25rem;
  }

  .hs-row__sign span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: transform var(--ph-dur-move) var(--ph-ease-out), background-color var(--ph-dur-state) var(--ph-ease-std);
  }

  .hs-row__sign span:last-child {
    transform: rotate(90deg);
  }

  .hs-row.is-open .hs-row__sign span {
    background: var(--color-ph-gold);
  }

  .hs-row.is-open .hs-row__sign span:last-child {
    transform: rotate(0deg);
  }

  /* Foco de escena: con una fila abierta, las demás bajan de tono. */
  .hs-index:has(.is-open) .hs-row:not(.is-open) .hs-row__title {
    opacity: 0.45;
  }

  @media (hover: hover) and (pointer: fine) {
    .hs-row__btn:hover .hs-row__title {
      opacity: 1;
      transform: translateX(6px);
    }
  }

  .hs-row__btn:focus-visible {
    outline-offset: 4px;
  }

  .hs-row__btn:active .hs-row__title {
    color: var(--color-ph-gold);
  }

  /* El texto del área, debajo del título y en su columna (la misma medida que
     la primera columna del botón). */
  .hs-row__body {
    padding: 0 0 clamp(24px, 3vw, 40px) 2.75rem;
  }

  .hs-row__body .ph-body {
    max-width: 52ch;
  }

  @media (min-width: 1024px) {
    .hs-row__body {
      padding-left: calc((100% - 11 * var(--ph-gutter)) / 12 + var(--ph-gutter));
    }
  }

  /* Plan de Acción: sus cinco sub-áreas en columnas tipográficas. */
  .hs-row__body--plan {
    padding-left: 0;
  }

  .hs-plan {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px var(--ph-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 600px) {
    .hs-plan { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 900px) {
    .hs-plan { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1200px) {
    .hs-plan { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  .hs-plan__col {
    padding-top: 14px;
    border-top: 1px solid var(--ph-hair-strong);
  }

  .hs-plan__title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-ph-white);
  }

  .hs-plan__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hs-plan__list li {
    font-size: 15px;
    line-height: 1.45;
    color: var(--ph-ink-body);
  }

  .hs__cta {
    margin-top: clamp(40px, 5vw, 64px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hs-row__title,
    .hs-row__sign span {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, kinetic, fadeUp, mountSection, afterTransitionPaint,
  } from '@/scripts/ph-text-animations';
  import { initAccordion } from '@/scripts/ph-accordion';
  import { cascade } from '@/scripts/ph-motion';

  gsap.registerPlugin(ScrollTrigger);

  function initHomeServices(): void {
    const section = document.querySelector<HTMLElement>('.hs');
    if (!section) return;
    const index = section.querySelector<HTMLElement>('[data-accordion]');
    if (index) initAccordion(index);
    if (!reducedMotion()) {
      const title = section.querySelector<HTMLElement>('[data-kinetic]');
      if (title) kinetic(title);
      fadeUp(section.querySelectorAll<HTMLElement>('.hs__lead'));
      // Los hilos del índice se dibujan en cascada.
      cascade(section.querySelectorAll<HTMLElement>('.hs-row'), 70);
      section.querySelectorAll<HTMLElement>('.hs-row').forEach((row) => {
        row.style.setProperty('--ph-rule-delay', row.style.getPropertyValue('--d'));
      });
    }
    mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initHomeServices));
</script>
