---
import { useTranslations, localizePath, type Lang } from '@/i18n/utils';
import Bug from '@/components/ui/Bug.astro';
import Plate from '@/components/ui/Plate.astro';
import KeyPlate from '@/components/ui/KeyPlate.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const areas = [
  { title: t('home.services.area.management.title'), body: t('home.services.area.management.body') },
  { title: t('home.services.area.career.title'), body: t('home.services.area.career.body') },
  { title: t('home.services.area.international.title'), body: t('home.services.area.international.body') },
  { title: t('home.services.area.comms.title'), body: t('home.services.area.comms.body') },
  { title: t('home.services.area.legal.title'), body: t('home.services.area.legal.body') },
];

const actionPlanSub = [
  {
    title: t('home.services.actionPlan.press.title'),
    bullets: [t('home.services.actionPlan.press.b1'), t('home.services.actionPlan.press.b2'), t('home.services.actionPlan.press.b3')],
  },
  {
    title: t('home.services.actionPlan.media.title'),
    bullets: [t('home.services.actionPlan.media.b1'), t('home.services.actionPlan.media.b2'), t('home.services.actionPlan.media.b3')],
  },
  {
    title: t('home.services.actionPlan.psych.title'),
    bullets: [t('home.services.actionPlan.psych.b1'), t('home.services.actionPlan.psych.b2'), t('home.services.actionPlan.psych.b3')],
  },
  {
    title: t('home.services.actionPlan.performance.title'),
    bullets: [t('home.services.actionPlan.performance.b1'), t('home.services.actionPlan.performance.b2'), t('home.services.actionPlan.performance.b3')],
  },
  {
    title: t('home.services.actionPlan.familyOffice.title'),
    bullets: [t('home.services.actionPlan.familyOffice.b1'), t('home.services.actionPlan.familyOffice.b2'), t('home.services.actionPlan.familyOffice.b3')],
  },
];

const servicesHref = localizePath('/servicios/', lang);
---

{/* «La alineación»: las cinco áreas como las filas de una alineación en
    pantalla, con su número, y el Plan de Acción como la fila distinta, con filo
    dorado. Acordeón con `<details name>`: sin JS ya deja una sola abierta; con JS
    se anima sin animar alturas (src/scripts/ph-disclosure.ts). */}
<section class="home-services" id="servicios" aria-labelledby="home-services-title">
  <Bug text={t('home.services.eyebrow')} />
  <header class="home-services__head" data-inview>
    <h2 class="home-services__title ph-in-wipe" id="home-services-title">{t('home.services.title')}</h2>
    <p class="home-services__lead ph-in-rise" style="--d: 140ms">{t('home.services.lead')}</p>
  </header>

  <ol class="lineup" role="list">
    {areas.map((item, idx) => (
      <li class="lineup__item" data-inview data-cascade="60">
        <details class="lineup__row" name="home-services">
          <summary class="lineup__summary">
            <span class="lineup__tab" aria-hidden="true"></span>
            <span class="lineup__num">{String(idx + 1).padStart(2, '0')}</span>
            <span class="lineup__name">{item.title}</span>
            <span class="lineup__plus" aria-hidden="true"><span></span><span></span></span>
          </summary>
          <div class="lineup__body">
            <p class="lineup__text">{item.body}</p>
          </div>
        </details>
      </li>
    ))}

  </ol>

  {/* El Plan de Acción va aparte: no es la sexta área sino lo que se suma a las
      cinco. En escritorio ocupa todo el ancho, para que sus cinco sub-áreas
      quepan en cinco columnas. */}
  <div class="lineup__item lineup__item--plan" data-inview>
    <Bug text={t('home.services.actionPlan.eyebrow')} inview={false} class="lineup__plan-bug" />
    <details class="lineup__row lineup__row--plan" name="home-services">
      <summary class="lineup__summary">
        <span class="lineup__tab" aria-hidden="true"></span>
        <span class="lineup__num lineup__num--plan" aria-hidden="true"><span></span></span>
        <span class="lineup__name">{t('home.services.actionPlan.title')}</span>
        <span class="lineup__plus" aria-hidden="true"><span></span><span></span></span>
      </summary>
      <div class="lineup__body lineup__body--plan">
        <ul class="plan-grid" role="list" data-plan-grid>
          {actionPlanSub.map((card, i) => (
            <li class="plan-card" style={`--d: ${i * 60}ms`}>
              <Plate as="div" variant="label" class="plan-card__title">{card.title}</Plate>
              <ul class="plan-card__bullets" role="list">
                {card.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </details>
  </div>

  <div class="home-services__cta ph-in-rise" data-inview>
    <KeyPlate href={servicesHref} label={t('home.services.cta')} />
  </div>
</section>

<style>
  .home-services {
    position: relative;
    padding: clamp(64px, 7vw, 104px) var(--ph-section-px);
    background: var(--color-ph-black);
  }
  /* En pantallas anchas, la alineación al lado de su titular, como el grafismo
     de una alineación junto al rótulo del partido. */
  @media (min-width: 1100px) {
    .home-services {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto auto 1fr;
      column-gap: clamp(40px, 5vw, 88px);
      align-items: start;
    }
    .home-services > :global(.ph-bug) { grid-column: 1; grid-row: 1; justify-self: start; }
    .home-services__head { grid-column: 1; grid-row: 2; margin-bottom: 0; }
    .home-services .home-services__title { font-size: clamp(48px, 4.6vw, 72px); }
    .lineup { grid-column: 2; grid-row: 1 / 4; }
    .lineup__item--plan { grid-column: 1 / -1; grid-row: 4; margin-top: clamp(40px, 4vw, 56px); }
    /* La placa llave cierra el bloque, detrás del plan. */
    .home-services__cta { grid-column: 1; grid-row: 5; }
  }

  .home-services__head {
    max-width: 880px;
    margin: clamp(28px, 4vw, 48px) 0 clamp(32px, 4.5vw, 52px);
  }

  .home-services__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 9.4vw, 76px);
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .home-services__lead {
    margin: clamp(18px, 2vw, 24px) 0 0;
    max-width: 40ch;
    font-family: var(--font-display);
    font-size: var(--ph-head-lead-size);
    line-height: 1.45;
    color: var(--ph-ink-lead);
    text-wrap: pretty;
  }

  /* ── La alineación ─────────────────────────────────────────────────────
     Cada área, una fila en placa: la celda con el número, el nombre y el «+».
     Abierta, gana la pestaña dorada y debajo se despliega su texto. */
  .lineup {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lineup__item {
    transition: clip-path var(--ph-dur-wipe) var(--ph-ease-out) var(--cd, 0ms);
    clip-path: inset(-8px -8px -8px -8px);
  }
  :global(html.ph-anim) .lineup__item:not(.is-inview) { clip-path: inset(-8px 100% -8px -8px); }
  :global(html.ph-anim:not(.ph-motion)) .lineup__item { animation: ph-failsafe-unclip 0s linear 2.5s forwards; }

  .lineup__row > summary { list-style: none; }
  .lineup__row > summary::-webkit-details-marker { display: none; }

  .lineup__summary {
    --cut: 60px;
    --edge: var(--ph-plate-edge);
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(12px, 2vw, 22px);
    min-height: 60px;
    padding: 10px calc(var(--cut) * 0.75) 10px 10px;
    color: var(--color-ph-white);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .lineup__summary::before,
  .lineup__summary::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .lineup__summary::before {
    inset: 0;
    background: var(--edge);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%);
    transition: background-color var(--ph-dur-state) var(--ph-ease-std);
  }
  .lineup__summary::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut) + 0.59px), calc(100% - var(--cut) + 0.59px) 100%, 0 100%);
    transition: background-color var(--ph-dur-state) var(--ph-ease-std);
  }
  .lineup__summary:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: 3px; }

  /* La pestaña dorada: la fila abierta está «en directo». */
  .lineup__tab {
    position: absolute;
    left: 0;
    bottom: 100%;
    width: var(--ph-tab-w);
    height: var(--ph-tab-h);
    background: var(--color-ph-gold);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 150ms var(--ph-ease-in);
  }

  .lineup__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-ph-gold);
    box-shadow: inset 0 0 0 1px rgba(214, 178, 94, 0.75);
  }
  /* El Plan de Acción no es la sexta área: en su celda, un rombo dorado. */
  .lineup__num--plan span {
    width: 10px;
    height: 10px;
    box-shadow: inset 0 0 0 1px var(--color-ph-gold);
    transform: rotate(45deg);
  }

  .lineup__name {
    font-family: var(--font-display);
    font-size: clamp(17px, calc(0.9vw + 14px), 26px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    transition: transform var(--ph-dur-state) var(--ph-ease-out), color var(--ph-dur-state) var(--ph-ease-std);
  }

  .lineup__plus {
    position: relative;
    width: 18px;
    height: 18px;
    color: rgba(255, 255, 255, 0.7);
  }
  .lineup__plus span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 18px;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
    transition: transform var(--ph-dur-state) var(--ph-ease-out);
  }
  .lineup__plus span:last-child { transform: rotate(90deg); }

  @media (hover: hover) and (pointer: fine) {
    .lineup__summary:hover::after { background: #15171b; }
    .lineup__summary:hover .lineup__name { transform: translateX(4px); }
  }
  .lineup__summary:active::after { background: #1a1d22; }

  /* Abierta: con JS, `data-state` manda desde el clic (el `open` de layout llega
     al final del cierre); sin JS, el `open` nativo. */
  .lineup__row:is([open]:not([data-state='closed']), [data-state='open']) .lineup__tab {
    transform: scaleX(1);
    transition: transform var(--ph-dur-tab) var(--ph-ease-out);
  }
  .lineup__row:is([open]:not([data-state='closed']), [data-state='open']) .lineup__name { color: var(--color-ph-gold); }
  .lineup__row:is([open]:not([data-state='closed']), [data-state='open']) .lineup__plus { color: var(--color-ph-gold); }
  .lineup__row:is([open]:not([data-state='closed']), [data-state='open']) .lineup__plus span:last-child { transform: rotate(0deg); }

  /* Lo que se despliega: el texto, alineado con el nombre. */
  .lineup__body {
    padding: 14px clamp(12px, 3vw, 40px) 22px calc(10px + 40px + clamp(12px, 2vw, 22px));
  }
  .lineup__text {
    margin: 0;
    max-width: 56ch;
    font-size: clamp(16px, calc(0.19vw + 15.3px), 18px);
    line-height: 1.6;
    color: var(--ph-ink-body);
  }

  /* ── El Plan de Acción: la fila distinta ────────────────────────────── */
  .lineup__item--plan { margin-top: 26px; }
  .lineup__plan-bug { margin-bottom: 10px; }
  .lineup__row--plan > .lineup__summary { --edge: rgba(214, 178, 94, 0.8); }

  .lineup__body--plan { padding: 14px 0 6px; }

  /* Sus cinco sub-áreas, como placas pequeñas: 1, 2 y 5 columnas. Al abrir
     entran en cascada (el script les da `is-inview`). */
  .plan-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1200px) {
    .plan-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
  .plan-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 0 4px;
    min-width: 0;
  }
  .plan-card__title { max-width: 100%; }
  .plan-card__bullets {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin: 0;
    padding: 0 0 0 2px;
    list-style: none;
    transition: opacity 320ms var(--ph-ease-out) calc(var(--d, 0ms) + 160ms);
  }
  .plan-card__bullets li {
    position: relative;
    padding-left: 16px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ph-ink-body);
  }
  .plan-card__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    background: var(--color-ph-gold);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  :global(html.ph-anim) [data-plan-grid][data-inview]:not(.is-inview) .plan-card__bullets { opacity: 0; }
  /* Las sub-áreas solo esperan si este script las gobierna (`data-inview` lo pone
     él). Si no llega, se ven al abrir el plan: la red de seguridad de CSS no
     corre dentro de un `<details>` cerrado, que no se pinta. */
  :global(html.ph-anim) .lineup__body [data-plan-grid]:not([data-inview]) :global(.ph-plate::before) {
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%);
  }
  :global(html.ph-anim) .lineup__body [data-plan-grid]:not([data-inview]) :global(.ph-plate__t) {
    clip-path: polygon(1px 1px, calc(100% - 1px) 1px, calc(100% - 1px) calc(100% - var(--cut) - 0.41px), calc(100% - var(--cut) - 0.41px) calc(100% - 1px), 1px calc(100% - 1px));
  }
  :global(html.ph-anim) .lineup__body [data-plan-grid]:not([data-inview]) :global(.ph-plate__in) { transform: none; }

  .home-services__cta { margin-top: clamp(36px, 5vw, 56px); }

  @media (prefers-reduced-motion: reduce) {
    .lineup__item,
    .lineup__tab,
    .lineup__name,
    .lineup__plus span,
    .lineup__summary::before,
    .lineup__summary::after,
    .plan-card__bullets { transition: none; }
  }
</style>

<script>
  import { mountSection, afterTransitionPaint } from '@/scripts/ph-text-animations';
  import { animateDisclosures, type DisclosureChange } from '@/scripts/ph-disclosure';

  function initHomeServices(): void {
    const section = document.querySelector<HTMLElement>('.home-services');
    if (section) mountSection(section);
  }

  /** ¿Está abierta? Con JS manda `data-state`, que cambia con el clic. */
  function isOpen(d: HTMLDetailsElement): boolean {
    return d.dataset.state ? d.dataset.state === 'open' : d.open;
  }

  function initLineup(): void {
    const rows = Array.from(document.querySelectorAll<HTMLDetailsElement>('.home-services .lineup__row'));
    if (!rows.length || rows[0].dataset.lineupOn) return;
    rows.forEach((d) => {
      d.dataset.lineupOn = '1';
      // El `name` deja una sola abierta sin JS. Con JS la exclusividad la lleva
      // este script: si no, abrir una cerraría la otra de golpe, sin animarla.
      if (d.getAttribute('name')) d.removeAttribute('name');
      d.dataset.state = d.open ? 'open' : 'closed';
    });

    // Las sub-áreas del plan entran en cascada cada vez que se abre.
    const planGrid = document.querySelector<HTMLElement>('.home-services [data-plan-grid]');
    // Lo destapa este script al abrir, no el observador de pantalla.
    planGrid?.setAttribute('data-inview', '');
    planGrid?.setAttribute('data-inview-manual', '');

    const change = (d: HTMLDetailsElement, open: boolean): DisclosureChange | null => {
      const panel = d.querySelector<HTMLElement>('.lineup__body');
      if (!panel) return null;
      d.dataset.state = open ? 'open' : 'closed';
      return {
        panel,
        open,
        setOpen: (v) => {
          d.open = v;
        },
        // Las sub-áreas del plan entran en cascada cada vez que se abre.
        onOpen: () => {
          const grid = panel.querySelector<HTMLElement>('[data-plan-grid]');
          if (!grid) return;
          grid.classList.remove('is-inview');
          void grid.offsetWidth;
          grid.classList.add('is-inview');
        },
      };
    };

    rows.forEach((d) => {
      const summary = d.querySelector('summary');
      summary?.addEventListener('click', (e) => {
        e.preventDefault();
        const opening = !isOpen(d);
        const changes: DisclosureChange[] = [];
        if (opening) {
          rows.filter((o) => o !== d && isOpen(o)).forEach((o) => {
            const c = change(o, false);
            if (c) changes.push(c);
          });
        }
        const c = change(d, opening);
        if (c) changes.push(c);
        animateDisclosures(changes);
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    afterTransitionPaint(initHomeServices);
    initLineup();
  });
</script>
