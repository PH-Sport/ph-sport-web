---
import { useTranslations, localizePath, type Lang } from '@/i18n/utils';
import { LinkButton, ArrowRightIcon } from 'mochi-ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const areas = [
  { title: t('home.services.area.management.title'), body: t('home.services.area.management.body') },
  { title: t('home.services.area.career.title'), body: t('home.services.area.career.body') },
  { title: t('home.services.area.international.title'), body: t('home.services.area.international.body') },
  { title: t('home.services.area.comms.title'), body: t('home.services.area.comms.body') },
  { title: t('home.services.area.legal.title'), body: t('home.services.area.legal.body') },
];

const actionPlanSub = (['press', 'media', 'psych', 'performance', 'familyOffice'] as const).map((key) => ({
  title: t(`home.services.actionPlan.${key}.title`),
  bullets: [
    t(`home.services.actionPlan.${key}.b1`),
    t(`home.services.actionPlan.${key}.b2`),
    t(`home.services.actionPlan.${key}.b3`),
  ],
}));

const servicesHref = localizePath('/servicios/', lang);

---

<section class="home-services" id="servicios" aria-labelledby="home-services-title">
  <div class="home-services__head">
    <div class="home-services__titles">
      <h2 class="ph-h2" id="home-services-title">{t('home.services.title')}</h2>
      <p class="ph-head-lead">{t('home.services.lead')}</p>
    </div>
    <div class="home-services__cta">
      <LinkButton href={servicesHref} variant="surface">
        {t('home.services.cta')}
        <ArrowRightIcon slot="icon" />
      </LinkButton>
    </div>
  </div>

  <div class="home-services__grid">
    {/* Cinco áreas: una abierta a la vez; el hueco se abre con «morph» y el texto
        entra 60 ms después (ph-ui.css + ph-motion.ts). */}
    <div class="ph-acc home-services__areas" data-ph-accordion>
      {areas.map((item, idx) => (
        <div class:list={['ph-acc__item', idx === 0 && 'is-open']}>
          <h3 class="home-services__area-heading">
            <button
              type="button"
              class="ph-acc__head"
              id={`hs-area-h-${idx}`}
              aria-expanded={idx === 0 ? 'true' : 'false'}
              aria-controls={`hs-area-${idx}`}
            >
              <span class="ph-acc__title">{item.title}</span>
              <span class="ph-acc__plus" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="ph-acc__body" id={`hs-area-${idx}`} role="region" aria-labelledby={`hs-area-h-${idx}`}>
            <div class="ph-acc__inner">
              <p class="ph-acc__content ph-body">{item.body}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Plan de Acción: el indicador se desplaza y el contenido llega desde el lado
        hacia el que va. */}
    <div class="home-services__plan" data-ph-tabs>
      <div class="home-services__plan-head">
        <span class="home-services__plan-eyebrow">{t('home.services.actionPlan.eyebrow')}</span>
        <h3 class="home-services__plan-title">{t('home.services.actionPlan.title')}</h3>
      </div>
      <div class="ph-seg-scroll">
        <div class="ph-seg" role="tablist" aria-label={t('home.services.actionPlan.title')}>
          <span class="ph-seg__thumb" aria-hidden="true"></span>
          {actionPlanSub.map((card, i) => (
            <button
              type="button"
              class="ph-seg__tab"
              role="tab"
              id={`hs-plan-tab-${i}`}
              aria-controls={`hs-plan-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {card.title}
            </button>
          ))}
        </div>
      </div>
      <div class="ph-swap">
        {actionPlanSub.map((card, i) => (
          <ul
            class="home-services__bullets"
            role="tabpanel"
            id={`hs-plan-${i}`}
            aria-labelledby={`hs-plan-tab-${i}`}
            data-ph-panel
            data-state={i === 0 ? 'in' : undefined}
            hidden={i !== 0}
          >
            {card.bullets.map((b) => <li>{b}</li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Mismo sistema que el resto de secciones (global.css: `.ph-head-*`;
     ph-ui.css: `.ph-h2`, `.ph-acc`, `.ph-seg`, `.ph-swap`). */
  .home-services {
    position: relative;
    padding: clamp(88px, 9vw, 156px) var(--ph-section-px) 0;
    color: var(--color-ph-white);
  }

  .home-services__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 24px;
    align-items: end;
  }
  .home-services__titles { grid-column: 1 / 9; display: grid; gap: var(--ph-head-lead-gap); }
  .home-services__titles .ph-head-lead { margin: 0; }
  .home-services__cta { grid-column: 10 / 13; justify-self: end; }

  .home-services__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 24px;
    align-items: start;
    margin-top: clamp(36px, 3vw, 56px);
  }
  .home-services__areas { grid-column: 1 / 8; }
  .home-services__area-heading { margin: 0; font: inherit; }

  .home-services__plan {
    grid-column: 8 / 13;
    display: grid;
    gap: 20px;
    padding: clamp(20px, 1.6vw, 24px);
    border-radius: var(--ph-r-lg);
    background: var(--mochi-solid);
    box-shadow: var(--mochi-shadow-surface);
  }
  .home-services__plan-head { display: grid; gap: 6px; }
  .home-services__plan-eyebrow { font-size: 14px; color: var(--ph-ink-meta); }
  .home-services__plan-title {
    margin: 0;
    font: 500 clamp(26px, calc(1vw + 20px), 34px)/1.05 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--color-ph-white);
  }
  .home-services__bullets { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .home-services__bullets li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    align-items: baseline;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ph-ink-body);
  }
  .home-services__bullets li::before { content: ''; width: 18px; height: 1.5px; background: var(--color-ph-gold); translate: 0 -4px; }

  @media (max-width: 900px) {
    .home-services__head,
    .home-services__grid { display: flex; flex-direction: column; align-items: stretch; }
    .home-services__cta { justify-self: start; }
  }
</style>
