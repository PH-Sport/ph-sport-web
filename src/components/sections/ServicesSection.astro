---
import { getServicesItems } from '@/lib/servicesItems';
import { useTranslations, type Lang } from '@/i18n/utils';
import SceneLabel from '@/components/ui/SceneLabel.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = getServicesItems(lang);

const areaKeys = ['management', 'career', 'international', 'comms', 'legal'] as const;
const areas = areaKeys.map((key) => ({
  key,
  title: t(`services.areas.items.${key}.title`),
  lead: t(`services.areas.items.${key}.lead`),
  bullets: [1, 2, 3, 4].map((n) => t(`services.areas.items.${key}.bullet${n}` as Parameters<typeof t>[0])),
}));

const romans = ['I', 'II', 'III', 'IV', 'V'];
const pillarImages = ['pillar-press', 'pillar-performance', 'pillar-media', 'pillar-family-office', 'pillar-psychology'];
---

<section class="sv" aria-labelledby="srv-hero-title">
  <div class="ph-page-bg" aria-hidden="true">
    <canvas class="ph-ambient" data-ambient="proyeccion"></canvas>
  </div>

  {/* 01 — Cabecera: «Un equipo / fuera del campo.» en dos líneas, entrada por
      palabras. Asoma ya el rótulo de las áreas en la primera pantalla. */}
  <header class="sv-hero">
    <SceneLabel text={t('services.hero.eyebrow')} />
    <h1 class="sv-hero__title ph-giant" id="srv-hero-title" data-reveal>
      <span class="sv-hero__line">{t('services.hero.titleLead')}</span>
      <span class="sv-hero__line">{t('services.hero.titleRest')}<span class="ph-gold">{t('services.hero.titleAccent')}</span>.</span>
    </h1>
    <p class="sv-hero__lead ph-lead" data-reveal>{t('services.hero.lead')}</p>
  </header>

  {/* 02 — Áreas de gestión: el titular se enciende al leerlo y las cinco áreas son
      un índice tipográfico (botón + panel). Cierra una banda tipográfica que
      viaja en horizontal con el scroll. */}
  <div class="sv-areas">
    <SceneLabel as="div" text={t('services.areas.eyebrow')} meta={t('services.areas.kicker')} />
    <h2 class="sv-areas__title ph-giant" data-kinetic>
      {t('services.areas.titleLead')}<span class="ph-gold">{t('services.areas.titleAccent1')}</span>{t('services.areas.titleMid')}<span class="ph-gold">{t('services.areas.titleAccent2')}</span>{t('services.areas.titleTrail')}
    </h2>

    <ol class="sv-index" role="list" data-accordion>
      {areas.map((area, idx) => (
        <li class="sv-row ph-rule" data-acc-row data-inview>
          <h3 class="sv-row__h">
            <button
              type="button"
              class="sv-row__btn"
              id={`srv-area-button-${area.key}`}
              aria-expanded="false"
              aria-controls={`srv-area-panel-${area.key}`}
              data-acc-toggle
            >
              <span class="sv-row__idx ph-index">{String(idx + 1).padStart(2, '0')}</span>
              <span class="sv-row__title">{area.title}</span>
              <span class="sv-row__sign" aria-hidden="true"><span></span><span></span></span>
            </button>
          </h3>
          <div class="sv-row__panel" id={`srv-area-panel-${area.key}`} role="region" aria-labelledby={`srv-area-button-${area.key}`} hidden data-acc-panel>
            <div class="sv-row__body">
              <div class="sv-row__lead" data-acc-col>
                <span class="sv-row__label">{t('services.areas.leadLabel')}</span>
                <p class="ph-body">{area.lead}</p>
              </div>
              <ul class="sv-row__bullets" role="list" data-acc-col>
                {area.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="sv-band" data-sv-band>
      <p class="sv-band__line" data-sv-band-line>{t('services.areas.foot')}</p>
    </div>
  </div>

  {/* 03 — Modelo operativo: la frase se enciende al leerla. */}
  <div class="sv-model">
    <SceneLabel text={t('services.model.eyebrow')} />
    <h2 class="sv-model__title ph-giant" data-kinetic>
      {t('services.model.titleLead')}<span class="ph-gold">{t('services.model.titleAccent')}</span>{t('services.model.titleTrail')}
    </h2>
    <p class="sv-model__lead ph-lead" data-reveal>{t('services.model.lead')}</p>
  </div>

  {/* 04 — Los cinco pilares: cada uno es una escena. Su título gigante y la imagen
      abriéndose desde una rendija horizontal a la altura del título, ligada al
      scroll. En escritorio el título alterna izquierda y derecha. */}
  <div class="sv-pillars">
    {items.map((item, idx) => (
      <article class:list={['sv-pillar', idx % 2 === 1 && 'sv-pillar--alt']} data-pillar>
        <p class="sv-pillar__num ph-index">{romans[idx]} / V</p>
        <div class="sv-pillar__frame">
          <div class="sv-pillar__img" data-pillar-img aria-hidden="true">
            <img
              src={`/${pillarImages[idx]}.webp`}
              srcset={`/${pillarImages[idx]}-sm.webp 800w, /${pillarImages[idx]}.webp 1600w`}
              sizes="(max-width: 1023px) 100vw, 66vw"
              alt=""
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </div>
          <h3 class="sv-pillar__title ph-giant">{item.title}</h3>
        </div>
        <div class="sv-pillar__text ph-grid">
          <p class="sv-pillar__body ph-body" data-reveal>{item.body}</p>
          <ul class="sv-pillar__tags" role="list">
            {item.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>

  {/* 05 — Manifiesto: el cartón final. */}
  <div class="sv-manifest">
    <SceneLabel text={t('services.manifest.eyebrow')} />
    <p class="sv-manifest__body ph-giant" data-kinetic>
      {t('services.manifest.bodyLead')} <span class="ph-gold">{t('services.manifest.bodyAccent')}</span>{t('services.manifest.bodyTrail')}
    </p>
  </div>

  {/* Sin JavaScript nadie abriría los paneles: se ven todos abiertos. El
      preflight de Tailwind oculta `[hidden]` con `!important` dentro de
      `@layer base`, y un `!important` de capa gana a uno sin capa: la regla va en
      la misma capa, donde decide la especificidad. */}
  <noscript><style>@layer base { .sv-row__panel[hidden] { display: block !important; } }</style></noscript>
</section>

<style>
  .sv {
    position: relative;
    /* Transparente: el fondo es la proyección de toda la página (`.ph-page-bg`). */
    background: transparent;
    color: var(--color-ph-white);
  }

  .sv-hero,
  .sv-areas,
  .sv-model,
  .sv-pillars,
  .sv-manifest {
    position: relative;
    z-index: 1;
    padding-inline: var(--ph-section-px);
  }

  /* ── 01 Cabecera ── */
  .sv-hero {
    padding-top: var(--ph-head-top);
  }

  .sv-hero__title {
    margin-top: clamp(20px, 2.6vw, 36px);
    font-size: clamp(44px, 12vw, 210px);
  }

  .sv-hero__line {
    display: block;
  }

  .sv-hero__lead {
    max-width: 44ch;
    margin-top: clamp(18px, 2vw, 28px);
  }

  @media (min-width: 1024px) {
    .sv-hero__lead {
      margin-left: calc((100% - 11 * var(--ph-gutter)) / 12 + var(--ph-gutter));
    }
  }

  /* ── 02 Áreas ── */
  .sv-areas {
    padding-top: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(72px, 9vw, 128px);
  }

  .sv-areas__title {
    max-width: 18ch;
    margin-top: clamp(32px, 4vw, 56px);
    font-size: clamp(32px, 8.4vw, 124px);
    line-height: 0.92;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .sv-areas__title {
      font-size: 7vw;
    }
  }

  .sv-index {
    margin: clamp(40px, 6vw, 88px) 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--ph-hair);
  }

  .sv-row {
    --ph-rule-color: var(--ph-hair-strong);
  }

  .sv-row__h {
    margin: 0;
    font: inherit;
    letter-spacing: normal;
  }

  .sv-row__btn {
    --col1: 2.75rem;
    display: grid;
    grid-template-columns: var(--col1) minmax(0, 1fr) 1.5rem;
    align-items: baseline;
    width: 100%;
    padding: clamp(18px, 2.2vw, 30px) 0;
    border: 0;
    background: transparent;
    color: var(--color-ph-white);
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  @media (min-width: 1024px) {
    .sv-row__btn {
      --col1: calc((100% - 11 * var(--ph-gutter)) / 12 + var(--ph-gutter));
    }
  }

  .sv-row__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 7.2vw, 40px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
    transition: opacity var(--ph-dur-state) var(--ph-ease-std), transform var(--ph-dur-state) var(--ph-ease-out);
  }

  @media (min-width: 1024px) {
    .sv-row__title {
      font-size: clamp(48px, 4.2vw, 64px);
    }
  }

  .sv-row__sign {
    position: relative;
    align-self: center;
    justify-self: end;
    width: 1.25rem;
    height: 1.25rem;
  }

  .sv-row__sign span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: transform var(--ph-dur-move) var(--ph-ease-out), background-color var(--ph-dur-state) var(--ph-ease-std);
  }

  .sv-row__sign span:last-child { transform: rotate(90deg); }
  .sv-row.is-open .sv-row__sign span { background: var(--color-ph-gold); }
  .sv-row.is-open .sv-row__sign span:last-child { transform: rotate(0deg); }

  .sv-index:has(.is-open) .sv-row:not(.is-open) .sv-row__title {
    opacity: 0.45;
  }

  @media (hover: hover) and (pointer: fine) {
    .sv-row__btn:hover .sv-row__title {
      opacity: 1;
      transform: translateX(6px);
    }
  }

  .sv-row__btn:focus-visible { outline-offset: 4px; }
  .sv-row__btn:active .sv-row__title { color: var(--color-ph-gold); }

  /* El panel: «Descripción» y el texto a la izquierda, las cuatro viñetas a la
     derecha, en la retícula. */
  .sv-row__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    padding: 0 0 clamp(28px, 3.4vw, 48px) 2.75rem;
  }

  @media (min-width: 1024px) {
    .sv-row__body {
      grid-template-columns: repeat(11, minmax(0, 1fr));
      column-gap: var(--ph-gutter);
      padding-left: calc((100% - 11 * var(--ph-gutter)) / 12 + var(--ph-gutter));
    }

    .sv-row__lead { grid-column: 1 / 6; }
    .sv-row__bullets { grid-column: 7 / 12; }
  }

  .sv-row__label {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-body);
    font-size: var(--ph-small);
    letter-spacing: 0.02em;
    color: var(--ph-ink-meta);
  }

  .sv-row__bullets {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sv-row__bullets li {
    padding-block: 10px;
    border-top: 1px solid var(--ph-hair);
    font-size: var(--ph-body);
    line-height: 1.45;
    color: var(--ph-ink-body);
  }

  /* «ACOMPAÑAMIENTO 360º · SERVICIO 365»: una banda tipográfica grande que viaja
     en horizontal con el scroll, recortada a los lados. */
  .sv-band {
    margin: clamp(56px, 8vw, 112px) calc(-1 * var(--ph-section-px)) 0;
    padding-inline: var(--ph-section-px);
    overflow-x: hidden; /* Safari < 16 no conoce `clip` */
    overflow-x: clip;
  }

  /* Sin movimiento (o sin JS) la banda se parte en líneas y cabe entera. */
  .sv-band__line {
    max-width: none;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 9vw, 140px);
    line-height: 0.9;
    letter-spacing: var(--ph-giant-track);
    color: var(--color-ph-white);
    overflow-wrap: break-word;
  }

  :global(html.ph-anim) .sv-band__line {
    display: inline-block;
    white-space: nowrap;
    font-size: clamp(56px, 16vw, 260px);
  }

  /* Red de seguridad: si el JS de movimiento no llega, a los 2,5 s vuelve a
     partirse en líneas (no viajaría nunca). */
  :global(html.ph-anim:not(.ph-motion)) .sv-band__line {
    animation: sv-band-fit 0s linear 2.5s forwards;
  }

  @keyframes sv-band-fit {
    to { white-space: normal; font-size: clamp(36px, 9vw, 140px); }
  }

  /* ── 03 Modelo ── */
  .sv-model {
    padding-top: clamp(72px, 9vw, 128px);
    padding-bottom: clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--ph-hair);
  }

  .sv-model__title {
    max-width: 17ch;
    margin-top: clamp(32px, 4vw, 56px);
    font-size: clamp(32px, 8.4vw, 124px);
    line-height: 0.92;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .sv-model__title { font-size: 6.6vw; }
  }

  .sv-model__lead {
    margin-top: clamp(20px, 2.4vw, 32px);
  }

  @media (min-width: 1024px) {
    .sv-model__lead {
      margin-left: calc((100% - 11 * var(--ph-gutter)) / 12 + var(--ph-gutter));
    }
  }

  /* ── 04 Pilares ── */
  .sv-pillar {
    padding-block: clamp(56px, 8vw, 120px) 0;
  }

  .sv-pillar__num {
    margin: 0 0 clamp(16px, 2vw, 24px);
  }

  /* El marco: la imagen (a sangre en el móvil, en 8 columnas en escritorio) con
     el título encima, a media altura: ahí está la rendija desde la que se abre. */
  .sv-pillar__frame {
    position: relative;
    display: grid;
    align-items: center;
    margin-inline: calc(-1 * var(--ph-section-px));
  }

  .sv-pillar__img {
    grid-area: 1 / 1;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #15171b;
  }

  .sv-pillar__img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.78);
  }

  .sv-pillar__title {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    padding-inline: var(--ph-section-px);
    font-size: clamp(48px, 14vw, 220px);
    line-height: 0.86;
    overflow-wrap: break-word;
  }

  @media (min-width: 1024px) {
    .sv-pillar__frame {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--ph-gutter);
      margin-inline: 0;
    }

    .sv-pillar__img {
      grid-area: 1 / 5 / 2 / 13;
      aspect-ratio: 16 / 10;
    }

    .sv-pillar__title {
      grid-area: 1 / 1 / 2 / 10;
      padding-inline: 0;
      font-size: 10vw;
    }

    .sv-pillar--alt .sv-pillar__img {
      grid-area: 1 / 1 / 2 / 9;
    }

    .sv-pillar--alt .sv-pillar__title {
      grid-area: 1 / 4 / 2 / 13;
      text-align: right;
    }

    .sv-pillar--alt .sv-pillar__num {
      text-align: right;
    }
  }

  .sv-pillar__text {
    row-gap: 20px;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .sv-pillar__body {
    grid-column: 1 / -1;
  }

  .sv-pillar__tags {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sv-pillar__tags li {
    font-family: var(--font-body);
    font-size: var(--ph-small);
    letter-spacing: 0.02em;
    color: var(--ph-ink-lead);
  }

  .sv-pillar__tags li + li::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin: 0 12px;
    vertical-align: -0.1em;
    background: var(--ph-hair-strong);
  }

  @media (min-width: 1024px) {
    .sv-pillar__body { grid-column: 2 / 7; }
    .sv-pillar__tags { grid-column: 8 / 13; align-self: start; padding-top: 0.35em; }

    .sv-pillar--alt .sv-pillar__body { grid-column: 7 / 12; }
    .sv-pillar--alt .sv-pillar__tags { grid-column: 1 / 6; grid-row: 1; }
  }

  /* ── 05 Manifiesto ── */
  .sv-manifest {
    padding-top: clamp(96px, 12vw, 176px);
    padding-bottom: clamp(96px, 12vw, 176px);
  }

  .sv-manifest__body {
    max-width: 19ch;
    margin-top: clamp(32px, 4vw, 56px);
    font-size: clamp(32px, 8.4vw, 124px);
    line-height: 0.94;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .sv-manifest__body { font-size: 6.2vw; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-row__title,
    .sv-row__sign span {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, riseWords, fadeUp, kinetic, travel, mountSection, afterTransitionPaint,
  } from '@/scripts/ph-text-animations';
  import { initAccordion } from '@/scripts/ph-accordion';
  import { cascade } from '@/scripts/ph-motion';

  gsap.registerPlugin(ScrollTrigger);

  function initServices(): void {
    const section = document.querySelector<HTMLElement>('.sv');
    if (!section) return;
    const index = section.querySelector<HTMLElement>('[data-accordion]');
    if (index) initAccordion(index);

    if (!reducedMotion()) {
      // La cabecera, en la primera pantalla: el titular sube por palabras y
      // detrás la entradilla.
      const title = section.querySelector<HTMLElement>('.sv-hero__title');
      if (title) riseWords(title, { delay: 0.06, stagger: 0.06 });
      fadeUp(section.querySelectorAll<HTMLElement>('.sv-hero__lead'), { delay: 0.34 });

      // Los titulares de escena se encienden al leerlos.
      section.querySelectorAll<HTMLElement>('[data-kinetic]').forEach((el) => kinetic(el));

      // Los hilos del índice se dibujan en cascada.
      cascade(section.querySelectorAll<HTMLElement>('.sv-row'), 70);
      section.querySelectorAll<HTMLElement>('.sv-row').forEach((row) => {
        row.style.setProperty('--ph-rule-delay', row.style.getPropertyValue('--d'));
      });

      // La banda viaja hacia la izquierda mientras cruza la pantalla.
      const band = section.querySelector<HTMLElement>('[data-sv-band]');
      const bandLine = section.querySelector<HTMLElement>('[data-sv-band-line]');
      if (band && bandLine) travel(bandLine, { container: band });

      fadeUp(section.querySelectorAll<HTMLElement>('.sv-model__lead'));

      // Cada pilar: la imagen se abre desde una rendija a la altura del título,
      // ligada al scroll; el texto sube detrás.
      section.querySelectorAll<HTMLElement>('[data-pillar]').forEach((pillar) => {
        const img = pillar.querySelector<HTMLElement>('[data-pillar-img]');
        const frame = pillar.querySelector<HTMLElement>('.sv-pillar__frame');
        if (img && frame) {
          gsap.fromTo(
            img,
            { clipPath: 'inset(50% 0% 50% 0%)' },
            {
              clipPath: 'inset(0% 0% 0% 0%)',
              ease: 'none',
              scrollTrigger: { trigger: frame, start: 'top 88%', end: 'center 52%', scrub: 0.3 },
            },
          );
          const photo = img.querySelector<HTMLElement>('img');
          if (photo) {
            gsap.fromTo(
              photo,
              { scale: 1.18 },
              { scale: 1, ease: 'none', scrollTrigger: { trigger: frame, start: 'top bottom', end: 'bottom top', scrub: 0.3 } },
            );
          }
        }
        const pillarTitle = pillar.querySelector<HTMLElement>('.sv-pillar__title');
        if (pillarTitle) riseWords(pillarTitle, { trigger: frame ?? pillar, stagger: 0.06 });
        fadeUp(pillar.querySelectorAll<HTMLElement>('.sv-pillar__body, .sv-pillar__tags'), {
          trigger: pillar.querySelector('.sv-pillar__text') ?? pillar,
          stagger: 0.08,
        });
      });
    }
    mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initServices));
</script>

<script>
  // Fondo vivo de la página (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
