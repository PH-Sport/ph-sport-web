  .srv-cta__btn:hover .srv-cta__arrow { transform: translateX(4px); }
  .srv-cta__arrow { transition: transform 0.2s; }
  .srv-cta__btn:focus-visible {
    outline: 2px solid var(--srv-gold);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .srv-cta__btn,
    .srv-cta__arrow { transition: none !important; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { EASE } from '@/scripts/ph-text-animations';

  // Abrir tarda más que cerrar: lo que llega se presenta, lo que se va no se hace
  // esperar.
  const SRV_OPEN_S = 0.5;
  const SRV_CLOSE_S = 0.32;
  const srvActive = new WeakMap<HTMLElement, gsap.core.Tween>();

  function srvReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function srvClosePanel(row: Element): void {
    const panel = row.querySelector<HTMLElement>('.srv-area-row__panel');
    const btn = row.querySelector<HTMLButtonElement>('[data-srv-area-toggle]');
    if (!panel || !btn) return;
    srvActive.get(panel)?.kill();
    const current = panel.offsetHeight;
    row.classList.remove('is-open');
    btn.setAttribute('aria-expanded', 'false');
    if (srvReducedMotion()) {
      panel.style.height = '';
      panel.style.opacity = '';
      return;
    }
    panel.style.height = current + 'px';
    panel.style.opacity = '1';
    const tween = gsap.to(panel, {
      height: 0,
      opacity: 0,
      duration: SRV_CLOSE_S,
      ease: EASE.std,
      onComplete: () => {
        panel.style.height = '';
        panel.style.opacity = '';
        srvActive.delete(panel);
      },
    });
    srvActive.set(panel, tween);
  }

  function srvOpenPanel(row: Element): void {
    const panel = row.querySelector<HTMLElement>('.srv-area-row__panel');
    const btn = row.querySelector<HTMLButtonElement>('[data-srv-area-toggle]');
    if (!panel || !btn) return;
    srvActive.get(panel)?.kill();
    row.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');
    if (srvReducedMotion()) {
      panel.style.height = '';
      panel.style.opacity = '';
      return;
    }
    panel.style.height = '0px';
    panel.style.opacity = '0';
    const target = panel.scrollHeight;
    const tween = gsap.to(panel, {
      height: target,
      opacity: 1,
      duration: SRV_OPEN_S,
      ease: EASE.out,
      onComplete: () => {
        panel.style.height = '';
        panel.style.opacity = '';
        srvActive.delete(panel);
      },
    });
    srvActive.set(panel, tween);
    // Los puntos entran uno tras otro, con su guion dibujándose.
    const bullets = panel.querySelectorAll<HTMLElement>('.srv-area-row__bullets li');
    if (bullets.length) {
      gsap.from(bullets, { opacity: 0, x: -10, duration: 0.45, ease: EASE.out, stagger: 0.05, delay: 0.12, clearProps: 'opacity,transform' });
    }
  }

  function initSrvAccordion(): void {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-srv-area-toggle]');
    if (!buttons.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.srv-area-row');
        if (!row) return;
        const scope = btn.closest('.srv-areas');
        if (!scope) return;
        const wasOpen = row.classList.contains('is-open');

        scope.querySelectorAll('.srv-area-row.is-open').forEach((r) => {
          if (r !== row) srvClosePanel(r);
        });

        if (wasOpen) {
          srvClosePanel(row);
        } else {
          srvOpenPanel(row);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initSrvAccordion);
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, stage, rollIn, riseIn, mountSection, afterTransitionPaint,
  } from '@/scripts/ph-text-animations';
  import { cascade, glint } from '@/scripts/ph-motion';

  gsap.registerPlugin(ScrollTrigger);

  function initServicesAnimations(): void {
    const section = document.querySelector<HTMLElement>('.srv');
    if (!section) return;
    if (!reducedMotion()) {
      // La cabecera, en la primera pantalla: pizarra, titular con su luz y entradilla.
      const hero = section.querySelector<HTMLElement>('.srv-hero');
      if (hero) stage(hero, { glint: true });

      // El tablero de áreas: titular y filas en cascada.
      const areas = section.querySelector<HTMLElement>('.srv-areas');
      if (areas) {
        stage(areas, { delay: 0.1 });
        cascade(areas.querySelectorAll<HTMLElement>('.srv-area-row'), 70);
      }

      const model = section.querySelector<HTMLElement>('.srv-model');
      if (model) stage(model, { glint: true });

      // Cada pilar: el número cae en paletas (lo arranca el núcleo al entrar), la
      // foto sale del negro, el título rueda y el texto sube detrás.
      section.querySelectorAll<HTMLElement>('.srv-block').forEach((block) => {
        const title = block.querySelector<HTMLElement>('[data-m="title"]');
        const body = block.querySelector<HTMLElement>('[data-m="lead"]');
        if (title) rollIn(title, { trigger: block, delay: 0.1 });
        if (body) riseIn(body, { trigger: block, delay: 0.3 });
      });

      // El manifiesto rueda línea a línea y su parte dorada recibe la luz.
      const manifest = section.querySelector<HTMLElement>('.srv-manifest');
      const manifestBody = manifest?.querySelector<HTMLElement>('[data-m="title"]');
      if (manifest && manifestBody) {
        const tween = rollIn(manifestBody, { trigger: manifest, stagger: 0.04 });
        const accent = manifestBody.querySelector<HTMLElement>('em');
        if (accent) tween.eventCallback('onComplete', () => glint(accent));
      }
    }
    mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initServicesAnimations));
</script>

<script>
  // Fondo animado de la cabecera (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
