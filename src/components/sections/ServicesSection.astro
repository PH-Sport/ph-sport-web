---
import { getServicesItems } from '@/lib/servicesItems';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** «03 · Servicios»: el número y la etiqueta van en estilos distintos en la fila índice. */
const [eyebrowNum, ...eyebrowRest] = t('services.hero.eyebrow').split(' · ');
const eyebrowLabel = eyebrowRest.join(' · ');

const areas = [
  {
    key: 'management',
    title: t('services.areas.items.management.title'),
    lead: t('services.areas.items.management.lead'),
    bullets: [
      t('services.areas.items.management.bullet1'),
      t('services.areas.items.management.bullet2'),
      t('services.areas.items.management.bullet3'),
      t('services.areas.items.management.bullet4'),
    ],
  },
  {
    key: 'career',
    title: t('services.areas.items.career.title'),
    lead: t('services.areas.items.career.lead'),
    bullets: [
      t('services.areas.items.career.bullet1'),
      t('services.areas.items.career.bullet2'),
      t('services.areas.items.career.bullet3'),
      t('services.areas.items.career.bullet4'),
    ],
  },
  {
    key: 'international',
    title: t('services.areas.items.international.title'),
    lead: t('services.areas.items.international.lead'),
    bullets: [
      t('services.areas.items.international.bullet1'),
      t('services.areas.items.international.bullet2'),
      t('services.areas.items.international.bullet3'),
      t('services.areas.items.international.bullet4'),
    ],
  },
  {
    key: 'comms',
    title: t('services.areas.items.comms.title'),
    lead: t('services.areas.items.comms.lead'),
    bullets: [
      t('services.areas.items.comms.bullet1'),
      t('services.areas.items.comms.bullet2'),
      t('services.areas.items.comms.bullet3'),
      t('services.areas.items.comms.bullet4'),
    ],
  },
  {
    key: 'legal',
    title: t('services.areas.items.legal.title'),
    lead: t('services.areas.items.legal.lead'),
    bullets: [
      t('services.areas.items.legal.bullet1'),
      t('services.areas.items.legal.bullet2'),
      t('services.areas.items.legal.bullet3'),
      t('services.areas.items.legal.bullet4'),
    ],
  },
];

/** Numeral e imagen de cada pilar, en el mismo orden que `getServicesItems`. Cada
    imagen tiene dos tamaños en `public/`: `-sm` (800 px) para móvil y la grande
    (1600 px). */
const pillarArt = [
  { roman: 'I', img: 'pillar-press' },
  { roman: 'II', img: 'pillar-performance' },
  { roman: 'III', img: 'pillar-media' },
  { roman: 'IV', img: 'pillar-family-office' },
  { roman: 'V', img: 'pillar-psychology' },
];
const pillars = getServicesItems(lang).map((item, i) => ({ ...item, ...pillarArt[i] }));
const pillarCount = pillarArt[pillarArt.length - 1].roman;
---

<section class="srv" aria-labelledby="srv-hero-title">
  <div class="ph-page-bg" aria-hidden="true">
    <canvas class="ph-ambient" data-ambient="estructura"></canvas>
  </div>

  {/* 01 — Hero: misma cabecera que Talentos y Sobre nosotros (global.css). */}
  <div class="srv-hero">
    <p class="ph-rowline srv-hero__index">
      <span class="ph-rowline__group">
        <span class="ph-rowline__num">{eyebrowNum}</span>
        <span class="ph-rowline__sep" aria-hidden="true">·</span>
        <span class="ph-rowline__label">{eyebrowLabel}</span>
      </span>
    </p>
    <h1 class="srv-hero__title ph-head-title" id="srv-hero-title">
      {t('services.hero.titleLead')}<br />
      {t('services.hero.titleRest')}<em>{t('services.hero.titleAccent')}</em>.
    </h1>
    <p class="srv-hero__lead ph-head-lead">{t('services.hero.lead')}</p>
  </div>

  {/* 02 — Áreas de gestión: acordeón en tarjeta (ph-ui.css + ph-motion.ts). Una
      sola área abierta a la vez; el hueco se abre con «morph» y el texto entra
      60 ms después. La primera arranca abierta, como en la portada, para que se
      vea qué hay dentro sin tener que pulsar. */}
  <div class="srv-areas">
    <header class="srv-areas__head">
      <div class="ph-rowline srv-areas__index">
        <span class="ph-rowline__label">{t('services.areas.eyebrow')}</span>
        <span class="ph-rowline__num">{t('services.areas.kicker')}</span>
      </div>
      <h2 class="srv-areas__title">
        {t('services.areas.titleLead')}<em>{t('services.areas.titleAccent1')}</em>{t('services.areas.titleMid')}<em>{t('services.areas.titleAccent2')}</em>{t('services.areas.titleTrail')}
      </h2>
    </header>

    <div class="ph-acc srv-acc" data-ph-accordion>
      {areas.map((area, idx) => {
        const panelId = `srv-area-panel-${area.key}`;
        const buttonId = `srv-area-button-${area.key}`;
        const open = idx === 0;
        return (
          <div class:list={['ph-acc__item', { 'is-open': open }]}>
            <h3 class="srv-acc__heading">
              <button
                type="button"
                class="ph-acc__head"
                id={buttonId}
                aria-expanded={open ? 'true' : 'false'}
                aria-controls={panelId}
              >
                <span class="ph-acc__num">{String(idx + 1).padStart(2, '0')}</span>
                <span class="ph-acc__title">{area.title}</span>
                <span class="ph-acc__plus" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="ph-acc__body" id={panelId} role="region" aria-labelledby={buttonId}>
              <div class="ph-acc__inner">
                <div class="ph-acc__content srv-acc__content">
                  <span class="srv-acc__label">{t('services.areas.leadLabel')}</span>
                  <p class="ph-body srv-acc__lead">{area.lead}</p>
                  <ul class="srv-acc__bullets" role="list">
                    {area.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <p class="ph-rowline__meta srv-areas__foot">{t('services.areas.foot')}</p>
  </div>

  {/* 03 — Modelo operativo: fila índice, titular y entradilla, como las demás
      cabeceras de la página. */}
  <div class="srv-model">
    <p class="ph-rowline">
      <span class="ph-rowline__label">{t('services.model.eyebrow')}</span>
    </p>
    <h2 class="srv-model__title">
      {t('services.model.titleLead')}<em>{t('services.model.titleAccent')}</em>{t('services.model.titleTrail')}
    </h2>
    <p class="ph-body srv-model__lead">{t('services.model.lead')}</p>
  </div>

  {/* 04 — Pilares: una tarjeta por pilar con la foto enmarcada dentro. La foto
      alterna de lado en escritorio y va arriba en móvil. Todo se ve al cargar:
      nada aparece al hacer scroll. */}
  <div class="srv-pillars">
    {pillars.map((pillar, idx) => (
      <article class:list={['srv-pillar', { 'srv-pillar--flip': idx % 2 === 1 }]}>
        <div class="srv-pillar__text">
          <span class="srv-pillar__roman">{pillar.roman}</span>
          <h3 class="srv-pillar__title">{pillar.title}</h3>
          <p class="ph-body">{pillar.body}</p>
          <ul class="srv-pillar__tags" role="list">
            {pillar.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>
        <div class="srv-pillar__media" aria-hidden="true">
          <img
            src={`/${pillar.img}.webp`}
            srcset={`/${pillar.img}-sm.webp 800w, /${pillar.img}.webp 1600w`}
            sizes="(max-width: 900px) 92vw, 46vw"
            width="1600"
            height="1000"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <span class="srv-pillar__chip">{pillar.roman} / {pillarCount}</span>
        </div>
      </article>
    ))}
  </div>

  {/* 05 — Manifiesto: cierre de la página en una tarjeta sólida. */}
  <div class="srv-manifest">
    <p class="ph-rowline">
      <span class="ph-rowline__meta">{t('services.manifest.eyebrow')}</span>
    </p>
    <div class="srv-manifest__card">
      {/* Dos renglones como bloques propios: así el segundo se equilibra solo y no
          deja una palabra suelta debajo (con un <br> el equilibrado no puede, porque
          el primer renglón fija el ancho). */}
      <p class="srv-manifest__body">
        <span class="srv-manifest__line">{t('services.manifest.bodyLead')}</span>
        <span class="srv-manifest__line"><em>{t('services.manifest.bodyAccent')}</em>{t('services.manifest.bodyTrail')}</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* Mismo sistema que el resto de la web (global.css: `.ph-rowline`, `.ph-head-*`;
     ph-ui.css: `.ph-acc`, `.ph-body`). Nada se anima al cargar ni al hacer scroll:
     lo único que se mueve es el acordeón, al pulsarlo. */
  .srv {
    --srv-edge: var(--ph-section-px, clamp(20px, 4vw, 48px));
    /* Aire entre bloques: el mismo que entre secciones de la portada. */
    --srv-gap: clamp(88px, 9vw, 156px);
    /* Marco de las tarjetas de pilar: la foto queda dentro con la esquina
       concéntrica a la de la tarjeta. */
    --srv-frame: clamp(8px, calc(0.38vw + 6.5px), 12px);

    position: relative;
    /* Transparente: el fondo es la luz animada de toda la página (`.ph-page-bg`). */
    background: transparent;
    color: var(--color-ph-white);
    font-family: var(--font-body);
  }

  .srv-hero,
  .srv-areas,
  .srv-model,
  .srv-pillars,
  .srv-manifest { position: relative; z-index: 1; }

  /* ── 01 Hero ──────────────────────────────────────────── */
  /* Misma cabecera que Talentos y Sobre nosotros (estilos y cifras en global.css:
     `.ph-rowline`, `.ph-head-*`): fila índice, titular y entradilla debajo. */
  .srv-hero {
    padding: var(--ph-head-top) var(--srv-edge) 0;
  }
  .srv-hero__title em {
    font-style: italic;
    color: var(--color-ph-gold);
    font-weight: 400;
  }

  /* ── 02 Áreas (acordeón) ─────────────────────────────── */
  /* Arranca nada más acabar la entradilla, para que se vea ya en la primera
     pantalla. Su fila índice («Áreas de gestión · 05 disciplinas · 01 equipo») hace
     de separador, así que la sección no lleva borde propio. */
  .srv-areas {
    padding: calc(var(--ph-head-after) + 8px) var(--srv-edge) 0;
  }
  .srv-areas__head {
    margin-bottom: clamp(28px, calc(1.15vw + 23.5px), 40px);
  }
  /* Titulares de sección de esta página (Áreas y Modelo): un escalón por debajo
     del titular de la cabecera. */
  .srv-areas__title,
  .srv-model__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(30px, calc(2.1vw + 22px), 52px);
    letter-spacing: -0.025em;
    line-height: 1.06;
    margin: clamp(22px, calc(0.95vw + 18.3px), 32px) 0 0;
    max-width: 17em;
    color: var(--color-ph-white);
    text-wrap: balance;
  }
  .srv-areas__title em,
  .srv-model__title em { font-style: italic; color: var(--color-ph-gold); font-weight: 400; }

  .srv-acc__heading { margin: 0; font: inherit; }
  /* Aquí el acordeón es el contenido principal de la página, no un resumen como
     en la portada: los títulos de área suben un escalón. */
  .srv-acc .ph-acc__title {
    font-size: clamp(20px, calc(0.95vw + 16.3px), 30px);
  }

  /* Dentro de cada área: «Descripción» encima del texto y, en escritorio, las
     viñetas al lado, alineadas con el primer renglón del texto. */
  .srv-acc__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'label .'
      'lead  bullets';
    gap: 8px clamp(24px, 4vw, 64px);
    align-items: start;
  }
  .srv-acc__label {
    grid-area: label;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ph-ink-meta);
  }
  .srv-acc__lead { grid-area: lead; }
  .srv-acc__bullets {
    grid-area: bullets;
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .srv-acc__bullets li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    align-items: baseline;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ph-ink-body);
  }
  .srv-acc__bullets li::before {
    content: '';
    width: 18px;
    height: 1.5px;
    background: var(--color-ph-gold);
    translate: 0 -4px;
  }
  @media (max-width: 900px) {
    .srv-acc__content {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'label' 'lead' 'bullets';
      row-gap: 8px;
    }
    .srv-acc__bullets { margin-top: 12px; }
  }

  /* El texto ya viene en mayúsculas del i18n: tamaño y espaciado de dato
     (`.ph-rowline__meta`), alineado a la derecha bajo la tarjeta. */
  .srv-areas__foot {
    margin: 20px 0 0;
    max-width: none;
    text-align: right;
  }

  /* ── 03 Modelo operativo ─────────────────────────────── */
  .srv-model {
    padding: var(--srv-gap) var(--srv-edge) 0;
  }
  .srv-model__lead {
    margin-top: var(--ph-head-lead-gap);
  }

  /* ── 04 Pilares ──────────────────────────────────────── */
  .srv-pillars {
    display: grid;
    gap: clamp(16px, 1.6vw, 24px);
    padding: clamp(36px, calc(1.9vw + 28.6px), 56px) var(--srv-edge) 0;
  }

  .srv-pillar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: var(--srv-frame);
    border: 1px solid var(--mochi-surface-border);
    border-radius: var(--ph-r-xl);
    background: var(--mochi-surface);
    box-shadow: var(--mochi-shadow-surface);
  }
  /* Uno sí y otro no, la foto pasa a la izquierda. */
  .srv-pillar--flip .srv-pillar__media { order: -1; }

  .srv-pillar__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(14px, calc(0.57vw + 11.8px), 20px);
    padding: clamp(24px, calc(3.8vw + 9px), 64px);
  }
  .srv-pillar__roman {
    font: italic 400 clamp(44px, calc(2.85vw + 33px), 74px)/1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ph-gold);
  }
  .srv-pillar__title {
    margin: 0;
    font: 500 clamp(36px, calc(2.85vw + 25px), 66px)/1 var(--font-display);
    letter-spacing: -0.035em;
    color: var(--color-ph-white);
  }
  .srv-pillar__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
  .srv-pillar__tags li {
    padding: 7px 12px;
    border: 1px solid var(--mochi-surface-border-strong);
    border-radius: var(--ph-r-sm);
    background: rgba(255, 255, 255, 0.03);
    font-size: 13px;
    line-height: 1.2;
    color: var(--ph-ink-body);
  }

  /* La foto, enmarcada dentro de la tarjeta: un <img> normal, sin fundidos ni
     capas a opacidad cero. Va en `lazy` porque está por debajo del primer
     pantallazo (regla de performance de ARCHITECTURE.md); en una captura de
     página completa sin hacer scroll puede salir el hueco vacío, y eso no es un
     fallo. Un velo oscuro suave la asienta en la paleta y deja leer la etiqueta
     «I / V». */
  .srv-pillar__media {
    position: relative;
    overflow: hidden;
    min-height: clamp(320px, 32vw, 520px);
    border-radius: calc(var(--ph-r-xl) - var(--srv-frame));
    background: var(--mochi-solid);
  }
  .srv-pillar__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .srv-pillar__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(13, 15, 18, 0.22);
    pointer-events: none;
  }
  .srv-pillar__chip {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    padding: 6px 10px;
    border: 1px solid var(--mochi-surface-border-strong);
    border-radius: var(--ph-r-sm);
    background: rgba(13, 15, 18, 0.72);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ph-white);
  }

  @media (max-width: 900px) {
    .srv-pillar { grid-template-columns: minmax(0, 1fr); }
    /* En móvil la foto va siempre arriba. */
    .srv-pillar__media,
    .srv-pillar--flip .srv-pillar__media {
      order: -1;
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
    .srv-pillar__text {
      padding: clamp(20px, 5vw, 28px) clamp(12px, 3vw, 20px) clamp(16px, 4vw, 24px);
    }
  }

  /* ── 05 Manifiesto ───────────────────────────────────── */
  .srv-manifest {
    /* Abajo poco aire: el pie de página ya trae el suyo. */
    padding: var(--srv-gap) var(--srv-edge) clamp(40px, calc(3vw + 28px), 72px);
  }
  .srv-manifest__card {
    margin-top: clamp(24px, calc(1.15vw + 19.5px), 36px);
    padding: clamp(32px, calc(5.3vw + 11px), 88px) clamp(24px, calc(6.1vw + 0px), 88px);
    border: 1px solid var(--mochi-solid-border);
    border-radius: var(--ph-r-xl);
    background: var(--mochi-solid);
    box-shadow: var(--mochi-shadow-surface);
  }
  .srv-manifest__body {
    margin: 0;
    max-width: 19em;
    font: 500 clamp(30px, calc(3.2vw + 17.5px), 64px)/1.08 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ph-white);
  }
  .srv-manifest__line {
    display: block;
    text-wrap: balance;
  }
  .srv-manifest__body em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-ph-gold);
  }
</style>

<script>
  // Fondo animado de la cabecera (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
