---
import { getServicesItems } from '@/lib/servicesItems';
import { useTranslations, type Lang } from '@/i18n/utils';
import Zone from '@/components/ui/Zone.astro';
import Visor from '@/components/ui/Visor.astro';
import Digits from '@/components/ui/Digits.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = getServicesItems(lang);

const areas = (['management', 'career', 'international', 'comms', 'legal'] as const).map((key) => ({
  key,
  title: t(`services.areas.items.${key}.title`),
  lead: t(`services.areas.items.${key}.lead`),
  bullets: [
    t(`services.areas.items.${key}.bullet1`),
    t(`services.areas.items.${key}.bullet2`),
    t(`services.areas.items.${key}.bullet3`),
    t(`services.areas.items.${key}.bullet4`),
  ],
}));

// El campo de la cabecera, a escala (105 × 68): bandas y líneas de fondo, medio
// campo, círculo central, áreas, áreas pequeñas y semicírculos. En el móvil va
// en vertical: el mismo dibujo con los ejes cambiados.
const PITCH = [
  'M0 0H105V68H0Z',
  'M52.5 0V68',
  'M52.5 24.85A9.15 9.15 0 1 1 52.5 43.15A9.15 9.15 0 1 1 52.5 24.85',
  'M0 13.84H16.5V54.16H0',
  'M0 24.84H5.5V43.16H0',
  'M16.5 26.69A9.15 9.15 0 0 1 16.5 41.31',
  'M105 13.84H88.5V54.16H105',
  'M105 24.84H99.5V43.16H105',
  'M88.5 26.69A9.15 9.15 0 0 0 88.5 41.31',
];
const SPOTS: Array<[number, number]> = [[52.5, 34], [11, 34], [94, 34]];

/** El mismo trazo con los ejes cambiados (x ↔ y): un reflejo, así que los arcos
 *  giran al revés. */
function transpose(d: string): string {
  const tokens = d.match(/[MHVAZ]|-?\d*\.?\d+/g) ?? [];
  const out: string[] = [];
  let i = 0;
  while (i < tokens.length) {
    const cmd = tokens[i++];
    if (cmd === 'M') { const x = tokens[i++]; const y = tokens[i++]; out.push(`M${y} ${x}`); }
    else if (cmd === 'H') out.push(`V${tokens[i++]}`);
    else if (cmd === 'V') out.push(`H${tokens[i++]}`);
    else if (cmd === 'A') {
      const [rx, ry, rot, large, sweep, x, y] = tokens.slice(i, i + 7);
      i += 7;
      out.push(`A${ry} ${rx} ${rot} ${large} ${sweep === '1' ? 0 : 1} ${y} ${x}`);
    } else if (cmd === 'Z') out.push('Z');
  }
  return out.join('');
}
const PITCH_V = PITCH.map(transpose);

// Los pilares: su foto y, para cada etiqueta, el punto de la imagen que anota
// (en % de la foto, que va siempre a 16:10). Elegidos mirando cada imagen.
const PILLARS = [
  { key: 'press', anchors: [[15, 17], [31, 41], [60, 55]] },
  { key: 'performance', anchors: [[53, 31], [83, 34], [42, 72], [66, 88]] },
  { key: 'media', anchors: [[86, 19], [21, 34], [64, 52], [46, 72]] },
  { key: 'family-office', anchors: [[78, 20], [55, 35], [66, 62], [42, 86]] },
  { key: 'psychology', anchors: [[60, 16], [54, 37], [47, 66]] },
] as const;
const ROMANS = ['I', 'II', 'III', 'IV', 'V'];

// El cierre del manifiesto: si lo que sigue a la parte dorada son palabras («a
// largo plazo.»), va en su propia línea, para que la elipse del telestrador
// rodee la parte dorada sin pisarlas; si es solo el punto (inglés), se queda
// pegado a ella.
const manifestTrail = t('services.manifest.bodyTrail');
const manifestTrailBreaks = /\p{L}/u.test(manifestTrail);
---

<section class="srv" aria-labelledby="srv-hero-title">
  <div class="ph-page-bg" aria-hidden="true">
    <canvas class="ph-ambient" data-ambient="estructura"></canvas>
  </div>

  {/* 01 — Cabecera: el titular, literalmente fuera del campo dibujado. */}
  <div class="srv-hero">
    <Zone text={t('services.hero.eyebrow')} />
    <div class="srv-hero__stage" data-inview>
      <div class="srv-hero__copy">
        <h1 class="srv-hero__title ph-head-title" id="srv-hero-title">
          <span class="ph-enter">{t('services.hero.titleLead')}<br />{t('services.hero.titleRest')}<span class="ph-accent">{t('services.hero.titleAccent')}</span>.</span>
        </h1>
        <p class="srv-hero__lead ph-head-lead"><span class="ph-enter">{t('services.hero.lead')}</span></p>
      </div>
      <div class="srv-pitch" aria-hidden="true">
        <svg class="srv-pitch__svg srv-pitch__svg--h" viewBox="-1 -1 107 70" data-hairline>
          {PITCH.map((d, i) => <path class="srv-pitch__line ph-draw" d={d} style={`--draw-delay: ${i === 0 ? 0 : 180 + i * 45}ms`} />)}
          {SPOTS.map(([x, y]) => <circle class="srv-pitch__spot" cx={x} cy={y} r="0.6" />)}
        </svg>
        <svg class="srv-pitch__svg srv-pitch__svg--v" viewBox="-1 -1 70 107" data-hairline>
          {PITCH_V.map((d, i) => <path class="srv-pitch__line ph-draw" d={d} style={`--draw-delay: ${i === 0 ? 0 : 180 + i * 45}ms`} />)}
          {SPOTS.map(([x, y]) => <circle class="srv-pitch__spot" cx={y} cy={x} r="0.6" />)}
        </svg>
      </div>
    </div>
  </div>

  {/* 02 — Áreas de gestión: filas con nodo e índice. Al abrir, la descripción y
      las cuatro claves como nodos sobre una línea que se dibuja. */}
  <div class="srv-areas">
    <header class="srv-areas__head" data-inview>
      <Zone as="div" text={t('services.areas.eyebrow')} meta={t('services.areas.kicker')} />
      <h2 class="srv-areas__title ph-enter">
        {t('services.areas.titleLead')}<span class="ph-accent">{t('services.areas.titleAccent1')}</span>{t('services.areas.titleMid')}<span class="ph-accent">{t('services.areas.titleAccent2')}</span>{t('services.areas.titleTrail')}
      </h2>
    </header>

    <ol class="srv-areas__list" role="list">
      {areas.map((area, idx) => {
        const panelId = `srv-area-panel-${area.key}`;
        const buttonId = `srv-area-button-${area.key}`;
        return (
          <li class="srv-area" data-inview style={`--i: ${idx}`}>
            <button
              type="button"
              class="srv-area__summary"
              id={buttonId}
              aria-expanded="false"
              aria-controls={panelId}
              data-srv-area-toggle
            >
              <span class="ph-node ph-node--pop srv-area__node" aria-hidden="true"></span>
              <span class="srv-area__idx ph-num">{String(idx + 1).padStart(2, '0')}</span>
              <span class="srv-area__title">{area.title}</span>
              <span class="srv-area__toggle" aria-hidden="true"><span></span><span></span></span>
            </button>
            <div class="srv-area__panel" id={panelId} role="region" aria-labelledby={buttonId}>
              <div class="srv-area__body">
                <div class="srv-area__lead">
                  <span class="srv-area__lead-label">{t('services.areas.leadLabel')}</span>
                  <p>{area.lead}</p>
                </div>
                <ul class="srv-area__bullets" role="list">
                  {area.bullets.map((b, i) => (
                    <li style={`--b: ${i}`}><span class="ph-node ph-node--sm" aria-hidden="true"></span><span>{b}</span></li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        );
      })}
    </ol>

    <p class="srv-areas__foot" data-inview>
      <svg class="srv-areas__ring" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="ph-draw" cx="12" cy="12" r="9" transform="rotate(-90 12 12)" />
      </svg>
      <span><Digits text={t('services.areas.foot')} /></span>
    </p>
  </div>

  {/* 03 — Modelo: la trayectoria que baja de las áreas a los pilares. Se dibuja
      con el scroll y descubre sus anotaciones al pasar. */}
  <div class="srv-model" data-srv-model>
    <span class="srv-model__trail" aria-hidden="true" data-srv-trail></span>
    <span class="srv-model__arrow" aria-hidden="true"></span>
    <div class="srv-model__notes">
      <p class="srv-model__note srv-model__label" data-stop="0.12">
        <span class="ph-node ph-node--sm srv-model__node" aria-hidden="true"></span>{t('services.model.eyebrow')}
      </p>
      <h2 class="srv-model__note srv-model__title" data-stop="0.32">
        <span class="ph-node ph-node--sm srv-model__node" aria-hidden="true"></span>{t('services.model.titleLead')}<span class="ph-accent">{t('services.model.titleAccent')}</span>{t('services.model.titleTrail')}
      </h2>
      <p class="srv-model__note srv-model__lead" data-stop="0.58">
        <span class="ph-node ph-node--sm srv-model__node" aria-hidden="true"></span>{t('services.model.lead')}
      </p>
    </div>
  </div>

  {/* 04 — Los cinco pilares: foto enmarcada por un visor y descubierta por un
      escaneo; sus etiquetas anotan puntos de la imagen (en escritorio, con una
      línea guía; en el móvil, en fila). */}
  <div class="srv-pillars">
    {items.map((item, idx) => {
      const pillar = PILLARS[idx];
      const side = idx % 2 === 1 ? 'right' : 'left';
      const full = `/pillar-${pillar.key}.webp`;
      const sm = `/pillar-${pillar.key}-sm.webp`;
      return (
        <article class={`pillar pillar--${side}`} data-inview data-pillar>
          <figure class="pillar__fig" aria-hidden="true">
            <div class="pillar__frame ph-scan" data-inview>
              <img
                class="ph-scan__media"
                src={full}
                srcset={`${sm} 800w, ${full} 1600w`}
                sizes="(max-width: 900px) 100vw, 56vw"
                alt=""
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
              />
              {pillar.anchors.slice(0, item.tags.length).map(([x, y], i) => (
                <span class="pillar__anchor" style={`left: ${x}%; top: ${y}%; --i: ${i}`} data-anchor={i}>
                  <span class="ph-node ph-node--sm"></span>
                </span>
              ))}
            </div>
            <Visor mode="view" arm={24} inset={-10} />
          </figure>
          <div class="pillar__text">
            <p class="pillar__mark"><span class="ph-num">{ROMANS[idx]}</span><span class="pillar__mark-sep">/</span><span class="ph-num">V</span></p>
            <h3 class="pillar__title">{item.title}</h3>
            <p class="pillar__body">{item.body}</p>
            <ul class="pillar__tags" role="list">
              {item.tags.map((tag, i) => (
                <li class="pillar__tag" style={`--i: ${i}`} data-tag={i}>
                  <span class="ph-node ph-node--sm pillar__tag-node" aria-hidden="true"></span>
                  <span>{tag}</span>
                </li>
              ))}
            </ul>
          </div>
          <svg class="pillar__leaders" aria-hidden="true" data-pillar-leaders>
            {item.tags.map(() => <path />)}
          </svg>
        </article>
      );
    })}
  </div>

  {/* 05 — Manifiesto: una trayectoria corta llega a su nodo y el telestrador
      rodea la parte dorada (la única elipse de la página). */}
  <div class="srv-manifest" data-inview data-srv-manifest>
    <p class="srv-manifest__label"><Digits text={t('services.manifest.eyebrow')} /></p>
    <div class="srv-manifest__row">
      <svg class="srv-manifest__trail" viewBox="0 0 40 120" aria-hidden="true">
        <path class="ph-draw" d="M6 2C6 46 34 54 34 104" />
      </svg>
      <p class="srv-manifest__body">
        <span class="ph-node ph-node--lg ph-node--pop srv-manifest__node" aria-hidden="true" data-srv-manifest-node></span>
        {t('services.manifest.bodyLead')}<br />
        <span class="srv-manifest__accent" data-srv-accent>{t('services.manifest.bodyAccent')}<svg class="srv-tele" aria-hidden="true"><path /></svg></span>{manifestTrailBreaks && <br />}{manifestTrail}
      </p>
    </div>
  </div>
</section>

{/* Sin JavaScript, las áreas no se pueden abrir: se muestran abiertas. */}
<noscript>
  <style>
    .srv-area__panel { display: block !important; }
    .srv-area__toggle { display: none !important; }
  </style>
</noscript>

<style>
  .srv {
    position: relative;
    /* Transparente: el fondo es la luz animada de toda la página (`.ph-page-bg`). */
    background: transparent;
    color: var(--color-ph-white);
    /* Red de seguridad: si algún trazo (las líneas guía de los pilares, la elipse
       del manifiesto) se pasara del borde, que no cree scroll horizontal. `clip`
       no crea un contenedor de scroll. */
    overflow-x: clip;
  }

  .srv-hero,
  .srv-areas,
  .srv-model,
  .srv-pillars,
  .srv-manifest { position: relative; z-index: 1; }

  /* ── 01 Cabecera ── */
  .srv-hero {
    padding: var(--ph-head-top) var(--ph-section-px) 0;
  }

  /* En el móvil el campo va encima, en una franja: se ve la última parte de un
     campo en vertical (área, área pequeña y semicírculo) y su línea de fondo
     queda justo encima del titular, que se queda fuera. Lo de arriba del campo
     se desvanece. En escritorio, a la derecha y entero (abajo). */
  .srv-hero__stage {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .srv-hero__title {
    margin-top: 14px;
  }

  .srv-hero__title .ph-enter { display: block; }
  .srv-hero__lead .ph-enter { --enter-delay: 90ms; display: block; }

  .srv-pitch {
    position: relative;
    order: -1;
    height: clamp(104px, 30vw, 156px);
    margin-top: var(--ph-head-title-gap);
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 70%);
    mask-image: linear-gradient(to bottom, transparent, #000 70%);
  }

  .srv-pitch__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .srv-pitch__svg--v {
    position: absolute;
    left: 0;
    bottom: 1px;
  }

  .srv-pitch__svg--h { display: none; }

  .srv-pitch__line {
    fill: none;
    stroke: var(--ph-struct);
    stroke-width: calc(1.25 * var(--k, 0.3));
    --draw-dur: 520ms;
  }

  .srv-pitch__line:first-child { --draw-dur: 640ms; }

  .srv-pitch__spot { fill: var(--ph-struct); }

  @media (min-width: 900px) {
    .srv-hero__stage {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      column-gap: clamp(32px, 4vw, 72px);
      align-items: start;
    }
    .srv-hero__title { margin-top: var(--ph-head-title-gap); }
    .srv-pitch {
      order: 0;
      grid-column: 2;
      grid-row: 1 / span 2;
      height: auto;
      width: 100%;
      max-width: 560px;
      justify-self: end;
      margin-top: calc(var(--ph-head-title-gap) + 0.12em);
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .srv-hero__copy { grid-column: 1; grid-row: 1; }
    .srv-pitch__svg--h { display: block; }
    .srv-pitch__svg--v { display: none; }
  }

  /* ── 02 Áreas ── */
  .srv-areas {
    padding: calc(var(--ph-head-after) + 4px) var(--ph-section-px) clamp(56px, 8vw, 104px);
  }

  .srv-areas__head {
    margin-bottom: clamp(20px, 2.4vw, 32px);
  }

  .srv-areas__title {
    --enter-delay: 80ms;
    margin: clamp(20px, calc(0.95vw + 16.3px), 30px) 0 0;
    max-width: 17em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, calc(2vw + 21px), 50px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .srv-areas__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ph-struct-soft);
  }

  .srv-area {
    position: relative;
    border-bottom: 1px solid var(--ph-struct-soft);
  }

  .srv-area__summary {
    all: unset;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: clamp(12px, 1.6vw, 22px);
    width: 100%;
    min-height: 64px;
    padding: clamp(16px, calc(0.76vw + 13px), 24px) 0;
    cursor: pointer;
    color: var(--color-ph-white);
    -webkit-tap-highlight-color: transparent;
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  .srv-area__summary:focus-visible {
    outline: 1.5px solid var(--color-ph-gold);
    outline-offset: 4px;
  }

  .srv-area__node {
    --node: 16px;
    background-color: var(--color-ph-black);
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  .srv-area__idx {
    font-size: 13px;
    color: var(--color-ph-gold);
  }

  .srv-area__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, calc(1vw + 16px), 32px);
    letter-spacing: -0.02em;
    line-height: 1.15;
    transition: transform var(--ph-dur-state) var(--ph-ease-out);
  }

  .srv-area__toggle {
    position: relative;
    width: 20px;
    height: 20px;
  }

  .srv-area__toggle span {
    position: absolute;
    left: 0;
    top: 50%;
    width: 20px;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: transform var(--ph-dur-state) var(--ph-ease-out);
  }

  .srv-area__toggle span:last-child { transform: rotate(90deg); }
  .srv-area.is-open .srv-area__toggle span:last-child { transform: none; }

  .srv-area.is-open .srv-area__summary { color: var(--color-ph-gold); }
  .srv-area.is-open .srv-area__node { background-color: var(--color-ph-gold); }
  .srv-area.is-open .srv-area__node::after { background-color: var(--color-ph-black); }

  @media (hover: hover) and (pointer: fine) {
    .srv-area__summary:hover { color: var(--color-ph-gold); }
    .srv-area__summary:hover .srv-area__title { transform: translateX(6px); }
  }

  .srv-area__panel { display: none; }
  .srv-area.is-open .srv-area__panel { display: block; }

  .srv-area__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    padding: 0 0 clamp(26px, 3.4vw, 40px);
  }

  @media (min-width: 900px) {
    .srv-area__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(24px, 4vw, 64px);
      padding-left: calc(16px + clamp(12px, 1.6vw, 22px) + 2.6ch + clamp(12px, 1.6vw, 22px));
    }
  }

  .srv-area__lead-label {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--color-ph-gold);
  }

  .srv-area__lead p {
    margin: 0;
    max-width: 56ch;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ph-ink-body);
  }

  /* Las cuatro claves: nodos sobre una línea vertical que se dibuja al abrir. */
  .srv-area__bullets {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 2px 0 2px;
    list-style: none;
  }

  .srv-area__bullets::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 10px;
    bottom: 10px;
    width: 1.5px;
    background: rgba(214, 178, 94, 0.55);
    transform-origin: 50% 0;
  }

  .srv-area__bullets li {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ph-ink-body);
  }

  .srv-area__bullets .ph-node {
    background-color: var(--color-ph-black);
    transform: translateY(1px);
  }

  :global(html.ph-anim) .srv-area.is-open .srv-area__bullets::before {
    animation: srv-draw-y 420ms var(--ph-ease-out) 80ms both;
  }

  :global(html.ph-anim) .srv-area.is-open .srv-area__bullets li {
    animation: srv-note-in 300ms var(--ph-ease-out) calc(160ms + var(--b, 0) * 60ms) both;
  }

  @keyframes srv-draw-y {
    from { transform: scaleY(0); }
    to { transform: none; }
  }

  @keyframes srv-note-in {
    from { opacity: 0; transform: translateX(-6px); }
    to { opacity: 1; transform: none; }
  }

  .srv-areas__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    max-width: none;
    margin: clamp(24px, 3vw, 40px) 0 0;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ph-ink-meta);
  }

  .srv-areas__foot .ph-num { color: var(--color-ph-gold); }

  .srv-areas__ring {
    width: 22px;
    height: 22px;
    flex: none;
  }

  .srv-areas__ring circle {
    fill: none;
    stroke: var(--color-ph-gold);
    stroke-width: 1.5;
    --draw-dur: 800ms;
    --draw-ease: cubic-bezier(0.45, 0, 0.25, 1);
  }

  /* ── 03 Modelo: la trayectoria vertical ── */
  .srv-model {
    --trail-x: calc(var(--ph-section-px) + 7px);
    padding: clamp(24px, 4vw, 48px) var(--ph-section-px) clamp(72px, 9vw, 120px);
  }

  /* La recta crece desde arriba con el scroll (ph-scroll-draw.ts). */
  .srv-model__trail {
    position: absolute;
    left: var(--trail-x);
    top: 0;
    bottom: 26px;
    width: 1.5px;
    background: var(--color-ph-gold);
    transform-origin: 50% 0;
  }

  .srv-model__arrow {
    position: absolute;
    left: calc(var(--trail-x) - 5.5px);
    bottom: 20px;
    width: 12px;
    height: 12px;
    border-right: 1.5px solid var(--color-ph-gold);
    border-bottom: 1.5px solid var(--color-ph-gold);
    transform: rotate(45deg);
    transition: opacity var(--ph-dur-state) var(--ph-ease-out);
  }

  .srv-model.is-armed:not(.is-reached) .srv-model__arrow { opacity: 0; }

  .srv-model__notes {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.6vw, 32px);
    max-width: 900px;
    padding-left: clamp(40px, 5vw, 72px);
  }

  .srv-model__note {
    position: relative;
    margin: 0;
    transition:
      opacity 320ms var(--ph-ease-out),
      transform 320ms var(--ph-ease-out);
  }

  /* Cada anotación cuelga de un nodo sobre la trayectoria por una línea corta. */
  .srv-model__node {
    position: absolute;
    left: calc(-1 * clamp(40px, 5vw, 72px) - 5.5px + 7.75px);
    top: 0.62em;
    margin-top: -5.5px;
    background-color: var(--color-ph-black);
  }

  .srv-model__note::before {
    content: '';
    position: absolute;
    left: calc(-1 * clamp(40px, 5vw, 72px) + 8px);
    width: calc(clamp(40px, 5vw, 72px) - 18px);
    top: 0.62em;
    height: 1px;
    background: rgba(214, 178, 94, 0.6);
    transform-origin: 0 50%;
    transition: transform var(--ph-dur-leader) var(--ph-ease-out);
  }

  .srv-model.is-armed .srv-model__note:not(.is-reached) {
    opacity: 0;
    transform: translateX(-6px);
  }

  .srv-model.is-armed .srv-model__note:not(.is-reached)::before {
    transform: scaleX(0);
  }

  .srv-model__label {
    font-size: 13px;
    letter-spacing: 0.03em;
    color: var(--color-ph-gold);
  }

  .srv-model__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 4vw, 52px);
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .srv-model__lead {
    max-width: 52ch;
    font-family: var(--font-display);
    font-size: var(--ph-head-lead-size);
    line-height: 1.5;
    color: var(--ph-ink-lead);
  }

  /* ── 04 Pilares ── */
  .srv-pillars {
    display: flex;
    flex-direction: column;
    gap: clamp(72px, 10vw, 140px);
    padding: 0 var(--ph-section-px) clamp(72px, 10vw, 140px);
  }

  .pillar {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(24px, 4vw, 40px);
  }

  .pillar__fig {
    position: relative;
    margin: 0;
  }

  .pillar__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #15171b;
  }

  .pillar__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Los puntos que anotan las etiquetas (solo en escritorio, con su línea). */
  .pillar__anchor {
    position: absolute;
    display: none;
    width: 0;
    height: 0;
    z-index: 4;
  }

  .pillar__anchor .ph-node {
    position: absolute;
    left: -5.5px;
    top: -5.5px;
    background-color: rgba(13, 15, 18, 0.6);
    transition:
      opacity 180ms var(--ph-ease-out) calc(640ms + var(--i, 0) * 80ms),
      transform 180ms var(--ph-ease-out) calc(640ms + var(--i, 0) * 80ms);
  }

  .pillar__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pillar__mark {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    font-size: 15px;
    color: var(--ph-ink-meta);
  }

  .pillar__mark .ph-num:first-child { color: var(--color-ph-gold); font-size: 17px; }

  .pillar__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(34px, 5vw, 68px);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .pillar__body {
    max-width: 48ch;
    margin: 0;
    font-size: clamp(16px, calc(0.19vw + 15.3px), 18px);
    line-height: 1.65;
    color: var(--ph-ink-body);
  }

  .pillar__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .pillar__tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--ph-ink-lead);
    transition:
      opacity 300ms var(--ph-ease-out) calc(420ms + var(--i, 0) * 60ms),
      transform 300ms var(--ph-ease-out) calc(420ms + var(--i, 0) * 60ms);
  }

  .pillar__tag-node { background-color: var(--color-ph-black); }

  :global(html.ph-anim) .pillar:not(.is-inview) .pillar__tag {
    opacity: 0;
    transform: translateX(-6px);
  }

  :global(html.ph-anim:not(.ph-motion)) .pillar__tag,
  :global(html.ph-anim:not(.ph-motion)) .pillar__anchor .ph-node {
    animation: ph-motion-failsafe 0s linear 2.5s forwards;
  }

  .pillar__leaders {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: none;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .pillar__leaders path {
    fill: none;
    stroke: rgba(214, 178, 94, 0.85);
    stroke-width: 1.5;
  }

  /* Escritorio: imagen y texto lado a lado, alternando; las etiquetas, en
     columna, anotan su punto de la imagen con una línea guía. */
  @media (min-width: 900px) {
    .pillar {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      column-gap: clamp(56px, 7vw, 120px);
      align-items: center;
    }

    .pillar--right {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    }

    .pillar--right .pillar__fig { order: 2; }

    .pillar__tags {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .pillar--right .pillar__tags { align-items: flex-end; }
    .pillar--right .pillar__tag { flex-direction: row-reverse; }

    .pillar__anchor { display: block; }
    .pillar__leaders { display: block; }

    :global(html.ph-anim) .pillar:not(.is-inview) .pillar__anchor .ph-node {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  /* ── 05 Manifiesto ── */
  .srv-manifest {
    padding: clamp(40px, 6vw, 72px) var(--ph-section-px) clamp(96px, 12vw, 160px);
    border-top: 1px solid var(--ph-struct-soft);
  }

  .srv-manifest__label {
    max-width: none;
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-ph-gold);
  }

  .srv-manifest__label .ph-num { color: var(--color-ph-gold); }

  .srv-manifest__row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: clamp(8px, 2vw, 24px);
    align-items: start;
    margin-top: 6px;
  }

  .srv-manifest__trail {
    width: 40px;
    height: 120px;
    overflow: visible;
  }

  .srv-manifest__trail path {
    fill: none;
    stroke: var(--color-ph-gold);
    stroke-width: 1.5;
  }

  .srv-manifest__trail path.ph-draw { --draw-dur: 640ms; --draw-ease: cubic-bezier(0.05, 0.7, 0.1, 1); }

  .srv-manifest__body {
    position: relative;
    max-width: 22em;
    margin: 92px 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(30px, 4.6vw, 60px);
    letter-spacing: -0.03em;
    /* Aire entre líneas: la elipse del telestrador pasa por ahí. */
    line-height: 1.3;
    color: var(--color-ph-white);
    text-wrap: balance;
  }

  /* El nodo donde termina la trayectoria, a la izquierda de la frase. */
  .srv-manifest__node {
    position: absolute;
    /* Centrado donde acaba la trayectoria: (34, 104) del dibujo de la columna. */
    left: calc(-1 * clamp(8px, 2vw, 24px) - 16px);
    top: 2px;
    background-color: var(--color-ph-black);
    transition-delay: 620ms;
  }

  .srv-manifest__accent {
    position: relative;
    display: inline;
    color: var(--color-ph-gold);
  }

  .srv-tele {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: visible;
    pointer-events: none;
  }

  .srv-tele path {
    fill: none;
    stroke: var(--color-ph-gold);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.92;
  }

  @media (prefers-reduced-motion: reduce) {
    .srv-area__summary,
    .srv-area__title,
    .srv-area__toggle span,
    .pillar__tag,
    .pillar__anchor .ph-node,
    .srv-model__note,
    .srv-model__note::before { transition: none; }
    .srv-area__summary:hover .srv-area__title { transform: none; }
  }
</style>

<script>
  import { mountSection, afterTransitionPaint } from '@/scripts/ph-text-animations';
  import { whenInView, prefersReducedMotion, ping } from '@/scripts/ph-motion';
  import { toggleDisclosure, type Disclosure } from '@/scripts/ph-disclosure';
  import { scrollDraw, remeasureScrollDraws } from '@/scripts/ph-scroll-draw';
  import { telestrator } from '@/scripts/ph-telestrator';

  // ── Áreas: acordeón (un área abierta a la vez) ──
  function initSrvAccordion(section: HTMLElement): void {
    const rows = Array.from(section.querySelectorAll<HTMLElement>('.srv-area'));
    const group: Disclosure[] = rows.map((row) => {
      const btn = row.querySelector<HTMLButtonElement>('[data-srv-area-toggle]')!;
      const panel = row.querySelector<HTMLElement>('.srv-area__panel')!;
      return {
        item: row,
        panel,
        isOpen: () => row.classList.contains('is-open'),
        set: (open: boolean) => {
          if (open) {
            rows.forEach((r) => {
              if (r === row) return;
              r.classList.remove('is-open');
              r.querySelector('[data-srv-area-toggle]')?.setAttribute('aria-expanded', 'false');
            });
          }
          row.classList.toggle('is-open', open);
          btn.setAttribute('aria-expanded', String(open));
        },
      };
    });

    group.forEach((d) => {
      const btn = d.item.querySelector<HTMLButtonElement>('[data-srv-area-toggle]');
      btn?.addEventListener('click', () => {
        const open = !d.isOpen();
        toggleDisclosure(group, d, open);
        if (open) ping(d.item.querySelector('.srv-area__node'));
        // Lo de debajo ha cambiado de sitio: la trayectoria del modelo se vuelve
        // a medir cuando se asienta.
        window.setTimeout(remeasureScrollDraws, 360);
      });
    });
  }

  // ── Pilares: líneas guía de cada etiqueta a su punto de la imagen ──
  const pillarObservers = new Set<ResizeObserver>();

  function drawPillar(article: HTMLElement, animate: boolean): void {
    const svg = article.querySelector<SVGSVGElement>('[data-pillar-leaders]');
    if (!svg || getComputedStyle(svg).display === 'none') return;
    const a = article.getBoundingClientRect();
    const paths = Array.from(svg.querySelectorAll<SVGPathElement>('path'));
    const r1 = (v: number) => Math.round(v * 10) / 10;
    paths.forEach((path, i) => {
      const anchor = article.querySelector<HTMLElement>(`[data-anchor="${i}"]`);
      const tagNode = article.querySelector<HTMLElement>(`[data-tag="${i}"] .pillar__tag-node`);
      if (!anchor || !tagNode) return;
      const p = anchor.getBoundingClientRect();
      const q = tagNode.getBoundingClientRect();
      const ax = p.left - a.left;
      const ay = p.top - a.top;
      const tx = q.left + q.width / 2 - a.left;
      const ty = q.top + q.height / 2 - a.top;
      // Del punto sale a 45° hasta la altura de la etiqueta y sigue recto hasta
      // su nodo; se para antes del anillo.
      const dx = tx - ax;
      const dy = ty - ay;
      const d = Math.min(Math.abs(dx) - 14, Math.abs(dy));
      const mx = ax + Math.sign(dx) * Math.max(0, d);
      const my = ay + Math.sign(dy) * Math.max(0, d);
      const ex = tx - Math.sign(dx) * 9;
      path.setAttribute('d', `M${r1(ax)} ${r1(ay)}L${r1(mx)} ${r1(my)}L${r1(mx)} ${r1(ty)}L${r1(ex)} ${r1(ty)}`);
      if (animate && !prefersReducedMotion()) {
        const len = Math.ceil(path.getTotalLength()) + 2;
        path.animate(
          [
            { strokeDasharray: `${len} ${len}`, strokeDashoffset: `${len}` },
            { strokeDasharray: `${len} ${len}`, strokeDashoffset: '0' },
          ],
          { duration: 420, delay: 640 + i * 80, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards' },
        );
      }
    });
  }

  function initPillars(section: HTMLElement): void {
    section.querySelectorAll<HTMLElement>('[data-pillar]').forEach((article) => {
      let entered = false;
      whenInView(article, () => {
        entered = true;
        drawPillar(article, true);
      });
      const ro = new ResizeObserver(() => {
        if (entered) drawPillar(article, false);
      });
      ro.observe(article);
      pillarObservers.add(ro);
      if (prefersReducedMotion()) {
        entered = true;
        drawPillar(article, false);
      }
    });
  }

  // ── Modelo: la trayectoria con el scroll y sus anotaciones ──
  function initModel(section: HTMLElement): void {
    const model = section.querySelector<HTMLElement>('[data-srv-model]');
    const trail = model?.querySelector<HTMLElement>('[data-srv-trail]');
    if (!model || !trail) return;
    const stops = Array.from(model.querySelectorAll<HTMLElement>('[data-stop]')).map((el) => ({
      at: Number(el.dataset.stop),
      el,
    }));
    // Un punto más al final: la flecha aparece cuando la trayectoria llega.
    stops.push({ at: 0.97, el: model });
    scrollDraw(model, trail, stops);
  }

  // ── Manifiesto: el telestrador y el nodo final ──
  function initManifest(section: HTMLElement): void {
    const manifest = section.querySelector<HTMLElement>('[data-srv-manifest]');
    const accent = manifest?.querySelector<HTMLElement>('[data-srv-accent]');
    const path = manifest?.querySelector<SVGPathElement>('.srv-tele path');
    const node = manifest?.querySelector<HTMLElement>('[data-srv-manifest-node]');
    if (!manifest || !accent || !path) return;
    telestrator(manifest, accent, path);
    if (node) whenInView(manifest, () => window.setTimeout(() => ping(node), 700));
  }

  function initServices(): void {
    const section = document.querySelector<HTMLElement>('.srv');
    if (!section || section.dataset.ready) return;
    section.dataset.ready = '1';
    mountSection(section);
    initSrvAccordion(section);
    initPillars(section);
    initModel(section);
    initManifest(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initServices));
  document.addEventListener('astro:before-swap', () => {
    pillarObservers.forEach((ro) => ro.disconnect());
    pillarObservers.clear();
  });
</script>

<script>
  // Fondo animado de la página (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
