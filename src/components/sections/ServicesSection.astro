---
import { getServicesItems } from '@/lib/servicesItems';
import { useTranslations, type Lang } from '@/i18n/utils';
import Bug from '@/components/ui/Bug.astro';
import Plate from '@/components/ui/Plate.astro';
import Ticker from '@/components/ui/Ticker.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = getServicesItems(lang);

const areaKeys = ['management', 'career', 'international', 'comms', 'legal'] as const;
const areas = areaKeys.map((key) => ({
  key,
  title: t(`services.areas.items.${key}.title`),
  lead: t(`services.areas.items.${key}.lead`),
  bullets: [
    t(`services.areas.items.${key}.bullet1`),
    t(`services.areas.items.${key}.bullet2`),
    t(`services.areas.items.${key}.bullet3`),
    t(`services.areas.items.${key}.bullet4`),
  ],
}));

const romans = ['I', 'II', 'III', 'IV', 'V'];
const pillarKeys = ['press', 'performance', 'media', 'familyOffice', 'psychology'];
const foot = t('services.areas.foot').split(' · ');
const manifestTicker = t('services.manifest.eyebrow').split(' · ');
---

<section class="srv" aria-labelledby="srv-hero-title">
  {/* 01 — Cabecera: «Un equipo» / «fuera del campo.» en dos placas en escalera.
      En la primera pantalla ya asoma el bloque de áreas. */}
  <header class="ph-head srv-head" data-inview>
    <Bug text={t('services.hero.eyebrow')} inview={false} />
    <h1 class="ph-head__title srv-head__title ph-lt" id="srv-hero-title">
      <Plate tab d={60}>{t('services.hero.titleLead')}</Plate>{' '}
      <Plate d={140} step={1}>{t('services.hero.titleRest')}<em>{t('services.hero.titleAccent')}</em>.</Plate>
    </h1>
    <p class="ph-head-lead srv-head__lead ph-in-rise" style="--d: 320ms">{t('services.hero.lead')}</p>
  </header>

  {/* 02 — Áreas de gestión: la alineación. Acordeón con botón y región
      (`aria-expanded`/`aria-controls`); se anima sin animar alturas
      (src/scripts/ph-disclosure.ts). */}
  <div class="srv-areas">
    <header class="srv-areas__head" data-inview>
      <div class="srv-areas__bugs">
        <Bug as="div" text={t('services.areas.eyebrow')} inview={false} />
        <Bug as="div" text={t('services.areas.kicker')} inview={false} d={80} />
      </div>
      <h2 class="srv-areas__title ph-in-wipe" style="--d: 140ms">
        {t('services.areas.titleLead')}<em>{t('services.areas.titleAccent1')}</em>{t('services.areas.titleMid')}<em>{t('services.areas.titleAccent2')}</em>{t('services.areas.titleTrail')}
      </h2>
    </header>

    {/* Sin JavaScript nadie abriría los paneles: se ven desplegados. */}
    <noscript set:html={'<style>.srv-panel[hidden]{display:block}</style>'} />
    <ol class="lineup" role="list">
      {areas.map((area, idx) => {
        const panelId = `srv-area-panel-${area.key}`;
        const buttonId = `srv-area-button-${area.key}`;
        return (
          <li class="lineup__item" data-inview data-cascade="60">
            <button
              type="button"
              class="lineup__summary"
              id={buttonId}
              aria-expanded="false"
              aria-controls={panelId}
              data-srv-area-toggle
            >
              <span class="lineup__tab" aria-hidden="true"></span>
              <span class="lineup__num">{String(idx + 1).padStart(2, '0')}</span>
              <span class="lineup__name">{area.title}</span>
              <span class="lineup__plus" aria-hidden="true"><span></span><span></span></span>
            </button>
            <div class="srv-panel" id={panelId} role="region" aria-labelledby={buttonId} hidden>
              <div class="srv-panel__body">
                <div class="srv-panel__desc">
                  <Bug as="div" text={t('services.areas.leadLabel')} inview={false} />
                  <p>{area.lead}</p>
                </div>
                <ol class="srv-panel__bullets" role="list">
                  {area.bullets.map((b, i) => <li style={`--d: ${120 + i * 60}ms`}>{b}</li>)}
                </ol>
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </div>

  <Ticker items={foot} class="srv-ticker" />

  {/* 03 — Modelo operativo: el corte de segmento. Una banda diagonal cruza el
      bloque al ritmo del scroll y aparecen la placa, el titular y la entradilla. */}
  <div class="srv-model" data-inview>
    <div class="srv-model__band" aria-hidden="true" data-srv-band><span></span><span></span></div>
    <div class="srv-model__inner">
      <Plate as="p" variant="label" tab>{t('services.model.eyebrow')}</Plate>
      <h2 class="srv-model__title ph-in-wipe" style="--d: 160ms">
        {t('services.model.titleLead')}<em>{t('services.model.titleAccent')}</em>{t('services.model.titleTrail')}
      </h2>
      <p class="srv-model__lead ph-in-rise" style="--d: 300ms">{t('services.model.lead')}</p>
    </div>
  </div>

  {/* 04 — Los pilares, como segmentos: la imagen a sangre se descubre en diagonal
      y empuja despacio con el scroll; encima, solapado, su rótulo inferior (el
      romano, la placa con el título, el texto en placa y las etiquetas). En
      escritorio el rótulo alterna de lado. */}
  <div class="srv-pillars">
    {items.map((item, idx) => (
      <article class:list={['pillar', `pillar--${pillarKeys[idx]}`, idx % 2 === 1 && 'pillar--right']} data-inview>
        <div class="pillar__frame ph-reveal" aria-hidden="true">
          <div class="pillar__push" data-pillar-push>
            <div class="pillar__img ph-reveal__img"></div>
          </div>
        </div>
        <div class="pillar__lt">
          <p class="pillar__roman"><span class="ph-num">{romans[idx]} / V</span></p>
          <h3 class="pillar__title"><Plate tab d={120}>{item.title}</Plate></h3>
          <Plate as="p" variant="text" d={200} class="pillar__body">{item.body}</Plate>
          <ul class="pillar__tags" role="list">
            {item.tags.map((tag, i) => (
              <li><Plate variant="label" d={300 + i * 60}>{tag}</Plate></li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>

  {/* 05 — Manifiesto: la cinta y la frase final en dos placas. */}
  <div class="srv-manifest">
    <Ticker items={manifestTicker} class="srv-ticker srv-ticker--manifest" />
    <div class="srv-manifest__inner" data-inview>
      <p class="srv-manifest__body ph-lt">
        <Plate tab lines>{t('services.manifest.bodyLead')}</Plate>{' '}
        <Plate d={110} step={1} lines><em>{t('services.manifest.bodyAccent')}</em>{t('services.manifest.bodyTrail')}</Plate>
      </p>
    </div>
  </div>
</section>

<style>
  .srv {
    position: relative;
    /* Transparente: el fondo es la luz animada de toda la página (`.ph-page-bg`). */
    background: transparent;
  }

  /* «fuera del campo.» (la más larga, en español) más su escalera cabe a 360 px. */
  .srv-head__title { font-size: clamp(36px, 10.2vw, 106px); }
  .srv-head__lead { max-width: 52ch; }

  /* ── 02 Áreas ─────────────────────────────────────────────────────────── */
  .srv-areas {
    position: relative;
    z-index: 1;
    padding: var(--ph-head-after) var(--ph-section-px) clamp(48px, 6vw, 80px);
  }
  .srv-areas__bugs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
  }
  .srv-areas__title {
    margin: clamp(20px, 2.4vw, 30px) 0 clamp(24px, 3vw, 36px);
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(26px, calc(2vw + 18px), 48px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--color-ph-white);
    text-wrap: balance;
  }
  .srv-areas__title em,
  .srv-model__title em {
    font-style: normal;
    color: var(--color-ph-gold);
  }

  /* La alineación: las mismas filas que en la portada. */
  .lineup {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lineup__item {
    transition: clip-path var(--ph-dur-wipe) var(--ph-ease-out) var(--cd, 0ms);
    clip-path: inset(-8px -8px -8px -8px);
  }
  :global(html.ph-anim) .lineup__item:not(.is-inview) { clip-path: inset(-8px 100% -8px -8px); }
  :global(html.ph-anim:not(.ph-motion)) .lineup__item { animation: ph-failsafe-unclip 0s linear 2.5s forwards; }

  .lineup__summary {
    --cut: 60px;
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(12px, 2vw, 22px);
    width: 100%;
    min-height: 60px;
    margin: 0;
    padding: 10px calc(var(--cut) * 0.75) 10px 10px;
    border: 0;
    background: none;
    text-align: left;
    color: var(--color-ph-white);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .lineup__summary::before,
  .lineup__summary::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .lineup__summary::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%);
  }
  .lineup__summary::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut) + 0.59px), calc(100% - var(--cut) + 0.59px) 100%, 0 100%);
    transition: background-color var(--ph-dur-state) var(--ph-ease-std);
  }
  .lineup__summary:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: 3px; }
  .lineup__tab {
    position: absolute;
    left: 0;
    bottom: 100%;
    width: var(--ph-tab-w);
    height: var(--ph-tab-h);
    background: var(--color-ph-gold);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 150ms var(--ph-ease-in);
  }
  .lineup__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-ph-gold);
    box-shadow: inset 0 0 0 1px rgba(214, 178, 94, 0.75);
  }
  .lineup__name {
    font-family: var(--font-display);
    font-size: clamp(17px, calc(0.9vw + 14px), 26px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    transition: transform var(--ph-dur-state) var(--ph-ease-out), color var(--ph-dur-state) var(--ph-ease-std);
  }
  .lineup__plus {
    position: relative;
    width: 18px;
    height: 18px;
    color: rgba(255, 255, 255, 0.7);
  }
  .lineup__plus span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 18px;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
    transition: transform var(--ph-dur-state) var(--ph-ease-out);
  }
  .lineup__plus span:last-child { transform: rotate(90deg); }
  @media (hover: hover) and (pointer: fine) {
    .lineup__summary:hover::after { background: #15171b; }
    .lineup__summary:hover .lineup__name { transform: translateX(4px); }
  }
  .lineup__summary:active::after { background: #1a1d22; }
  .lineup__summary[aria-expanded='true'] .lineup__tab {
    transform: scaleX(1);
    transition: transform var(--ph-dur-tab) var(--ph-ease-out);
  }
  .lineup__summary[aria-expanded='true'] .lineup__name,
  .lineup__summary[aria-expanded='true'] .lineup__plus { color: var(--color-ph-gold); }
  .lineup__summary[aria-expanded='true'] .lineup__plus span:last-child { transform: rotate(0deg); }

  /* El panel que se despliega: dos columnas en escritorio, «Descripción» con su
     texto y las cuatro viñetas con su número. */
  .srv-panel {
    --cut: 28px;
    position: relative;
    z-index: 0;
    margin-top: 3px;
  }
  .srv-panel[hidden] { display: none; }
  .srv-panel::before,
  .srv-panel::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .srv-panel::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%);
  }
  .srv-panel::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut) + 0.59px), calc(100% - var(--cut) + 0.59px) 100%, 0 100%);
  }
  .srv-panel__body {
    display: grid;
    gap: 24px;
    padding: clamp(18px, 2.4vw, 30px) clamp(16px, 2.4vw, 32px) clamp(24px, 3vw, 36px);
  }
  @media (min-width: 900px) {
    .srv-panel__body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); }
  }
  .srv-panel__desc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .srv-panel__desc p {
    margin: 0;
    max-width: 54ch;
    font-size: clamp(16px, calc(0.19vw + 15.3px), 18px);
    line-height: 1.65;
    color: var(--ph-ink-body);
  }
  .srv-panel__bullets {
    counter-reset: srv-bullet;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .srv-panel__bullets li {
    counter-increment: srv-bullet;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
    padding: 11px 0;
    font-size: 16px;
    line-height: 1.45;
    color: var(--ph-ink-body);
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.08);
    transition:
      opacity 320ms var(--ph-ease-out) var(--d, 0ms),
      transform 420ms var(--ph-ease-out) var(--d, 0ms);
  }
  .srv-panel__bullets li::before {
    content: counter(srv-bullet, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--color-ph-gold);
  }
  :global(html.ph-anim) .srv-panel[data-inview]:not(.is-inview) .srv-panel__bullets li { opacity: 0; transform: translateX(-10px); }

  /* ── Cintas ───────────────────────────────────────────────────────────── */
  .srv-ticker { position: relative; z-index: 1; }

  /* ── 03 Modelo: el corte de segmento ─────────────────────────────────── */
  .srv-model {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding: clamp(72px, 10vw, 140px) var(--ph-section-px);
  }
  /* La banda diagonal: dorada con una blanca fina delante, como la cortinilla.
     Cruza el bloque al ritmo del scroll (script). */
  .srv-model__band {
    position: absolute;
    top: -100%;
    bottom: -100%;
    left: 0;
    display: flex;
    gap: 8px;
    pointer-events: none;
    opacity: 0.85;
    /* Solo existe cuando hay movimiento: la enciende el script. */
    visibility: hidden;
  }
  .srv-model__band span:first-child { width: 10px; background: var(--color-ph-gold); }
  .srv-model__band span:last-child { width: 2px; background: var(--color-ph-white); }
  .srv-model__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 980px;
    margin-inline: auto;
  }
  .srv-model__title {
    margin: clamp(22px, 2.6vw, 32px) 0 0;
    font-family: var(--font-display);
    font-size: clamp(28px, calc(2.6vw + 18px), 60px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--color-ph-white);
    text-wrap: balance;
  }
  .srv-model__lead {
    margin: clamp(18px, 2vw, 26px) 0 0;
    max-width: 46ch;
    font-family: var(--font-display);
    font-size: var(--ph-head-lead-size);
    line-height: 1.45;
    color: var(--ph-ink-lead);
  }

  /* ── 04 Pilares ──────────────────────────────────────────────────────── */
  .srv-pillars {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 9vw, 128px);
    padding-bottom: clamp(72px, 9vw, 128px);
  }
  .pillar { position: relative; }
  .pillar__frame {
    --arh: 62.5%;
    aspect-ratio: 16 / 10;
    background: #15171b;
  }
  .pillar__push {
    position: absolute;
    inset: 0;
    transform-origin: 50% 60%;
  }
  .pillar__img {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .pillar--press .pillar__img { background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), url('/pillar-press-sm.webp'); }
  .pillar--performance .pillar__img { background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), url('/pillar-performance-sm.webp'); }
  .pillar--media .pillar__img { background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), url('/pillar-media-sm.webp'); }
  .pillar--familyOffice .pillar__img { background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), url('/pillar-family-office-sm.webp'); }
  .pillar--psychology .pillar__img { background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), url('/pillar-psychology-sm.webp'); }
  @media (min-width: 901px) {
    .pillar--press .pillar__img { background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), url('/pillar-press.webp'); }
    .pillar--performance .pillar__img { background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), url('/pillar-performance.webp'); }
    .pillar--media .pillar__img { background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), url('/pillar-media.webp'); }
    .pillar--familyOffice .pillar__img { background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), url('/pillar-family-office.webp'); }
    .pillar--psychology .pillar__img { background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), url('/pillar-psychology.webp'); }
  }

  /* El rótulo inferior, solapado sobre el borde de abajo de la imagen. */
  .pillar__lt {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin: -56px var(--ph-section-px) 0;
  }
  .pillar__roman {
    margin: 0 0 4px;
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 10px;
    font-size: 13px;
    color: var(--color-ph-gold);
    background: var(--ph-plate);
    box-shadow: inset 0 0 0 1px var(--color-ph-gold);
  }
  .pillar__title {
    margin: 0;
    font-size: clamp(34px, calc(2.6vw + 26px), 72px);
  }
  .pillar__body { max-width: min(100%, 34rem); }
  .pillar__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1024px) {
    .pillar {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      padding: 0 var(--ph-section-px);
    }
    .pillar__frame { grid-column: 1 / 9; grid-row: 1; }
    .pillar__lt {
      grid-column: 7 / 13;
      grid-row: 1;
      margin: 0 0 clamp(-48px, -3vw, -24px);
      align-self: end;
    }
    .pillar--right .pillar__frame { grid-column: 5 / 13; }
    .pillar--right .pillar__lt { grid-column: 1 / 7; }
  }

  /* ── 05 Manifiesto ───────────────────────────────────────────────────── */
  .srv-manifest { position: relative; z-index: 1; }
  .srv-manifest__inner {
    padding: clamp(56px, 8vw, 112px) var(--ph-section-px) clamp(72px, 10vw, 140px);
  }
  .srv-manifest__body {
    max-width: none;
    margin: 0;
    font-size: clamp(26px, calc(3vw + 16px), 64px);
  }

  @media (prefers-reduced-motion: reduce) {
    .lineup__item,
    .lineup__tab,
    .lineup__name,
    .lineup__plus span,
    .lineup__summary::after,
    .srv-panel__bullets li { transition: none; }
  }
</style>

<script>
  import { animateDisclosures, type DisclosureChange } from '@/scripts/ph-disclosure';

  function initSrvAccordion(): void {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-srv-area-toggle]'));
    if (!buttons.length || buttons[0].dataset.srvOn) return;

    const panelOf = (btn: HTMLButtonElement) => document.getElementById(btn.getAttribute('aria-controls') ?? '');
    // Las viñetas entran en cascada cada vez que se abre; las destapa este script.
    buttons.forEach((btn) => {
      btn.dataset.srvOn = '1';
      const panel = panelOf(btn);
      panel?.setAttribute('data-inview', '');
      panel?.setAttribute('data-inview-manual', '');
    });

    const change = (btn: HTMLButtonElement, open: boolean): DisclosureChange | null => {
      const panel = panelOf(btn);
      if (!panel) return null;
      btn.setAttribute('aria-expanded', String(open));
      return {
        panel,
        open,
        setOpen: (v) => {
          panel.hidden = !v;
        },
        // Las viñetas entran en cascada cada vez que se abre.
        onOpen: () => {
          panel.classList.remove('is-inview');
          void panel.offsetWidth;
          panel.classList.add('is-inview');
        },
      };
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const opening = btn.getAttribute('aria-expanded') !== 'true';
        const changes: DisclosureChange[] = [];
        if (opening) {
          buttons
            .filter((o) => o !== btn && o.getAttribute('aria-expanded') === 'true')
            .forEach((o) => {
              const c = change(o, false);
              if (c) changes.push(c);
            });
        }
        const c = change(btn, opening);
        if (c) changes.push(c);
        animateDisclosures(changes);
      });
    });
  }

  document.addEventListener('astro:page-load', initSrvAccordion);
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { reducedMotion, mountSection, afterTransitionPaint } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(ScrollTrigger);

  function initServicesAnimations(): void {
    const section = document.querySelector<HTMLElement>('.srv');
    if (!section) return;
    if (!reducedMotion()) {
      // El corte de segmento: la banda cruza el bloque del modelo de abajo a la
      // izquierda a arriba a la derecha, al ritmo del dedo. Termina de cruzar
      // mientras el bloque entra (antes de que su texto llegue a la zona de
      // lectura): si siguiera cruzando con el bloque en pantalla, se quedaría
      // encima del titular y la entradilla al parar de hacer scroll.
      const model = section.querySelector<HTMLElement>('.srv-model');
      const band = section.querySelector<HTMLElement>('[data-srv-band]');
      if (model && band) {
        gsap.set(band, { visibility: 'visible' });
        gsap.fromTo(
          band,
          { x: () => -model.offsetWidth * 0.35, rotate: -45 },
          {
            x: () => model.offsetWidth * 1.25,
            rotate: -45,
            ease: 'none',
            scrollTrigger: { trigger: model, start: 'top bottom', end: 'top 30%', scrub: 0.4, invalidateOnRefresh: true },
          },
        );
      }
      // Cada pilar empuja despacio mientras cruza la pantalla.
      section.querySelectorAll<HTMLElement>('[data-pillar-push]').forEach((push) => {
        gsap.fromTo(
          push,
          { scale: 1 },
          {
            scale: 1.08,
            ease: 'none',
            scrollTrigger: { trigger: push.parentElement, start: 'top bottom', end: 'bottom top', scrub: 0.6 },
          },
        );
      });
    }
    mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initServicesAnimations));
</script>

