---
import type { PlayerDetailPayload } from '@/lib/playerDetail';
import { useTranslations, type Lang } from '@/i18n/utils';
import { nationalTeamBadgeSrc } from '@/lib/nationalTeamBadge';
import Bug from '@/components/ui/Bug.astro';
import Plate from '@/components/ui/Plate.astro';

interface Props {
  lang: Lang;
  players: PlayerDetailPayload[];
}

const { lang, players } = Astro.props;
const t = useTranslations(lang);

/** Ancho real de la tarjeta en cada grid (2/3/5 columnas); lo comparten AVIF y WebP. */
const photoSizes = '(max-width: 720px) 50vw, (max-width: 1200px) 33vw, 240px';

const cards = players.map((player) => {
  const badges = player.nationalTeamCodes
    .map((code) => {
      const src = nationalTeamBadgeSrc(code);
      return src ? { code, src } : null;
    })
    .filter((b): b is { code: string; src: string } => b !== null);
  return { player, badges };
});

const roleOptions = [
  { value: 'all', label: t('talents.role.all') },
  { value: 'player', label: t('talents.role.players') },
  { value: 'coach', label: t('talents.role.coaches') },
];
const sortOptions = [
  { value: 'default', label: t('talents.sort.default') },
  { value: 'az', label: t('talents.sort.az') },
  { value: 'za', label: t('talents.sort.za') },
];
---

<section class="talents" aria-labelledby="talents-title">
  <div class="ph-page-bg" aria-hidden="true">
    <canvas class="ph-ambient" data-ambient="trayectorias"></canvas>
  </div>

  {/* Cabecera: bug, «El roster.» en su placa y la entradilla. Los controles y la
      primera fila de fichas asoman ya en la primera pantalla. */}
  <header class="ph-head talents__head" data-inview>
    <Bug text={t('talents.eyebrow')} inview={false} />
    <h1 class="ph-head__title talents__title" id="talents-title">
      <Plate tab d={60}>{t('talents.title')}<em>{t('talents.titleAccent')}</em>.</Plate>
    </h1>
    <p class="ph-head-lead ph-in-rise" style="--d: 300ms">{t('talents.lead')}</p>
  </header>

  {/* La barra de filtros de la realización: el buscador en una placa de entrada
      (en el móvil, plegado en un icono) y el rol y el orden como controles
      segmentados de una pulsación, con su rótulo delante. Son grupos de radios
      nativos: las flechas cambian de opción y el lector de pantalla los anuncia
      como tales. */}
  <div class="talents__controls" data-talents-controls data-inview>
    <div class="seg seg--role ph-in-rise" style="--d: 360ms" role="radiogroup" aria-labelledby="talents-role-label">
      <span class="seg__label" id="talents-role-label">{t('talents.role.trigger')}</span>
      <div class="seg__cells">
        {roleOptions.map((opt, i) => (
          <label class="seg__opt">
            <input type="radio" name="talents-role" value={opt.value} checked={i === 0} data-talents-role />
            <span class="seg__text">{opt.label}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="talents__row2 ph-in-rise" style="--d: 420ms">
      <div class="talents__search" data-talents-search-wrap>
        <button
          type="button"
          class="talents__search-open"
          aria-label={t('talents.search.label')}
          aria-expanded="false"
          aria-controls="talents-search-input"
          data-talents-search-open
        >
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
        </button>
        <svg class="talents__search-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
        <input
          type="search"
          id="talents-search-input"
          class="talents__search-input"
          placeholder={t('talents.search.placeholder')}
          aria-label={t('talents.search.label')}
          autocomplete="off"
          data-talents-search
        />
        <button type="button" class="talents__search-btn" aria-label={t('talents.search.clear')} data-talents-clear hidden>
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="m6 6 12 12M18 6 6 18"></path></svg>
        </button>
        <button type="button" class="talents__search-btn talents__search-close" aria-label={t('talents.search.close')} data-talents-search-close>
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="m6 6 12 12M18 6 6 18"></path></svg>
        </button>
      </div>

      <div class="seg seg--sort" role="radiogroup" aria-labelledby="talents-sort-label">
        <span class="seg__label" id="talents-sort-label">{t('talents.sort.trigger')}</span>
        <div class="seg__cells">
          {sortOptions.map((opt, i) => (
            <label class="seg__opt">
              <input type="radio" name="talents-sort" value={opt.value} checked={i === 0} data-talents-sort />
              <span class="seg__text">{opt.label}</span>
            </label>
          ))}
        </div>
      </div>
    </div>
  </div>

  {/* Las fichas de la alineación: la foto a sangre en su celda y, pegado abajo,
      el rótulo inferior con el nombre y el club; los escudos de selección arriba
      a la derecha, en placas cuadradas. No son clicables (DECISIONS.md,
      2026-04-24). */}
  <ul class="talents__grid" role="list" data-talents-grid>
    {cards.map(({ player, badges }, idx) => (
      <li class="talents__item" data-talent-card data-name={player.name} data-role={player.role} data-index={idx}>
        <div class="talents__card" data-inview data-cascade="60">
          <div class="talents__photo ph-reveal">
            <div class="talents__push">
              <picture>
                {player.photoSrcsetAvif && (
                  <source type="image/avif" srcset={player.photoSrcsetAvif} sizes={photoSizes} />
                )}
                <img
                  class="ph-reveal__img"
                  src={player.photoSrc}
                  srcset={player.photoSrcset || undefined}
                  sizes={photoSizes}
                  alt={player.name}
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="640"
                />
              </picture>
            </div>
          </div>
          {badges.length > 0 && (
            <div class="talents__badges" aria-hidden="true">
              {badges.map(({ code, src }) => (
                <span class="talents__badge-cell">
                  <img src={src} alt="" class="talents__badge" width="20" height="20" loading="lazy" decoding="async" data-national-code={code} />
                </span>
              ))}
            </div>
          )}
          <div class="talents__lt">
            <span class="ph-plate talents__name" data-plate-lines>
              <span class="ph-plate__tab" aria-hidden="true"></span>
              <span class="ph-plate__t"><span class="ph-plate__in">{player.name}</span></span>
            </span>
            {player.subtitle && (
              <span class="ph-plate talents__club" data-plate-lines>
                <span class="ph-plate__t"><span class="ph-plate__in">{player.subtitle}</span></span>
              </span>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>

  <div class="talents__empty" data-talents-empty role="status" hidden>
    <Plate as="p" variant="text" class="talents__empty-text">{t('talents.empty.filter')}</Plate>
    <button type="button" class="ph-key talents__reset" data-talents-reset>
      <span class="ph-key__label">
        <span class="ph-key__text">{t('talents.reset')}</span>
        <span class="ph-key__text" aria-hidden="true">{t('talents.reset')}</span>
      </span>
      <svg class="ph-key__arrow" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.6 0.6 9.2 5 1.6 9.4Z" fill="currentColor" /></svg>
    </button>
  </div>
</section>

<style>
  .talents {
    position: relative;
    padding-bottom: clamp(80px, 11vw, 140px);
    /* Transparente: el fondo es la luz animada de toda la página (`.ph-page-bg`). */
    background: transparent;
  }

  /* «The roster.» (la más larga) cabe en una placa a 360 px. */
  .talents__title { font-size: clamp(48px, 14vw, 106px); }

  /* ── La barra de filtros ─────────────────────────────────────────────── */
  .talents__controls {
    /* Alto de la barra de filtros: placas de 48 px, como la de entrada del
       buscador. */
    --ctl-h: 48px;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: var(--ph-head-after) var(--ph-section-px) 18px;
  }
  .talents__row2 {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    min-width: 0;
  }

  /* Control segmentado: una placa con su rótulo delante y una celda por opción.
     La elegida, en blanco con el texto en negro. */
  .seg {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .seg__label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--color-ph-gold);
  }
  .seg__cells {
    --cut: var(--ctl-h);
    position: relative;
    z-index: 0;
    display: flex;
    height: var(--ctl-h);
    padding-right: calc(var(--cut) * 0.55);
    min-width: 0;
  }
  .seg__cells::before,
  .seg__cells::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .seg__cells::before {
    inset: 0;
    background: var(--ph-plate-edge);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, 0 100%);
  }
  .seg__cells::after {
    inset: 1px;
    background: var(--ph-plate);
    clip-path: polygon(0 0, calc(100% - 0.41px) 0, calc(100% - var(--cut) + 1.59px) 100%, 0 100%);
  }
  .seg__opt {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    cursor: pointer;
  }
  .seg__opt + .seg__opt { box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.1); }
  .seg__opt input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .seg__text {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0 12px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.72);
    transition: color var(--ph-dur-state) var(--ph-ease-std), background-color var(--ph-dur-state) var(--ph-ease-std);
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .seg__opt:hover .seg__text { color: var(--color-ph-white); background-color: rgba(255, 255, 255, 0.06); }
  }
  .seg__opt input:checked + .seg__text {
    color: var(--color-ph-black);
    background-color: var(--color-ph-white);
  }
  .seg__opt input:focus-visible + .seg__text {
    outline: 2px solid var(--color-ph-gold);
    outline-offset: -3px;
  }

  /* ── El buscador: una placa de entrada ───────────────────────────────── */
  .talents__search {
    position: relative;
    z-index: 0;
    display: flex;
    align-items: center;
    flex: 0 0 var(--ctl-h);
    height: var(--ctl-h);
  }
  .talents__search::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Opaca: desplegada en el móvil, va encima del control de orden. */
    background: var(--color-ph-black);
    box-shadow: inset 0 0 0 1px var(--ph-plate-edge);
    transition: box-shadow var(--ph-dur-state) var(--ph-ease-std);
  }
  .talents__search:focus-within::before { box-shadow: inset 0 0 0 1px var(--color-ph-gold); }
  .talents__search-open {
    display: grid;
    place-items: center;
    width: var(--ctl-h);
    height: var(--ctl-h);
    padding: 0;
    border: 0;
    color: var(--color-ph-white);
    background: transparent;
    cursor: pointer;
  }
  .talents__search-open:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: -3px; }
  .talents__search-icon {
    display: none;
    flex: 0 0 auto;
    margin-left: 14px;
    color: var(--color-ph-gold);
  }
  .talents__search-input {
    display: none;
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    padding: 0 10px;
    border: 0;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-ph-white);
  }
  .talents__search-input::placeholder { color: rgba(255, 255, 255, 0.6); }
  .talents__search-input::-webkit-search-decoration,
  .talents__search-input::-webkit-search-cancel-button,
  .talents__search-input::-webkit-search-results-button,
  .talents__search-input::-webkit-search-results-decoration { appearance: none; }
  .talents__search-btn {
    display: none;
    flex: 0 0 auto;
    place-items: center;
    width: var(--ctl-h);
    height: var(--ctl-h);
    padding: 0;
    border: 0;
    color: rgba(255, 255, 255, 0.72);
    background: transparent;
    cursor: pointer;
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }
  .talents__search-btn:hover { color: var(--color-ph-gold); }
  .talents__search-btn:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: -3px; }

  /* Móvil: el buscador plegado en un icono; al tocarlo se despliega encima de la
     fila, barriendo de izquierda a derecha. */
  .talents__row2 .seg { flex: 1 1 auto; }
  .talents__search.is-expanded,
  .talents__search.is-collapsing {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    flex: none;
  }
  .talents__search.is-expanded .talents__search-open,
  .talents__search.is-collapsing .talents__search-open { display: none; }
  .talents__search.is-expanded .talents__search-icon,
  .talents__search.is-collapsing .talents__search-icon,
  .talents__search.is-expanded .talents__search-input,
  .talents__search.is-collapsing .talents__search-input { display: block; }
  /* Desplegada en el móvil basta la de cerrar, que también vacía: dos aspas
     iguales una al lado de otra confundían. */
  .talents__search.is-expanded .talents__search-close,
  .talents__search.is-collapsing .talents__search-close { display: grid; }
  .talents__search.is-expanded { animation: talents-search-open var(--ph-dur-wipe) var(--ph-ease-out) both; }
  .talents__search.is-collapsing { animation: talents-search-close 200ms var(--ph-ease-in) both; pointer-events: none; }
  @keyframes talents-search-open {
    from { clip-path: inset(0 calc(100% - 48px) 0 0); }
    to { clip-path: inset(0); }
  }
  @keyframes talents-search-close {
    from { clip-path: inset(0); }
    to { clip-path: inset(0 calc(100% - 48px) 0 0); }
  }
  @media (min-width: 721px) {
    .talents__controls {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 12px 16px;
    }
    /* El buscador a la izquierda y los dos controles a la derecha. */
    .talents__row2 { display: contents; }
    .talents__search {
      order: 1;
      flex: 1 1 260px;
      max-width: 420px;
      margin-right: auto;
    }
    .talents__controls .seg--role { order: 2; }
    .talents__controls .seg--sort { order: 3; }
    .talents__search-open,
    .talents__search-close { display: none !important; }
    .talents__search-icon,
    .talents__search-input { display: block; }
    .talents__search-btn:not([hidden]):not(.talents__search-close) { display: grid; }
    .talents__row2 .seg { flex: 0 0 auto; }
    .seg__opt { flex: 0 0 auto; }
  }
  /* Escritorio ancho: el rótulo de cada control, delante de su placa. */
  @media (min-width: 1200px) {
    .seg { flex-direction: row; align-items: center; gap: 12px; }
  }

  /* ── El grid: 2 → 3 → 5 columnas ────────────────────────────────────── */
  .talents__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(8px, 1.4vw, 16px);
    margin: 0;
    padding: 0 var(--ph-section-px);
    list-style: none;
  }
  @media (min-width: 720px) {
    .talents__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  }
  @media (min-width: 1200px) {
    .talents__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  }

  .talents__item { margin: 0; }
  .talents__item[hidden] { display: none; }

  /* La ficha: la foto a sangre en su celda, con un filo de placa encima. El
     filo y el fondo van dentro de la foto: hasta que se revela no hay casilla
     vacía a la vista. */
  .talents__card { position: relative; }
  .talents__photo {
    --arh: 133.333%;
    aspect-ratio: 3 / 4;
    background: #15171b;
  }
  .talents__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .talents__push {
    position: absolute;
    inset: 0;
    transition: transform 420ms var(--ph-ease-out);
  }
  .talents__photo picture { display: contents; }
  .talents__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Escudos de selección: arriba a la derecha, cada uno en su placa cuadrada. */
  .talents__badges {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    display: flex;
    gap: 3px;
    pointer-events: none;
    transition: clip-path 200ms var(--ph-ease-out) calc(var(--cd, 0ms) + 380ms);
    clip-path: inset(0 0 0 0);
  }
  .talents__badge-cell {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    background: var(--ph-plate);
    box-shadow: inset 0 0 0 1px var(--ph-plate-edge);
  }
  .talents__badge { display: block; width: 20px; height: 20px; object-fit: contain; }
  :global(html.ph-anim) .talents__card:not(.is-inview) .talents__badges { clip-path: inset(0 0 0 100%); }
  :global(html.ph-anim:not(.ph-motion)) .talents__badges { animation: ph-failsafe-unclip 0s linear 2.5s forwards; }

  /* El rótulo inferior de la ficha: placa con el nombre y, debajo, la del club,
     un paso a la derecha. */
  .talents__lt {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 6px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .talents__name {
    --lh: 1.18;
    --pt: 0.48em;
    --pb: 0.44em;
    --pl: 0.62em;
    --pr: 1.8em;
    --d: 240ms;
    font-family: var(--font-display);
    font-size: clamp(14px, calc(0.35vw + 12.6px), 17px);
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--color-ph-white);
  }
  .talents__club {
    --lh: 1.25;
    --pt: 0.5em;
    --pb: 0.46em;
    --pl: 0.7em;
    --pr: 1.9em;
    --d: 300ms;
    max-width: calc(100% - 6px);
    margin-left: 6px;
    font-family: var(--font-body);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.72);
  }
  /* La pestaña dorada asoma al señalar la ficha. */
  .talents__name .ph-plate__tab {
    width: 40px;
    height: 4px;
    transform: scaleX(0);
    transition: transform 140ms var(--ph-ease-in);
  }

  @media (hover: hover) and (pointer: fine) {
    .talents__card:hover .talents__push { transform: scale(1.04); }
    .talents__card:hover .talents__name .ph-plate__tab {
      transform: scaleX(1);
      transition: transform var(--ph-dur-tab) var(--ph-ease-out);
    }
  }

  /* ── Vacío: el aviso en una placa y la placa llave que limpia ─────────── */
  .talents__empty {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin: clamp(24px, 4vw, 40px) var(--ph-section-px) 0;
  }
  .talents__empty[hidden] { display: none; }
  .talents__empty-text { color: var(--ph-ink-lead); }

  @media (prefers-reduced-motion: reduce) {
    .seg__text,
    .talents__push,
    .talents__badges,
    .talents__name .ph-plate__tab { transition: none; }
    .talents__search.is-expanded,
    .talents__search.is-collapsing { animation: none; }
    .talents__card:hover .talents__push { transform: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  // Desde `gsap/all` y no `gsap/Flip`: con `gsap/Flip` el comprobador de tipos
  // falla en macOS por mayúsculas (los tipos de GSAP se citan como `flip.d.ts` y
  // `Flip.d.ts`). El paquete se declara sin efectos secundarios, así que solo
  // viaja Flip: el bundle pesa lo mismo (medido).
  import { Flip } from 'gsap/all';
  import { EASE, mountSection, afterTransitionPaint, scheduleScrollTriggerRefresh } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(Flip);

  type SortMode = 'default' | 'az' | 'za';
  type RoleFilter = 'all' | 'player' | 'coach';

  const reduceMotion = (): boolean => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Vuelve a lanzar la entrada de una pieza (las fichas que entran, el aviso de
   *  vacío): sin la clase y con ella otra vez, en dos fotogramas de estilo. */
  function replay(el: Element): void {
    el.classList.remove('is-inview');
    (el as HTMLElement).style.setProperty('--cd', '0ms');
    void (el as HTMLElement).offsetWidth;
    el.classList.add('is-inview');
  }

  /**
   * Cambia el grid (filtrar, buscar, ordenar) y anima el cambio en vez de saltar:
   * las fichas que se quedan se deslizan a su sitio nuevo (FLIP), las que salen se
   * apagan en 150 ms y las que entran se descubren en diagonal. Con movimiento
   * reducido, el cambio es directo.
   */
  function flipGrid(cards: HTMLElement[], mutate: () => void): void {
    if (reduceMotion()) {
      mutate();
      scheduleScrollTriggerRefresh();
      return;
    }
    // Las fichas que aún no habían entrado en pantalla (y siguen sin revelar)
    // llegarían vacías: al reordenar se dan todas por reveladas.
    cards.forEach((card) => card.querySelector('.talents__card')?.classList.add('is-inview'));
    const state = Flip.getState(cards);
    mutate();
    Flip.from(state, {
      duration: 0.42,
      ease: EASE.out,
      stagger: 0.01,
      absolute: true,
      absoluteOnLeave: true,
      prune: true,
      onEnter: (els) => {
        els.forEach((el) => {
          const card = el.querySelector('.talents__card');
          if (card) replay(card);
        });
      },
      onLeave: (els) => gsap.to(els, { opacity: 0, duration: 0.15, ease: EASE.in }),
      onComplete: scheduleScrollTriggerRefresh,
    });
  }

  function normalize(s: string): string {
    return s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
  }

  function isMobile(): boolean {
    return window.matchMedia('(max-width: 720px)').matches;
  }

  function initTalents(): void {
    const controls = document.querySelector<HTMLElement>('[data-talents-controls]');
    const grid = document.querySelector<HTMLUListElement>('[data-talents-grid]');
    const empty = document.querySelector<HTMLElement>('[data-talents-empty]');
    if (!controls || !grid || !empty || controls.dataset.talentsOn) return;
    controls.dataset.talentsOn = '1';

    const searchWrap = controls.querySelector<HTMLElement>('[data-talents-search-wrap]');
    const search = controls.querySelector<HTMLInputElement>('[data-talents-search]');
    const openBtn = controls.querySelector<HTMLButtonElement>('[data-talents-search-open]');
    const clearBtn = controls.querySelector<HTMLButtonElement>('[data-talents-clear]');
    const closeBtn = controls.querySelector<HTMLButtonElement>('[data-talents-search-close]');
    const roleInputs = Array.from(controls.querySelectorAll<HTMLInputElement>('[data-talents-role]'));
    const sortInputs = Array.from(controls.querySelectorAll<HTMLInputElement>('[data-talents-sort]'));
    const reset = empty.querySelector<HTMLButtonElement>('[data-talents-reset]');
    if (!searchWrap || !search || !openBtn || !clearBtn || !closeBtn || !reset) return;

    // El aviso de vacío entra con su placa cada vez que aparece; lo destapa este
    // script, no el observador de pantalla.
    empty.setAttribute('data-inview', '');
    empty.setAttribute('data-inview-manual', '');

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-talent-card]'));
    const currentRole = (): RoleFilter => {
      const v = roleInputs.find((i) => i.checked)?.value;
      return v === 'player' || v === 'coach' ? v : 'all';
    };
    const currentSort = (): SortMode => {
      const v = sortInputs.find((i) => i.checked)?.value;
      return v === 'az' || v === 'za' ? v : 'default';
    };

    function sortCards(mode: SortMode): void {
      const sorted = [...cards].sort((a, b) => {
        if (mode === 'default') return Number(a.dataset.index) - Number(b.dataset.index);
        const cmp = (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', undefined, { sensitivity: 'base' });
        return mode === 'az' ? cmp : -cmp;
      });
      for (const card of sorted) grid!.appendChild(card);
    }

    function filterCards(query: string): void {
      const norm = normalize(query.trim());
      const role = currentRole();
      let visible = 0;
      for (const card of cards) {
        const nameMatch = !norm || normalize(card.dataset.name ?? '').includes(norm);
        const roleMatch = role === 'all' || role === (card.dataset.role ?? 'player');
        const match = nameMatch && roleMatch;
        card.hidden = !match;
        if (match) visible++;
      }
      const wasHidden = empty!.hidden;
      empty!.hidden = visible > 0;
      if (wasHidden && !empty!.hidden && !reduceMotion()) replay(empty!);
    }

    const applyFilter = () => flipGrid(cards, () => filterCards(search!.value));
    const syncClearBtn = () => { clearBtn!.hidden = search!.value.length === 0; };

    function openSearch(): void {
      searchWrap!.classList.remove('is-collapsing');
      searchWrap!.classList.add('is-expanded');
      openBtn!.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => search!.focus());
    }

    function closeSearch(): void {
      if (!searchWrap!.classList.contains('is-expanded')) return;
      search!.blur();
      searchWrap!.classList.remove('is-expanded');
      openBtn!.setAttribute('aria-expanded', 'false');
      if (reduceMotion()) {
        openBtn!.focus();
        return;
      }
      searchWrap!.classList.add('is-collapsing');
      const onEnd = (e: AnimationEvent): void => {
        if (e.target !== searchWrap) return;
        searchWrap!.classList.remove('is-collapsing');
        searchWrap!.removeEventListener('animationend', onEnd);
        openBtn!.focus();
      };
      searchWrap!.addEventListener('animationend', onEnd);
    }

    search.addEventListener('input', () => {
      syncClearBtn();
      applyFilter();
    });

    clearBtn.addEventListener('click', () => {
      search.value = '';
      syncClearBtn();
      applyFilter();
      search.focus();
    });

    openBtn.addEventListener('click', () => {
      if (isMobile()) openSearch();
    });

    closeBtn.addEventListener('click', () => {
      search.value = '';
      syncClearBtn();
      applyFilter();
      closeSearch();
    });

    search.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && searchWrap.classList.contains('is-expanded')) {
        e.preventDefault();
        closeSearch();
      }
    });

    roleInputs.forEach((input) => input.addEventListener('change', applyFilter));
    sortInputs.forEach((input) =>
      input.addEventListener('change', () => flipGrid(cards, () => sortCards(currentSort()))),
    );

    reset.addEventListener('click', () => {
      search.value = '';
      roleInputs.forEach((i) => { i.checked = i.value === 'all'; });
      sortInputs.forEach((i) => { i.checked = i.value === 'default'; });
      syncClearBtn();
      flipGrid(cards, () => {
        filterCards('');
        sortCards('default');
      });
      if (searchWrap.classList.contains('is-expanded')) closeSearch();
      else if (!isMobile()) search.focus();
      else roleInputs[0]?.focus();
    });

    // Si el navegador restaura el formulario al volver atrás, el grid lo sigue.
    if (search.value || currentRole() !== 'all' || currentSort() !== 'default') {
      syncClearBtn();
      filterCards(search.value);
      sortCards(currentSort());
    }
  }

  /** La entrada de las fichas va por columnas: cada una espera a su vecina de la
   *  izquierda dentro de la fila que entra a la vez (`data-cascade`, ph-motion). */
  function initTalentsAnimations(): void {
    const section = document.querySelector<HTMLElement>('.talents');
    if (section) mountSection(section);
  }

  document.addEventListener('astro:page-load', () => {
    initTalents();
    afterTransitionPaint(initTalentsAnimations);
  });
</script>

<script>
  // Fondo animado de la página (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
