---
import type { PlayerDetailPayload } from '@/lib/playerDetail';
import { useTranslations, type Lang } from '@/i18n/utils';
import { nationalTeamBadgeSrc } from '@/lib/nationalTeamBadge';
import SceneLabel from '@/components/ui/SceneLabel.astro';

interface Props {
  lang: Lang;
  players: PlayerDetailPayload[];
}

const { lang, players } = Astro.props;
const t = useTranslations(lang);

/** Ancho real de la tarjeta en cada grid (2/3/5 columnas); lo comparten AVIF y WebP. */
const photoSizes = '(max-width: 719px) 50vw, (max-width: 1199px) 33vw, 260px';

const cards = players.map((player) => {
  const badges = player.nationalTeamCodes
    .map((code) => {
      const src = nationalTeamBadgeSrc(code);
      return src ? { code, src } : null;
    })
    .filter((b): b is { code: string; src: string } => b !== null);
  return { player, badges };
});
---

{/* Talentos: la escena del roster. Rótulo, «El roster.» grande pero contenido
    (entra por letras), entradilla y el buscador, con la primera fila de fotos
    asomando ya en la primera pantalla. El buscador es una línea de escritura,
    a la vista también en el móvil. El grid sale en el orden del archivo y no hay
    controles para reordenarlo ni filtrarlo por rol: lo decidió el equipo
    (DECISIONS.md, 2026-10-04). Grid suizo de 2/3/5 columnas; cada foto se abre
    como una persiana al entrar. Las tarjetas no son clicables (DECISIONS.md,
    2026-04-24). */}
<section class="tl" aria-labelledby="talents-title">
  <div class="ph-page-bg" aria-hidden="true">
    <canvas class="ph-ambient" data-ambient="proyeccion"></canvas>
  </div>

  <header class="tl__head">
    <SceneLabel text={t('talents.eyebrow')} />
    <h1 class="tl__title ph-giant" id="talents-title" data-reveal>{t('talents.title')}<span class="ph-gold">{t('talents.titleAccent')}</span>.</h1>
    <p class="tl__lead ph-lead" data-reveal>{t('talents.lead')}</p>
  </header>

  <div class="tl-controls" data-talents-controls data-reveal>
    <label class="tl-search" data-talents-search-wrap>
      <span class="ph-sr">{t('talents.search.label')}</span>
      <svg class="tl-search__icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        type="search"
        class="tl-search__input"
        placeholder={t('talents.search.placeholder')}
        aria-label={t('talents.search.label')}
        autocomplete="off"
        data-talents-search
      />
      <button type="button" class="tl-search__btn tl-search__clear" aria-label={t('talents.search.clear')} data-talents-clear hidden>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m6 6 12 12M18 6 6 18"></path></svg>
      </button>
    </label>
  </div>

  <ul class="tl-grid" role="list" data-talents-grid>
    {cards.map(({ player, badges }, idx) => (
      <li class="tl-item" data-talent-card data-name={player.name}>
        <div class="tl-card" data-inview>
          <div class="tl-card__photo">
            <picture>
              {player.photoSrcsetAvif && (
                <source type="image/avif" srcset={player.photoSrcsetAvif} sizes={photoSizes} />
              )}
              <img
                class="tl-card__img"
                src={player.photoSrc}
                srcset={player.photoSrcset || undefined}
                sizes={photoSizes}
                alt={player.name}
                loading={idx < 5 ? 'eager' : 'lazy'}
                decoding="async"
                width="480"
                height="640"
              />
            </picture>
            {badges.length > 0 && (
              <div class="tl-card__badges" aria-hidden="true">
                {badges.map(({ code, src }) => (
                  <img src={src} alt="" class="tl-card__badge" width="20" height="20" loading="lazy" decoding="async" data-national-code={code} />
                ))}
              </div>
            )}
          </div>
          <p class="tl-card__name"><span class="tl-card__name-in">{player.name}</span></p>
          {player.subtitle && <p class="tl-card__club"><span class="tl-card__club-in">{player.subtitle}</span></p>}
        </div>
      </li>
    ))}
  </ul>

  <div class="tl-empty" data-talents-empty role="status" hidden>
    <p class="tl-empty__text">{t('talents.empty.filter')}</p>
    <button type="button" class="tl-empty__reset" data-talents-reset>{t('talents.reset')}</button>
  </div>
</section>

<style>
  .tl {
    position: relative;
    padding: var(--ph-head-top) var(--ph-section-px) clamp(96px, 12vw, 160px);
    /* Transparente: el fondo es la proyección de toda la página (`.ph-page-bg`). */
    background: transparent;
    color: var(--color-ph-white);
  }

  .tl__head,
  .tl-controls,
  .tl-grid,
  .tl-empty {
    position: relative;
    z-index: 1;
  }

  /* «El roster.» grande pero contenido: deja asomar la primera fila de fotos. */
  .tl__title {
    margin-top: clamp(20px, 2.6vw, 36px);
    font-size: clamp(56px, 18vw, 160px);
  }

  .tl__lead {
    margin-top: clamp(14px, 1.6vw, 22px);
  }

  /* ── El buscador ── */
  .tl-controls {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 28px;
    margin: clamp(22px, 2.6vw, 36px) 0 clamp(18px, 2vw, 28px);
    padding-top: 10px;
    border-top: 1px solid var(--ph-hair);
  }

  /* El buscador: una línea de escritura. El hilo de abajo se ilumina al
     escribir (oro con texto; blanco con el foco). */
  .tl-search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1 1 320px;
    max-width: 440px;
    min-height: 52px;
    color: var(--ph-ink-meta);
    cursor: text;
  }

  .tl-search::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 1px;
    background: var(--ph-hair-strong);
    transition: background-color var(--ph-dur-state) var(--ph-ease-std);
  }

  .tl-search:focus-within::after {
    background: var(--color-ph-white);
  }

  .tl-search.has-value::after {
    background: var(--color-ph-gold);
  }

  .tl-search__icon {
    flex: 0 0 auto;
  }

  .tl-search__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 6px 0;
    border: 0;
    outline: none;
    background: transparent;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(22px, calc(0.57vw + 19.8px), 28px);
    letter-spacing: -0.02em;
    color: var(--color-ph-white);
  }

  .tl-search__input::placeholder {
    color: rgba(255, 255, 255, 0.42);
  }

  .tl-search__input::-webkit-search-decoration,
  .tl-search__input::-webkit-search-cancel-button,
  .tl-search__input::-webkit-search-results-button,
  .tl-search__input::-webkit-search-results-decoration {
    appearance: none;
  }

  .tl-search__btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -12px;
    border: 0;
    background: transparent;
    color: var(--ph-ink-lead);
    cursor: pointer;
  }

  .tl-search__btn[hidden] {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .tl-search__btn:hover { color: var(--color-ph-white); }
  }

  /* ── Grid suizo: 2 → 3 → 5 columnas ── */
  .tl-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px var(--ph-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .tl-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px var(--ph-gutter); }
  }

  @media (min-width: 1200px) {
    .tl-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 40px var(--ph-gutter); }
  }

  .tl-item { margin: 0; }
  .tl-item[hidden] { display: none; }

  .tl-card {
    position: relative;
    transition: opacity var(--ph-dur-state) var(--ph-ease-std);
  }

  /* La foto, en un rectángulo duro 3:4. Al entrar en pantalla se abre como una
     persiana, de abajo arriba (600 ms, escalón por columna en `--d`); el nombre
     sube 300 ms después. */
  .tl-card__photo {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #15171b;
    clip-path: inset(0 0 0 0);
    transition: clip-path 600ms var(--ph-ease-emph) var(--d, 0ms);
  }

  .tl-card__photo picture {
    display: contents;
  }

  .tl-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms var(--ph-ease-out);
  }

  :global(html.ph-anim) .tl-card:not(.is-inview) .tl-card__photo {
    clip-path: inset(100% 0 0 0);
  }

  .tl-card__badges {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    gap: 4px;
    pointer-events: none;
  }

  .tl-card__badge {
    display: block;
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .tl-card__name,
  .tl-card__club {
    max-width: none;
    margin: 0;
    overflow: hidden; /* Safari < 16 no conoce `clip` */
    overflow: clip;
  }

  .tl-card__name {
    margin-top: 12px;
    padding-bottom: 2px;
  }

  .tl-card__name-in,
  .tl-card__club-in {
    display: block;
    transition: transform 520ms var(--ph-ease-out) calc(var(--d, 0ms) + 300ms);
  }

  .tl-card__club-in {
    transition-delay: calc(var(--d, 0ms) + 360ms);
  }

  :global(html.ph-anim) .tl-card:not(.is-inview) .tl-card__name-in,
  :global(html.ph-anim) .tl-card:not(.is-inview) .tl-card__club-in {
    transform: translateY(110%);
  }

  .tl-card__name-in {
    position: relative;
    width: fit-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(17px, calc(0.29vw + 15.9px), 20px);
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--color-ph-white);
  }

  .tl-card__name-in::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--color-ph-gold);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--ph-dur-move) var(--ph-ease-out);
  }

  .tl-card__club {
    margin-top: 4px;
  }

  .tl-card__club-in {
    font-family: var(--font-body);
    font-size: var(--ph-small);
    line-height: 1.4;
    color: var(--ph-ink-meta);
  }

  /* Al señalar una tarjeta: la foto empuja un poco, el nombre se subraya y las
     demás bajan de tono (foco de escena). */
  @media (hover: hover) and (pointer: fine) {
    .tl-grid:has(.tl-card:hover) .tl-card:not(:hover) {
      opacity: 0.6;
    }

    .tl-card:hover .tl-card__img {
      transform: scale(1.04);
    }

    .tl-card:hover .tl-card__name-in::after {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-card,
    .tl-card__photo,
    .tl-card__img,
    .tl-card__name-in,
    .tl-card__club-in,
    .tl-card__name-in::after {
      transition: none;
    }
  }

  :global(html.ph-anim:not(.ph-motion)) .tl-card__photo,
  :global(html.ph-anim:not(.ph-motion)) .tl-card__name-in,
  :global(html.ph-anim:not(.ph-motion)) .tl-card__club-in {
    animation: ph-motion-failsafe 0s linear 2.5s forwards;
  }

  /* ── Vacío: una frase grande y el enlace para limpiar ── */
  .tl-empty {
    margin-top: clamp(32px, 5vw, 56px);
    padding-top: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--ph-hair);
  }

  .tl-empty[hidden] {
    display: none;
  }

  .tl-empty__text {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, calc(1.53vw + 22px), 44px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-ph-white);
  }

  .tl-empty__reset {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 20px;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.015em;
    color: var(--color-ph-white);
    cursor: pointer;
  }

  .tl-empty__reset::before,
  .tl-empty__reset::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 1px;
    transform-origin: 0 50%;
  }

  .tl-empty__reset::before {
    background: var(--ph-hair-strong);
  }

  .tl-empty__reset::after {
    background: var(--color-ph-gold);
    transform: scaleX(0);
    transition: transform var(--ph-dur-move) var(--ph-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .tl-empty__reset:hover::after { transform: scaleX(1); }
  }

  .tl-empty__reset:focus-visible::after { transform: scaleX(1); }
  .tl-empty__reset:active { color: var(--color-ph-gold); }
</style>

<script>
  import { gsap } from 'gsap';
  // Desde `gsap/all` y no `gsap/Flip`: con `gsap/Flip` el comprobador de tipos
  // falla en macOS por mayúsculas (los tipos de GSAP se citan como `flip.d.ts` y
  // `Flip.d.ts`). El paquete se declara sin efectos secundarios, así que solo
  // viaja Flip: el bundle pesa lo mismo (medido).
  import { Flip } from 'gsap/all';
  import { EASE } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(Flip);

  const reduceMotion = (): boolean => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * Cambia el grid al buscar y anima el cambio en vez de saltar: las fichas que
   * se quedan se deslizan a su sitio nuevo, las que salen se encogen y las que
   * entran crecen desde el suyo (FLIP). Así se ve qué ha pasado con cada una. Con
   * movimiento reducido, el cambio es directo.
   */
  function flipGrid(cards: HTMLElement[], mutate: () => void): void {
    if (reduceMotion()) { mutate(); return; }
    // Las fichas que aún no habían entrado en pantalla (con la persiana cerrada)
    // llegarían vacías: al recolocarse se dan todas por abiertas.
    cards.forEach((card) => card.querySelector('.tl-card')?.classList.add('is-inview'));
    const state = Flip.getState(cards);
    mutate();
    Flip.from(state, {
      duration: 0.5,
      ease: EASE.out,
      stagger: 0.012,
      absolute: true,
      absoluteOnLeave: true,
      prune: true,
      onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.92 }, { opacity: 1, scale: 1, duration: 0.42, ease: EASE.out, clearProps: 'opacity,transform' }),
      onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.92, duration: 0.2, ease: EASE.in }),
    });
  }

  function normalize(s: string): string {
    return s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
  }

  function initTalents(): void {
    const controls = document.querySelector<HTMLElement>('[data-talents-controls]');
    const grid = document.querySelector<HTMLUListElement>('[data-talents-grid]');
    const empty = document.querySelector<HTMLElement>('[data-talents-empty]');
    if (!controls || !grid || !empty) return;

    const searchWrap = controls.querySelector<HTMLLabelElement>('[data-talents-search-wrap]');
    const search = controls.querySelector<HTMLInputElement>('[data-talents-search]');
    const clearBtn = controls.querySelector<HTMLButtonElement>('[data-talents-clear]');
    const reset = empty.querySelector<HTMLButtonElement>('[data-talents-reset]');
    if (!searchWrap || !search || !clearBtn || !reset) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-talent-card]'));

    function filterCards(query: string): void {
      const norm = normalize(query.trim());
      let visible = 0;
      for (const card of cards) {
        const match = !norm || normalize(card.dataset.name ?? '').includes(norm);
        card.hidden = !match;
        if (match) visible++;
      }
      empty!.hidden = visible > 0;
    }

    function applyFilter(query: string): void {
      flipGrid(cards, () => filterCards(query));
    }

    function syncSearchState(): void {
      const has = search!.value.length > 0;
      clearBtn!.hidden = !has;
      searchWrap!.classList.toggle('has-value', has);
    }

    search.addEventListener('input', () => {
      syncSearchState();
      applyFilter(search.value);
    });

    clearBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      search.value = '';
      syncSearchState();
      applyFilter('');
      search.focus();
    });

    reset.addEventListener('click', () => {
      search.value = '';
      syncSearchState();
      applyFilter('');
      search.focus();
    });

    syncSearchState();
  }

  document.addEventListener('astro:page-load', initTalents);
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import {
    reducedMotion, riseLetters, fadeUp, mountSection, afterTransitionPaint,
  } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(ScrollTrigger);

  /** Columnas del grid en cada ancho (las mismas que el CSS: 2, 3 y 5). */
  function columns(): number {
    if (window.matchMedia('(min-width: 1200px)').matches) return 5;
    if (window.matchMedia('(min-width: 720px)').matches) return 3;
    return 2;
  }

  /**
   * Las persianas se abren por filas, de izquierda a derecha: cada foto espera a
   * su vecina de la izquierda (`--d`, 80 ms por columna). La apertura la dispara
   * el núcleo de movimiento al entrar cada ficha en pantalla.
   */
  function setColumnDelays(section: HTMLElement): void {
    const cols = columns();
    let i = 0;
    section.querySelectorAll<HTMLElement>('[data-talent-card]:not([hidden]) .tl-card').forEach((card) => {
      card.style.setProperty('--d', `${(i % cols) * 80}ms`);
      i++;
    });
  }

  function initTalentsAnimations(): void {
    const section = document.querySelector<HTMLElement>('.tl');
    if (!section) return;
    if (!reducedMotion()) {
      // La cabecera, en la primera pantalla: el titular entra por letras y detrás
      // la entradilla y el buscador.
      const title = section.querySelector<HTMLElement>('.tl__title');
      if (title) riseLetters(title, { delay: 0.08 });
      fadeUp(section.querySelectorAll<HTMLElement>('.tl__lead, [data-talents-controls]'), { delay: 0.32, stagger: 0.08 });
      setColumnDelays(section);
    }
    mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initTalentsAnimations));
</script>

<script>
  // Fondo vivo de la página (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
