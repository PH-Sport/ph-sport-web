---
import type { PlayerDetailPayload } from '@/lib/playerDetail';
import { useTranslations, type Lang } from '@/i18n/utils';
import { nationalTeamBadgeSrc } from '@/lib/nationalTeamBadge';
import Zone from '@/components/ui/Zone.astro';
import Visor from '@/components/ui/Visor.astro';
import NodeLink from '@/components/ui/NodeLink.astro';

interface Props {
  lang: Lang;
  players: PlayerDetailPayload[];
}

const { lang, players } = Astro.props;
const t = useTranslations(lang);

/** Ancho real de la tarjeta en cada grid (2/3/5 columnas); lo comparten AVIF y WebP. */
const photoSizes = '(max-width: 720px) 50vw, (max-width: 1200px) 33vw, 240px';

const cards = players.map((player) => {
  const badges = player.nationalTeamCodes
    .map((code) => {
      const src = nationalTeamBadgeSrc(code);
      return src ? { code, src } : null;
    })
    .filter((b): b is { code: string; src: string } => b !== null);
  return { player, badges };
});
---

{/* Talentos: la sala de seguimiento. La barra de herramientas lleva el
    buscador, a la vista también en el móvil; no hay controles para reordenar el
    grid ni filtrarlo por rol: lo decidió el equipo (DECISIONS.md, 2026-10-04).
    Cada tarjeta es un jugador en seguimiento: un visor se clava en las esquinas
    de su foto (que se descubre con un escaneo) y se queda en marcas pequeñas, y
    su nombre cuelga de la esquina por una línea guía. Las tarjetas no son
    clicables y el orden del grid es el del archivo (CLAUDE.md, «Roster»). */}
<section class="talents" aria-labelledby="talents-title">
  <div class="ph-page-bg" aria-hidden="true">
    <canvas class="ph-ambient" data-ambient="trayectorias"></canvas>
  </div>

  <header class="talents__head">
    <Zone text={t('talents.eyebrow')} />
    <h1 class="talents__title ph-head-title" id="talents-title" data-inview>
      <span class="talents__title-text ph-enter">{t('talents.title')}<span class="ph-accent">{t('talents.titleAccent')}</span>.</span>
      <Visor mode="view" arm={20} inset={-12} />
    </h1>
    <p class="talents__lead ph-head-lead" data-inview><span class="ph-enter">{t('talents.lead')}</span></p>
  </header>

  <div class="talents__controls" data-talents-controls>
    <label class="talents__search" data-talents-search-wrap>
      <span class="ph-sr">{t('talents.search.label')}</span>
      <svg class="talents__search-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        type="search"
        class="talents__search-input"
        placeholder={t('talents.search.placeholder')}
        aria-label={t('talents.search.label')}
        autocomplete="off"
        data-talents-search
      />
      <button
        type="button"
        class="talents__search-clear"
        aria-label={t('talents.search.clear')}
        data-talents-clear
        hidden
      >
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
      <span class="talents__search-line" aria-hidden="true"></span>
    </label>
  </div>

  <ul class="talents__grid" role="list" data-talents-grid>
    {cards.map(({ player, badges }) => (
      <li
        class="talents__item"
        data-talent-card
        data-name={player.name}
      >
        <article class="tcard" data-inview>
          <div class="tcard__photo ph-scan" data-inview>
            <picture>
              {player.photoSrcsetAvif && (
                <source type="image/avif" srcset={player.photoSrcsetAvif} sizes={photoSizes} />
              )}
              <img
                class="ph-scan__media"
                src={player.photoSrc}
                srcset={player.photoSrcset || undefined}
                sizes={photoSizes}
                alt={player.name}
                loading="lazy"
                decoding="async"
                width="480"
                height="640"
              />
            </picture>
            {badges.length > 0 && (
              <div class="tcard__badges" aria-hidden="true">
                {badges.map(({ code, src }) => (
                  <span class="tcard__badge">
                    <img
                      src={src}
                      alt=""
                      width="22"
                      height="22"
                      loading="lazy"
                      decoding="async"
                      data-national-code={code}
                    />
                  </span>
                ))}
              </div>
            )}
            <Visor mode="view" arm={22} inset={0} settle class="tcard__visor" />
          </div>
          <div class="tcard__meta">
            <span class="tcard__leader" aria-hidden="true"><i></i><i></i></span>
            <span class="tcard__text">
              <span class="tcard__name">{player.name}</span>
              {player.subtitle && <span class="tcard__club">{player.subtitle}</span>}
            </span>
          </div>
        </article>
      </li>
    ))}
  </ul>

  <div class="talents__empty" data-talents-empty role="status" hidden>
    <span class="talents__empty-frame" aria-hidden="true">
      <span class="ph-visor talents__empty-visor"><i></i><i></i><i></i><i></i></span>
    </span>
    <p class="talents__empty-text">{t('talents.empty.filter')}</p>
    <NodeLink label={t('talents.reset')} data-talents-reset="" />
  </div>
</section>

<style>
  .talents {
    position: relative;
    padding: var(--ph-head-top) var(--ph-section-px) clamp(80px, 12vw, 140px);
    /* Transparente: el fondo es la luz animada de toda la página (`.ph-page-bg`). */
    background: transparent;
    color: var(--color-ph-white);
  }

  .talents__head,
  .talents__controls,
  .talents__grid,
  .talents__empty { position: relative; z-index: 1; }

  /* Cabecera compacta: zona, titular (fijado por un visor al entrar) y
     entradilla. Cifras compartidas en global.css (`--ph-head-*`). */
  .talents__title {
    position: relative;
    display: inline-block;
  }

  .talents__title-text { display: block; }

  .talents__lead .ph-enter {
    --enter-delay: 90ms;
    display: block;
  }

  /* ── Barra de herramientas: el buscador ── */
  .talents__controls {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px clamp(16px, 2.4vw, 32px);
    margin-top: var(--ph-head-after);
    margin-bottom: clamp(18px, 2vw, 28px);
    padding-block: 10px;
    border-top: 1px solid var(--ph-struct-soft);
    border-bottom: 1px solid var(--ph-struct-soft);
  }

  /* Buscador: una línea debajo que se ilumina mientras se escribe. */
  .talents__search {
    position: relative;
    flex: 1 1 260px;
    max-width: 420px;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 4px;
    cursor: text;
  }

  .talents__search-icon {
    flex: 0 0 auto;
    color: rgba(255, 255, 255, 0.7);
  }

  .talents__search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 44px;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-ph-white);
    font-family: var(--font-body);
    font-size: 15px;
  }

  .talents__search-input::placeholder {
    color: rgba(255, 255, 255, 0.58);
  }

  .talents__search-input::-webkit-search-decoration,
  .talents__search-input::-webkit-search-cancel-button,
  .talents__search-input::-webkit-search-results-button,
  .talents__search-input::-webkit-search-results-decoration {
    appearance: none;
  }

  /* La línea: blanca al 24 %, dorada con el foco y más viva al escribir. */
  .talents__search-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--ph-struct);
    transform-origin: 0 50%;
    transition: background-color var(--ph-dur-state) var(--ph-ease-std), transform var(--ph-dur-state) var(--ph-ease-out);
  }

  .talents__search:focus-within .talents__search-line {
    background: var(--color-ph-gold-muted);
  }

  .talents__search.is-typing .talents__search-line {
    background: var(--color-ph-gold);
    transform: scaleY(2);
  }

  .talents__search-clear {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: color var(--ph-dur-state) var(--ph-ease-std);
  }

  .talents__search-clear:hover {
    color: var(--color-ph-gold);
  }

  /* ── Grid: 2 → 3 → 5 columnas ── */
  .talents__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px clamp(10px, 1.5vw, 16px);
  }

  @media (min-width: 720px) {
    .talents__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 16px; }
  }

  @media (min-width: 1200px) {
    .talents__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 34px 18px; }
  }

  .talents__item { margin: 0; }
  .talents__item[hidden] { display: none; }

  /* ── La tarjeta: un jugador en seguimiento ── */
  .tcard {
    position: relative;
    display: block;
  }

  .tcard__photo {
    position: relative;
    aspect-ratio: 3 / 4;
    background: #15171b;
  }

  /* Sin caja propia: la foto sigue midiéndose contra .tcard__photo. */
  .tcard__photo picture { display: contents; }

  .tcard__photo img.ph-scan__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      clip-path var(--ph-dur-scan) cubic-bezier(0.45, 0, 0.25, 1) var(--scan-delay, 0ms),
      filter var(--ph-dur-move) var(--ph-ease-std);
  }

  /* El visor de la foto: se clava al entrar y se queda en marcas pequeñas; al
     señalar la tarjeta (o al encontrarla buscando) vuelve a fijarse entero. */
  .tcard__photo :global(.tcard__visor) {
    --visor-arm: 22px;
    --visor-inset: 0px;
  }

  .tcard:hover :global(.tcard__visor > i::before),
  .tcard:hover :global(.tcard__visor > i::after) {
    transform: none;
    transition-delay: 0ms;
  }

  /* Escudos de selección: nodos pequeños arriba a la derecha. */
  .tcard__badges {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    display: flex;
    gap: 4px;
    pointer-events: none;
  }

  .tcard__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1.5px solid rgba(214, 178, 94, 0.75);
    border-radius: 50%;
    background: rgba(13, 15, 18, 0.72);
  }

  .tcard__badge img {
    display: block;
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  /* La etiqueta cuelga de la esquina de abajo a la izquierda de la foto por una
     línea guía corta: tramo a 45° y tramo recto. */
  .tcard__meta {
    position: relative;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    column-gap: 6px;
    padding-top: 8px;
  }

  .tcard__leader {
    position: relative;
    display: block;
    height: 18px;
    margin-top: -8px;
  }

  .tcard__leader > i {
    position: absolute;
    height: 1.5px;
    background: rgba(214, 178, 94, 0.85);
    transform-origin: 0 50%;
    transition: transform var(--ph-dur-leader) var(--ph-ease-out);
  }

  .tcard__leader > i:first-child {
    left: 0;
    top: -0.75px;
    width: calc(14px * 1.41421);
    transform: rotate(45deg);
  }

  .tcard__leader > i:last-child {
    left: 14px;
    top: 13.25px;
    width: 8px;
  }

  .tcard__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding-top: 4px;
    transition: transform var(--ph-dur-move) var(--ph-ease-out);
  }

  .tcard__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(15px, calc(0.2vw + 14.2px), 17px);
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-ph-white);
  }

  .tcard__club {
    font-size: clamp(13px, calc(0.1vw + 12.6px), 14px);
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.66);
  }

  /* Entrada: la foto se escanea (`.ph-scan`), el visor se clava y, detrás, se
     dibuja la línea guía y llega la etiqueta. */
  :global(html.ph-anim) .tcard:not(.is-inview) .tcard__leader > i:first-child { transform: rotate(45deg) scaleX(0); }
  :global(html.ph-anim) .tcard:not(.is-inview) .tcard__leader > i:last-child { transform: scaleX(0); }
  :global(html.ph-anim) .tcard:not(.is-inview) .tcard__text { opacity: 0; transform: translateX(-6px); }

  .tcard__leader > i:first-child { transition-delay: calc(var(--scan-delay, 0ms) + 320ms); }
  .tcard__leader > i:last-child { transition-delay: calc(var(--scan-delay, 0ms) + 460ms); }
  .tcard__text {
    transition:
      opacity 320ms var(--ph-ease-out) calc(var(--scan-delay, 0ms) + 520ms),
      transform 320ms var(--ph-ease-out) calc(var(--scan-delay, 0ms) + 520ms);
  }

  :global(html.ph-anim:not(.ph-motion)) .tcard__text {
    animation: ph-motion-failsafe 0s linear 2.5s forwards;
  }

  :global(html.ph-anim:not(.ph-motion)) .tcard__leader > i:last-child {
    animation: ph-motion-failsafe 0s linear 2.5s forwards;
  }

  :global(html.ph-anim:not(.ph-motion)) .tcard__leader > i:first-child {
    animation: tcard-leader-failsafe 0s linear 2.5s forwards;
  }

  @keyframes tcard-leader-failsafe {
    to { transform: rotate(45deg); }
  }

  /* Señalar (escritorio): visor entero, foto un punto más luminosa y la línea
     guía se alarga mientras la etiqueta se desliza. */
  @media (hover: hover) and (pointer: fine) {
    .tcard:hover .tcard__photo img.ph-scan__media {
      filter: brightness(1.08);
      transition-delay: 0ms;
    }
    .tcard:hover .tcard__leader > i:last-child {
      transform: scaleX(1.75);
      transition-delay: 0ms;
    }
    .tcard:hover .tcard__text {
      transform: translateX(6px);
      transition-delay: 0ms;
    }
    .tcard:hover .tcard__name { color: var(--color-ph-gold); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tcard__leader > i,
    .tcard__text,
    .tcard__photo img.ph-scan__media { transition: none; }
    .tcard:hover .tcard__text,
    .tcard:hover .tcard__leader > i:last-child { transform: none; }
  }

  /* ── Vacío: un marco de escuadras sin nada dentro ── */
  .talents__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin: clamp(32px, 6vw, 64px) 0 0;
    padding: 16px 0;
    text-align: center;
  }

  .talents__empty[hidden] { display: none; }

  .talents__empty-frame {
    position: relative;
    display: block;
    width: clamp(120px, 22vw, 168px);
    aspect-ratio: 3 / 4;
  }

  .talents__empty-visor {
    --visor-arm: 20px;
    --visor-inset: 0px;
    --visor-color: var(--ph-struct);
  }

  .talents__empty-text {
    margin: 0;
    max-width: 36ch;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ph-ink-lead);
  }
</style>

<script>
  import { gsap } from 'gsap';
  // Desde `gsap/all` y no `gsap/Flip`: con `gsap/Flip` el comprobador de tipos
  // falla en macOS por mayúsculas (los tipos de GSAP se citan como `flip.d.ts` y
  // `Flip.d.ts`). El paquete se declara sin efectos secundarios, así que solo
  // viaja Flip: el bundle pesa lo mismo (medido).
  import { Flip } from 'gsap/all';
  import { EASE } from '@/scripts/ph-text-animations';

  gsap.registerPlugin(Flip);

  const reduceMotion = (): boolean => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Da por entrada una tarjeta: escaneada, fijada y con su etiqueta. */
  function markSeen(card: HTMLElement): void {
    card.querySelectorAll<HTMLElement>('.tcard, .ph-scan, .ph-visor--view').forEach((el) => el.classList.add('is-inview'));
  }

  /**
   * Cambia el grid al buscar y anima el cambio en vez de saltar: las fichas que
   * se quedan se deslizan a su sitio nuevo, las que salen se encogen y las que
   * entran crecen desde el suyo (FLIP). Así se ve qué ha pasado con cada una. Con
   * movimiento reducido, el cambio es directo.
   */
  function flipGrid(cards: HTMLElement[], mutate: () => void): void {
    if (reduceMotion()) { mutate(); return; }
    // Las fichas que aún no habían entrado en pantalla llegarían vacías: al
    // recolocarse se dan todas por vistas.
    cards.forEach(markSeen);
    const state = Flip.getState(cards);
    mutate();
    Flip.from(state, {
      duration: 0.5,
      ease: EASE.out,
      stagger: 0.012,
      absolute: true,
      absoluteOnLeave: true,
      prune: true,
      onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.42, ease: EASE.out, clearProps: 'opacity,transform' }),
      onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.9, duration: 0.2, ease: EASE.in }),
    });
  }

  function normalize(s: string): string {
    return s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
  }

  function initTalents(): void {
    const controls = document.querySelector<HTMLElement>('[data-talents-controls]');
    const grid = document.querySelector<HTMLUListElement>('[data-talents-grid]');
    const empty = document.querySelector<HTMLElement>('[data-talents-empty]');
    if (!controls || !grid || !empty || controls.dataset.ready) return;
    controls.dataset.ready = '1';

    const searchWrap = controls.querySelector<HTMLLabelElement>('[data-talents-search-wrap]');
    const search = controls.querySelector<HTMLInputElement>('[data-talents-search]');
    const clearBtn = controls.querySelector<HTMLButtonElement>('[data-talents-clear]');
    const reset = empty.querySelector<HTMLButtonElement>('[data-talents-reset]');
    if (!searchWrap || !search || !clearBtn || !reset) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-talent-card]'));

    function filterCards(query: string): void {
      const norm = normalize(query.trim());
      let visible = 0;
      for (const card of cards) {
        const match = !norm || normalize(card.dataset.name ?? '').includes(norm);
        card.hidden = !match;
        // Al buscar, lo que coincide queda fijado por su visor.
        card.querySelector('.tcard__photo')?.classList.toggle('is-targeted', match && !!norm);
        if (match) visible++;
      }
      empty!.hidden = visible > 0;
    }

    function applyFilter(query: string): void {
      flipGrid(cards, () => filterCards(query));
    }

    function syncClearBtn(): void {
      clearBtn!.hidden = search!.value.length === 0;
    }

    let typingTimer = 0;
    search.addEventListener('input', () => {
      syncClearBtn();
      // La línea del buscador se enciende mientras se escribe.
      searchWrap.classList.add('is-typing');
      window.clearTimeout(typingTimer);
      typingTimer = window.setTimeout(() => searchWrap.classList.remove('is-typing'), 600);
      applyFilter(search.value);
    });

    clearBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      search.value = '';
      syncClearBtn();
      applyFilter('');
      search.focus();
    });

    reset.addEventListener('click', () => {
      search.value = '';
      syncClearBtn();
      applyFilter('');
      search.focus();
    });

    syncClearBtn();
  }

  document.addEventListener('astro:page-load', initTalents);
</script>

<script>
  import { mountSection, afterTransitionPaint } from '@/scripts/ph-text-animations';

  /** Columnas del grid en cada ancho (las mismas que el CSS: 2, 3 y 5). */
  function columns(): number {
    if (window.matchMedia('(min-width: 1200px)').matches) return 5;
    if (window.matchMedia('(min-width: 720px)').matches) return 3;
    return 2;
  }

  /**
   * Las fichas se escanean por filas, de izquierda a derecha: cada una espera a
   * su vecina de la izquierda (`--scan-delay`, 70 ms). El escaneo lo dispara el
   * núcleo de movimiento al entrar cada ficha en pantalla.
   */
  function setRowDelays(section: HTMLElement): void {
    const cols = columns();
    let i = 0;
    section.querySelectorAll<HTMLElement>('[data-talent-card]:not([hidden]) .tcard').forEach((card) => {
      card.style.setProperty('--scan-delay', `${(i % cols) * 70}ms`);
      i++;
    });
  }

  function initTalentsAnimations(): void {
    const section = document.querySelector<HTMLElement>('.talents');
    if (!section) return;
    setRowDelays(section);
    mountSection(section);
  }

  document.addEventListener('astro:page-load', () => afterTransitionPaint(initTalentsAnimations));
</script>

<script>
  // Fondo animado de la página (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
