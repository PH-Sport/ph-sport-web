---
import type { PlayerDetailPayload } from '@/lib/playerDetail';
import { useTranslations, type Lang } from '@/i18n/utils';
import { nationalTeamBadgeSrc } from '@/lib/nationalTeamBadge';

interface Props {
  lang: Lang;
  players: PlayerDetailPayload[];
}

const { lang, players } = Astro.props;
const t = useTranslations(lang);


/** Ancho real de la tarjeta en cada grid (2/3/5 columnas); lo comparten AVIF y WebP. */
const photoSizes = '(max-width: 720px) 50vw, (max-width: 1200px) 33vw, 240px';

const cards = players.map((player) => {
  const badges = player.nationalTeamCodes
    .map((code) => {
      const src = nationalTeamBadgeSrc(code);
      return src ? { code, src } : null;
    })
    .filter((b): b is { code: string; src: string } => b !== null);
  return { player, badges };
});

/** Los dos desplegables («Ver» y «Orden») con la pieza `.ph-select` de ph-ui.css:
 *  el botón crece hasta ser la lista. La primera opción de cada uno es la de partida. */
const selects = [
  {
    key: 'role',
    label: t('talents.role.label'),
    trigger: t('talents.role.trigger'),
    options: [
      { value: 'all', label: t('talents.role.all') },
      { value: 'player', label: t('talents.role.players') },
      { value: 'coach', label: t('talents.role.coaches') },
    ],
  },
  {
    key: 'sort',
    label: t('talents.sort.label'),
    trigger: t('talents.sort.trigger'),
    options: [
      { value: 'default', label: t('talents.sort.default') },
      { value: 'az', label: t('talents.sort.az') },
      { value: 'za', label: t('talents.sort.za') },
    ],
  },
];
---

<section class="talents" aria-labelledby="talents-title">
  <div class="ph-page-bg" aria-hidden="true">
    <canvas class="ph-ambient" data-ambient="trayectorias"></canvas>
  </div>

  <header class="talents__head">
    <h1 class="talents__title ph-head-title" id="talents-title">
      {t('talents.title')}<em>{t('talents.titleAccent')}</em>.
    </h1>
    <p class="talents__lead ph-head-lead">{t('talents.lead')}</p>
  </header>

  <div class="talents__controls" data-talents-controls>
    {/* En móvil el buscador se pliega a un cuadro con la lupa; al tocarlo, ese
        cuadro crece hasta ocupar la barra (comportamiento en el script de abajo). */}
    <label class="talents__search" data-talents-search-wrap>
      <span class="visually-hidden">{t('talents.search.label')}</span>
      <svg class="ph-ico talents__search-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        type="search"
        class="talents__search-input"
        placeholder={t('talents.search.placeholder')}
        aria-label={t('talents.search.label')}
        autocomplete="off"
        data-talents-search
      />
      <button
        type="button"
        class="talents__search-btn talents__search-clear"
        aria-label={t('talents.search.clear')}
        data-talents-clear
        hidden
      >
        <svg class="ph-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"></path></svg>
      </button>
      <button
        type="button"
        class="talents__search-btn talents__search-close"
        aria-label={t('talents.search.close')}
        data-talents-search-close
      >
        <svg class="ph-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"></path></svg>
      </button>
    </label>

    {/* Desplegables: la pieza compartida `.ph-select` (ph-ui.css + ph-motion.ts).
        Al elegir emite `ph:select`, que el script de abajo convierte en filtro u
        orden. Las opciones llevan tabindex="-1": se llega a ellas con las flechas
        al abrir, y con la lista cerrada no se cuelan en el recorrido del tabulador. */}
    {selects.map((s) => (
      <div class="ph-select talents__select" data-ph-select data-align="end" data-talents-select={s.key}>
        <button
          type="button"
          class="ph-select__btn"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls={`talents-${s.key}-list`}
          aria-label={s.label}
        >
          <span>{s.trigger}</span>
          <svg class="ph-select__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        <div class="ph-select__panel">
          <div class="ph-select__current" aria-hidden="true">
            <span>{s.trigger}</span>
            <svg class="ph-select__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
          </div>
          <div class="ph-select__list" role="listbox" id={`talents-${s.key}-list`} aria-label={s.label}>
            <span class="ph-select__hl" aria-hidden="true"></span>
            {s.options.map((o, i) => (
              <button
                type="button"
                class="ph-select__opt"
                role="option"
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex="-1"
                data-value={o.value}
                style={`--i: ${i}`}
              >
                <span>{o.label}</span>
                <svg class="ph-select__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
              </button>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>

  {/* Tarjetas con la pieza `.ph-player` de ph-ui.css (la misma de la portada): al
      pasar el ratón se eleva y la foto crece un poco. No son clicables (CLAUDE.md). */}
  <ul class="talents__grid" role="list" data-talents-grid>
    {cards.map(({ player, badges }, idx) => (
      <li
        class="ph-player talents__item"
        data-talent-card
        data-name={player.name}
        data-role={player.role}
        data-index={idx}
      >
        <div class="ph-player__photo">
          <picture>
            {player.photoSrcsetAvif && (
              <source type="image/avif" srcset={player.photoSrcsetAvif} sizes={photoSizes} />
            )}
            <img
              src={player.photoSrc}
              srcset={player.photoSrcset || undefined}
              sizes={photoSizes}
              alt={player.name}
              loading="lazy"
              decoding="async"
              width="480"
              height="640"
            />
          </picture>
        </div>
        {badges.length > 0 && (
          <div class="ph-player__badges" aria-hidden="true">
            {badges.map(({ code, src }) => (
              <img
                src={src}
                alt=""
                width="22"
                height="22"
                loading="lazy"
                decoding="async"
                data-national-code={code}
              />
            ))}
          </div>
        )}
        <div class="ph-player__meta">
          <span class="ph-player__name">{player.name}</span>
          {player.subtitle && <span class="ph-player__club">{player.subtitle}</span>}
        </div>
      </li>
    ))}
  </ul>

  <div class="talents__empty" data-talents-empty role="status" hidden>
    <p class="talents__empty-text">{t('talents.empty.filter')}</p>
    <button type="button" class="talents__reset" data-talents-reset>
      {t('talents.reset')}
    </button>
  </div>
</section>

<style>
  .talents {
    position: relative;
    padding: var(--ph-head-top) var(--ph-section-px, clamp(20px, 4vw, 48px)) clamp(80px, 12vw, 140px);
    /* Transparente: el fondo es la luz animada de toda la página (`.ph-page-bg`). */
    background: transparent;
    color: var(--color-ph-white, #ffffff);
  }

  .talents__head,
  .talents__controls,
  .talents__grid,
  .talents__empty { position: relative; z-index: 1; }

  /* Cabecera igual en Talentos, Servicios y Sobre nosotros (estilos y cifras en
     global.css: `.ph-head-*`): titular y entradilla debajo. Los controles y las primeras tarjetas caben ya en la primera pantalla. */
  .talents__title em {
    color: var(--color-ph-gold, #d6b25e);
    font-style: italic;
    font-weight: 400;
  }

  /* ── Barra de controles ─────────────────────────────────────────────────────
     Buscador a la izquierda y los dos desplegables a la derecha, todos a 44 px de
     alto (lo mínimo cómodo para el dedo). `z-index: 2` para que las listas abiertas
     pasen por encima de las tarjetas. */
  .talents__controls {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 0;
    margin-top: var(--ph-head-after);
    margin-bottom: clamp(8px, calc(0.76vw + 5px), 16px);
    border-top: 1px solid var(--color-ph-line, rgba(255, 255, 255, 0.12));
  }
  /* Los desplegables se quedan a la derecha también cuando el buscador de móvil
     sale del flujo al abrirse. */
  .talents__controls > .talents__select:first-of-type { margin-left: auto; }

  /* Buscador: campo de Mochi. El filo es una sombra interior para que, al enfocar,
     pase de 1 px gris a 2 px dorado con el mismo muelle (como `TextField`). */
  .talents__search {
    position: relative;
    flex: 1 1 280px;
    max-width: 520px;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 6px 0 13px;
    box-sizing: border-box;
    border-radius: var(--ph-r-btn);
    /* Campo relleno, sin filo: el anillo solo aparece con el foco. */
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 0 transparent;
    cursor: text;
    transition:
      box-shadow var(--mochi-duration-snappy) var(--mochi-ease-snappy),
      background-color var(--mochi-duration-color) var(--mochi-ease-color);
  }
  @media (hover: hover) {
    .talents__search:hover { background: rgba(255, 255, 255, 0.09); }
  }
  .talents__search:focus-within {
    box-shadow: inset 0 0 0 2px var(--mochi-focus-ring);
  }
  .talents__search-icon {
    width: 18px;
    height: 18px;
    color: var(--ph-ink-meta);
  }
  .talents__search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    padding: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-ph-white, #ffffff);
    font: 400 15px/1.2 var(--font-display);
    letter-spacing: -0.003em;
  }
  /* En pantallas táctiles, 16 px: por debajo, iOS amplía la página al enfocar. */
  @media (pointer: coarse) {
    .talents__search-input { font-size: 16px; }
  }
  .talents__search-input::placeholder { color: var(--ph-ink-meta); opacity: 1; }
  /* Fuera los adornos nativos del campo de búsqueda: los botones son los nuestros. */
  .talents__search-input::-webkit-search-decoration,
  .talents__search-input::-webkit-search-cancel-button,
  .talents__search-input::-webkit-search-results-button,
  .talents__search-input::-webkit-search-results-decoration {
    appearance: none;
  }

  /* Botones dentro del campo (limpiar y, en móvil, cerrar): 32 px a 6 px del borde,
     con esquinas concéntricas a las del campo. */
  .talents__search-btn {
    all: unset;
    box-sizing: border-box;
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--ph-r-xs);
    color: var(--ph-ink-meta);
    cursor: pointer;
    transition:
      background-color var(--mochi-duration-color) var(--mochi-ease-color),
      color var(--mochi-duration-color) var(--mochi-ease-color),
      transform var(--mochi-duration-snappy) var(--mochi-ease-snappy);
  }
  .talents__search-btn .ph-ico { width: 16px; height: 16px; }
  @media (hover: hover) {
    .talents__search-btn:hover { background: rgba(255, 255, 255, 0.07); color: var(--color-ph-white); }
  }
  .talents__search-btn:active {
    transform: scale(0.965);
    transition-duration: var(--mochi-duration-press);
    transition-timing-function: var(--mochi-ease-press);
  }
  .talents__search-btn:focus-visible { outline: 2px solid var(--mochi-focus-ring); outline-offset: 1px; }
  /* La X de limpiar aparece al escribir: entra con desenfoque corto. */
  .talents__search-clear { animation: talentsBtnIn var(--mochi-duration-snappy) var(--mochi-ease-snappy) both; }
  /* «Cerrar» solo existe en el buscador desplegado de móvil. */
  .talents__search-close { display: none; }

  @keyframes talentsBtnIn {
    from { opacity: 0; scale: 0.8; filter: blur(4px); }
    to { opacity: 1; scale: 1; filter: blur(0); }
  }

  /* Desplegables: la pieza compartida a 44 px de alto, a juego con el buscador. La
     fila de arriba de la lista abierta se recoloca para caer justo donde estaba el
     texto del botón; las opciones no llevan bandera, así que van en dos columnas. */
  .talents__select { flex: none; }
  .talents__select .ph-select__btn { height: 44px; }
  .talents__select .ph-select__current { height: 30px; }
  .talents__select .ph-select__opt { grid-template-columns: 1fr 16px; }

  /* ── Móvil: el buscador se pliega a la lupa y crece hasta ser la barra ──────
     Plegado es un cuadro de 44 px. Al tocarlo pasa a cubrir la barra entera y el
     recorte se abre desde ese cuadro con el muelle «morph»; el campo y la X entran
     60 ms después con desenfoque. Al cerrar se recoge al mismo cuadro y solo
     entonces vuelve a su sitio (`is-closing`, ver el script). */
  @media (max-width: 720px) {
    .talents__search {
      flex: 0 0 44px;
      width: 44px;
      padding: 0;
      gap: 0;
      justify-content: center;
      cursor: pointer;
      /* En el cuadro de 44 px este recorte no quita nada; en la barra abierta deja
         ver solo su primer cuadro, y desde ahí se anima. */
      clip-path: inset(0 calc(100% - 44px) 0 0 round var(--ph-r-btn));
      transition:
        clip-path var(--mochi-duration-morph) var(--mochi-ease-morph),
        box-shadow var(--mochi-duration-snappy) var(--mochi-ease-snappy),
        background-color var(--mochi-duration-color) var(--mochi-ease-color);
    }
    .talents__search .talents__search-input,
    .talents__search .talents__search-btn {
      display: none;
    }

    .talents__search.is-open,
    .talents__search.is-closing {
      position: absolute;
      top: 16px;
      left: 0;
      right: 0;
      z-index: 4;
      width: auto;
      padding: 0 6px 0 13px;
      gap: 10px;
      justify-content: flex-start;
      cursor: text;
      background: var(--mochi-solid);
    }
    .talents__search.is-open { clip-path: inset(0 0 0 0 round var(--ph-r-btn)); }
    .talents__search.is-open .talents__search-input,
    .talents__search.is-closing .talents__search-input { display: block; }
    .talents__search.is-open .talents__search-btn,
    .talents__search.is-closing .talents__search-btn { display: inline-grid; }

    .talents__search.is-open .talents__search-input,
    .talents__search.is-open .talents__search-close {
      animation: talentsSearchIn var(--mochi-duration-fade-in) var(--mochi-ease-fade-in) 60ms both;
    }
    .talents__search.is-closing .talents__search-input,
    .talents__search.is-closing .talents__search-btn {
      animation: talentsSearchOut var(--mochi-duration-fade-out) var(--mochi-ease-fade-out) both;
    }
  }

  @keyframes talentsSearchIn {
    from { opacity: 0; filter: blur(6px); translate: -6px 0; }
    to { opacity: 1; filter: blur(0); translate: 0 0; }
  }
  @keyframes talentsSearchOut {
    from { opacity: 1; filter: blur(0); }
    to { opacity: 0; filter: blur(4px); }
  }

  /* ── Rejilla: 2 → 3 → 5 columnas ─────────────────────────────────────────── */
  .talents__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1.5vw, 16px);
  }
  @media (min-width: 720px) {
    .talents__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  }
  @media (min-width: 1200px) {
    .talents__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; }
  }

  .talents__item { margin: 0; }
  /* Sin caja propia: la foto se mide contra `.ph-player__photo`, como sin <picture>. */
  .talents__item picture { display: contents; }

  /* ── Sin resultados: tarjeta con el botón para volver a empezar ──────────── */
  .talents__empty {
    display: grid;
    justify-items: center;
    gap: 18px;
    /* Ocupa el sitio donde empezarían las tarjetas. */
    margin: 0;
    padding: clamp(32px, 4vw, 48px) 24px;
    text-align: center;
    background: var(--mochi-surface);
    border-radius: var(--ph-r-lg);
    box-shadow: var(--mochi-shadow-surface);
  }
  .talents__empty-text {
    margin: 0;
    max-width: 44ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ph-ink-body);
  }
  /* Botón en tono «solid» de Mochi: se aclara y su sombra crece al pasar el ratón;
     se hunde al pulsar. */
  .talents__reset {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    border-radius: var(--ph-r-btn);
    background: var(--mochi-solid);
    color: var(--color-ph-white);
    box-shadow: var(--mochi-shadow-surface);
    font: 500 15px/1 var(--font-display);
    letter-spacing: -0.005em;
    cursor: pointer;
    transition:
      transform var(--mochi-duration-snappy) var(--mochi-ease-snappy),
      background-color var(--mochi-duration-color) var(--mochi-ease-color),
      box-shadow var(--mochi-duration-morph) var(--mochi-ease-morph);
  }
  @media (hover: hover) {
    .talents__reset:hover { background: #292d34; box-shadow: var(--ph-sh-raise); }
  }
  .talents__reset:active {
    transform: scale(0.965);
    transition-duration: var(--mochi-duration-press);
    transition-timing-function: var(--mochi-ease-press);
  }
  .talents__reset:focus-visible { outline: 2px solid var(--mochi-focus-ring); outline-offset: 3px; }

  /* «Reducir movimiento»: todo salta a su estado final. */
  @media (prefers-reduced-motion: reduce) {
    .talents__search,
    .talents__search-btn,
    .talents__reset {
      transition-duration: 1ms !important;
      transition-delay: 0ms !important;
    }
    .talents__search-clear,
    .talents__search .talents__search-input,
    .talents__search .talents__search-btn {
      animation: none !important;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  type SortMode = 'default' | 'az' | 'za';
  type RoleFilter = 'all' | 'player' | 'coach';

  function normalize(s: string): string {
    return s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
  }

  function isMobile(): boolean {
    return window.matchMedia('(max-width: 720px)').matches;
  }

  /** Duración del muelle «morph» de Mochi en ms (0 con «reducir movimiento»). */
  function morphMs(): number {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return 0;
    const v = getComputedStyle(document.documentElement).getPropertyValue('--mochi-duration-morph');
    return parseFloat(v) || 0;
  }

  /** Marca como elegida la opción `value` de un desplegable `.ph-select`. Al abrirlo,
   *  ph-motion.ts lee `aria-selected` para colocar el resaltado y el foco. */
  function setSelectValue(sel: HTMLElement, value: string): void {
    sel.querySelectorAll<HTMLElement>('.ph-select__opt').forEach((o) => {
      o.setAttribute('aria-selected', String(o.dataset.value === value));
    });
  }

  function selectedValue(e: Event): string {
    return (e as CustomEvent<{ value?: string }>).detail?.value ?? '';
  }

  function initTalents(): void {
    const controls = document.querySelector<HTMLElement>('[data-talents-controls]');
    const grid = document.querySelector<HTMLUListElement>('[data-talents-grid]');
    const empty = document.querySelector<HTMLElement>('[data-talents-empty]');
    if (!controls || !grid || !empty) return;

    const searchWrap = controls.querySelector<HTMLLabelElement>('[data-talents-search-wrap]');
    const search = controls.querySelector<HTMLInputElement>('[data-talents-search]');
    const clearBtn = controls.querySelector<HTMLButtonElement>('[data-talents-clear]');
    const closeBtn = controls.querySelector<HTMLButtonElement>('[data-talents-search-close]');
    const roleSel = controls.querySelector<HTMLElement>('[data-talents-select="role"]');
    const sortSel = controls.querySelector<HTMLElement>('[data-talents-select="sort"]');
    const reset = empty.querySelector<HTMLButtonElement>('[data-talents-reset]');
    if (!searchWrap || !search || !clearBtn || !closeBtn || !roleSel || !sortSel || !reset) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-talent-card]'));
    let currentRole: RoleFilter = 'all';

    function applySort(mode: SortMode): void {
      const sorted = [...cards].sort((a, b) => {
        if (mode === 'default') {
          return Number(a.dataset.index) - Number(b.dataset.index);
        }
        const cmp = (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', undefined, { sensitivity: 'base' });
        return mode === 'az' ? cmp : -cmp;
      });
      for (const card of sorted) grid!.appendChild(card);
    }

    function applyFilter(query: string): void {
      const norm = normalize(query.trim());
      let visible = 0;
      for (const card of cards) {
        const name = card.dataset.name ?? '';
        const r = card.dataset.role ?? 'player';
        const nameMatch = !norm || normalize(name).includes(norm);
        const roleMatch = currentRole === 'all' || currentRole === r;
        const match = nameMatch && roleMatch;
        card.hidden = !match;
        if (match) visible++;
      }
      empty!.hidden = visible > 0;
    }

    function syncClearBtn(): void {
      clearBtn!.hidden = search!.value.length === 0;
    }

    /* Buscador de móvil. Abrir: `is-open` lo saca a cubrir la barra y su recorte se
       abre con una transición (interrumpible). Cerrar: `is-closing` lo mantiene
       encima mientras el recorte se recoge a la lupa; al terminar, vuelve al flujo.
       Se mide con la duración del muelle y no con `transitionend`, que también
       llega burbujeando desde los hijos (CLAUDE.md, «animationend burbujea»). */
    let closeTimer = 0;

    function openSearch(): void {
      window.clearTimeout(closeTimer);
      searchWrap!.classList.remove('is-closing');
      searchWrap!.classList.add('is-open');
      requestAnimationFrame(() => search!.focus());
    }

    function closeSearch(): void {
      if (!searchWrap!.classList.contains('is-open')) return;
      search!.blur();
      searchWrap!.classList.remove('is-open');
      searchWrap!.classList.add('is-closing');
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        searchWrap!.classList.remove('is-closing');
      }, morphMs() + 40);
    }

    search.addEventListener('input', () => {
      syncClearBtn();
      applyFilter(search.value);
    });

    clearBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      search.value = '';
      syncClearBtn();
      applyFilter('');
      search.focus();
    });

    /* Móvil: tocar la lupa plegada despliega el buscador. */
    searchWrap.addEventListener('click', (e) => {
      if (!isMobile()) return;
      if (searchWrap.classList.contains('is-open')) return;
      e.preventDefault();
      openSearch();
    });

    closeBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      search.value = '';
      syncClearBtn();
      applyFilter('');
      closeSearch();
    });

    search.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && searchWrap.classList.contains('is-open')) {
        e.preventDefault();
        closeSearch();
      }
    });

    /* Los desplegables los abre, recorre y cierra ph-motion.ts (ratón y teclado);
       aquí solo se escucha la opción elegida. */
    roleSel.addEventListener('ph:select', (e) => {
      const value = selectedValue(e);
      currentRole = value === 'player' || value === 'coach' ? value : 'all';
      applyFilter(search.value);
    });

    sortSel.addEventListener('ph:select', (e) => {
      const value = selectedValue(e);
      applySort(value === 'az' || value === 'za' ? value : 'default');
    });

    reset.addEventListener('click', () => {
      search.value = '';
      currentRole = 'all';
      setSelectValue(roleSel, 'all');
      setSelectValue(sortSel, 'default');
      syncClearBtn();
      applyFilter('');
      applySort('default');
      closeSearch();
      search.focus();
    });

    syncClearBtn();
  }

  document.addEventListener('astro:page-load', initTalents);
</script>

<script>
  // Fondo animado de la página (se inicia solo en cada astro:page-load).
  import '@/scripts/ph-ambient';
</script>
