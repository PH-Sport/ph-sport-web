---
/**
 * Botón-enlace de PHSPORT: lleva a otra página, al correo o a una sección. Es un
 * enlace de verdad (se abre en otra pestaña, se copia, funciona sin JavaScript).
 *
 * Sustituye al `LinkButton` de Mochi desde el 2026-10-02 con el mismo aspecto y
 * movimiento: recuadro opaco sin filo y con sombra, que al pasar el ratón se aclara
 * y su sombra crece, la flecha avanza 3 px, y al pulsar se encoge un poco con el
 * muelle «press». Por qué ya no es de Mochi: DECISIONS.md (2026-10-02).
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  /** `surface`: recuadro gris oscuro. `accent`: dorado, para la acción principal. */
  variant?: 'surface' | 'accent';
  /** Alto: 36 px (`sm`), 44 px (`md`) o 56 px (`lg`). */
  size?: 'sm' | 'md' | 'lg';
  /** Flecha a la derecha del texto, para los enlaces que llevan a otra página. */
  arrow?: boolean;
}

const { href, variant = 'surface', size = 'md', arrow = false, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['ph-btn', className]} data-variant={variant} data-size={size} {...rest}>
  <span class="ph-btn__label">
    <slot />
    {arrow && (
      <svg class="ph-btn__arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.92" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    )}
  </span>
</a>

<style>
  .ph-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    margin: 0;
    padding: 0 20px;
    border: 0;
    border-radius: var(--ph-r-btn);
    overflow: hidden;
    isolation: isolate;
    /* Pesos de Mochi. Söhne no tiene 500 ni 520 (pinta 400 y 600), pero no se
       redondean: las letras acentuadas salen de Helvetica (la Söhne servida no las
       trae, docs/hallazgos-abiertos.md), y Helvetica sí tiene 500. */
    font: 500 15px/20px var(--ph-font-sans);
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
    vertical-align: middle;
    cursor: pointer;
    transform-origin: 50% 50%;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--ph-duration-snappy) var(--ph-ease-snappy),
      box-shadow var(--ph-duration-morph) var(--ph-ease-morph),
      background-color var(--ph-duration-color) var(--ph-ease-color);
  }
  .ph-btn[data-size='sm'] { height: 36px; padding: 0 16px; border-radius: var(--ph-r-btn-sm); font: 520 13px/16px var(--ph-font-sans); }
  .ph-btn[data-size='lg'] { height: 56px; padding: 0 26px; border-radius: var(--ph-r-btn-lg); font: 520 17px/22px var(--ph-font-sans); }

  .ph-btn[data-variant='surface'] { background: var(--ph-surface); color: var(--ph-on-surface); box-shadow: var(--ph-sh-surface); }
  .ph-btn[data-variant='accent'] { background: var(--ph-accent); color: var(--ph-on-accent); box-shadow: var(--ph-sh-accent); }

  .ph-btn:active {
    transform: scale(0.965);
    transition-duration: var(--ph-duration-press);
    transition-timing-function: var(--ph-ease-press);
  }
  .ph-btn:focus-visible { outline: 2px solid var(--ph-focus-ring); outline-offset: 3px; }

  .ph-btn__label { display: inline-flex; align-items: center; gap: 8px; }

  @media (hover: hover) {
    /* Al pasar el ratón, el recuadro se aclara y su sombra crece. */
    .ph-btn[data-variant='surface']:hover { background: var(--ph-solid); box-shadow: var(--ph-sh-raise); }
    .ph-btn[data-variant='accent']:hover { background: var(--ph-accent-strong); box-shadow: var(--ph-sh-accent-raise); }
    .ph-btn__arrow { transition: transform var(--ph-duration-snappy) var(--ph-ease-snappy); }
    .ph-btn:hover .ph-btn__arrow { transform: translateX(3px); }
  }
</style>
