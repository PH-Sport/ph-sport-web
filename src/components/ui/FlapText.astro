---
/**
 * Un texto con sus cifras en paletas del marcador: «21 INTEGRANTES · 7 PAÍSES»
 * pinta 21 y 7 como `Flap` y el resto como texto. El texto no cambia; solo cómo
 * se dibujan los números.
 */
import Flap from './Flap.astro';

interface Props {
  text: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { text, size = 'sm' } = Astro.props;
const parts = text.split(/(\d+)/).filter((p) => p.length > 0);
---

{parts.map((part) => (/^\d+$/.test(part) ? <Flap value={part} size={size} /> : <span>{part}</span>))}
