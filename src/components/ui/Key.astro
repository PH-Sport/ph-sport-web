---
/**
 * Tecla: el botón-enlace de la web. Al pasar el ratón la palabra rueda y la
 * flecha sale y vuelve a entrar en la diagonal del logo; al pulsar se hunde.
 * Estilos `.ph-key` en global.css.
 *
 * La palabra va dos veces para poder rodar; la segunda copia está oculta a los
 * lectores de pantalla, que leen el enlace una sola vez.
 */
interface Props {
  href: string;
  label: string;
  tone?: 'default' | 'gold';
  hreflang?: string;
  class?: string;
}

const { href, label, tone = 'default', hreflang, class: className } = Astro.props;
---

<a href={href} hreflang={hreflang} class:list={['ph-key', tone === 'gold' && 'ph-key--gold', className]}>
  <span class="ph-key__label">
    <span class="ph-key__text">{label}</span>
    <span class="ph-key__text" aria-hidden="true">{label}</span>
  </span>
  <span class="ph-key__arrow" aria-hidden="true">
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" /></svg>
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" /></svg>
  </span>
</a>
