---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { useTranslations, type Lang } from '@/i18n/utils';
import { SITE_URL } from '@/lib/constants';

const lang: Lang = 'es';
const t = useTranslations(lang);

// `hasHero`: el hueco de la cabecera flotante lo pone la propia página con
// `--ph-head-top`, igual que Talentos, Servicios y Sobre nosotros, para que la
// fila índice caiga en el mismo sitio al pasar de una a otra.
---

<BaseLayout
  title={`${t('legal.title')} — ${t('site.name')}`}
  description={t('legal.description')}
  lang={lang}
  canonical={`${SITE_URL}/aviso-legal`}
  hasHero
>
  <article class="legal" aria-labelledby="legal-title">
    <header class="legal__head">
      <p class="ph-rowline">
        <span class="ph-rowline__group">
          <span class="ph-rowline__label">Legal</span>
        </span>
        <span class="ph-rowline__meta legal__updated">Última actualización: junio de 2026</span>
      </p>
      <h1 id="legal-title" class="ph-head-title legal__title">Aviso Legal</h1>
    </header>

    <div class="legal__body">

      <section class="legal__section">
        <h2><span class="legal__num">01.</span> Titular del sitio web</h2>
        <p>En cumplimiento del artículo 10 de la Ley 34/2002 de Servicios de la Sociedad de la Información y del Comercio Electrónico (LSSI-CE), se comunican los datos identificativos del titular:</p>
        <dl class="legal__facts">
          <div class="legal__fact">
            <dt>Razón social</dt>
            <dd>MANAGEMENTPH REPRESENTACIÓN DE DEPORTISTAS, S.L.</dd>
          </div>
          <div class="legal__fact">
            <dt>CIF</dt>
            <dd>B02645448</dd>
          </div>
          <div class="legal__fact">
            <dt>Domicilio social</dt>
            <dd>Calle Picasso n.º 13, 28691 Villanueva de la Cañada, Madrid (España)</dd>
          </div>
          <div class="legal__fact">
            <dt>Email</dt>
            <dd><a href="mailto:info@phsport.es" class="legal__link">info@phsport.es</a></dd>
          </div>
          <div class="legal__fact">
            <dt>Actividad</dt>
            <dd>Representación y gestión de futbolistas y entrenadores</dd>
          </div>
        </dl>
      </section>

      <section class="legal__section">
        <h2><span class="legal__num">02.</span> Objeto</h2>
        <p>Este sitio web tiene por finalidad la presentación de los servicios de representación deportiva de PHSPORT, agencia especializada en la gestión integral de futbolistas y entrenadores.</p>
      </section>

      <section class="legal__section">
        <h2><span class="legal__num">03.</span> Propiedad intelectual e industrial</h2>
        <p>Los contenidos del sitio web —incluyendo textos, imágenes, diseño gráfico y código fuente— son propiedad de MANAGEMENTPH REPRESENTACIÓN DE DEPORTISTAS, S.L. o de terceros que han autorizado su uso. Queda prohibida su reproducción, distribución, comunicación pública o transformación, total o parcial, sin autorización escrita del titular.</p>
      </section>

      <section class="legal__section">
        <h2><span class="legal__num">04.</span> Limitación de responsabilidad</h2>
        <p>PHSPORT no garantiza la disponibilidad continua del sitio web ni se responsabiliza de posibles daños derivados de su uso o de la información publicada. Los enlaces a sitios de terceros son responsabilidad exclusiva de sus respectivos titulares.</p>
      </section>

      <section class="legal__section">
        <h2><span class="legal__num">05.</span> Legislación aplicable y jurisdicción</h2>
        <p>Este aviso legal se rige por la legislación española. Para cualquier controversia derivada del uso del sitio, las partes se someten a los juzgados y tribunales de Madrid, con renuncia expresa a cualquier otro fuero.</p>
      </section>

    </div>
  </article>
</BaseLayout>

<style>
  /* Página de lectura con el lenguaje de las demás: fila índice, titular y una
     columna de texto cómoda. Los mismos estilos van repetidos en las cuatro
     páginas legales (aviso y privacidad, en español e inglés) a propósito: son
     páginas sueltas y así cada una se entiende sin abrir otro archivo. Si se
     cambia uno, cambiar los cuatro. */
  .legal {
    padding: var(--ph-head-top) var(--ph-section-px) clamp(80px, calc(5.7vw + 58px), 140px);
  }

  /* El dato de la derecha es una frase en minúsculas, no un valor en mayúsculas:
     sin el espaciado extra de `.ph-rowline__meta`. */
  .legal__updated {
    letter-spacing: 0.01em;
  }

  /* Más contenido que las cabeceras de sección: el titular aquí es una etiqueta
     de documento, no un lema. Cabe en una línea en escritorio. */
  .legal__title {
    max-width: 16em;
    font-size: clamp(40px, calc(3.05vw + 28px), 72px);
    line-height: 1;
  }

  /* Columna de lectura: ~64 caracteres a 16–17 px. El tamaño va en la columna
     para que `ch` mida con la letra del texto. */
  .legal__body {
    max-width: 64ch;
    margin-top: var(--ph-head-after);
    font-size: clamp(16px, calc(0.1vw + 15.6px), 17px);
    line-height: 1.7;
    color: var(--ph-ink-body);
  }

  .legal__section + .legal__section {
    margin-top: clamp(44px, calc(1.5vw + 38px), 64px);
  }

  /* Subtítulo: más aire arriba (entre apartados) que abajo (hasta su texto). El
     número va en mono dorado, como en el resto de la web; el texto del título no
     cambia, solo se le da estilo a su principio. */
  .legal__section h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, calc(0.38vw + 18.5px), 24px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ph-white);
  }
  .legal__num {
    flex: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ph-gold);
  }

  .legal__section p {
    max-width: none;
    margin: 0;
    color: inherit;
    text-wrap: pretty;
  }
  .legal__section p + p {
    margin-top: 1em;
  }
  /* Citas dentro del texto (el asunto del email en Privacidad): ya llevan
     comillas, así que sin cursiva; solo un punto más de luz. */
  .legal__section em {
    font-style: normal;
    color: var(--ph-ink-lead);
  }

  /* Datos de la empresa en una tarjeta, como el resto de superficies de la web. */
  .legal__facts {
    margin: 22px 0 0;
    padding: 4px clamp(18px, calc(0.57vw + 15.8px), 24px);
    background: var(--mochi-surface);
    border: 1px solid var(--mochi-surface-border);
    border-radius: var(--ph-r-lg);
    box-shadow: var(--mochi-shadow-surface);
  }
  .legal__section h2 + .legal__facts {
    margin-top: 0;
  }
  .legal__fact {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: 4px 20px;
    padding: 14px 0;
  }
  .legal__fact + .legal__fact {
    border-top: 1px solid var(--mochi-surface-border);
  }
  .legal__fact dt {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ph-ink-meta);
  }
  .legal__fact dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ph-ink-lead);
    overflow-wrap: anywhere;
  }

  /* Enlaces subrayados con el subrayado algo separado del texto; al pasar el
     ratón el subrayado se enciende en vez de cambiar el texto. */
  .legal__link {
    color: var(--color-ph-gold);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: rgba(214, 178, 94, 0.45);
    border-radius: 2px;
    transition: text-decoration-color var(--mochi-duration-color) var(--mochi-ease-color);
  }
  .legal__link:focus-visible {
    outline: 2px solid var(--mochi-focus-ring);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .legal__link:hover {
      text-decoration-color: currentColor;
    }
  }

  @media (max-width: 540px) {
    .legal__fact {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal__link {
      transition-duration: 1ms;
    }
  }
</style>
