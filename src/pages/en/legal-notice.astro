---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { useTranslations, type Lang } from '@/i18n/utils';
import { SITE_URL } from '@/lib/constants';

const lang: Lang = 'en';
const t = useTranslations(lang);

// `hasHero`: el hueco de la cabecera flotante lo pone la propia página con
// `--ph-head-top`, igual que Talentos, Servicios y Sobre nosotros, para que el
// titular caiga en el mismo sitio al pasar de una a otra.
---

<BaseLayout
  title={`${t('legal.title')} — ${t('site.name')}`}
  description={t('legal.description')}
  lang={lang}
  canonical={`${SITE_URL}/en/legal-notice`}
  hasHero
  ambient={false}
>
  <article class="legal" aria-labelledby="legal-title">
    <header class="legal__head">
      <h1 id="legal-title" class="ph-head-title legal__title">Legal Notice</h1>
      <p class="legal__updated">Last updated: June 2026</p>
    </header>

    <div class="legal__body">

      <section class="legal__section">
        <h2><span class="legal__num">01.</span> Website owner</h2>
        <p>In compliance with Article 10 of Spanish Law 34/2002 on Information Society Services and Electronic Commerce (LSSI-CE), the following identification details of the website owner are provided:</p>
        <dl class="legal__facts">
          <div class="legal__fact">
            <dt>Company name</dt>
            <dd>MANAGEMENTPH REPRESENTACIÓN DE DEPORTISTAS, S.L.</dd>
          </div>
          <div class="legal__fact">
            <dt>Tax ID (CIF)</dt>
            <dd>B02645448</dd>
          </div>
          <div class="legal__fact">
            <dt>Registered address</dt>
            <dd>Calle Picasso n.º 13, 28691 Villanueva de la Cañada, Madrid (Spain)</dd>
          </div>
          <div class="legal__fact">
            <dt>Email</dt>
            <dd><a href="mailto:info@phsport.es" class="legal__link">info@phsport.es</a></dd>
          </div>
          <div class="legal__fact">
            <dt>Activity</dt>
            <dd>Representation and management of football players and coaches</dd>
          </div>
        </dl>
      </section>

      <section class="legal__section">
        <h2><span class="legal__num">02.</span> Purpose</h2>
        <p>This website presents the sports representation services offered by PHSPORT, an agency specialising in the comprehensive management of football players and coaches.</p>
      </section>

      <section class="legal__section">
        <h2><span class="legal__num">03.</span> Intellectual and industrial property</h2>
        <p>The contents of this website —including texts, images, graphic design and source code— are the property of MANAGEMENTPH REPRESENTACIÓN DE DEPORTISTAS, S.L. or of third parties who have authorised their use. Any reproduction, distribution, public communication or transformation, in whole or in part, without written authorisation from the owner is strictly prohibited.</p>
      </section>

      <section class="legal__section">
        <h2><span class="legal__num">04.</span> Limitation of liability</h2>
        <p>PHSPORT does not guarantee the continuous availability of the website and accepts no responsibility for any damage arising from its use or the information published therein. Links to third-party websites are the sole responsibility of their respective owners.</p>
      </section>

      <section class="legal__section">
        <h2><span class="legal__num">05.</span> Applicable law and jurisdiction</h2>
        <p>This legal notice is governed by Spanish law. For any dispute arising from the use of this website, the parties submit to the courts and tribunals of Madrid, expressly waiving any other jurisdiction that may apply to them.</p>
      </section>

    </div>
  </article>
</BaseLayout>

<style>
  /* Página de lectura con el lenguaje de las demás: titular, fecha de
     actualización y una columna de texto cómoda. Los mismos estilos van repetidos en las cuatro
     páginas legales (aviso y privacidad, en español e inglés) a propósito: son
     páginas sueltas y así cada una se entiende sin abrir otro archivo. Si se
     cambia uno, cambiar los cuatro. */
  .legal {
    padding: var(--ph-head-top) var(--ph-section-px) clamp(80px, calc(5.7vw + 58px), 140px);
  }

  /* La fecha de actualización, bajo el título como una línea normal: es dato
     legal, no un rótulo. */
  .legal__updated {
    margin: 16px 0 0;
    font-size: 14px;
    color: var(--ph-ink-meta);
  }

  /* Más contenido que las cabeceras de sección: el titular aquí es una etiqueta
     de documento, no un lema. Cabe en una línea en escritorio. */
  .legal__title {
    max-width: 16em;
    font-size: clamp(40px, calc(3.05vw + 28px), 72px);
    line-height: 1;
  }

  /* Columna de lectura: ~64 caracteres a 16–17 px. El tamaño va en la columna
     para que `ch` mida con la letra del texto. */
  .legal__body {
    max-width: 64ch;
    margin-top: var(--ph-head-after);
    font-size: clamp(16px, calc(0.1vw + 15.6px), 17px);
    line-height: 1.7;
    color: var(--ph-ink-body);
  }

  .legal__section + .legal__section {
    margin-top: clamp(44px, calc(1.5vw + 38px), 64px);
  }

  /* Subtítulo: más aire arriba (entre apartados) que abajo (hasta su texto). El
     número va en mono dorado, como en el resto de la web; el texto del título no
     cambia, solo se le da estilo a su principio. */
  .legal__section h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, calc(0.38vw + 18.5px), 24px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ph-white);
  }
  /* El número del apartado, en la letra del título y más apagado. */
  .legal__num {
    flex: none;
    font-variant-numeric: tabular-nums;
    color: var(--ph-ink-meta);
  }

  .legal__section p {
    max-width: none;
    margin: 0;
    color: inherit;
    text-wrap: pretty;
  }
  .legal__section p + p {
    margin-top: 1em;
  }
  /* Citas dentro del texto (el asunto del email en Privacidad): ya llevan
     comillas, así que sin cursiva; solo un punto más de luz. */
  .legal__section em {
    font-style: normal;
    color: var(--ph-ink-lead);
  }

  /* Datos de la empresa en una tarjeta, como el resto de superficies de la web. */
  /* Los datos de la empresa, como una lista con líneas finas sobre el fondo: es
     texto para leer, no algo que se toca, así que no va en tarjeta. */
  .legal__facts {
    margin: 22px 0 0;
    padding: 0;
    border-top: 1px solid var(--mochi-surface-border);
    border-bottom: 1px solid var(--mochi-surface-border);
  }
  .legal__section h2 + .legal__facts {
    margin-top: 0;
  }
  .legal__fact {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: 4px 20px;
    padding: 14px 0;
  }
  .legal__fact + .legal__fact {
    border-top: 1px solid var(--mochi-surface-border);
  }
  .legal__fact dt {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ph-ink-meta);
  }
  .legal__fact dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ph-ink-lead);
    overflow-wrap: anywhere;
  }

  /* Enlaces subrayados con el subrayado algo separado del texto; al pasar el
     ratón el subrayado se enciende en vez de cambiar el texto. */
  .legal__link {
    color: var(--color-ph-gold);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: rgba(214, 178, 94, 0.45);
    border-radius: 2px;
    transition: text-decoration-color var(--mochi-duration-color) var(--mochi-ease-color);
  }
  .legal__link:focus-visible {
    outline: 2px solid var(--mochi-focus-ring);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .legal__link:hover {
      text-decoration-color: currentColor;
    }
  }

  @media (max-width: 540px) {
    .legal__fact {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal__link {
      transition-duration: 1ms;
    }
  }
</style>
