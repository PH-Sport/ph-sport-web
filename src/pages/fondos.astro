---
/**
 * Muestrario de fondos animados: cada fondo a pantalla completa, sin nada encima,
 * y una barra para cambiar de uno a otro. Solo existe en la rama
 * `feat/muestrario-fondos` (DECISIONS.md, 2026-10-06): no es una página de la web,
 * no está enlazada y no se indexa. El motor está en
 * `src/scripts/ph-fondos-muestrario.ts`.
 */
import '@/styles/global.css';

/** En el orden de la barra (y de las teclas 1-7). `donde`: en qué versión sale. */
const fondos = [
  { id: 'velo', nombre: 'Velo', donde: 'A' },
  { id: 'neon', nombre: 'Neón', donde: 'A' },
  { id: 'trayectorias', nombre: 'Trayectorias', donde: 'A · C' },
  { id: 'estructura', nombre: 'Estructura', donde: 'A' },
  { id: 'calidez', nombre: 'Calidez', donde: 'A · C' },
  { id: 'proyeccion', nombre: 'Proyección', donde: 'B' },
  { id: 'estructura-c', nombre: 'Estructura', donde: 'C' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0d0f12" />
    <title>Fondos — PHSPORT</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="fondos">
    {/* La cuadrícula de la variante C: solo con su «Estructura», que la enciende. */}
    <div class="fondos__grid" data-fondos-grid aria-hidden="true" hidden></div>
    <canvas class="fondos__canvas" data-fondos-canvas aria-hidden="true"></canvas>

    <p class="fondos__aviso" role="status">Este navegador no puede dibujar los fondos (le falta WebGL2).</p>

    <nav class="fondos__bar" aria-label="Fondos" data-fondos-bar>
      {fondos.map((f, i) => (
        <button type="button" class="fondos__opt" data-fondo={f.id} data-nombre={f.nombre} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="fondos__name">{f.nombre}</span>
          <span class="fondos__where">{f.donde}</span>
        </button>
      ))}
    </nav>

    <script>
      import '@/scripts/ph-fondos-muestrario';
    </script>
  </body>
</html>

<style>
  :global(html),
  :global(body.fondos) {
    height: 100%;
    overflow: hidden;
    background: var(--color-ph-black);
  }

  .fondos__canvas,
  .fondos__grid {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .fondos__canvas { z-index: 1; display: block; }

  /* La de la variante C (`body::before` de su global.css), igual. */
  .fondos__grid {
    z-index: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: var(--ph-section-px) 0;
  }

  @media (min-width: 900px) {
    .fondos__grid { background-size: 64px 64px; }
  }

  .fondos__aviso {
    display: none;
    position: fixed;
    inset: 40% 24px auto;
    margin: 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 16px;
    color: rgba(255, 255, 255, 0.72);
  }

  :global(html.fondos--sin-webgl) .fondos__aviso { display: block; }

  /* La barra: abajo, al centro, pequeña. Se esconde sola sin ratón. */
  .fondos__bar {
    position: fixed;
    left: 50%;
    bottom: calc(20px + env(safe-area-inset-bottom));
    z-index: 2;
    display: flex;
    gap: 2px;
    max-width: calc(100% - 24px);
    padding: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    transform: translateX(-50%);
    background: rgba(13, 15, 18, 0.82);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: opacity 300ms cubic-bezier(0.2, 0, 0, 1), transform 300ms cubic-bezier(0.2, 0, 0, 1);
  }

  .fondos__bar::-webkit-scrollbar { display: none; }

  :global(html.fondos--quieto) .fondos__bar {
    opacity: 0;
    transform: translate(-50%, 10px);
    pointer-events: none;
  }

  :global(html.fondos--quieto) { cursor: none; }

  .fondos__opt {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    min-height: 48px;
    padding: 8px 14px 9px;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.62);
    cursor: pointer;
    transition: color 200ms cubic-bezier(0.2, 0, 0, 1), background-color 200ms cubic-bezier(0.2, 0, 0, 1);
  }

  .fondos__opt::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 4px;
    height: 2px;
    background: var(--color-ph-gold);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fondos__opt[aria-pressed='true'] { color: var(--color-ph-white); }
  .fondos__opt[aria-pressed='true']::after { transform: scaleX(1); }

  @media (hover: hover) and (pointer: fine) {
    .fondos__opt:hover { color: var(--color-ph-white); background-color: rgba(255, 255, 255, 0.05); }
  }

  .fondos__opt:focus-visible { outline: 2px solid var(--color-ph-gold); outline-offset: -2px; }

  .fondos__name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.1;
    white-space: nowrap;
  }

  .fondos__where {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.1;
    color: var(--color-ph-gold);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .fondos__bar,
    .fondos__opt,
    .fondos__opt::after { transition: none; }
  }
</style>
