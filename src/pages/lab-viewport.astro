---
/**
 * Página de laboratorio — TEMPORAL, no fusionar a main.
 *
 * Mide, dentro del motor donde el fallo existe (WebKit de iPhone en navegadores
 * que no son Safari), qué cambia exactamente cuando la barra de direcciones se
 * recoge y vuelve a salir. Registra el mínimo y el máximo de cada magnitud desde
 * que se cargó la página, así basta con deslizar arriba y abajo un par de veces
 * y leer los números: lo que tenga min ≠ max es lo que se está moviendo.
 *
 * Deliberadamente sin BaseLayout: sin ClientRouter, sin GSAP y sin el CSS del
 * sitio, para que ninguna de esas piezas contamine la medida.
 */
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <!-- Mismo viewport que el sitio real, para medir en sus mismas condiciones -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Laboratorio de viewport — PHSPORT</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      /* Réplica de lo que hace el sitio: respaldo en svh, congelado por el script. */
      :root { --ph-viewport-h: 100svh; }
      [data-viewport-probe] {
        position: fixed; top: 0; left: -9999px;
        width: 1px; height: 100svh;
        visibility: hidden; pointer-events: none;
      }
      body {
        background: #0d0f12;
        color: #fff;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        font-size: 13px;
        line-height: 1.5;
      }
      #panel {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 10;
        background: rgba(13, 15, 18, 0.96);
        border-bottom: 2px solid #d6b25e;
        padding: 10px 12px;
      }
      #panel h1 { font-size: 13px; color: #d6b25e; margin-bottom: 6px; }
      table { width: 100%; border-collapse: collapse; }
      td { padding: 2px 0; }
      td:first-child { color: #9aa0a6; }
      td:nth-child(n+2) { text-align: right; font-variant-numeric: tabular-nums; }
      .cambia { color: #ff6b6b; font-weight: 700; }
      .estable { color: #51cf66; }
      .bloque {
        border-bottom: 1px dashed #333;
        padding: 24px 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #666;
      }
      /* Bloques de referencia: uno por unidad, para ver cuál aguanta */
      .ref-svh { min-height: 100svh; }
      .ref-lvh { min-height: 100lvh; }
      .ref-dvh { min-height: 100dvh; }
      /* Sondas de medición: fuera de vista, sólo para leer su altura */
      .sonda { position: absolute; top: 0; left: -9999px; width: 1px; }
      #s-congelada { height: var(--ph-viewport-h); }
      #s-svh { height: 100svh; }
      #s-lvh { height: 100lvh; }
      #s-dvh { height: 100dvh; }
      #s-vh  { height: 100vh; }
    </style>
  </head>
  <body>
    <div data-viewport-probe aria-hidden="true"></div>
    <div class="sonda" id="s-congelada"></div>
    <div class="sonda" id="s-svh"></div>
    <div class="sonda" id="s-lvh"></div>
    <div class="sonda" id="s-dvh"></div>
    <div class="sonda" id="s-vh"></div>

    <div id="panel">
      <h1>LAB · desliza arriba y abajo 2 o 3 veces</h1>
      <table>
        <thead>
          <tr><td>medida</td><td>ahora</td><td>mín</td><td>máx</td></tr>
        </thead>
        <tbody id="filas"></tbody>
      </table>
      <div style="margin-top:6px;color:#9aa0a6">
        eventos resize: <span id="n-resize">0</span> ·
        visualViewport: <span id="n-vv">0</span>
      </div>
    </div>

    <div class="bloque" style="padding-top:180px">↓ desliza ↓</div>
    <div class="bloque ref-svh">bloque de 100svh</div>
    <div class="bloque ref-lvh">bloque de 100lvh</div>
    <div class="bloque ref-dvh">bloque de 100dvh</div>
    <div class="bloque" style="min-height:60vh">fin</div>

    <script is:inline>
      (function () {
        // El congelador del sitio, replicado aquí para poder comparar en la misma
        // pantalla lo que se mueve y lo que ya no.
        (function congelar() {
          var anchoMedido = -1;
          var sonda = document.querySelector('[data-viewport-probe]');
          function medir() {
            if (!sonda || window.innerWidth === anchoMedido) return;
            anchoMedido = window.innerWidth;
            document.documentElement.style.setProperty(
              '--ph-viewport-h',
              Math.round(sonda.getBoundingClientRect().height) + 'px',
            );
          }
          medir();
          addEventListener('resize', medir, { passive: true });
        })();

        var MEDIDAS = [
          { id: '→ CONGELADA', leer: function () { return document.getElementById('s-congelada').getBoundingClientRect().height; } },
          { id: 'innerHeight', leer: function () { return window.innerHeight; } },
          { id: 'visualVP', leer: function () { return window.visualViewport ? Math.round(window.visualViewport.height) : 0; } },
          { id: '100svh', leer: function () { return document.getElementById('s-svh').getBoundingClientRect().height; } },
          { id: '100lvh', leer: function () { return document.getElementById('s-lvh').getBoundingClientRect().height; } },
          { id: '100dvh', leer: function () { return document.getElementById('s-dvh').getBoundingClientRect().height; } },
          { id: '100vh', leer: function () { return document.getElementById('s-vh').getBoundingClientRect().height; } },
          { id: 'alto documento', leer: function () { return document.documentElement.scrollHeight; } },
        ];

        var estado = MEDIDAS.map(function (m) { return { id: m.id, leer: m.leer, min: Infinity, max: -Infinity, ahora: 0 }; });
        var tbody = document.getElementById('filas');
        var celdas = estado.map(function (e) {
          var tr = document.createElement('tr');
          tr.innerHTML = '<td>' + e.id + '</td><td></td><td></td><td></td>';
          tbody.appendChild(tr);
          return tr.children;
        });

        var nResize = 0, nVV = 0;
        addEventListener('resize', function () { nResize++; });
        if (window.visualViewport) window.visualViewport.addEventListener('resize', function () { nVV++; });

        function pintar() {
          for (var i = 0; i < estado.length; i++) {
            var e = estado[i];
            var v = Math.round(e.leer());
            e.ahora = v;
            if (v < e.min) e.min = v;
            if (v > e.max) e.max = v;
            celdas[i][1].textContent = v;
            celdas[i][2].textContent = e.min;
            celdas[i][3].textContent = e.max;
            var cambia = e.max - e.min > 1;
            celdas[i][3].className = cambia ? 'cambia' : 'estable';
            celdas[i][2].className = cambia ? 'cambia' : 'estable';
          }
          document.getElementById('n-resize').textContent = nResize;
          document.getElementById('n-vv').textContent = nVV;
          requestAnimationFrame(pintar);
        }
        requestAnimationFrame(pintar);
      })();
    </script>
  </body>
</html>
